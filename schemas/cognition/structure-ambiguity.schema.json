{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cognitura:schema:cognition:structure-ambiguity:2.0.0",
  "title": "Cognitura StructureAmbiguity 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "revisionId",
    "publicationState",
    "locationRef",
    "recommendedStructure",
    "alternatives",
    "rationale",
    "closureImpacts",
    "sourceRefs",
    "gapRefs"
  ],
  "properties": {
    "schemaVersion": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/schemaVersion"},
    "artifactId": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactId"},
    "revisionId": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/revisionId"},
    "publicationState": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/publicationState"},
    "locationRef": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRef"},
    "recommendedStructure": {"$ref": "#/$defs/recommendedStructure"},
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/alternative"}
    },
    "rationale": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/nonBlankText"},
    "closureImpacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/closureImpact"}
    },
    "sourceRefs": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray"},
    "gapRefs": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray"}
  },
  "if": {
    "properties": {"sourceRefs": {"maxItems": 0}},
    "required": ["sourceRefs"]
  },
  "then": {
    "properties": {"gapRefs": {"minItems": 1}}
  },
  "$defs": {
    "recommendedStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "affectedRefs"],
      "properties": {
        "summary": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/nonBlankText"},
        "affectedRefs": {
          "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray",
          "minItems": 1
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternativeId", "summary", "affectedRefs", "riskLevel"],
      "properties": {
        "alternativeId": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactId"},
        "summary": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/nonBlankText"},
        "affectedRefs": {
          "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray",
          "minItems": 1
        },
        "riskLevel": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/riskLevel"}
      }
    },
    "closureImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeRef", "impact", "riskLevel"],
      "properties": {
        "scopeRef": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRef"},
        "impact": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/nonBlankText"},
        "riskLevel": {"$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/riskLevel"}
      }
    }
  }
}
