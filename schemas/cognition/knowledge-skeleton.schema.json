{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cognitura:schema:cognition:knowledge-skeleton:2.0.0",
  "title": "Cognitura KnowledgeSkeleton 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "revisionId",
    "publicationState",
    "landscapeThesis",
    "themes",
    "coreThemeRefs",
    "relations",
    "understandingRoute",
    "structureAmbiguityRefs",
    "sourceCoverage",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/schemaVersion"
    },
    "artifactId": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactId"
    },
    "revisionId": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/revisionId"
    },
    "publicationState": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/publicationState"
    },
    "landscapeThesis": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:cognitura:schema:cognition:knowledge-theme:2.0.0"
      }
    },
    "coreThemeRefs": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray",
      "maxItems": 9
    },
    "relations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/relation"
      }
    },
    "understandingRoute": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray",
      "minItems": 1
    },
    "structureAmbiguityRefs": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/artifactRefArray"
    },
    "sourceCoverage": {
      "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/sourceCoverage"
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "urn:cognitura:schema:cognition:common:2.0.0#/$defs/gap"
      }
    }
  },
  "if": {
    "properties": {
      "publicationState": {
        "const": "PUBLISHED"
      }
    },
    "required": ["publicationState"]
  },
  "then": {
    "properties": {
      "landscapeThesis": {
        "minLength": 1
      },
      "coreThemeRefs": {
        "minItems": 3,
        "maxItems": 9
      }
    }
  }
}
