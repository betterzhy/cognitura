#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s --manifest <path> [--repo-root <path>]\n' "$0" >&2
  exit 2
}

fail() {
  printf 'HighFidelityDesignManifestValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    fail "SHA256_TOOL_MISSING"
  fi
}

manifest=""
repo_root=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --manifest) [[ "$#" -ge 2 ]] || usage; manifest="$2"; shift 2 ;;
    --repo-root) [[ "$#" -ge 2 ]] || usage; repo_root="$2"; shift 2 ;;
    *) usage ;;
  esac
done
if [[ -z "${manifest}" ]]; then
  script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  manifest="${script_root}/docs/engineering/cognitura-high-fidelity-design-manifest.yaml"
  [[ -n "${repo_root}" ]] || repo_root="${script_root}"
fi
[[ -f "${manifest}" ]] || fail "MISSING_MANIFEST: ${manifest}"
if [[ -z "${repo_root}" ]]; then
  repo_root="$(cd "$(dirname "${manifest}")/../.." && pwd -P)"
fi

[[ "$(grep -c '^manifestVersion: 1$' "${manifest}" || true)" -eq 1 ]] ||
  fail "MANIFEST_VERSION_MISMATCH"
[[ "$(grep -c '^canonicalProjectName: Cognitura$' "${manifest}" || true)" -eq 1 ]] ||
  fail "PROJECT_NAME_MISMATCH"
[[ "$(grep -c '^  - sourceId: HF-DESIGN-001$' "${manifest}" || true)" -eq 1 ]] ||
  fail "SOURCE_COUNT: expected exactly HF-DESIGN-001"
[[ "$(grep -c '^  - sourceId: ' "${manifest}" || true)" -eq 1 ]] ||
  fail "SOURCE_COUNT: expected 1"

source_path="$(sed -n 's/^    path: //p' "${manifest}")"
role="$(sed -n 's/^    role: //p' "${manifest}")"
version="$(sed -n 's/^    version: //p' "${manifest}")"
status="$(sed -n 's/^    status: //p' "${manifest}")"
declared_size="$(sed -n 's/^    sizeBytes: //p' "${manifest}")"
declared_hash="$(sed -n 's/^    sha256: //p' "${manifest}")"
fingerprint_scope="$(sed -n 's/^    fingerprintScope: //p' "${manifest}")"

[[ "${source_path}" == "Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md" ]] ||
  fail "PATH_MISMATCH"
[[ "${role}" == "HIGH_FIDELITY_INTERACTION_SPECIALTY_CANDIDATE" ]] || fail "ROLE_MISMATCH"
[[ "${version}" == "Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0" ]] ||
  fail "VERSION_MISMATCH"
[[ "${status}" == "CANDIDATE_AWAITING_REPOSITORY_GATE" ]] || fail "STATUS_MISMATCH"
[[ "${fingerprint_scope}" == "HF-DG2_ORTHOGONAL_STATE_AND_RECOVERY" ]] ||
  fail "FINGERPRINT_SCOPE_MISMATCH"

source_file="${repo_root}/${source_path}"
[[ -f "${source_file}" ]] || fail "MISSING_SOURCE: ${source_path}"
actual_size="$(wc -c <"${source_file}" | tr -d '[:space:]')"
[[ "${declared_size}" == "${actual_size}" ]] ||
  fail "SIZE_MISMATCH: declared ${declared_size}, actual ${actual_size}"
actual_hash="$(hash_file "${source_file}")"
[[ "${declared_hash}" == "${actual_hash}" ]] ||
  fail "SHA256_MISMATCH: declared ${declared_hash}, actual ${actual_hash}"

printf '%s\n' \
  "HighFidelityDesignManifestValidation = PASS" \
  "SourceBodyManifestCoupling = REQUIRED" \
  "SourceCount = 1" \
  "SourceStatus = CANDIDATE_AWAITING_REPOSITORY_GATE" \
  "SourceFingerprintScope = HF-DG2_ORTHOGONAL_STATE_AND_RECOVERY" \
  "SourceSizeBytes = ${actual_size}" \
  "SourceSha256 = ${actual_hash}"
