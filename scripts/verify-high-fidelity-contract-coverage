#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s --coverage <path> --document <path>\n' "$0" >&2
  exit 2
}

fail() {
  printf 'HighFidelityContractCoverageValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

coverage=""
document=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --coverage) [[ "$#" -ge 2 ]] || usage; coverage="$2"; shift 2 ;;
    --document) [[ "$#" -ge 2 ]] || usage; document="$2"; shift 2 ;;
    *) usage ;;
  esac
done
if [[ -z "${coverage}" || -z "${document}" ]]; then
  script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  [[ -n "${coverage}" ]] || coverage="${script_root}/docs/engineering/cognitura-high-fidelity-contract-coverage.md"
  [[ -n "${document}" ]] || document="${script_root}/Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md"
fi
[[ -f "${coverage}" ]] || fail "MISSING_COVERAGE: ${coverage}"
[[ -f "${document}" ]] || fail "MISSING_DOCUMENT: ${document}"

count_unique_rows() {
  local marker="$1"
  awk -F'|' -v marker="${marker}" '
    $2 ~ "`" marker "`" {
      value=$3
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value != "") seen[value]=1
      rows++
    }
    END {
      unique=0
      for (value in seen) unique++
      print rows ":" unique
    }
  ' "${document}"
}

state_counts="$(count_unique_rows StateCode)"
[[ "${state_counts}" == "46:46" ]] ||
  fail "expected 46 unique original StateCode rows, found ${state_counts}"
exception_counts="$(count_unique_rows ExceptionCode)"
[[ "${exception_counts}" == "20:20" ]] ||
  fail "expected 20 unique ExceptionCode rows, found ${exception_counts}"
rf_counts="$(awk -F'|' '/^\| RF-AC-[0-9][0-9] / {gsub(/ /, "", $2); seen[$2]=1; rows++} END {unique=0; for (v in seen) unique++; print rows ":" unique}' "${document}")"
[[ "${rf_counts}" == "20:20" ]] ||
  fail "expected 20 unique RF-AC rows, found ${rf_counts}"
rm_counts="$(awk '/^ISHFI-RM-[0-9][0-9] =$/ {seen[$1]=1; rows++} END {unique=0; for (v in seen) unique++; print rows ":" unique}' "${document}")"
[[ "${rm_counts}" == "30:30" ]] ||
  fail "expected 30 unique reverse-migration items, found ${rm_counts}"

grep -Fqx 'GateClosure = DEFERRED_UNTIL_HF_D04' "${coverage}" ||
  fail "GateClosure must remain DEFERRED_UNTIL_HF_D04"

for required in \
  'CanonicalProjectName = Cognitura' \
  'CoverageStatus = CANDIDATE_TRACE_REGISTERED' \
  'BusinessImplementation = NOT_AUTHORIZED' \
  'FormalDatabaseWrite = NOT_AUTHORIZED' \
  'RemotePush = NOT_AUTHORIZED'; do
  grep -Fqx "${required}" "${coverage}" ||
    fail "missing or invalid coverage field: ${required}"
done

for id in STATE-CODES EXCEPTION-CODES RF-AC REVERSE-MIGRATION; do
  count="$(grep -c "^| ${id} |" "${coverage}" || true)"
  [[ "${count}" -eq 1 ]] || fail "missing coverage ID: ${id}"
done
row_count="$(grep -c '^| \(STATE-CODES\|EXCEPTION-CODES\|RF-AC\|REVERSE-MIGRATION\) |' "${coverage}" || true)"
[[ "${row_count}" -eq 4 ]] || fail "CoverageRowCount must be 4"
grep -Fq "| STATE-CODES | ${state_counts%%:*} |" "${coverage}" ||
  fail "STATE-CODES coverage count must match candidate inventory"
grep -Fq "| EXCEPTION-CODES | ${exception_counts%%:*} |" "${coverage}" ||
  fail "EXCEPTION-CODES coverage count must match candidate inventory"
grep -Fq "| RF-AC | ${rf_counts%%:*} |" "${coverage}" ||
  fail "RF-AC coverage count must match candidate inventory"
grep -Fq "| REVERSE-MIGRATION | ${rm_counts%%:*} |" "${coverage}" ||
  fail "REVERSE-MIGRATION coverage count must match candidate inventory"
grep -Fq 'Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md' "${coverage}" ||
  fail "candidate source trace is missing"

printf '%s\n' \
  "HighFidelityContractCoverageValidation = PASS" \
  "CoverageRowCount = 4" \
  "GateClosure = DEFERRED_UNTIL_HF_D04"
