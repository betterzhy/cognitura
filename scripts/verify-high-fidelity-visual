  [[ -f "${export_manifest}" ]] || fail "static export companion manifest is missing"
  if ! manifest_summary="$(node - "${export_manifest}" <<'NODE'
const fs = require("fs");
const path = process.argv[2];
const manifest = JSON.parse(fs.readFileSync(path, "utf8"));
const fail = (message) => { throw new Error(message); };
if (manifest.schemaVersion !== "1.0") fail("schemaVersion");
if (manifest.exportType !== "PNG_COMPANION_MANIFEST") fail("exportType");
if (manifest.artifact !== "static-export-example.png") fail("artifact");
if (manifest.canonicalFactAuthority !== "EXTERNAL_CANONICAL_MODEL_NOT_IMAGE") fail("authority");
if (manifest.readerVisibility?.rawTechnicalIds !== "HIDDEN_BY_DEFAULT") fail("readerVisibility");
if (manifest.readerVisibility?.machineIdentityLocation !== "COMPANION_MANIFEST") fail("identityLocation");
if (!Array.isArray(manifest.objects) || manifest.objects.length !== 5) fail("objects");
if (!Array.isArray(manifest.relations) || manifest.relations.length !== 1) fail("relations");
if (!Array.isArray(manifest.sources) || manifest.sources.length !== 1) fail("sources");
const objectIds = manifest.objects.map((entry) => entry.id);
const relationIds = manifest.relations.map((entry) => entry.id);
const sourceIds = manifest.sources.map((entry) => entry.id);
const unique = (values) => new Set(values).size === values.length;
if (!unique(objectIds) || !unique(relationIds) || !unique(sourceIds)) fail("duplicate identity");
const objectSet = new Set(objectIds);
for (const relation of manifest.relations) {
  if (!objectSet.has(relation.sourceId) || !objectSet.has(relation.targetId)) fail("relation target");
}
const supportable = new Set([...objectIds, ...relationIds]);
for (const source of manifest.sources) {
  if (!Array.isArray(source.supports) || source.supports.some((id) => !supportable.has(id))) fail("source support");
}
process.stdout.write([
  objectIds.sort().join(","),
  relationIds.sort().join(","),
  sourceIds.sort().join(","),
  manifest.relations[0].sourceId + "->" + manifest.relations[0].targetId,
  manifest.sources[0].supports.slice().sort().join(",")
].join("\n"));
NODE
  )"; then
    fail "static export companion manifest is invalid"
  fi
  manifest_objects="$(sed -n '1p' <<<"${manifest_summary}")"
