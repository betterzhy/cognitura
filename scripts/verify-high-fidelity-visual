  run_headless_dump_dom \
    "${module_dom_chrome_profile}" \
    "${module_dom_file}" \
    "file://${prototype_dir}/index.html?state=module-default" ||
    fail "Chrome could not evaluate the module-default fixture"
  module_dom="$(<"${module_dom_file}")"
  for module_dom_contract in \
    'data-fixture-status="ACCEPTED"' \
    'data-state-fixture="module-default"' \
    'data-module-default-evidence="HIGH_FIDELITY_VISUAL_PASS"' \
    'data-zero-interaction-cognitive-closure="COMPLETE"' \
    'data-continuous-explanatory-narrative="REQUIRED"' \
    'data-primary-cognitive-spine="VISIBLE"' \
    'data-primary-visual-projection-count="1"' \
    'data-key-relation-count="2"' \
    'data-persistent-governance-side-panel-count="0"' \
    'data-visible-perspective-switches="0"' \
    'data-knowledge-element-entry="ON_DEMAND"' \
    'data-source-evidence-entry="ON_DEMAND"' \
    'id="module-default-document"' \
    'aria-label="展开 KnowledgeElement：Read View"' \
    'aria-label="按需查看 SourceEvidence 支持范围"'; do
    [[ "${module_dom}" == *"${module_dom_contract}"* ]] ||
      fail "module-default DOM is missing contract: ${module_dom_contract}"
  done

  module_document_count="$(evaluated_dom_literal_count "${module_dom}" 'id="module-default-document"')"
  [[ "${module_document_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real document root"

  module_opening_dom="$(evaluated_dom_section "${module_dom}" '<header class="module-opening">' '</header>')"
  core_question_count="$(evaluated_dom_regex_count "${module_opening_dom}" '<h1([ >])')"
  [[ "${core_question_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real CoreQuestion"

  core_conclusion_count="$(evaluated_dom_literal_count "${module_dom}" 'class="module-conclusion-lead"')"
  [[ "${core_conclusion_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real CoreConclusion"

  module_closure_count="$(evaluated_dom_literal_count "${module_dom}" 'class="module-closure"')"
  [[ "${module_closure_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real .module-closure"
  module_closure_dom="$(evaluated_dom_section "${module_dom}" '<section class="module-closure"' '</section>')"
  for closure_region in Conditions Results 'Boundaries / Exceptions'; do
    closure_region_count="$(evaluated_dom_literal_count "${module_closure_dom}" "${closure_region} ·")"
    [[ "${closure_region_count}" -eq 1 ]] ||
      fail "module-default must contain exactly one real ${closure_region} region"
  done

  primary_projection_count="$(evaluated_dom_literal_count "${module_dom}" 'class="module-primary-projection"')"
  [[ "${primary_projection_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real primary visual projection"
  declared_primary_projection_count="$(evaluated_dom_attribute_value "${module_dom}" 'data-primary-visual-projection-count')"
  [[ "${primary_projection_count}" == "${declared_primary_projection_count}" ]] ||
    fail "module-default real primary visual projection count ${primary_projection_count} does not match declared count ${declared_primary_projection_count}"

  module_relations_count="$(evaluated_dom_literal_count "${module_dom}" 'class="module-relations"')"
  [[ "${module_relations_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real .module-relations"
  module_relations_dom="$(evaluated_dom_section "${module_dom}" '<section class="module-relations"' '</section>')"
  relation_count="$(evaluated_dom_regex_count "${module_relations_dom}" '<li([ >])')"
  [[ "${relation_count}" -ge 1 && "${relation_count}" -le 3 ]] ||
    fail "module-default real Relation count must be between 1 and 3"
  declared_relation_count="$(evaluated_dom_attribute_value "${module_dom}" 'data-key-relation-count')"
  [[ "${relation_count}" == "${declared_relation_count}" ]] ||
    fail "module-default real Relation count ${relation_count} does not match declared count ${declared_relation_count}"

  persistent_governance_count="$(evaluated_dom_literal_count "${module_dom}" 'class="persistent-governance-sidebar"')"
  declared_persistent_governance_count="$(evaluated_dom_attribute_value "${module_dom}" 'data-persistent-governance-side-panel-count')"
  [[ "${persistent_governance_count}" == "${declared_persistent_governance_count}" ]] ||
    fail "module-default real persistent governance side panel count ${persistent_governance_count} does not match declared count ${declared_persistent_governance_count}"
  [[ "${persistent_governance_count}" -eq 0 ]] ||
    fail "module-default real persistent governance side panel count must be 0"

  module_evidence_png="${evidence_dir}/module-default-reading-desktop.png"
  [[ -f "${module_evidence_png}" ]] || fail "module-default visual evidence is missing"
  module_png_description="$(file "${module_evidence_png}" 2>/dev/null || true)"
  [[ "${module_png_description}" == *"PNG image data, 1440 x 1100"* ]] ||
    fail "module-default visual evidence must be a 1440x1100 PNG"
  captured_module_png="${runtime_tmp}/module-default-reading-desktop.png"
  run_headless_screenshot \
    "${module_png_chrome_profile}" \
    "${captured_module_png}" \
    '1440,1100' \
    "file://${prototype_dir}/index.html?state=module-default" ||
    fail "Chrome could not recapture the module-default evidence"
  captured_module_description="$(file "${captured_module_png}" 2>/dev/null || true)"
  [[ "${captured_module_description}" == *"PNG image data, 1440 x 1100"* ]] ||
    fail "recaptured module-default evidence must be a 1440x1100 PNG"
  cmp -s "${captured_module_png}" "${module_evidence_png}" ||
    fail "module-default visual evidence is stale for the current prototype"
fi

printf 'HighFidelityVisualTaskCardValidation = PASS\n'
printf 'TaskCardCount = 6\n'
printf 'TaskCardSetStatus = READY_FOR_EXECUTION\n'
printf 'ActiveTaskCard = %s\n' "${active_task}"
printf 'DoneTaskCardCount = %s\n' "${done_count}"
printf 'ReadyTaskCardCount = %s\n' "${ready_count}"
printf 'BlockedTaskCardCount = %s\n' "${blocked_count}"
printf 'Task6WriteSetItemCount = 22\n'
printf 'VisualFoundationPrototypeValidation = PASS\n'
printf 'VisualFoundationEvidence = 1440x1100\n'
printf 'UnknownFixtureStateRejection = PASS\n'
printf 'VisualFoundationEvidenceFreshness = PASS\n'
if [[ "${active_number}" -ge 2 ]]; then
  printf 'ModuleDefaultReadingPrototypeValidation = PASS\n'
  printf 'ModuleDefaultReadingRealDOMValidation = PASS\n'
  printf 'ModuleDefaultReadingEvidence = 1440x1100\n'
  printf 'ModuleDefaultReadingEvidenceFreshness = PASS\n'
fi
printf 'HighFidelityVisualDesign = NOT_RUN\n'
printf 'HighFidelityUsabilityValidation = NOT_RUN\n'
printf 'BusinessImplementation = NOT_AUTHORIZED\n'
printf 'FormalDatabaseWrite = NOT_AUTHORIZED\n'
printf 'RemotePush = NOT_AUTHORIZED\n'
