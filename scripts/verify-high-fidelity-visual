for owner_contract in \
  'RF-AC-01|HV-D04' 'RF-AC-02|HV-D01' 'RF-AC-03|HV-D02' 'RF-AC-04|HV-D01' \
  'RF-AC-05|HV-D01' 'RF-AC-06|HV-D01' 'RF-AC-07|HV-D02' 'RF-AC-08|HV-D01' \
  'RF-AC-09|HV-D02' 'RF-AC-10|HV-D04' 'RF-AC-11|HV-D01' 'RF-AC-12|HV-D01' \
  'RF-AC-13|HV-D03' 'RF-AC-14|HV-D03' 'RF-AC-15|HV-D04' 'RF-AC-16|HV-D02' \
  'RF-AC-17|HV-D03' 'RF-AC-18|HV-D03' 'RF-AC-19|HV-D04' 'RF-AC-20|HV-D05'; do
  rf_id="${owner_contract%%|*}"
  rf_gate="${owner_contract#*|}"
  rf_line_count="$(grep -Ec "^RFAcceptance = ${rf_id}\\|" "${acceptance}" || true)"
  [[ "${rf_line_count}" -eq 1 ]] || fail "${rf_id} must have exactly one acceptance row"
  grep -Eq "^RFAcceptance = ${rf_id}\\|.*\\|Gate=${rf_gate}$" "${acceptance}" ||
    fail "${rf_id} must be owned by ${rf_gate}"
  grep -Eq "^RFAcceptance = ${rf_id}\\|.*\\|Artifact=PLANNED:[^|]+\\|Status=NOT_RUN\\|Gate=${rf_gate}$" "${acceptance}" ||
    fail "${rf_id} canonical input contract must remain PLANNED/NOT_RUN"
  rf_gate_suffix="${rf_gate#HV-D}"
  rf_gate_number=$((10#${rf_gate_suffix}))
  observation_count="$(grep -Ec "^HVVisualAcceptanceObservation = ${rf_id}\\|" "${acceptance}" || true)"
  if [[ "${rf_gate_number}" -lt "${active_number}" ]]; then
    [[ "${observation_count}" -eq 1 ]] ||
      fail "${rf_id} must have exactly one completed visual observation"
    grep -Eq "^HVVisualAcceptanceObservation = ${rf_id}\\|Owner=${rf_gate}\\|Artifact=docs/design/high-fidelity/evidence/[^|]+\\|Status=PASS_HIGH_FIDELITY_VISUAL_ONLY\\|Usability=NOT_RUN\\|Implementation=NOT_RUN$" "${acceptance}" ||
      fail "${rf_id} must record PASS_HIGH_FIDELITY_VISUAL_ONLY"
  else
    [[ "${observation_count}" -eq 0 ]] ||
      fail "${rf_id} must not record a visual observation before its owner stage"
  fi
done

