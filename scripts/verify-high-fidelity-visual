  rm -rf "${runtime_tmp}"
}
trap cleanup_runtime EXIT

terminate_headless_chrome() {
  local chrome_pid="$1"
  kill "${chrome_pid}" 2>/dev/null || true
  wait "${chrome_pid}" 2>/dev/null || true
}

run_headless_dump_dom() {
  local chrome_profile="$1"
  local output_file="$2"
  local fixture_url="$3"
  local chrome_pid attempt artifact_ready

  "${chrome_bin}" \
    --headless=new --disable-gpu --hide-scrollbars \
    --user-data-dir="${chrome_profile}" --no-first-run --no-default-browser-check \
    --use-mock-keychain --dump-dom "${fixture_url}" >"${output_file}" 2>/dev/null &
  chrome_pid=$!
  artifact_ready=NO
  attempt=0
  while [[ "${attempt}" -lt 300 ]]; do
    if grep -Fq '</html>' "${output_file}" 2>/dev/null; then
      artifact_ready=YES
      break
    fi
    kill -0 "${chrome_pid}" 2>/dev/null || break
    sleep 0.1
    attempt=$((attempt + 1))
  done
  terminate_headless_chrome "${chrome_pid}"
  [[ "${artifact_ready}" == "YES" ]]
}

run_headless_screenshot() {
  local chrome_profile="$1"
  local output_file="$2"
  local viewport="$3"
  local fixture_url="$4"
  local chrome_pid attempt artifact_ready

  "${chrome_bin}" \
    --headless=new --disable-gpu --hide-scrollbars \
    --user-data-dir="${chrome_profile}" --no-first-run --no-default-browser-check \
    --use-mock-keychain --window-size="${viewport}" \
    --screenshot="${output_file}" "${fixture_url}" >/dev/null 2>&1 &
  chrome_pid=$!
  artifact_ready=NO
  attempt=0
  while [[ "${attempt}" -lt 300 ]]; do
    if file "${output_file}" 2>/dev/null | grep -Fq 'PNG image data'; then
      artifact_ready=YES
      break
    fi
    kill -0 "${chrome_pid}" 2>/dev/null || break
    sleep 0.1
    attempt=$((attempt + 1))
  done
  terminate_headless_chrome "${chrome_pid}"
  [[ "${artifact_ready}" == "YES" ]]
}

evaluated_dom_literal_count() {
  local evaluated_dom="$1"
  local literal="$2"
  printf '%s\n' "${evaluated_dom}" |
    { grep -Fo -- "${literal}" || true; } |
    wc -l |
    tr -d '[:space:]'
}

evaluated_dom_regex_count() {
  local evaluated_dom="$1"
  local regex="$2"
  printf '%s\n' "${evaluated_dom}" |
    { grep -Eo -- "${regex}" || true; } |
    wc -l |
    tr -d '[:space:]'
}

evaluated_dom_attribute_value() {
  local evaluated_dom="$1"
  local attribute="$2"
  local matches match_count
  matches="$(printf '%s\n' "${evaluated_dom}" | { grep -Eo -- "${attribute}=\"[^\"]*\"" || true; })"
  match_count="$(printf '%s\n' "${matches}" | awk 'NF {count++} END {print count+0}')"
  [[ "${match_count}" -eq 1 ]] ||
    fail "module-default evaluated DOM must declare ${attribute} exactly once"
  printf '%s\n' "${matches}" | sed -n "s/^${attribute}=\"\([^\"]*\)\"$/\1/p"
}

evaluated_dom_section() {
  local evaluated_dom="$1"
  local opening_pattern="$2"
  local closing_pattern="$3"
  printf '%s\n' "${evaluated_dom}" | awk \
    -v opening_pattern="${opening_pattern}" \
    -v closing_pattern="${closing_pattern}" '
      index($0, opening_pattern) {inside=1}
      inside {print}
      inside && index($0, closing_pattern) {exit}
    '
}

