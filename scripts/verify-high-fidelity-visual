  'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
  'README.md' 'AGENTS.md' 'docs/task-cards/README.md'
assert_plan_write_set 12 \
  'docs/engineering/cognitura-development-entry-prompt.md' \
  'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' \
  'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
  'docs/task-cards/README.md'

future_task_write_counts=(17 18 19 21 12 7)
future_task_index=0
for task in 7 8 9 10 11 12; do
  task_body="$(plan_task_body "${task}")"
  [[ "$(printf '%s\n' "${task_body}" | grep -Fc "\`WriteSetItemCount = ${future_task_write_counts[${future_task_index}]}\`" || true)" -eq 1 ]] ||
    fail "master plan Task ${task} WriteSetItemCount must be ${future_task_write_counts[${future_task_index}]}"
  future_task_index=$((future_task_index + 1))
done

design_index="${script_root}/docs/engineering/cognitura-design-index.md"
root_task_index="${script_root}/docs/task-cards/README.md"
for sync_file in \
  "${script_root}/AGENTS.md" \
  "${script_root}/README.md" \
  "${evidence_plan}" \
  "${acceptance}" \
  "${design_index}" \
  "${root_task_index}"; do
  [[ -f "${sync_file}" ]] || fail "state synchronization file is missing: ${sync_file}"
done
for project_status in \
  'HighFidelityVisualFoundation = PASS' \
  'HighFidelityVisualTaskCardSet = READY_FOR_EXECUTION' \
  'HighFidelityVisualProjectedEntry = HV-D01 READY / RELEASED' \
  'ActiveDesignTaskCard = HV-D01'; do
  require_line_once "${script_root}/AGENTS.md" "${project_status}"
  require_line_once "${script_root}/README.md" "${project_status}"
done
for execution_line in \
  'HVExecutionTask = HV-D00|VisualFoundation|DONE|PASS' \
  'HVExecutionTask = HV-D01|ModuleDefaultReading|READY|RELEASED' \
  'HVExecutionTask = HV-D02|FocusAndSource|BLOCKED_BY_DEPENDENCY|NOT_RELEASED' \
  'HVExecutionTask = HV-D03|RevisionAndRecovery|BLOCKED_BY_DEPENDENCY|NOT_RELEASED' \
  'HVExecutionTask = HV-D04|CrossLayerResponsiveAndExport|BLOCKED_BY_DEPENDENCY|NOT_RELEASED' \
  'HVExecutionTask = HV-D05|FixedVisualUsabilityReview|BLOCKED_BY_DEPENDENCY|NOT_RELEASED'; do
  require_line_once "${evidence_plan}" "${execution_line}"
done
require_line_once "${acceptance}" 'VisualFoundationArtifactCapture = PASS'
require_line_once "${acceptance}" 'HighFidelityVisualDesign = NOT_RUN'
require_line_once "${acceptance}" 'HighFidelityUsabilityValidation = NOT_RUN'
require_line_once "${design_index}" 'HighFidelityVisualTaskCardSet = READY_FOR_EXECUTION'
require_line_once "${design_index}" 'HighFidelityVisualFoundation = PASS'
require_line_once "${design_index}" 'ActiveDesignTaskCard = HV-D01'
require_line_once "${root_task_index}" 'HighFidelityVisualTaskCardSet = READY_FOR_EXECUTION'
require_line_once "${root_task_index}" 'HighFidelityVisualActiveTaskCard = HV-D01'

for owner_contract in \
  'RF-AC-01|HV-D04' 'RF-AC-02|HV-D01' 'RF-AC-03|HV-D02' 'RF-AC-04|HV-D01' \
  'RF-AC-05|HV-D01' 'RF-AC-06|HV-D01' 'RF-AC-07|HV-D02' 'RF-AC-08|HV-D01' \
  'RF-AC-09|HV-D02' 'RF-AC-10|HV-D04' 'RF-AC-11|HV-D01' 'RF-AC-12|HV-D01' \
  'RF-AC-13|HV-D03' 'RF-AC-14|HV-D03' 'RF-AC-15|HV-D04' 'RF-AC-16|HV-D02' \
  'RF-AC-17|HV-D03' 'RF-AC-18|HV-D03' 'RF-AC-19|HV-D04' 'RF-AC-20|HV-D05'; do
  rf_id="${owner_contract%%|*}"
  rf_gate="${owner_contract#*|}"
  rf_line_count="$(grep -Ec "^RFAcceptance = ${rf_id}\\|" "${acceptance}" || true)"
  [[ "${rf_line_count}" -eq 1 ]] || fail "${rf_id} must have exactly one acceptance row"
  grep -Eq "^RFAcceptance = ${rf_id}\\|.*\\|Gate=${rf_gate}$" "${acceptance}" ||
    fail "${rf_id} must be owned by ${rf_gate}"
done

grep -Eq '^EvidencePath = 05\|.*\|Artifact=PLANNED:docs/design/high-fidelity/evidence/module-recovery-desktop\.png\|Status=NOT_RUN\|Gate=HV-D03$' "${evidence_plan}" ||
  fail "EvidencePath 05 canonical primary artifact must be module-recovery-desktop.png"
grep -Eq '^EvidencePath = 06\|.*\|Artifact=PLANNED:docs/design/high-fidelity/evidence/knowledge-landscape-theme-desktop\.png\|Status=NOT_RUN\|Gate=HV-D04$' "${evidence_plan}" ||
  fail "EvidencePath 06 canonical primary artifact must be knowledge-landscape-theme-desktop.png"

for artifact in index.html styles.css prototype.js; do
  [[ -f "${prototype_dir}/${artifact}" ]] || fail "prototype artifact is missing: ${artifact}"
done
[[ -f "${evidence_dir}/README.md" ]] || fail "evidence contract is missing"

[[ "$(field_value "${visual_design}" HighFidelityVisualDesign)" == "NOT_RUN" ]] ||
  fail "HighFidelityVisualDesign must be NOT_RUN"
[[ "$(field_value "${visual_design}" HighFidelityUsabilityValidation)" == "NOT_RUN" ]] ||
  fail "HighFidelityUsabilityValidation must be NOT_RUN"
for line in \
  'PrototypeKind = DOCUMENTATION_ONLY_NON_PRODUCTION_FIXTURE' \
  'FixtureDataSource = EMBEDDED_DETERMINISTIC_DATA' \
  'FixtureStateTransport = URL_QUERY_ONLY' \
  'DesktopViewport = 1440x1100' \
  'SmallScreenViewport = 390x844' \
  'DesktopContentThreshold = 1180px' \
  'CompactLayoutThreshold = 900px' \
  'FocusRingToken = --focus-ring' \
  'DocumentWidthToken = --document-width' \
  'HierarchyRailToken = --hierarchy-rail-width' \
  'SourceMarkerToken = --source-marker' \
  'StaleToken = --status-stale' \
  'ErrorToken = --status-error'; do
  require_line "${visual_design}" "${line}"
done
expected_fixture_states=(visual-foundation module-default relation-focus source-verification revision-impact partial-failure conflicted-draft domain-default theme-default module-small-screen static-export)
actual_fixture_states="$(sed -n 's/^FixtureState = //p' "${visual_design}" | LC_ALL=C sort)"
expected_fixture_state_set="$(printf '%s\n' "${expected_fixture_states[@]}" | LC_ALL=C sort)"
[[ "${actual_fixture_states}" == "${expected_fixture_state_set}" ]] ||
  fail "FixtureState must be the exact canonical set"
for state_id in "${expected_fixture_states[@]}"; do
  require_text "${visual_design}" "FixtureState = ${state_id}"
  require_text "${prototype_dir}/prototype.js" "${state_id}"
done

require_text "${prototype_dir}/index.html" 'data-prototype-kind="DOCUMENTATION_ONLY_NON_PRODUCTION_FIXTURE"'
require_text "${prototype_dir}/index.html" 'data-default-reading-persistent-side-panels="0"'
require_text "${prototype_dir}/index.html" 'data-source-evidence="ON_DEMAND"'
require_text "${prototype_dir}/index.html" 'data-state-fixture="visual-foundation"'
require_text "${prototype_dir}/prototype.js" 'URLSearchParams'
require_text "${prototype_dir}/prototype.js" 'window.location.search'
for token in --font-reading --space-section --color-ink --focus-ring --document-width --hierarchy-rail-width --source-marker --status-stale --status-error; do
  require_text "${prototype_dir}/styles.css" "${token}"
done
require_text "${prototype_dir}/styles.css" '@media (max-width: 900px)'
require_text "${prototype_dir}/styles.css" ':focus-visible'

combined_prototype="$(printf '%s\n' \
  "$(sed 's/[[:space:]]//g' "${prototype_dir}/index.html")" \
  "$(sed 's/[[:space:]]//g' "${prototype_dir}/prototype.js")" \
  "$(sed 's/[[:space:]]//g' "${prototype_dir}/styles.css")")"
if printf '%s\n' "${combined_prototype}" | grep -Eqi 'fetch\(|XMLHttpRequest|WebSocket|EventSource|sendBeacon'; then
  fail "prototype must not use network APIs"
fi
if printf '%s\n' "${combined_prototype}" | grep -Eqi 'localStorage|sessionStorage|indexedDB|document\.cookie'; then
  fail "prototype must not persist user data"
fi
if printf '%s\n' "${combined_prototype}" | grep -Eqi "https?://|@import|url\\([^)]*//|(src|href)=([\"']?//)|import\\(([\"']?//)"; then
  fail "prototype must not use external network resources"
fi
if printf '%s\n' "${combined_prototype}" | grep -Eqi '(src|href|import[^[:alnum:]])[^\n]*(web/|server/)'; then
  fail "prototype must not import production web/server assets"
fi

require_text "${evidence_dir}/README.md" 'visual-foundation-desktop.png'
require_text "${evidence_dir}/README.md" '1440x1100'
require_text "${evidence_dir}/README.md" 'state=visual-foundation'
evidence_png="${evidence_dir}/visual-foundation-desktop.png"
[[ -f "${evidence_png}" ]] || fail "visual foundation evidence is missing"
png_description="$(file "${evidence_png}" 2>/dev/null || true)"
[[ "${png_description}" == *"PNG image data, 1440 x 1100"* ]] ||
  fail "visual foundation evidence must be a 1440x1100 PNG"

chrome_bin="${CHROME_BIN:-}"
if [[ -z "${chrome_bin}" ]]; then
  for chrome_candidate in \
    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' \
    '/Applications/Chromium.app/Contents/MacOS/Chromium'; do
    if [[ -x "${chrome_candidate}" ]]; then
      chrome_bin="${chrome_candidate}"
      break
    fi
  done
fi
if [[ -z "${chrome_bin}" ]]; then
  chrome_bin="$(command -v google-chrome || command -v chromium || true)"
fi
[[ -n "${chrome_bin}" && -x "${chrome_bin}" ]] ||
  fail "Chrome headless is required for visual evidence freshness validation"

runtime_tmp="$(mktemp -d "${TMPDIR:-/tmp}/cognitura-hv-runtime.XXXXXX")"
cleanup_runtime() {
  rm -f "${runtime_tmp}/visual-foundation-desktop.png"
  rmdir "${runtime_tmp}" 2>/dev/null || true
}
trap cleanup_runtime EXIT

rogue_dom="$("${chrome_bin}" \
  --headless=new --disable-gpu --hide-scrollbars \
  --dump-dom \
  "file://${prototype_dir}/index.html?state=rogue-state" 2>/dev/null)" ||
  fail "Chrome could not evaluate the unknown fixture state"
[[ "${rogue_dom}" == *'data-fixture-status="REJECTED_UNKNOWN_STATE"'* ]] ||
  fail "unknown fixture state must be explicitly rejected"
[[ "${rogue_dom}" == *'data-state-fixture="REJECTED"'* ]] ||
  fail "unknown fixture state must not fall back to a canonical fixture"

captured_png="${runtime_tmp}/visual-foundation-desktop.png"
"${chrome_bin}" \
  --headless=new --disable-gpu --hide-scrollbars \
  --window-size=1440,1100 \
  --screenshot="${captured_png}" \
  "file://${prototype_dir}/index.html?state=visual-foundation" >/dev/null 2>&1 ||
  fail "Chrome could not recapture the visual foundation evidence"
captured_description="$(file "${captured_png}" 2>/dev/null || true)"
[[ "${captured_description}" == *"PNG image data, 1440 x 1100"* ]] ||
  fail "recaptured visual foundation evidence must be a 1440x1100 PNG"
cmp -s "${captured_png}" "${evidence_png}" ||
  fail "visual foundation evidence is stale for the current prototype"

