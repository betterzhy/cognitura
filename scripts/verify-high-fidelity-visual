terminate_headless_chrome() {
  local chrome_pid="$1"
  kill "${chrome_pid}" 2>/dev/null || true
  wait "${chrome_pid}" 2>/dev/null || true
}

run_headless_dump_dom() {
  local chrome_profile="$1"
  local output_file="$2"
  local fixture_url="$3"
  local chrome_pid attempt artifact_ready
  shift 3

  "${chrome_bin}" \
    --headless=new --disable-gpu --hide-scrollbars \
    --user-data-dir="${chrome_profile}" --no-first-run --no-default-browser-check \
    --use-mock-keychain "$@" --dump-dom "${fixture_url}" >"${output_file}" 2>/dev/null &
  chrome_pid=$!
  artifact_ready=NO
  attempt=0
  while [[ "${attempt}" -lt 300 ]]; do
    if grep -Fq '</html>' "${output_file}" 2>/dev/null; then
      artifact_ready=YES
      break
    fi
    kill -0 "${chrome_pid}" 2>/dev/null || break
    sleep 0.1
    attempt=$((attempt + 1))
  done
  terminate_headless_chrome "${chrome_pid}"
  [[ "${artifact_ready}" == "YES" ]]
}

run_headless_screenshot() {
  local chrome_profile="$1"
  local output_file="$2"
  local viewport="$3"
  local fixture_url="$4"
  local chrome_pid attempt artifact_ready

  "${chrome_bin}" \
    --headless=new --disable-gpu --hide-scrollbars \
    --user-data-dir="${chrome_profile}" --no-first-run --no-default-browser-check \
    --use-mock-keychain --window-size="${viewport}" \
    --screenshot="${output_file}" "${fixture_url}" >/dev/null 2>&1 &
  chrome_pid=$!
  artifact_ready=NO
  attempt=0
  while [[ "${attempt}" -lt 300 ]]; do
    if file "${output_file}" 2>/dev/null | grep -Fq 'PNG image data'; then
      artifact_ready=YES
      break
    fi
    kill -0 "${chrome_pid}" 2>/dev/null || break
    sleep 0.1
    attempt=$((attempt + 1))
  done
  terminate_headless_chrome "${chrome_pid}"
  [[ "${artifact_ready}" == "YES" ]]
}

probe_attribute_value() {
  local probe_dom="$1"
  local attribute="$2"
  local matches match_count
  matches="$(printf '%s\n' "${probe_dom}" | { grep -Eo -- "${attribute}=\"[^\"]*\"" || true; })"
  match_count="$(printf '%s\n' "${matches}" | awk 'NF {count++} END {print count+0}')"
  [[ "${match_count}" -eq 1 ]] ||
    fail "module-default browser selector probe must declare ${attribute} exactly once"
  printf '%s\n' "${matches}" | sed -n "s/^${attribute}=\"\([^\"]*\)\"$/\1/p"
}

require_probe_value() {
  local probe_dom="$1"
  local attribute="$2"
  local expected="$3"
  local actual
  actual="$(probe_attribute_value "${probe_dom}" "${attribute}")"
  [[ "${actual}" == "${expected}" ]] ||
    fail "module-default browser selector probe ${attribute} must be ${expected}, got ${actual}"
}

write_module_selector_probe() {
  local output_file="$1"
  local target_url="$2"
  {
    printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><title>Module selector probe</title></head><body>'
    printf '<iframe id="target" src="%s"></iframe>\n' "${target_url}"
    cat <<'EOF'
<script>
(function () {
  "use strict";
  const frame = document.getElementById("target");
  const setProbe = function (name, value) {
    document.documentElement.setAttribute("data-probe-" + name, String(value));
  };
  const evaluateTarget = function () {
    const targetDocument = frame.contentDocument;
    if (!targetDocument || targetDocument.readyState !== "complete" ||
        targetDocument.documentElement.dataset.fixtureStatus !== "ACCEPTED") {
      window.setTimeout(evaluateTarget, 10);
      return;
    }
    const root = "#module-default-document";
    const closureRegions = Array.prototype.slice.call(
      targetDocument.querySelectorAll(root + " .module-closure > div")
    );
    const semanticRegionCount = function (prefix) {
      return closureRegions.filter(function (region) {
        const label = region.querySelector(".eyebrow");
        return label && label.textContent.replace(/\s+/g, " ").trim().indexOf(prefix) === 0;
      }).length;
    };

    setProbe("fixture-status", targetDocument.documentElement.dataset.fixtureStatus || "");
    setProbe("state-fixture", targetDocument.body.dataset.stateFixture || "");
    setProbe("module-default-evidence", targetDocument.body.dataset.moduleDefaultEvidence || "");
    setProbe("zero-interaction-cognitive-closure", targetDocument.body.dataset.zeroInteractionCognitiveClosure || "");
    setProbe("continuous-explanatory-narrative", targetDocument.body.dataset.continuousExplanatoryNarrative || "");
    setProbe("primary-cognitive-spine", targetDocument.body.dataset.primaryCognitiveSpine || "");
    setProbe("visible-perspective-switches", targetDocument.body.dataset.visiblePerspectiveSwitches || "");
    setProbe("knowledge-element-entry", targetDocument.body.dataset.knowledgeElementEntry || "");
    setProbe("source-evidence-entry", targetDocument.body.dataset.sourceEvidenceEntry || "");
    setProbe("declared-primary-projection-count", targetDocument.body.dataset.primaryVisualProjectionCount || "");
    setProbe("declared-relation-count", targetDocument.body.dataset.keyRelationCount || "");
    setProbe("declared-governance-count", targetDocument.body.dataset.persistentGovernanceSidePanelCount || "");
    setProbe("module-document-count", targetDocument.querySelectorAll("#module-default-document").length);
    setProbe("core-question-count", targetDocument.querySelectorAll(root + " .module-opening h1").length);
    setProbe("core-conclusion-count", targetDocument.querySelectorAll(root + " .module-conclusion-lead").length);
    setProbe("closure-count", targetDocument.querySelectorAll(root + " .module-closure").length);
    setProbe("conditions-count", semanticRegionCount("Conditions"));
    setProbe("results-count", semanticRegionCount("Results"));
    setProbe("boundaries-count", semanticRegionCount("Boundaries / Exceptions"));
    setProbe("primary-projection-count", targetDocument.querySelectorAll(root + " .module-primary-projection").length);
    setProbe("relations-container-count", targetDocument.querySelectorAll(root + " .module-relations").length);
    setProbe("relation-count", targetDocument.querySelectorAll(root + " .module-relations li").length);
    setProbe("governance-count", targetDocument.querySelectorAll("#module-default-fixture .persistent-governance-sidebar").length);
    setProbe("knowledge-element-label-count", targetDocument.querySelectorAll(root + " button[aria-label='展开 KnowledgeElement：Read View']").length);
    setProbe("source-evidence-label-count", targetDocument.querySelectorAll(root + " button[aria-label='按需查看 SourceEvidence 支持范围']").length);
    setProbe("status", "READY");
  };
  frame.addEventListener("load", evaluateTarget);
  if (frame.contentDocument && frame.contentDocument.readyState === "complete") {
    window.setTimeout(evaluateTarget, 0);
  }
}());
</script>
</body></html>
EOF
  } >"${output_file}"
}

hvd02_probe_attribute_value() {
  local probe_name="$1"
  local probe_dom="$2"
  local attribute="$3"
  local matches match_count
  matches="$(printf '%s\n' "${probe_dom}" | { grep -Eo -- "${attribute}=\"[^\"]*\"" || true; })"
  match_count="$(printf '%s\n' "${matches}" | awk 'NF {count++} END {print count+0}')"
  [[ "${match_count}" -eq 1 ]] ||
    fail "${probe_name} browser selector probe must declare ${attribute} exactly once"
  printf '%s\n' "${matches}" | sed -n "s/^${attribute}=\"\([^\"]*\)\"$/\1/p"
}

require_hvd02_probe_value() {
  local probe_name="$1"
  local probe_dom="$2"
  local attribute="$3"
  local expected="$4"
  local actual
  actual="$(hvd02_probe_attribute_value "${probe_name}" "${probe_dom}" "${attribute}")"
  [[ "${actual}" == "${expected}" ]] ||
    fail "${probe_name} browser selector probe ${attribute} must be ${expected}, got ${actual}"
}

write_hvd02_selector_probe() {
  local output_file="$1"
  local target_url="$2"
  local fixture_kind="$3"
  {
    printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><title>HV-D02 selector probe</title></head><body>'
    printf '<iframe id="target" src="%s"></iframe>\n' "${target_url}"
    printf '<script>document.documentElement.setAttribute("data-probe-requested-kind", "%s");</script>\n' "${fixture_kind}"
    cat <<'EOF'
<script>
(function () {
  "use strict";
  const frame = document.getElementById("target");
  const setProbe = function (name, value) {
    document.documentElement.setAttribute("data-probe-" + name, String(value));
  };
  const evaluateTarget = function () {
    const targetDocument = frame.contentDocument;
    if (!targetDocument || targetDocument.readyState !== "complete" ||
        targetDocument.documentElement.dataset.fixtureStatus !== "ACCEPTED") {
      window.setTimeout(evaluateTarget, 10);
      return;
    }
    const kind = document.documentElement.getAttribute("data-probe-requested-kind");
    const isRelation = kind === "relation-focus";
    const fixtureSelector = isRelation ? "#relation-focus-fixture" : "#source-verification-fixture";
    const rootSelector = isRelation ? "#relation-focus-document" : "#source-verification-document";
    const fixture = targetDocument.querySelector(fixtureSelector);
    const root = targetDocument.querySelector(rootSelector);
    if (!fixture || !root) {
      setProbe("document-count", 0);
      setProbe("status", "READY");
      return;
    }
    const isRendered = function (element) {
      if (!element || element.closest("[hidden], [aria-hidden='true']")) {
        return false;
      }
      let current = element;
      while (current) {
        const currentStyle = targetDocument.defaultView.getComputedStyle(current);
        if (currentStyle.display === "none" ||
            currentStyle.visibility === "hidden" ||
            currentStyle.visibility === "collapse" ||
            Number(currentStyle.opacity) === 0) {
          return false;
        }
        current = current.parentElement;
      }
      const rect = element.getBoundingClientRect();
      return element.getClientRects().length > 0 &&
        rect.width > 0 &&
        rect.height > 0;
    };
    const renderedCount = function (selector) {
      return Array.prototype.filter.call(targetDocument.querySelectorAll(selector), isRendered).length;
    };
    const isKeyboardInteractable = function (element) {
      return isRendered(element) &&
        element.tagName === "BUTTON" &&
        !element.disabled &&
        element.getAttribute("aria-disabled") !== "true" &&
        element.tabIndex >= 0;
    };
    const renderedInteractableCount = function (selector) {
      return Array.prototype.filter.call(
        targetDocument.querySelectorAll(selector),
        isKeyboardInteractable
      ).length;
    };
    const buttons = Array.prototype.slice.call(fixture.querySelectorAll("button:not([disabled])"));
    const enterControl = fixture.querySelector("[data-enter-action]");
    const quickSourcePanel = isRelation ? fixture.querySelector(".quick-source-panel") : null;
    setProbe("quick-source-initially-hidden", quickSourcePanel ? quickSourcePanel.hidden : "MISSING");
    if (enterControl) {
      enterControl.focus();
      enterControl.dispatchEvent(new KeyboardEvent("keydown", {key: "Enter", bubbles: true}));
      setProbe("quick-source-visible-after-enter", quickSourcePanel ? !quickSourcePanel.hidden : "MISSING");
      setProbe("quick-source-rendered-after-enter", quickSourcePanel ? isRendered(quickSourcePanel) : "MISSING");
      setProbe(
        "quick-source-close-interactable-after-enter",
        isRelation ? renderedInteractableCount(rootSelector + " .quick-source-close") === 1 : "NOT_APPLICABLE"
      );
      enterControl.click();
    }
    if (isRelation) {
      const quickSourceClose = fixture.querySelector(".quick-source-close");
      if (quickSourceClose) {
        quickSourceClose.click();
      }
      setProbe("quick-source-hidden-after-explicit-close", quickSourcePanel ? quickSourcePanel.hidden : "MISSING");
      setProbe("quick-source-explicit-close-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      setProbe("quick-source-explicit-close-transition", targetDocument.body.dataset.lastTransition || "");
      if (enterControl) {
        enterControl.click();
      }
    }
    root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
    if (isRelation) {
      setProbe("quick-source-hidden-after-escape", quickSourcePanel ? quickSourcePanel.hidden : "MISSING");
      setProbe("quick-source-focus-return", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      setProbe("quick-source-close-transition", targetDocument.body.dataset.lastTransition || "");
      root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
    }

    setProbe("fixture-status", targetDocument.documentElement.dataset.fixtureStatus || "");
    setProbe("state-fixture", targetDocument.body.dataset.stateFixture || "");
    setProbe("document-count", targetDocument.querySelectorAll(rootSelector).length);
    setProbe("state-code", root.dataset.stateCode || "");
    setProbe("origin-anchor-declaration", root.dataset.originAnchorId || "");
    setProbe("independent-fact-declaration", root.dataset.independentFactCount || "");
    setProbe("focus-return-status", targetDocument.body.dataset.focusReturnStatus || "");
    setProbe("focus-returned-to", targetDocument.body.dataset.focusReturnedTo || "");
    setProbe("last-transition", targetDocument.body.dataset.lastTransition || "");
    setProbe("keyboard-enter-action", targetDocument.body.dataset.keyboardEnterAction || "");
    setProbe("touch-equivalent-action", targetDocument.body.dataset.touchEquivalentAction || "");
    setProbe("active-element", targetDocument.activeElement ? targetDocument.activeElement.id : "");
    setProbe("button-count", buttons.length);
    setProbe("touch-equivalent-control-count", fixture.querySelectorAll("button[data-touch-equivalent]").length);
    setProbe("rendered-interactable-enter-control-count", renderedInteractableCount(fixtureSelector + " [data-enter-action]"));

    if (isRelation) {
      setProbe("evidence-stage", targetDocument.body.dataset.relationFocusEvidence || "");
      setProbe("declared-primary-focus-count", targetDocument.body.dataset.primaryStableFocusCount || "");
      setProbe("primary-focus-kind", root.dataset.primaryFocusKind || "");
      setProbe("primary-focus-count", root.querySelectorAll(".relation-focus-primary").length);
      setProbe("rendered-document-count", renderedCount(rootSelector));
      setProbe("rendered-primary-focus-count", renderedCount(rootSelector + " .relation-focus-primary"));
      setProbe("origin-anchor-count", fixture.querySelectorAll(".relation-origin-anchor").length);
      setProbe("rendered-origin-anchor-count", renderedCount(fixtureSelector + " .relation-origin-anchor"));
      setProbe("interactable-origin-anchor-count", renderedInteractableCount(fixtureSelector + " .relation-origin-anchor"));
      setProbe("statement-count", root.querySelectorAll(".relation-focus-statement").length);
      setProbe("rendered-statement-count", renderedCount(rootSelector + " .relation-focus-statement"));
      setProbe("endpoint-count", root.querySelectorAll(".relation-endpoint").length);
      setProbe("rendered-endpoint-count", renderedCount(rootSelector + " .relation-endpoint"));
      setProbe("declared-endpoint-count", root.dataset.endpointCount || "");
      setProbe("support-scope-count", root.querySelectorAll(".relation-support-scope").length);
      setProbe("rendered-support-scope-count", renderedCount(rootSelector + " .relation-support-scope"));
      setProbe("quick-source-panel-count", root.querySelectorAll(".quick-source-panel").length);
      setProbe("quick-source-trigger-count", root.querySelectorAll("#relation-quick-source-trigger[data-enter-action='OPEN_QUICK_SOURCE']").length);
      setProbe("rendered-interactable-quick-source-trigger-count", renderedInteractableCount(rootSelector + " #relation-quick-source-trigger[data-enter-action='OPEN_QUICK_SOURCE']"));
      setProbe("quick-source-close-count", root.querySelectorAll(".quick-source-close[data-focus-return-target='relation-quick-source-trigger'][data-touch-equivalent='CLOSE_QUICK_SOURCE']").length);
      setProbe("rendered-interactable-close-control-count", renderedInteractableCount(rootSelector + " .relation-focus-close[data-focus-return-target='relation-origin-anchor']"));
      setProbe("close-control-count", root.querySelectorAll(".relation-focus-close[data-focus-return-target='relation-origin-anchor']").length);
      setProbe("quick-source-persistence", targetDocument.body.dataset.quickSourcePersistence || "");
    } else {
      setProbe("evidence-stage", targetDocument.body.dataset.sourceVerificationEvidence || "");
      setProbe("workspace-history", targetDocument.body.dataset.workspaceHistory || "");
      setProbe("original-reading-anchor", targetDocument.body.dataset.originalReadingAnchor || "");
      setProbe("canonical-target", root.dataset.canonicalTarget || "");
      setProbe("proposition-count", root.querySelectorAll(".verification-proposition").length);
      setProbe("rendered-document-count", renderedCount(rootSelector));
      setProbe("rendered-proposition-count", renderedCount(rootSelector + " .verification-proposition"));
      setProbe("support-matrix-count", root.querySelectorAll(".source-support-matrix").length);
      setProbe("rendered-support-matrix-count", renderedCount(rootSelector + " .source-support-matrix"));
      setProbe("support-row-count", root.querySelectorAll(".support-matrix-grid [role='row']:not(.support-matrix-head)").length);
      setProbe("rendered-support-row-count", renderedCount(rootSelector + " .support-matrix-grid [role='row']:not(.support-matrix-head)"));
      setProbe("support-scope-count", root.querySelectorAll(".source-support-scope").length);
      setProbe("rendered-support-scope-count", renderedCount(rootSelector + " .source-support-scope"));
      setProbe("conflict-count", root.querySelectorAll(".source-conflict").length);
      setProbe("rendered-conflict-count", renderedCount(rootSelector + " .source-conflict"));
      setProbe("gap-count", root.querySelectorAll(".source-gap").length);
      setProbe("rendered-gap-count", renderedCount(rootSelector + " .source-gap"));
      setProbe("return-target-count", fixture.querySelectorAll("#source-origin-anchor.source-return-anchor").length);
      setProbe("rendered-interactable-return-target-count", renderedInteractableCount(fixtureSelector + " #source-origin-anchor.source-return-anchor"));
      setProbe("close-control-count", root.querySelectorAll(".source-verification-close[data-focus-return-target='source-origin-anchor']").length);
      setProbe("rendered-interactable-close-control-count", renderedInteractableCount(rootSelector + " .source-verification-close[data-focus-return-target='source-origin-anchor']"));
    }
    setProbe("status", "READY");
  };
  frame.addEventListener("load", evaluateTarget);
  if (frame.contentDocument && frame.contentDocument.readyState === "complete") {
    window.setTimeout(evaluateTarget, 0);
  }
}());
</script>
</body></html>
EOF
  } >"${output_file}"
}

write_hvd03_selector_probe() {
  local output_file="$1"
  local target_url="$2"
  local fixture_kind="$3"
  {
    printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><title>HV-D03 selector probe</title></head><body>'
    printf '<iframe id="target" src="%s"></iframe>\n' "${target_url}"
    printf '<script>document.documentElement.setAttribute("data-probe-requested-kind", "%s");</script>\n' "${fixture_kind}"
    cat <<'EOF'
<script>
(function () {
  "use strict";
  const frame = document.getElementById("target");
  let evaluationStarted = false;
  const setProbe = function (name, value) {
    document.documentElement.setAttribute("data-probe-" + name, String(value));
  };
  const evaluateTarget = function () {
    const targetDocument = frame.contentDocument;
    if (!targetDocument || targetDocument.readyState !== "complete" ||
        targetDocument.documentElement.dataset.fixtureStatus !== "ACCEPTED") {
      window.setTimeout(evaluateTarget, 10);
      return;
    }
    if (evaluationStarted) {
      return;
    }
    evaluationStarted = true;
    const kind = document.documentElement.getAttribute("data-probe-requested-kind");
    const fixtureSelector = "#" + kind + "-fixture";
    const rootSelector = kind === "revision-impact" ? "#revision-impact-document" :
      kind === "partial-failure" ? "#partial-failure-document" : "#conflicted-draft-document";
    const fixture = targetDocument.querySelector(fixtureSelector);
    const root = targetDocument.querySelector(rootSelector);
    if (!fixture || !root) {
      setProbe("document-count", 0);
      setProbe("status", "READY");
      return;
    }
    const isRendered = function (element) {
      if (!element || element.closest("[hidden], [aria-hidden='true']")) {
        return false;
      }
      let current = element;
      while (current) {
        const style = targetDocument.defaultView.getComputedStyle(current);
        if (style.display === "none" || style.visibility === "hidden" ||
            style.visibility === "collapse" || Number(style.opacity) === 0) {
          return false;
        }
        current = current.parentElement;
      }
      const rect = element.getBoundingClientRect();
      return element.getClientRects().length > 0 && rect.width > 0 && rect.height > 0;
    };
    const renderedCount = function (selector) {
      return Array.prototype.filter.call(targetDocument.querySelectorAll(selector), isRendered).length;
    };
    const isKeyboardInteractable = function (element) {
      return isRendered(element) && element.tagName === "BUTTON" && !element.disabled &&
        element.getAttribute("aria-disabled") !== "true" && !element.closest("[inert]") &&
        element.tabIndex >= 0;
    };
    const interactableCount = function (selector) {
      return Array.prototype.filter.call(targetDocument.querySelectorAll(selector), isKeyboardInteractable).length;
    };
    setProbe("fixture-status", targetDocument.documentElement.dataset.fixtureStatus || "");
    setProbe("state-fixture", targetDocument.body.dataset.stateFixture || "");
    setProbe("document-count", targetDocument.querySelectorAll(rootSelector).length);
    setProbe("rendered-document-count", renderedCount(rootSelector));
    setProbe("state-code", root.dataset.stateCode || "");
    setProbe("processing-state", root.dataset.processingState || "");
    setProbe("draft-state", root.dataset.draftState || "");
    setProbe("origin-anchor-declaration", root.dataset.originAnchorId || "");
    setProbe("origin-anchor-count", fixture.querySelectorAll(".workspace-return-anchor").length);
    setProbe("interactable-origin-anchor-count", interactableCount(fixtureSelector + " .workspace-return-anchor"));

    if (kind === "revision-impact") {
      setProbe("evidence-stage", targetDocument.body.dataset.revisionImpactEvidence || "");
      setProbe("before-count", root.querySelectorAll(".revision-before").length);
      setProbe("after-count", root.querySelectorAll(".revision-after").length);
      setProbe("rendered-before-count", renderedCount(rootSelector + " .revision-before"));
      setProbe("rendered-after-count", renderedCount(rootSelector + " .revision-after"));
      setProbe("impact-lane-count", root.querySelectorAll(".impact-lane").length);
      setProbe("rendered-impact-lane-count", renderedCount(rootSelector + " .impact-lane"));
      setProbe("semantic-count", root.querySelectorAll(".impact-semantic").length);
      setProbe("structural-count", root.querySelectorAll(".impact-structural").length);
      setProbe("expression-count", root.querySelectorAll(".impact-expression").length);
      setProbe("rendered-semantic-count", renderedCount(rootSelector + " .impact-lane.impact-semantic"));
      setProbe("rendered-structural-count", renderedCount(rootSelector + " .impact-lane.impact-structural"));
      setProbe("rendered-expression-count", renderedCount(rootSelector + " .impact-lane.impact-expression"));
      setProbe("blocker-count", root.querySelectorAll(".impact-lane.blocker[data-severity='BLOCKER'][aria-expanded='true']").length);
      setProbe("rendered-blocker-count", renderedCount(rootSelector + " .impact-lane.blocker[data-severity='BLOCKER'][aria-expanded='true']"));
      setProbe("draft-preserved-count", root.querySelectorAll(".draft-preserved").length);
      setProbe("commit-control-count", root.querySelectorAll("button.commit-control").length);
      setProbe("disabled-commit-count", root.querySelectorAll("button.commit-control:disabled[aria-disabled='true']").length);
      root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
      setProbe("escape-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("escape-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
    }

    if (kind === "partial-failure") {
      setProbe("evidence-stage", targetDocument.body.dataset.recoveryEvidence || "");
      setProbe("canonical-saved-boundary", targetDocument.body.dataset.canonicalSavedBoundary || "");
      setProbe("canonical-version", root.dataset.canonicalVersion || "");
      setProbe("changeset-id", root.dataset.changesetId || "");
      setProbe("idempotency-key", root.dataset.idempotencyKey || "");
      setProbe("saved-boundary-count", root.querySelectorAll(".saved-boundary").length);
      setProbe("rendered-saved-boundary-count", renderedCount(rootSelector + " .saved-boundary"));
      setProbe("processing-state-count", root.querySelectorAll(".processing-state").length);
      setProbe("rendered-processing-state-count", renderedCount(rootSelector + " .processing-state"));
      setProbe("complete-count", root.querySelectorAll(".processing-state.complete").length);
      setProbe("failed-count", root.querySelectorAll(".processing-state.failed").length);
      setProbe("stale-count", root.querySelectorAll(".processing-state.stale").length);
      setProbe("pending-count", root.querySelectorAll(".processing-state.pending").length);
      setProbe("stale-projection-count", root.querySelectorAll(".stale-projection .stale-badge").length);
      setProbe("rendered-stale-projection-count", renderedCount(rootSelector + " .stale-projection .stale-badge"));
      setProbe("before-after-count", root.querySelectorAll(".mini-diff span").length);
      setProbe("rendered-before-after-count", renderedCount(rootSelector + " .mini-diff span"));
      setProbe("retry-count", interactableCount(rootSelector + " .retry-recompute"));
      setProbe("query-count", interactableCount(rootSelector + " .query-original-result"));
      setProbe("restore-count", interactableCount(rootSelector + " .restore-draft"));
      setProbe("revert-count", interactableCount(rootSelector + " .revert-changeset"));
      root.querySelector(".retry-recompute").click();
      setProbe("retry-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("retry-scope", targetDocument.body.dataset.retryScope || "");
      root.querySelector(".query-original-result").click();
      setProbe("query-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("result-query-key", targetDocument.body.dataset.resultQueryKey || "");
      root.querySelector(".restore-draft").click();
      setProbe("restore-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("restored-draft", targetDocument.body.dataset.restoredDraft || "");
      setProbe("restored-anchor", targetDocument.body.dataset.restoredSemanticAnchor || "");
      setProbe("restore-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      root.querySelector(".revert-changeset").click();
      setProbe("revert-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("revert-disposition", targetDocument.body.dataset.revertDisposition || "");
    }

    if (kind === "conflicted-draft") {
      setProbe("evidence-stage", targetDocument.body.dataset.conflictedDraftEvidence || "");
      setProbe("base-version", root.dataset.baseVersion || "");
      setProbe("latest-version", root.dataset.latestVersion || "");
      setProbe("draft-preserved", root.dataset.draftPreserved || "");
      setProbe("three-way-count", root.querySelectorAll(".three-way-diff > article").length);
      setProbe("rendered-three-way-count", renderedCount(rootSelector + " .three-way-diff > article"));
      setProbe("base-count", root.querySelectorAll(".diff-base").length);
      setProbe("latest-count", root.querySelectorAll(".diff-latest").length);
      setProbe("draft-count", root.querySelectorAll(".diff-draft").length);
      setProbe("conflict-panel-count", root.querySelectorAll("#conflict-detail-panel").length);
      setProbe("rendered-conflict-panel-count", renderedCount(rootSelector + " #conflict-detail-panel"));
      setProbe("guard-count", root.querySelectorAll(".conflict-guard").length);
      setProbe("rendered-guard-count", renderedCount(rootSelector + " .conflict-guard"));
      setProbe("rebase-count", interactableCount(rootSelector + " .rebase-draft"));
      setProbe("disabled-commit-count", root.querySelectorAll("button.conflict-commit:disabled[aria-disabled='true']").length);
      root.querySelector(".rebase-draft").click();
      setProbe("rebase-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("rebase-status", targetDocument.body.dataset.rebaseStatus || "");
      root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
      setProbe("first-escape-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("first-escape-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      setProbe("panel-hidden-after-escape", targetDocument.getElementById("conflict-detail-panel").hidden);
      root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
      setProbe("second-escape-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("second-escape-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
    }
    setProbe("status", "READY");
  };
  frame.addEventListener("load", evaluateTarget);
  if (frame.contentDocument && frame.contentDocument.readyState === "complete") {
    window.setTimeout(evaluateTarget, 0);
  }
}());
</script>
</body></html>
EOF
  } >"${output_file}"
}

write_hvd04_selector_probe() {
  local output_file="$1"
  local target_url="$2"
  local fixture_kind="$3"
  local fixture_width="$4"
  local fixture_height="$5"
  {
    printf '%s\n' '<!doctype html>' '<html><head><meta charset="utf-8"><title>HV-D04 selector probe</title></head><body style="margin:0">'
    printf '<iframe id="target" style="width:%spx;height:%spx;border:0" src="%s"></iframe>\n' \
      "${fixture_width}" "${fixture_height}" "${target_url}"
    printf '<script>document.documentElement.setAttribute("data-probe-requested-kind", "%s");</script>\n' "${fixture_kind}"
    cat <<'EOF'
<script>
(function () {
  "use strict";
  const frame = document.getElementById("target");
  let evaluationStarted = false;
  const setProbe = function (name, value) {
    document.documentElement.setAttribute("data-probe-" + name, String(value));
  };
  const evaluateTarget = function () {
    const targetDocument = frame.contentDocument;
    if (!targetDocument || targetDocument.readyState !== "complete" ||
        targetDocument.documentElement.dataset.fixtureStatus !== "ACCEPTED") {
      window.setTimeout(evaluateTarget, 10);
      return;
    }
    if (evaluationStarted) {
      return;
    }
    evaluationStarted = true;
    const kind = document.documentElement.dataset.probeRequestedKind;
    const rootSelector = kind === "domain-default" ? "#landscape-theme-document" :
      kind === "theme-default" ? "#cross-domain-document" :
      kind === "module-small-screen" ? "#small-screen-document" : "#static-export-document";
    const root = targetDocument.querySelector(rootSelector);
    const isRendered = function (element) {
      if (!element || element.closest("[hidden], [aria-hidden='true']")) {
        return false;
      }
      let current = element;
      while (current) {
        const style = targetDocument.defaultView.getComputedStyle(current);
        if (style.display === "none" || style.visibility === "hidden" ||
            style.visibility === "collapse" || Number(style.opacity) === 0) {
          return false;
        }
        current = current.parentElement;
      }
      const rect = element.getBoundingClientRect();
      return element.getClientRects().length > 0 && rect.width > 0 && rect.height > 0;
    };
    const renderedCount = function (selector) {
      return Array.prototype.filter.call(targetDocument.querySelectorAll(selector), isRendered).length;
    };
    const isInteractable = function (element) {
      if (!isRendered(element) || element.tagName !== "BUTTON" || element.disabled ||
          element.getAttribute("aria-disabled") === "true" || element.closest("[inert]") ||
          element.tabIndex < 0) {
        return false;
      }
      let pointerTarget = element;
      while (pointerTarget) {
        if (targetDocument.defaultView.getComputedStyle(pointerTarget).pointerEvents === "none") {
          return false;
        }
        pointerTarget = pointerTarget.parentElement;
      }
      const rect = element.getBoundingClientRect();
      if (rect.width < 44 || rect.height < 44 || rect.left < 0 || rect.top < 0 ||
          rect.right > targetDocument.defaultView.innerWidth ||
          rect.bottom > targetDocument.defaultView.innerHeight) {
        return false;
      }
      const hitPoints = [
        [rect.left + rect.width / 2, rect.top + rect.height / 2],
        [rect.left + 1, rect.top + 1],
        [rect.right - 1, rect.top + 1],
        [rect.left + 1, rect.bottom - 1],
        [rect.right - 1, rect.bottom - 1]
      ];
      return hitPoints.every(function (point) {
        const hitTarget = targetDocument.elementFromPoint(point[0], point[1]);
        return hitTarget === element || element.contains(hitTarget);
      });
    };
    const interactableCount = function (selector) {
      return Array.prototype.filter.call(targetDocument.querySelectorAll(selector), isInteractable).length;
    };
    const uniqueAttributeValues = function (selector, attribute) {
      return Array.from(new Set(Array.prototype.map.call(
        root.querySelectorAll(selector), function (element) { return element.getAttribute(attribute); }
      ))).sort().join(",");
    };
    const directLayerSignature = function (caseSelector) {
      return Array.prototype.filter.call(
        targetDocument.querySelectorAll(rootSelector + " " + caseSelector + " > .canonical-hierarchy > span"),
        isRendered
      ).map(function (element) {
        const roles = ["landscape-level", "theme-level", "module-level", "element-level"]
          .filter(function (role) { return element.classList.contains(role); });
        return roles.join("+") + "=" + element.innerText.trim().replace(/\s+/g, " ");
      }).join(";");
    };
    const directHierarchyTopology = function (caseSelector) {
      const hierarchy = root.querySelector(caseSelector + " > .canonical-hierarchy");
      if (!hierarchy) {
        return "";
      }
      return Array.prototype.map.call(hierarchy.children, function (element) {
        if (element.tagName === "I") {
          const separatorClasses = Array.from(element.classList).sort();
          return separatorClasses.length === 0
            ? "I.separator"
            : "I.separator+" + separatorClasses.join("+");
        }
        if (element.tagName !== "SPAN") {
          return element.tagName + ".unexpected";
        }
        const roles = ["landscape-level", "theme-level", "module-level", "element-level"]
          .filter(function (role) { return element.classList.contains(role); });
        const allowedClasses = ["canonical-level"].concat(roles);
        const unexpectedClasses = Array.from(element.classList)
          .filter(function (className) { return !allowedClasses.includes(className); })
          .sort();
        const canonicalToken = element.classList.contains("canonical-level")
          ? "canonical-level"
          : "missing-canonical-level";
        const unexpectedToken = unexpectedClasses.length === 0
          ? ""
          : "+unexpected(" + unexpectedClasses.join("+") + ")";
        return "SPAN." + canonicalToken + "." + roles.join("+") + unexpectedToken;
      }).join(",");
    };
    const safeSeparatorCount = function (caseSelector) {
      const hierarchy = root.querySelector(caseSelector + " > .canonical-hierarchy");
      if (!hierarchy) {
        return 0;
      }
      const hierarchyRect = hierarchy.getBoundingClientRect();
      return Array.prototype.filter.call(hierarchy.querySelectorAll(":scope > i"), function (separator) {
        if (!isRendered(separator)) {
          return false;
        }
        const rect = separator.getBoundingClientRect();
        return rect.width <= 24 && rect.height <= 24 &&
          rect.left >= hierarchyRect.left && rect.top >= hierarchyRect.top &&
          rect.right <= hierarchyRect.right && rect.bottom <= hierarchyRect.bottom;
      }).length;
    };
    setProbe("fixture-status", targetDocument.documentElement.dataset.fixtureStatus || "");
    setProbe("state-fixture", targetDocument.body.dataset.stateFixture || "");
    setProbe("document-count", targetDocument.querySelectorAll(rootSelector).length);
    setProbe("rendered-document-count", renderedCount(rootSelector));
    setProbe("state-code", root ? root.dataset.stateCode || "" : "");
    setProbe("forbidden-surface-count", renderedCount(
      rootSelector + " .card-wall, " + rootSelector + " .graph-workspace, " +
      rootSelector + " .second-knowledge-tree, " + rootSelector + " .persistent-governance-panel"
    ));

    if (kind === "domain-default") {
      setProbe("evidence-stage", targetDocument.body.dataset.crossLayerEvidence || "");
      setProbe("hierarchy-count", renderedCount(rootSelector + " > .canonical-hierarchy .canonical-level"));
      setProbe("landscape-level-count", renderedCount(rootSelector + " > .canonical-hierarchy .landscape-level"));
      setProbe("theme-level-count", renderedCount(rootSelector + " > .canonical-hierarchy .theme-level"));
      setProbe("module-level-count", renderedCount(rootSelector + " > .canonical-hierarchy .module-level"));
      setProbe("element-level-count", renderedCount(rootSelector + " > .canonical-hierarchy .element-level"));
      setProbe("landscape-thesis-count", renderedCount(rootSelector + " .landscape-thesis"));
      setProbe("theme-responsibility-count", renderedCount(rootSelector + " .theme-responsibility"));
      setProbe("understanding-route-count", renderedCount(rootSelector + " .understanding-route"));
      setProbe("global-boundary-count", renderedCount(rootSelector + " .global-boundary"));
      setProbe("theme-closure-count", renderedCount(rootSelector + " .theme-closure"));
      setProbe("theme-core-question-count", renderedCount(rootSelector + " .theme-core-question"));
      setProbe("theme-thesis-count", renderedCount(rootSelector + " .theme-thesis"));
      setProbe("theme-spine-count", renderedCount(rootSelector + " .theme-spine"));
      setProbe("module-cooperation-count", renderedCount(rootSelector + " .module-cooperation > p"));
      setProbe("theme-boundary-count", renderedCount(rootSelector + " .theme-boundary"));
      setProbe("theme-entry-count", interactableCount(rootSelector + " .theme-entry"));
      root.querySelector(".theme-entry").click();
      setProbe("theme-entry-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("theme-entry-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
      setProbe("escape-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("escape-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
    }

    if (kind === "theme-default") {
      setProbe("evidence-stage", targetDocument.body.dataset.crossDomainEvidence || "");
      setProbe("case-count", renderedCount(rootSelector + " .cross-domain-case"));
      setProbe("mechanism-case-count", renderedCount(rootSelector + " .mechanism-domain"));
      setProbe("rule-case-count", renderedCount(rootSelector + " .rule-policy-domain"));
      setProbe("independent-domain-raw-count", root.querySelectorAll(
        ".independent-domain-object, .fifth-domain-object, [data-layer='IndependentDomain']"
      ).length);
      setProbe("independent-domain-rendered-count", renderedCount(
        rootSelector + " .independent-domain-object, " + rootSelector + " .fifth-domain-object, " +
        rootSelector + " [data-layer='IndependentDomain']"
      ));
      setProbe("mechanism-raw-layer-count", root.querySelectorAll(
        ".mechanism-domain > .canonical-hierarchy > span"
      ).length);
      setProbe("rule-raw-layer-count", root.querySelectorAll(
        ".rule-policy-domain > .canonical-hierarchy > span"
      ).length);
      setProbe("mechanism-direct-child-count", root.querySelector(
        ".mechanism-domain > .canonical-hierarchy"
      ).children.length);
      setProbe("rule-direct-child-count", root.querySelector(
        ".rule-policy-domain > .canonical-hierarchy"
      ).children.length);
      setProbe("mechanism-direct-child-topology", directHierarchyTopology(".mechanism-domain"));
      setProbe("rule-direct-child-topology", directHierarchyTopology(".rule-policy-domain"));
      setProbe("mechanism-safe-separator-count", safeSeparatorCount(".mechanism-domain"));
      setProbe("rule-safe-separator-count", safeSeparatorCount(".rule-policy-domain"));
      setProbe("mechanism-hierarchy-count", renderedCount(rootSelector + " .mechanism-domain .canonical-level"));
      setProbe("rule-hierarchy-count", renderedCount(rootSelector + " .rule-policy-domain .canonical-level"));
      setProbe("mechanism-landscape-count", renderedCount(rootSelector + " .mechanism-domain .landscape-level"));
      setProbe("mechanism-theme-count", renderedCount(rootSelector + " .mechanism-domain .theme-level"));
      setProbe("mechanism-module-count", renderedCount(rootSelector + " .mechanism-domain .module-level"));
      setProbe("mechanism-element-count", renderedCount(rootSelector + " .mechanism-domain .element-level"));
      setProbe("rule-landscape-count", renderedCount(rootSelector + " .rule-policy-domain .landscape-level"));
      setProbe("rule-theme-count", renderedCount(rootSelector + " .rule-policy-domain .theme-level"));
      setProbe("rule-module-count", renderedCount(rootSelector + " .rule-policy-domain .module-level"));
      setProbe("rule-element-count", renderedCount(rootSelector + " .rule-policy-domain .element-level"));
      setProbe("mechanism-layer-signature", directLayerSignature(".mechanism-domain"));
      setProbe("rule-layer-signature", directLayerSignature(".rule-policy-domain"));
      setProbe("closure-count", renderedCount(rootSelector + " .domain-closure"));
    }

    if (kind === "module-small-screen") {
      const trigger = root.querySelector("#small-element-trigger");
      const overlay = root.querySelector("#small-element-overlay");
      const closeControl = root.querySelector("#small-overlay-close");
      setProbe("evidence-stage", targetDocument.body.dataset.smallScreenEvidence || "");
      setProbe("primary-surface", targetDocument.body.dataset.smallScreenPrimarySurface || "");
      setProbe("root-width", Math.round(root.getBoundingClientRect().width));
      setProbe("hierarchy-count", renderedCount(rootSelector + " .small-hierarchy .canonical-level"));
      setProbe("core-question-count", renderedCount(rootSelector + " .small-core-question"));
      setProbe("core-conclusion-count", renderedCount(rootSelector + " .small-core-conclusion"));
      setProbe("narrative-count", renderedCount(rootSelector + " .small-narrative"));
      setProbe("spine-count", renderedCount(rootSelector + " .small-spine"));
      setProbe("boundary-count", renderedCount(rootSelector + " .small-boundaries"));
      setProbe("hover-only-count", renderedCount(rootSelector + " [data-hover-only]"));
      setProbe("trigger-count", interactableCount(rootSelector + " #small-element-trigger"));
      setProbe("close-control-raw-count", root.querySelectorAll("#small-overlay-close").length);
      setProbe("trigger-touch-height", Math.round(trigger.getBoundingClientRect().height));
      setProbe("horizontal-overflow", root.scrollWidth > root.clientWidth);
      setProbe("overlay-rendered-before", isRendered(overlay));
      trigger.click();
      setProbe("overlay-rendered-after-open", isRendered(overlay));
      setProbe("open-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("open-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      setProbe("close-control-count", interactableCount(rootSelector + " #small-overlay-close"));
      closeControl.click();
      setProbe("overlay-hidden-after-explicit-close", overlay.hidden);
      setProbe("explicit-close-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("explicit-close-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      trigger.click();
      setProbe("overlay-rendered-after-reopen", isRendered(overlay));
      setProbe("reopen-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("reopen-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
      root.dispatchEvent(new KeyboardEvent("keydown", {key: "Escape", bubbles: true}));
      setProbe("overlay-hidden-after-escape", overlay.hidden);
      setProbe("escape-transition", targetDocument.body.dataset.lastTransition || "");
      setProbe("escape-focus", targetDocument.activeElement ? targetDocument.activeElement.id : "");
    }

    if (kind === "static-export") {
      const exportTitle = root.querySelector(".export-header h1");
      const exportTitleRange = targetDocument.createRange();
      exportTitleRange.selectNodeContents(exportTitle);
      const rawIds = ["landscape-data-systems", "theme-concurrency-consistency",
        "module-mvcc-consistent-read", "element-read-view", "element-version-chain",
        "rel-read-view-selects-version", "src-mvcc-mechanism"];
      const visibleText = root.innerText || "";
      setProbe("evidence-stage", targetDocument.body.dataset.staticExportEvidence || "");
      setProbe("machine-identity-source", targetDocument.body.dataset.machineIdentitySource || "");
      setProbe("raw-technical-ids-visible", targetDocument.body.dataset.rawTechnicalIdsVisible || "");
      setProbe("image-canonical-authority", targetDocument.body.dataset.imageCanonicalAuthority || "");
      setProbe("title-line-count", Array.from(exportTitleRange.getClientRects()).filter(function (rect) {
        return rect.width > 0 && rect.height > 0;
      }).length);
      setProbe("hierarchy-count", renderedCount(rootSelector + " .export-hierarchy [data-object-id]"));
      setProbe("core-question-count", renderedCount(rootSelector + " .export-opening"));
      setProbe("mechanism-count", renderedCount(rootSelector + " .export-mechanism"));
      setProbe("narrative-count", renderedCount(rootSelector + " .export-narrative"));
      setProbe("boundary-count", renderedCount(rootSelector + " .export-boundary"));
      setProbe("relation-count", renderedCount(rootSelector + " .export-relation[data-relation-id]"));
      setProbe("source-count", renderedCount(rootSelector + " .export-source[data-source-id]"));
      setProbe("raw-relation-identity-count", root.querySelectorAll("[data-relation-id]").length);
      setProbe("raw-source-identity-count", root.querySelectorAll("[data-source-id]").length);
      setProbe("object-id-set", uniqueAttributeValues("[data-object-id]", "data-object-id"));
      setProbe("relation-id-set", uniqueAttributeValues("[data-relation-id]", "data-relation-id"));
      setProbe("source-id-set", uniqueAttributeValues("[data-source-id]", "data-source-id"));
      setProbe("relation-source-object-id", root.querySelector(".export-relation").dataset.sourceObjectId || "");
      setProbe("relation-target-object-id", root.querySelector(".export-relation").dataset.targetObjectId || "");
      setProbe("raw-id-visible-count", rawIds.filter(function (id) { return visibleText.includes(id); }).length);
    }
    setProbe("status", "READY");
  };
  frame.addEventListener("load", evaluateTarget);
  if (frame.contentDocument && frame.contentDocument.readyState === "complete") {
    window.setTimeout(evaluateTarget, 0);
  }
}());
</script>
</body></html>
EOF
  } >"${output_file}"
}

rogue_dom_file="${runtime_tmp}/rogue-state-dom.html"
run_headless_dump_dom \
  "${rogue_chrome_profile}" \
  "${rogue_dom_file}" \
  "file://${prototype_dir}/index.html?state=rogue-state" ||
  fail "Chrome could not evaluate the unknown fixture state"
rogue_dom="$(<"${rogue_dom_file}")"
[[ "${rogue_dom}" == *'data-fixture-status="REJECTED_UNKNOWN_STATE"'* ]] ||
  fail "unknown fixture state must be explicitly rejected"
[[ "${rogue_dom}" == *'data-state-fixture="REJECTED"'* ]] ||
  fail "unknown fixture state must not fall back to a canonical fixture"

captured_png="${runtime_tmp}/visual-foundation-desktop.png"
run_headless_screenshot \
  "${foundation_chrome_profile}" \
  "${captured_png}" \
  '1440,1100' \
  "file://${prototype_dir}/index.html?state=visual-foundation" ||
  fail "Chrome could not recapture the visual foundation evidence"
captured_description="$(file "${captured_png}" 2>/dev/null || true)"
[[ "${captured_description}" == *"PNG image data, 1440 x 1100"* ]] ||
  fail "recaptured visual foundation evidence must be a 1440x1100 PNG"
cmp -s "${captured_png}" "${evidence_png}" ||
  fail "visual foundation evidence is stale for the current prototype"

if [[ "${active_number}" -ge 2 ]]; then
  require_line_once "${visual_design}" 'HV-D01 ModuleDefaultReading = PASS'
  if [[ "${active_number}" -eq 2 ]]; then
    require_line_once "${visual_design}" 'HV-D02 FocusAndSource = NOT_RUN'
  else
    require_line_once "${visual_design}" 'HV-D02 FocusAndSource = PASS'
  fi
  require_text "${evidence_dir}/README.md" 'module-default-reading-desktop.png'
  require_text "${evidence_dir}/README.md" 'state=module-default'

  module_probe_file="${runtime_tmp}/module-default-selector-probe.html"
  write_module_selector_probe \
    "${module_probe_file}" \
    "file://${prototype_dir}/index.html?state=module-default"
  module_probe_dom_file="${runtime_tmp}/module-default-selector-probe-dom.html"
  run_headless_dump_dom \
    "${module_dom_chrome_profile}" \
    "${module_probe_dom_file}" \
    "file://${module_probe_file}" \
    --allow-file-access-from-files ||
    fail "Chrome could not evaluate the module-default browser selector probe"
  module_probe_dom="$(<"${module_probe_dom_file}")"
  require_probe_value "${module_probe_dom}" 'data-probe-status' 'READY'
  require_probe_value "${module_probe_dom}" 'data-probe-fixture-status' 'ACCEPTED'
  require_probe_value "${module_probe_dom}" 'data-probe-state-fixture' 'module-default'
  require_probe_value "${module_probe_dom}" 'data-probe-module-default-evidence' 'HIGH_FIDELITY_VISUAL_PASS'
  require_probe_value "${module_probe_dom}" 'data-probe-zero-interaction-cognitive-closure' 'COMPLETE'
  require_probe_value "${module_probe_dom}" 'data-probe-continuous-explanatory-narrative' 'REQUIRED'
  require_probe_value "${module_probe_dom}" 'data-probe-primary-cognitive-spine' 'VISIBLE'
  require_probe_value "${module_probe_dom}" 'data-probe-visible-perspective-switches' '0'
  require_probe_value "${module_probe_dom}" 'data-probe-knowledge-element-entry' 'ON_DEMAND'
  require_probe_value "${module_probe_dom}" 'data-probe-source-evidence-entry' 'ON_DEMAND'
  require_probe_value "${module_probe_dom}" 'data-probe-knowledge-element-label-count' '1'
  require_probe_value "${module_probe_dom}" 'data-probe-source-evidence-label-count' '1'

  module_document_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-module-document-count')"
  [[ "${module_document_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real document root"

  core_question_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-core-question-count')"
  [[ "${core_question_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real CoreQuestion"

  core_conclusion_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-core-conclusion-count')"
  [[ "${core_conclusion_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real CoreConclusion"

  module_closure_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-closure-count')"
  [[ "${module_closure_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real .module-closure"
  for closure_contract in \
    'Conditions|data-probe-conditions-count' \
    'Results|data-probe-results-count' \
    'Boundaries / Exceptions|data-probe-boundaries-count'; do
    closure_region="${closure_contract%%|*}"
    closure_attribute="${closure_contract#*|}"
    closure_region_count="$(probe_attribute_value "${module_probe_dom}" "${closure_attribute}")"
    [[ "${closure_region_count}" -eq 1 ]] ||
      fail "module-default must contain exactly one real ${closure_region} region"
  done

  primary_projection_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-primary-projection-count')"
  [[ "${primary_projection_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real primary visual projection"
  declared_primary_projection_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-declared-primary-projection-count')"
  [[ "${primary_projection_count}" == "${declared_primary_projection_count}" ]] ||
    fail "module-default real primary visual projection count ${primary_projection_count} does not match declared count ${declared_primary_projection_count}"

  module_relations_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-relations-container-count')"
  [[ "${module_relations_count}" -eq 1 ]] ||
    fail "module-default must contain exactly one real .module-relations"
  relation_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-relation-count')"
  [[ "${relation_count}" -ge 1 && "${relation_count}" -le 3 ]] ||
    fail "module-default real Relation count must be between 1 and 3"
  declared_relation_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-declared-relation-count')"
  [[ "${relation_count}" == "${declared_relation_count}" ]] ||
    fail "module-default real Relation count ${relation_count} does not match declared count ${declared_relation_count}"

  persistent_governance_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-governance-count')"
  declared_persistent_governance_count="$(probe_attribute_value "${module_probe_dom}" 'data-probe-declared-governance-count')"
  [[ "${persistent_governance_count}" == "${declared_persistent_governance_count}" ]] ||
    fail "module-default real persistent governance side panel count ${persistent_governance_count} does not match declared count ${declared_persistent_governance_count}"
  [[ "${persistent_governance_count}" -eq 0 ]] ||
    fail "module-default real persistent governance side panel count must be 0"

  module_evidence_png="${evidence_dir}/module-default-reading-desktop.png"
