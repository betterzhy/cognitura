#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s [--cards-dir <path>] [--visual-design <path>] [--prototype-dir <path>] [--evidence-dir <path>] [--plan <path>] [--acceptance <path>] [--evidence-plan <path>]\n' "$0" >&2
  exit 2
}

fail() {
  printf 'HighFidelityVisualTaskCardValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cards_dir="${script_root}/docs/task-cards/high-fidelity-visual"
visual_design="${script_root}/docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md"
prototype_dir="${script_root}/docs/design/high-fidelity/prototype"
evidence_dir="${script_root}/docs/design/high-fidelity/evidence"
plan="${script_root}/docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md"
acceptance="${script_root}/docs/engineering/cognitura-high-fidelity-design-acceptance.md"
evidence_plan="${script_root}/docs/engineering/cognitura-high-fidelity-design-plan.md"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --cards-dir)
      [[ "$#" -ge 2 ]] || usage
      cards_dir="$2"
      shift 2
      ;;
    --visual-design)
      [[ "$#" -ge 2 ]] || usage
      visual_design="$2"
      shift 2
      ;;
    --prototype-dir)
      [[ "$#" -ge 2 ]] || usage
      prototype_dir="$2"
      shift 2
      ;;
    --evidence-dir)
      [[ "$#" -ge 2 ]] || usage
      evidence_dir="$2"
      shift 2
      ;;
    --plan)
      [[ "$#" -ge 2 ]] || usage
      plan="$2"
      shift 2
      ;;
    --acceptance)
      [[ "$#" -ge 2 ]] || usage
      acceptance="$2"
      shift 2
      ;;
    --evidence-plan)
      [[ "$#" -ge 2 ]] || usage
      evidence_plan="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

field_value() {
  local file="$1"
  local field="$2"
  local count
  count="$(grep -c "^${field} = " "${file}" || true)"
  [[ "${count}" -eq 1 ]] || fail "$(basename "${file}"): expected one ${field} field, found ${count}"
  sed -n "s/^${field} = //p" "${file}"
}

require_field_value() {
  local file="$1"
  local field="$2"
  local expected="$3"
  local actual
  actual="$(field_value "${file}" "${field}")"
  [[ "${actual}" == "${expected}" ]] ||
    fail "$(basename "${file}"): ${field} must be ${expected}, got ${actual}"
}

require_line() {
  local file="$1"
  local line="$2"
  grep -Fqx "${line}" "${file}" || fail "$(basename "${file}"): missing contract line: ${line}"
}

require_line_once() {
  local file="$1"
  local line="$2"
  [[ "$(grep -Fxc "${line}" "${file}" || true)" -eq 1 ]] ||
    fail "$(basename "${file}"): expected one contract line: ${line}"
}

require_text() {
  local file="$1"
  local text="$2"
  grep -Fq -- "${text}" "${file}" || fail "$(basename "${file}"): missing contract text: ${text}"
}

assert_card_write_set() {
  local card="$1"
  local task_id="$2"
  shift 2
  local expected_sorted actual_sorted
  expected_sorted="$(printf '%s\n' "$@" | LC_ALL=C sort)"
  actual_sorted="$(awk '
    $0 == "## 3. 写集" {inside=1; next}
    $0 == "## 4. 禁止写集" {inside=0}
    inside && $0 ~ /^- `[^`]+`$/ {
      line=$0
      sub(/^- `/,"",line)
      sub(/`$/,"",line)
      print line
    }
  ' "${card}" | LC_ALL=C sort)"
  [[ "${actual_sorted}" == "${expected_sorted}" ]] ||
    fail "${task_id}: write-set paths do not match exact contract"
  if printf '%s\n' "${actual_sorted}" | grep -Eq '(\*|\?|\[)'; then
    fail "${task_id}: write-set glob paths are forbidden"
  fi
}

plan_task_body() {
  local task_number="$1"
  awk -v task_number="${task_number}" '
    $0 ~ "^### Task " task_number ":" {inside=1}
    inside && $0 ~ "^### Task " && $0 !~ "^### Task " task_number ":" {exit}
    inside {print}
  ' "${plan}"
}

assert_plan_write_set() {
  local task_number="$1"
  shift
  local body expected_sorted actual_sorted
  body="$(plan_task_body "${task_number}")"
  expected_sorted="$(printf '%s\n' "$@" | LC_ALL=C sort)"
  actual_sorted="$(printf '%s\n' "${body}" | awk '
    /^- (Create|Modify): `[^`]+`$/ {
      line=$0
      sub(/^- (Create|Modify): `/,"",line)
      sub(/`$/,"",line)
      print line
    }
  ' | LC_ALL=C sort)"
  [[ "${actual_sorted}" == "${expected_sorted}" ]] ||
    fail "master plan Task ${task_number} write-set paths do not match exact contract"
  if printf '%s\n' "${actual_sorted}" | grep -Eq '(\*|\?|\[)'; then
    fail "master plan Task ${task_number} write-set glob paths are forbidden"
  fi
}

[[ -d "${cards_dir}" ]] || fail "cards directory does not exist: ${cards_dir}"
[[ -f "${cards_dir}/README.md" ]] || fail "visual task card index is missing"
[[ -f "${visual_design}" ]] || fail "visual design baseline is missing"
[[ -d "${prototype_dir}" ]] || fail "prototype directory is missing"
[[ -d "${evidence_dir}" ]] || fail "evidence directory is missing"
[[ -f "${plan}" ]] || fail "high-fidelity master plan is missing"
[[ -f "${acceptance}" ]] || fail "high-fidelity acceptance is missing"
[[ -f "${evidence_plan}" ]] || fail "high-fidelity evidence plan is missing"

index="${cards_dir}/README.md"
[[ "$(field_value "${index}" CanonicalProjectName)" == "Cognitura" ]] ||
  fail "CanonicalProjectName must be Cognitura"
[[ "$(field_value "${index}" TaskCardSet)" == "HIGH_FIDELITY_VISUAL" ]] ||
  fail "TaskCardSet must be HIGH_FIDELITY_VISUAL"
[[ "$(field_value "${index}" TaskCardIDs)" == "HV-D00,HV-D01,HV-D02,HV-D03,HV-D04,HV-D05" ]] ||
  fail "TaskCardIDs must be HV-D00..HV-D05"
[[ "$(field_value "${index}" TaskCardCount)" == "6" ]] || fail "TaskCardCount must be 6"
[[ "$(field_value "${index}" TaskCardSetStatus)" == "READY_FOR_EXECUTION" ]] ||
  fail "TaskCardSetStatus must be READY_FOR_EXECUTION"
active_task="$(field_value "${index}" ActiveTaskCard)"
case "${active_task}" in
  HV-D01|HV-D02|HV-D03|HV-D04|HV-D05) ;;
  *) fail "ActiveTaskCard must identify the sole READY HV design card" ;;
esac
active_suffix="${active_task#HV-D}"
active_number=$((10#${active_suffix}))
for boundary in \
  "BusinessImplementation=NOT_AUTHORIZED" \
  "FormalDatabaseWrite=NOT_AUTHORIZED" \
  "RemotePush=NOT_AUTHORIZED" \
  "W1-I00Creation=FORBIDDEN" \
  "W1-I00Release=FORBIDDEN"; do
  field="${boundary%%=*}"
  value="${boundary#*=}"
  [[ "$(field_value "${index}" "${field}")" == "${value}" ]] ||
    fail "${field} must be ${value}"
done

declared_ids=(HV-D00 HV-D01 HV-D02 HV-D03 HV-D04 HV-D05)
expected_dependency=(NONE HV-D00 HV-D01 HV-D02 HV-D03 HV-D04)
expected_write_count=(22 17 18 19 21 12)
required_sections=("## 1. 目标" "## 2. 前置条件与输入" "## 3. 写集" "## 4. 禁止写集" "## 5. 执行步骤" "## 6. 验证命令" "## 7. Gate 与完成定义" "## 8. 提交与审查")

shopt -s nullglob
actual_cards=("${cards_dir}"/HV-D*.md)
shopt -u nullglob
[[ "${#actual_cards[@]}" -eq 6 ]] ||
  fail "actual visual task card count ${#actual_cards[@]} does not match 6"

preflight_ready_count=0
for preflight_card in "${actual_cards[@]}"; do
  if [[ "$(sed -n 's/^Status = //p' "${preflight_card}")" == "READY" ]]; then
    preflight_ready_count=$((preflight_ready_count + 1))
  fi
done
[[ "${preflight_ready_count}" -eq 1 ]] || fail "exactly one READY card is required"

ready_count=0
done_count=0
blocked_count=0
card_index=0
for task_id in "${declared_ids[@]}"; do
  shopt -s nullglob
  matches=("${cards_dir}/${task_id}-"*.md)
  shopt -u nullglob
  [[ "${#matches[@]}" -eq 1 ]] || fail "cannot resolve declared TaskCardID: ${task_id}"
  card="${matches[0]}"
  [[ "$(field_value "${card}" TaskCardID)" == "${task_id}" ]] ||
    fail "${task_id}: TaskCardID does not match filename"
  [[ "$(field_value "${card}" CardKind)" == "HIGH_FIDELITY_VISUAL_DESIGN" ]] ||
    fail "${task_id}: CardKind must be HIGH_FIDELITY_VISUAL_DESIGN"
  status="$(field_value "${card}" Status)"
  if [[ "${card_index}" -lt "${active_number}" ]]; then
    expected_card_status="DONE"
    expected_gate="${task_id} PASS"
  elif [[ "${card_index}" -eq "${active_number}" ]]; then
    expected_card_status="READY"
    expected_gate="${task_id} NOT_RUN"
  else
    expected_card_status="BLOCKED_BY_DEPENDENCY"
    expected_gate="${task_id} NOT_RUN"
  fi
  [[ "${status}" == "${expected_card_status}" ]] ||
    fail "${task_id}: Status must be ${expected_card_status} for active stage ${active_task}"
  [[ "$(field_value "${card}" Gate)" == "${expected_gate}" ]] ||
    fail "${task_id}: Gate must be ${expected_gate} for active stage ${active_task}"
  [[ "$(field_value "${card}" DependsOn)" == "${expected_dependency[${card_index}]}" ]] ||
    fail "${task_id}: DependsOn must be ${expected_dependency[${card_index}]}"
  [[ "$(field_value "${card}" WriteSetItemCount)" == "${expected_write_count[${card_index}]}" ]] ||
    fail "${task_id}: WriteSetItemCount must be ${expected_write_count[${card_index}]}"
  for section in "${required_sections[@]}"; do
    grep -Fqx "${section}" "${card}" || fail "${task_id}: missing required section: ${section}"
  done
  write_path_count="$(awk '
    $0 == "## 3. 写集" {inside=1; next}
    $0 == "## 4. 禁止写集" {inside=0}
    inside && $0 ~ /^- `[^`]+`$/ {count++}
    END {print count+0}
  ' "${card}")"
  [[ "${write_path_count}" -eq "${expected_write_count[${card_index}]}" ]] ||
    fail "${task_id}: write-set path count ${write_path_count} does not match ${expected_write_count[${card_index}]}"
  case "${task_id}" in
    HV-D00) assert_card_write_set "${card}" "${task_id}" \
      'docs/task-cards/high-fidelity-visual/README.md' \
      'docs/task-cards/high-fidelity-visual/HV-D00-visual-foundation.md' \
      'docs/task-cards/high-fidelity-visual/HV-D01-module-default-reading.md' \
      'docs/task-cards/high-fidelity-visual/HV-D02-focus-and-source.md' \
      'docs/task-cards/high-fidelity-visual/HV-D03-revision-and-recovery.md' \
      'docs/task-cards/high-fidelity-visual/HV-D04-cross-layer-responsive-export.md' \
      'docs/task-cards/high-fidelity-visual/HV-D05-fixed-visual-usability-review.md' \
      'tests/task-cards/verify-high-fidelity-visual-cards.sh' \
      'scripts/verify-high-fidelity-visual' \
      'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
      'docs/design/high-fidelity/prototype/index.html' \
      'docs/design/high-fidelity/prototype/styles.css' \
      'docs/design/high-fidelity/prototype/prototype.js' \
      'docs/design/high-fidelity/evidence/README.md' \
      'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'README.md' 'AGENTS.md' \
      'docs/design/high-fidelity/evidence/visual-foundation-desktop.png' \
      'docs/engineering/cognitura-design-index.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md' \
      'docs/task-cards/README.md' ;;
    HV-D01) assert_card_write_set "${card}" "${task_id}" \
      'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
      'docs/design/high-fidelity/prototype/prototype.js' \
      'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
      'docs/design/high-fidelity/evidence/module-default-reading-desktop.png' \
      'docs/design/high-fidelity/evidence/README.md' \
      'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/task-cards/high-fidelity-visual/HV-D01-module-default-reading.md' \
      'docs/task-cards/high-fidelity-visual/HV-D02-focus-and-source.md' \
      'docs/task-cards/high-fidelity-visual/README.md' \
      'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
      'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' 'docs/task-cards/README.md' ;;
    HV-D02) assert_card_write_set "${card}" "${task_id}" \
      'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
      'docs/design/high-fidelity/prototype/prototype.js' \
      'docs/design/high-fidelity/evidence/module-relation-focus-desktop.png' \
      'docs/design/high-fidelity/evidence/module-source-verification-desktop.png' \
      'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
      'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/task-cards/high-fidelity-visual/HV-D02-focus-and-source.md' \
      'docs/task-cards/high-fidelity-visual/HV-D03-revision-and-recovery.md' \
      'docs/task-cards/high-fidelity-visual/README.md' \
      'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
      'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' 'docs/task-cards/README.md' ;;
    HV-D03) assert_card_write_set "${card}" "${task_id}" \
      'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
      'docs/design/high-fidelity/prototype/prototype.js' \
      'docs/design/high-fidelity/evidence/module-revision-impact-desktop.png' \
      'docs/design/high-fidelity/evidence/module-recovery-desktop.png' \
      'docs/design/high-fidelity/evidence/module-conflicted-draft-desktop.png' \
      'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
      'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/task-cards/high-fidelity-visual/HV-D03-revision-and-recovery.md' \
      'docs/task-cards/high-fidelity-visual/HV-D04-cross-layer-responsive-export.md' \
      'docs/task-cards/high-fidelity-visual/README.md' \
      'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
      'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' 'docs/task-cards/README.md' ;;
    HV-D04) assert_card_write_set "${card}" "${task_id}" \
      'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
      'docs/design/high-fidelity/prototype/prototype.js' \
      'docs/design/high-fidelity/evidence/knowledge-landscape-theme-desktop.png' \
      'docs/design/high-fidelity/evidence/cross-domain-reading-desktop.png' \
      'docs/design/high-fidelity/evidence/module-default-reading-small-screen.png' \
      'docs/design/high-fidelity/evidence/static-export-example.png' \
      'docs/design/high-fidelity/evidence/static-export-manifest.json' \
      'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
      'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/task-cards/high-fidelity-visual/HV-D04-cross-layer-responsive-export.md' \
      'docs/task-cards/high-fidelity-visual/HV-D05-fixed-visual-usability-review.md' \
      'docs/task-cards/high-fidelity-visual/README.md' \
      'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
      'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' 'docs/task-cards/README.md' ;;
    HV-D05) assert_card_write_set "${card}" "${task_id}" \
      'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
      'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/engineering/cognitura-design-index.md' \
      'docs/task-cards/high-fidelity-visual/HV-D05-fixed-visual-usability-review.md' \
      'docs/task-cards/high-fidelity-visual/README.md' \
      'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
      'README.md' 'AGENTS.md' 'docs/task-cards/README.md' ;;
  esac
  case "${status}" in
    READY) ready_count=$((ready_count + 1)) ;;
    DONE) done_count=$((done_count + 1)) ;;
    BLOCKED_BY_DEPENDENCY) blocked_count=$((blocked_count + 1)) ;;
    *) fail "${task_id}: illegal status ${status}" ;;
  esac
  card_index=$((card_index + 1))
done
[[ "${ready_count}" -eq 1 ]] || fail "exactly one READY card is required"
[[ "${done_count}" -eq "${active_number}" ]] ||
  fail "DONE card count must match active stage ${active_task}"
expected_blocked_count=$((5 - active_number))
[[ "${blocked_count}" -eq "${expected_blocked_count}" ]] ||
  fail "dependency-blocked card count must match active stage ${active_task}"

require_text "${plan}" 'WriteSetItemCount = 22'
task6_body="$(awk '
  $0 == "### Task 6: HV-D00 Visual Foundation and Prototype Governance" {inside=1}
  $0 == "### Task 7: HV-D01 Module Default Reading Evidence" {inside=0}
  inside {print}
' "${plan}")"
task6_expected_paths=(
  'docs/task-cards/high-fidelity-visual/README.md'
  'docs/task-cards/high-fidelity-visual/HV-D00-visual-foundation.md'
  'docs/task-cards/high-fidelity-visual/HV-D01-module-default-reading.md'
  'docs/task-cards/high-fidelity-visual/HV-D02-focus-and-source.md'
  'docs/task-cards/high-fidelity-visual/HV-D03-revision-and-recovery.md'
  'docs/task-cards/high-fidelity-visual/HV-D04-cross-layer-responsive-export.md'
  'docs/task-cards/high-fidelity-visual/HV-D05-fixed-visual-usability-review.md'
  'tests/task-cards/verify-high-fidelity-visual-cards.sh'
  'scripts/verify-high-fidelity-visual'
  'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md'
  'docs/design/high-fidelity/prototype/index.html'
  'docs/design/high-fidelity/prototype/styles.css'
  'docs/design/high-fidelity/prototype/prototype.js'
  'docs/design/high-fidelity/evidence/README.md'
  'docs/engineering/cognitura-high-fidelity-design-plan.md'
  'README.md'
  'AGENTS.md'
  'docs/design/high-fidelity/evidence/visual-foundation-desktop.png'
  'docs/engineering/cognitura-design-index.md'
  'docs/engineering/cognitura-high-fidelity-design-acceptance.md'
  'docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md'
  'docs/task-cards/README.md'
)
for path in "${task6_expected_paths[@]}"; do
  [[ "$(printf '%s\n' "${task6_body}" | grep -Fxc -- "- Create: \`${path}\`" || true)" -eq 1 ||
     "$(printf '%s\n' "${task6_body}" | grep -Fxc -- "- Modify: \`${path}\`" || true)" -eq 1 ]] ||
    fail "master plan Task 6 missing exact write-set path: ${path}"
done
task6_path_count="$(printf '%s\n' "${task6_body}" | grep -Ec '^- (Create|Modify): `[^`]+`$' || true)"
[[ "${task6_path_count}" -eq 22 ]] || fail "master plan Task 6 write-set path count must be 22"
assert_plan_write_set 7 \
  'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
  'docs/design/high-fidelity/prototype/prototype.js' \
  'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
  'docs/design/high-fidelity/evidence/module-default-reading-desktop.png' \
  'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
  'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
  'docs/task-cards/high-fidelity-visual/HV-D01-module-default-reading.md' \
  'docs/task-cards/high-fidelity-visual/HV-D02-focus-and-source.md' \
  'docs/task-cards/high-fidelity-visual/README.md' \
  'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
  'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' 'docs/task-cards/README.md'
assert_plan_write_set 8 \
  'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
  'docs/design/high-fidelity/prototype/prototype.js' \
  'docs/design/high-fidelity/evidence/module-relation-focus-desktop.png' \
  'docs/design/high-fidelity/evidence/module-source-verification-desktop.png' \
  'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
  'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
  'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
  'docs/task-cards/high-fidelity-visual/HV-D02-focus-and-source.md' \
  'docs/task-cards/high-fidelity-visual/HV-D03-revision-and-recovery.md' \
  'docs/task-cards/high-fidelity-visual/README.md' \
  'tests/task-cards/verify-high-fidelity-visual-cards.sh' 'scripts/verify-high-fidelity-visual' \
  'docs/engineering/cognitura-design-index.md' 'README.md' 'AGENTS.md' 'docs/task-cards/README.md'
assert_plan_write_set 9 \
  'docs/design/high-fidelity/prototype/index.html' 'docs/design/high-fidelity/prototype/styles.css' \
  'docs/design/high-fidelity/prototype/prototype.js' \
  'docs/design/high-fidelity/evidence/module-revision-impact-desktop.png' \
  'docs/design/high-fidelity/evidence/module-recovery-desktop.png' \
  'docs/design/high-fidelity/evidence/module-conflicted-draft-desktop.png' \
  'docs/design/high-fidelity/cognitura-high-fidelity-visual-design-1.0.md' \
  'docs/design/high-fidelity/evidence/README.md' 'docs/engineering/cognitura-high-fidelity-design-plan.md' \
  'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
  'docs/task-cards/high-fidelity-visual/HV-D03-revision-and-recovery.md' \
  'docs/task-cards/high-fidelity-visual/HV-D04-cross-layer-responsive-export.md' \
