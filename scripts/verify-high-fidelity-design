#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s [--cards-dir <path>] [--plan <path>]\n' "$0" >&2
  exit 2
}

fail() {
  printf 'HighFidelityDesignTaskCardValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

cards_dir=""
plan=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --cards-dir)
      [[ "$#" -ge 2 ]] || usage
      cards_dir="$2"
      shift 2
      ;;
    --plan)
      [[ "$#" -ge 2 ]] || usage
      plan="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ -z "${cards_dir}" ]]; then
  cards_dir="${script_root}/docs/task-cards/high-fidelity-design"
fi
[[ -n "${plan}" ]] || plan="${script_root}/docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md"
[[ -d "${cards_dir}" ]] || fail "cards directory does not exist: ${cards_dir}"
[[ -f "${cards_dir}/README.md" ]] || fail "task card index is missing: README.md"
[[ -f "${plan}" ]] || fail "Task 5 plan does not exist: ${plan}"

task5_step_body() {
  local start_header="$1"
  local end_header="$2"

  awk -v start_header="${start_header}" -v end_header="${end_header}" '
    $0 == start_header {inside_step=1; next}
    $0 == end_header {inside_step=0}
    inside_step {print}
  ' "${plan}"
}

required_verification_commands=(
  'scripts/verify-high-fidelity-design'
  'bash tests/task-cards/verify-high-fidelity-design-cards.sh'
  'scripts/verify-interaction-state-contracts'
  'bash tests/contracts/interaction-state/verify-interaction-state-contracts.sh'
  'scripts/verify-high-fidelity-design-manifest'
  'bash tests/contracts/interaction-state/verify-high-fidelity-design-manifest.sh'
  'scripts/verify-high-fidelity-contract-coverage'
  'bash tests/contracts/interaction-state/verify-high-fidelity-contract-coverage.sh'
  'scripts/verify-specialty-contract-coverage docs/engineering/cognitura-specialty-contract-coverage.md docs/design/cognitura-schema-baseline-2.0.md'
  'bash tests/contracts/specialty-coverage/verify-specialty-contract-coverage.sh'
  'bash tests/contracts/ui/verify-ui-contracts.sh'
  "npm exec --yes --package=node@24.18.0 -- sh -c 'scripts/verify-wave0 --stage schema'"
  'bash tests/ci/verify-markdown-links.sh'
  "npm exec --yes --package=node@24.18.0 -- sh -c 'scripts/verify-wave0'"
  'git diff --check'
)
required_refreeze_sentinel_commands=(
  'git diff --exit-code HEAD^ HEAD -- Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md docs/engineering/cognitura-high-fidelity-design-manifest.yaml docs/engineering/cognitura-high-fidelity-contract-coverage.md'
  'test "$(git diff --name-only HEAD^ HEAD | LC_ALL=C sort | paste -sd " " -)" = "docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md docs/task-cards/high-fidelity-design/HF-D04-fixed-design-review.md scripts/verify-high-fidelity-design tests/task-cards/verify-high-fidelity-design-cards.sh"'
)
for verification_step in 1 5; do
  if [[ "${verification_step}" -eq 1 ]]; then
    start_header='- [ ] **Step 1: Freeze and verify the candidate**'
    end_header='- [ ] **Step 2: Run independent general and final reviews**'
    verification_marker='VerificationFence = TASK5_STEP1_REQUIRED_GATE'
  else
    start_header='- [ ] **Step 5: Verify and commit closure**'
    end_header='### Task 6: HV-D00 Visual Foundation and Prototype Governance'
    verification_marker='VerificationFence = TASK5_STEP5_REQUIRED_GATE'
  fi
  step_body="$(task5_step_body "${start_header}" "${end_header}")"
  marker_count="$(printf '%s\n' "${step_body}" | grep -Fxc "${verification_marker}" || true)"
  global_marker_count="$(grep -Fxc "${verification_marker}" "${plan}" || true)"
  [[ "${marker_count}" -eq 1 && "${global_marker_count}" -eq 1 ]] ||
    fail "Task 5 Step ${verification_step} expected exactly one verification fence marker: ${verification_marker}"
  if ! verification_commands="$(printf '%s\n' "${step_body}" | awk -v marker="${verification_marker}" '
    $0 == marker {marker_seen=1; awaiting_fence=1; next}
    awaiting_fence {
      if ($0 != "```bash") {
        exit 1
      }
      awaiting_fence=0
      inside_fence=1
      next
    }
    inside_fence && $0 == "```" {inside_fence=0; fence_closed=1; exit}
    inside_fence {print}
    END {
      if (!marker_seen || awaiting_fence || !fence_closed) {
        exit 1
      }
    }
  ')"; then
    fail "Task 5 Step ${verification_step} verification fence marker must be immediately followed by one closed bash fence: ${verification_marker}"
  fi
  all_step_bash_commands="$(printf '%s\n' "${step_body}" | awk '
    $0 == "```bash" {inside_fence=1; next}
    inside_fence && $0 == "```" {inside_fence=0; next}
    inside_fence {print}
  ')"
  for required_command in "${required_verification_commands[@]}"; do
    [[ "$(printf '%s\n' "${verification_commands}" | grep -Fxc "${required_command}" || true)" -eq 1 ]] ||
      fail "Task 5 Step ${verification_step} designated verification fence missing command: ${required_command}"
  done
  if [[ "${verification_step}" -eq 1 ]]; then
    for sentinel_command in "${required_refreeze_sentinel_commands[@]}"; do
      [[ "$(printf '%s\n' "${verification_commands}" | grep -Fxc "${sentinel_command}" || true)" -eq 1 ]] ||
        fail "Task 5 Step 1 re-freeze sentinel missing command: ${sentinel_command}"
    done
    expected_verification_commands="$(printf '%s\n' \
      "${required_refreeze_sentinel_commands[@]}" \
      "${required_verification_commands[@]}" \
      'git status --short')"
    step1_verification_commands="${verification_commands}"
  else
    expected_verification_commands="$(printf '%s\n' "${required_verification_commands[@]}")"
  fi
  [[ "${verification_commands}" == "${expected_verification_commands}" ]] ||
    fail "Task 5 Step ${verification_step} designated verification fence must exactly match the ordered command list"
  while IFS= read -r expected_command; do
    [[ "$(printf '%s\n' "${all_step_bash_commands}" | grep -Fxc "${expected_command}" || true)" -eq 1 ]] ||
      fail "Task 5 Step ${verification_step} command must occur exactly once across all Step bash fences: ${expected_command}"
  done <<<"${expected_verification_commands}"
done

for sentinel_command in "${required_refreeze_sentinel_commands[@]}"; do
  [[ "$(printf '%s\n' "${step1_verification_commands}" | grep -Fxc "${sentinel_command}" || true)" -eq 1 ]] ||
    fail "Task 5 Step 1 re-freeze sentinel missing command: ${sentinel_command}"
done

field_value() {
  sed -n "s/^$2 = //p" "$1"
}

index_value() {
  local field="$1"
  local count
  count="$(grep -c "^${field} = " "${cards_dir}/README.md" || true)"
  [[ "${count}" -eq 1 ]] || fail "README.md: expected one ${field} field, found ${count}"
  field_value "${cards_dir}/README.md" "${field}"
}

contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "${item}" == "${needle}" ]] && return 0
  done
  return 1
}

[[ "$(index_value CanonicalProjectName)" == "Cognitura" ]] ||
  fail "CanonicalProjectName must be Cognitura"
[[ "$(index_value TaskCardSet)" == "HIGH_FIDELITY_DESIGN" ]] ||
  fail "TaskCardSet must be HIGH_FIDELITY_DESIGN"
[[ "$(index_value TaskCardIDs)" == "HF-D00,HF-D01,HF-D02,HF-D03,HF-D04" ]] ||
  fail "TaskCardIDs must be HF-D00..HF-D04"
[[ "$(index_value TaskCardCount)" == "5" ]] || fail "TaskCardCount must be 5"
task_card_set_status="$(index_value TaskCardSetStatus)"
case "${task_card_set_status}" in
  READY_FOR_EXECUTION|COMPLETE) ;;
  *) fail "TaskCardSetStatus must be READY_FOR_EXECUTION or COMPLETE" ;;
esac
[[ "$(index_value BusinessImplementation)" == "NOT_AUTHORIZED" ]] ||
  fail "BusinessImplementation must be NOT_AUTHORIZED"
[[ "$(index_value FormalDatabaseWrite)" == "NOT_AUTHORIZED" ]] ||
  fail "FormalDatabaseWrite must be NOT_AUTHORIZED"
[[ "$(index_value RemotePush)" == "NOT_AUTHORIZED" ]] ||
  fail "RemotePush must be NOT_AUTHORIZED"
[[ "$(index_value W1-I00Creation)" == "FORBIDDEN" ]] ||
  fail "W1-I00Creation must be FORBIDDEN"
[[ "$(index_value W1-I00Release)" == "FORBIDDEN" ]] ||
  fail "W1-I00Release must be FORBIDDEN"

declared_ids=(HF-D00 HF-D01 HF-D02 HF-D03 HF-D04)
required_fields=(TaskCardID CardKind Status Gate Risk DependsOn ReviewRoute DesignOwner LocalCommitBoundary WriteSetSource WriteSetItemCount)
required_sections=("## 1. 目标" "## 2. 前置条件与输入" "## 3. 写集" "## 4. 禁止写集" "## 5. 执行步骤" "## 6. 验证命令" "## 7. Gate 与完成定义" "## 8. 提交与审查")

shopt -s nullglob
actual_cards=("${cards_dir}"/HF-D*.md)
implementation_cards=("${cards_dir}"/W1-I*.md "${cards_dir}"/HF-I*.md)
shopt -u nullglob
[[ "${#actual_cards[@]}" -eq 5 ]] ||
  fail "actual design task card count ${#actual_cards[@]} does not match 5"
[[ "${#implementation_cards[@]}" -eq 0 ]] ||
  fail "implementation card is forbidden in HIGH_FIDELITY_DESIGN"

ready_count=0
ready_id=""
seen_ids=()
card_index=0
for expected_id in "${declared_ids[@]}"; do
  shopt -s nullglob
  matches=("${cards_dir}/${expected_id}-"*.md)
  shopt -u nullglob
  [[ "${#matches[@]}" -eq 1 ]] || fail "cannot resolve declared TaskCardID: ${expected_id}"
  file="${matches[0]}"
  filename="$(basename "${file}")"

  for field in "${required_fields[@]}"; do
    count="$(grep -c "^${field} = " "${file}" || true)"
    [[ "${count}" -eq 1 ]] || fail "${filename}: missing required field: ${field}"
  done
  for section in "${required_sections[@]}"; do
    grep -Fqx "${section}" "${file}" || fail "${filename}: missing required section: ${section}"
  done

  task_id="$(field_value "${file}" TaskCardID)"
  status="$(field_value "${file}" Status)"
  gate="$(field_value "${file}" Gate)"
  depends_on="$(field_value "${file}" DependsOn)"
  write_count="$(field_value "${file}" WriteSetItemCount)"

  if [[ "${#seen_ids[@]}" -gt 0 ]] && contains "${task_id}" "${seen_ids[@]}"; then
    fail "duplicate TaskCardID: ${task_id}"
  fi
  seen_ids+=("${task_id}")
  [[ "${task_id}" == "${expected_id}" ]] || fail "${filename}: TaskCardID mismatch"
  [[ "$(field_value "${file}" CardKind)" == "DESIGN" ]] || fail "${filename}: CardKind must be DESIGN"
  [[ "$(field_value "${file}" Risk)" == "HIGH" ]] || fail "${filename}: Risk must be HIGH"
  [[ "$(field_value "${file}" LocalCommitBoundary)" == "REQUIRED" ]] ||
    fail "${filename}: LocalCommitBoundary must be REQUIRED"
  [[ "$(field_value "${file}" WriteSetSource)" == "APPROVED_TASK_PLAN_EXACT" ]] ||
    fail "${filename}: WriteSetSource must be APPROVED_TASK_PLAN_EXACT"

  expected_gate="HF-DG${card_index}"
  [[ "${gate}" == "${expected_gate}"* ]] || fail "Gate mismatch for ${task_id}"
  if [[ "${card_index}" -eq 0 ]]; then
    [[ "${depends_on}" == "NONE" ]] || fail "HF-D00 must have no dependency"
    expected_write_count=20
  else
    previous_index=$((card_index - 1))
    printf -v expected_dependency 'HF-D%02d' "${previous_index}"
    [[ "${depends_on}" == "${expected_dependency}" ]] ||
      fail "dependency mismatch for ${task_id}"
    case "${task_id}" in
      HF-D01) expected_write_count=21 ;;
      HF-D02) expected_write_count=16 ;;
      HF-D03) expected_write_count=17 ;;
      HF-D04) expected_write_count=19 ;;
    esac
  fi
  [[ "${write_count}" == "${expected_write_count}" ]] ||
    fail "${filename}: WriteSetItemCount must be ${expected_write_count}"
  write_set="$(awk '/^## 3[.] 写集$/ {inside=1; next} /^## 4[.] 禁止写集$/ {inside=0} inside {print}' "${file}")"
  for forbidden in 'server/' 'web/' 'raw/' 'schemas/' '.idea/' 'W1-I00' \
    'cognitura-specialty-contract-coverage.md' \
    'scripts/verify-source-manifest' 'scripts/verify-specialty-contract-coverage'; do
    [[ "${write_set}" != *"${forbidden}"* ]] || fail "${filename}: write set contains forbidden path: ${forbidden}"
  done
  if [[ "${task_id}" != "HF-D01" ]]; then
    [[ "${write_set}" != *"cognitura-source-manifest.yaml"* ]] ||
      fail "${filename}: write set contains forbidden path: cognitura-source-manifest.yaml"
  fi
  actual_write_count="$(awk '/^## 3[.] 写集$/ {inside=1; next} /^## 4[.] 禁止写集$/ {inside=0} inside && /^- (Create|Modify): / {count++} END {print count+0}' "${file}")"
  [[ "${actual_write_count}" == "${expected_write_count}" ]] ||
    fail "${filename}: declared write set contains ${actual_write_count} items, expected ${expected_write_count}"

  if [[ "${task_id}" == "HF-D02" ]]; then
    for required_hfd02_path in \
      'AGENTS.md' \
      'README.md' \
      'Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md' \
      'docs/contracts/cognitura-page-contracts.md' \
      'docs/engineering/cognitura-design-index.md' \
      'docs/engineering/cognitura-high-fidelity-design-manifest.yaml' \
      'docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md' \
      'docs/task-cards/high-fidelity-design/HF-D02-interaction-state-model.md' \
      'docs/task-cards/high-fidelity-design/HF-D03-high-fidelity-evidence-contract.md' \
      'docs/task-cards/high-fidelity-design/README.md' \
      'scripts/verify-high-fidelity-design' \
      'scripts/verify-high-fidelity-design-manifest' \
      'scripts/verify-interaction-state-contracts' \
      'tests/contracts/interaction-state/verify-high-fidelity-design-manifest.sh' \
      'tests/contracts/interaction-state/verify-interaction-state-contracts.sh' \
      'tests/task-cards/verify-high-fidelity-design-cards.sh'; do
      grep -Fqx -- "- Modify: \`${required_hfd02_path}\`" "${file}" ||
        fail "${filename}: missing exact HF-D02 write-set path: ${required_hfd02_path}"
    done
  fi
  if [[ "${task_id}" == "HF-D03" ]]; then
    for required_hfd03_path in \
      'AGENTS.md' \
      'README.md' \
      'Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md' \
      'docs/engineering/cognitura-design-index.md' \
      'docs/engineering/cognitura-high-fidelity-design-manifest.yaml' \
      'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md' \
      'docs/task-cards/high-fidelity-design/HF-D03-high-fidelity-evidence-contract.md' \
      'docs/task-cards/high-fidelity-design/HF-D04-fixed-design-review.md' \
      'docs/task-cards/high-fidelity-design/README.md' \
      'scripts/verify-high-fidelity-design' \
      'scripts/verify-high-fidelity-design-manifest' \
      'scripts/verify-interaction-state-contracts' \
      'tests/contracts/interaction-state/verify-high-fidelity-design-manifest.sh' \
      'tests/contracts/interaction-state/verify-interaction-state-contracts.sh' \
      'tests/task-cards/verify-high-fidelity-design-cards.sh'; do
      if ! grep -Fqx -- "- Modify: \`${required_hfd03_path}\`" "${file}" &&
        ! grep -Fqx -- "- Create: \`${required_hfd03_path}\`" "${file}"; then
        fail "${filename}: missing exact HF-D03 write-set path: ${required_hfd03_path}"
      fi
    done
  fi
  if [[ "${task_id}" == "HF-D04" ]]; then
    for required_hfd04_path in \
      'AGENTS.md' \
      'README.md' \
      'Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md' \
      'docs/engineering/cognitura-design-index.md' \
      'docs/engineering/cognitura-high-fidelity-design-manifest.yaml' \
      'docs/engineering/cognitura-high-fidelity-contract-coverage.md' \
      'docs/engineering/cognitura-high-fidelity-design-plan.md' \
      'docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
      'docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md' \
      'docs/task-cards/high-fidelity-design/HF-D04-fixed-design-review.md' \
      'docs/task-cards/high-fidelity-design/README.md' \
      'scripts/verify-high-fidelity-design' \
      'scripts/verify-high-fidelity-design-manifest' \
      'scripts/verify-high-fidelity-contract-coverage' \
      'scripts/verify-interaction-state-contracts' \
      'tests/contracts/interaction-state/verify-high-fidelity-design-manifest.sh' \
      'tests/contracts/interaction-state/verify-high-fidelity-contract-coverage.sh' \
      'tests/contracts/interaction-state/verify-interaction-state-contracts.sh' \
      'tests/task-cards/verify-high-fidelity-design-cards.sh'; do
      grep -Fqx -- "- Modify: \`${required_hfd04_path}\`" "${file}" ||
        fail "${filename}: missing exact HF-D04 write-set path: ${required_hfd04_path}"
    done
  fi

  case "${status}" in
    DONE) ;;
    READY)
      ready_count=$((ready_count + 1))
      ready_id="${task_id}"
      ;;
    BLOCKED_BY_DEPENDENCY) ;;
    *) fail "${filename}: invalid Status: ${status}" ;;
  esac
  card_index=$((card_index + 1))
done

active_card="$(index_value ActiveTaskCard)"
if [[ "${task_card_set_status}" == "COMPLETE" ]]; then
  [[ "${ready_count}" -eq 0 && "${active_card}" == "NONE" ]] ||
    fail "closed HF design set must keep every card DONE with ActiveTaskCard NONE"
  for completed_id in "${declared_ids[@]}"; do
    completed_file=("${cards_dir}/${completed_id}-"*.md)
    [[ "$(field_value "${completed_file[0]}" Status)" == "DONE" ]] ||
      fail "closed HF design set must keep every card DONE"
  done
else
  [[ "${ready_count}" -eq 1 ]] || fail "expected exactly one READY task card, found ${ready_count}"
  [[ "${active_card}" == "${ready_id}" ]] || fail "ActiveTaskCard ${active_card} is not READY"
fi

receipt_value() {
  local receipt_file="$1"
  local receipt_label="$2"
  local receipt_field="$3"
  local receipt_count

  receipt_count="$(grep -c "^${receipt_field} = " "${receipt_file}" || true)"
  [[ "${receipt_count}" -eq 1 ]] ||
    fail "${receipt_label}: missing re-freeze receipt field: ${receipt_field}"
  field_value "${receipt_file}" "${receipt_field}"
}

preparation_review_mode=0
expected_parent_repair_sha=""
if [[ "${active_card}" == "HF-D04" && "${ready_id}" == "HF-D04" ]]; then
  preparation_review_mode=1
fi

if [[ "${preparation_review_mode}" -eq 1 ]]; then
  shopt -s nullglob
  hfd04_receipt_cards=("${cards_dir}/HF-D04-"*.md)
  shopt -u nullglob
  [[ "${#hfd04_receipt_cards[@]}" -eq 1 ]] || fail "cannot resolve HF-D04 receipt card"
  hfd04_receipt_card="${hfd04_receipt_cards[0]}"
  plan_receipt_sha="$(receipt_value "${plan}" "master plan" ReFreezeParentRepairSHA)"
  plan_receipt_reason="$(receipt_value "${plan}" "master plan" ReFreezeReason)"
  plan_reviewed_sha="$(receipt_value "${plan}" "master plan" ReviewedPreparationSHA)"
  card_receipt_sha="$(receipt_value "${hfd04_receipt_card}" "HF-D04 card" ReFreezeParentRepairSHA)"
  card_receipt_reason="$(receipt_value "${hfd04_receipt_card}" "HF-D04 card" ReFreezeReason)"
  card_reviewed_sha="$(receipt_value "${hfd04_receipt_card}" "HF-D04 card" ReviewedPreparationSHA)"
  [[ "${plan_receipt_sha}" == "${card_receipt_sha}" ]] ||
    fail "master plan and HF-D04 card re-freeze receipt SHA must match"
  [[ "${plan_receipt_reason}" == "${card_receipt_reason}" ]] ||
    fail "master plan and HF-D04 card re-freeze receipt reason must match"
  [[ "${plan_reviewed_sha}" == "${card_reviewed_sha}" ]] ||
    fail "master plan and HF-D04 card ReviewedPreparationSHA must match"
  [[ "${plan_receipt_sha}" =~ ^[0-9a-f]{40}$ ]] ||
    fail "re-freeze receipt SHA must be a full lowercase Git SHA"
  [[ "${plan_reviewed_sha}" =~ ^[0-9a-f]{40}$ ]] ||
    fail "ReviewedPreparationSHA must be a full lowercase Git SHA"
  [[ "${plan_receipt_reason}" == "STATUS_COMMAND_GLOBAL_UNIQUENESS_AND_RECEIPT_TEST_SCOPE" ]] ||
    fail "re-freeze receipt reason must be STATUS_COMMAND_GLOBAL_UNIQUENESS_AND_RECEIPT_TEST_SCOPE"
  git -C "${script_root}" cat-file -e "${plan_reviewed_sha}^{commit}" 2>/dev/null ||
    fail "ReviewedPreparationSHA must resolve to an existing Git commit"
  expected_parent_repair_sha="$(git -C "${script_root}" rev-parse "${plan_reviewed_sha}^")"
  [[ "${plan_receipt_sha}" == "${expected_parent_repair_sha}" ]] ||
    fail "re-freeze receipt SHA must equal the parent owner-repair SHA"
  protected_assets=(
    Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md
    docs/engineering/cognitura-high-fidelity-design-manifest.yaml
    docs/engineering/cognitura-high-fidelity-contract-coverage.md
  )
  git -C "${script_root}" diff --quiet "${plan_reviewed_sha}^" "${plan_reviewed_sha}" -- "${protected_assets[@]}" ||
    fail "re-freeze preparation commit must not modify protected specialty assets"
  expected_refreeze_paths='docs/superpowers/plans/2026-08-06-high-fidelity-design-alignment.md docs/task-cards/high-fidelity-design/HF-D04-fixed-design-review.md scripts/verify-high-fidelity-design tests/task-cards/verify-high-fidelity-design-cards.sh'
  actual_refreeze_paths="$(git -C "${script_root}" diff-tree --no-commit-id --name-only -r "${plan_reviewed_sha}" | LC_ALL=C sort | paste -sd ' ' -)"
  [[ "${actual_refreeze_paths}" == "${expected_refreeze_paths}" ]] ||
    fail "re-freeze preparation commit must contain exactly four governance paths"
fi

if [[ "${task_card_set_status}" == "READY_FOR_EXECUTION" ]]; then
  passed_ready=0
  for expected_id in "${declared_ids[@]}"; do
    file=("${cards_dir}/${expected_id}-"*.md)
    status="$(field_value "${file[0]}" Status)"
    if [[ "${expected_id}" == "${ready_id}" ]]; then
      [[ "${status}" == "READY" ]] || fail "active card ${ready_id} is not READY"
      passed_ready=1
    elif [[ "${passed_ready}" -eq 0 ]]; then
      [[ "${status}" == "DONE" ]] || fail "predecessor ${expected_id} must be DONE"
    else
      [[ "${status}" == "BLOCKED_BY_DEPENDENCY" ]] ||
        fail "successor ${expected_id} must be BLOCKED_BY_DEPENDENCY"
    fi
  done
fi

review_output=()
if [[ "${task_card_set_status}" == "COMPLETE" ]]; then
  hfd04_card=("${cards_dir}/HF-D04-"*.md)
  reviewed_sha="$(field_value "${hfd04_card[0]}" ReviewedPreparationSHA)"
  [[ "${reviewed_sha}" == "463fd4829e7c4bb8da071253e8ae9b15cee2a0cf" ]] ||
    fail "HF-D04 ReviewedPreparationSHA mismatch"
  for review_stage in 1 2; do
    [[ "$(field_value "${hfd04_card[0]}" "ReviewStage${review_stage}Model")" == "gpt-5.6-sol/high" ]] ||
      fail "HF-D04 Stage ${review_stage} model must be gpt-5.6-sol/high"
    [[ "$(field_value "${hfd04_card[0]}" "ReviewStage${review_stage}Verdict")" == "GO" ]] ||
      fail "HF-D04 Stage ${review_stage} verdict must be GO"
    for severity in P0 P1 P2; do
      [[ "$(field_value "${hfd04_card[0]}" "ReviewStage${review_stage}${severity}")" == "0" ]] ||
        fail "HF-D04 Stage ${review_stage} findings must be zero"
    done
    review_output+=("HFD04ReviewStage${review_stage} = GO / P0=0 / P1=0 / P2=0")
  done
  [[ "$(field_value "${hfd04_card[0]}" UltraReviewUsed)" == "NO" ]] ||
    fail "HF-D04 must not use ultra review"
  review_output+=("ReviewedPreparationSHA = ${reviewed_sha}")
fi

if [[ "${preparation_review_mode}" -eq 1 ]]; then
  receipt_review_mode_output="ENABLED"
else
  receipt_review_mode_output="DISABLED"
fi

printf '%s\n' \
  "HighFidelityDesignTaskCardValidation = PASS" \
  "TaskCardCount = 5" \
  "TaskCardSetStatus = ${task_card_set_status}" \
  "ActiveTaskCard = ${active_card}" \
  "ReFreezePreparationReviewMode = ${receipt_review_mode_output}"
if [[ "${task_card_set_status}" == "COMPLETE" ]]; then
  printf '%s\n' "${review_output[@]}"
fi
printf '%s\n' \
  "BusinessImplementation = NOT_AUTHORIZED" \
  "W1-I00Release = FORBIDDEN"
