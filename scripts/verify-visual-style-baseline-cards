model_route_schema_current=0
model_route_head_current=0
model_route_marker_current=0
if git -C "${repo_root}" merge-base --is-ancestor \
     "${model_route_design_sha}" HEAD 2>/dev/null &&
   git -C "${repo_root}" merge-base --is-ancestor \
     "${model_route_plan_sha}" HEAD 2>/dev/null; then
  model_route_head_current=1
fi
if grep -Eq \
    '(^ModelGateRouting = |2026-08-13-cognitura-model-gate-routing|1199e76a18db1d168c67c328ce7f195f3cdac7d9|fac5f50c6a3f1afb743f95f40ac6b7f5e4e888e1|deep_reviewer / L[34] / xhigh / ONE)' \
    "${index_file}"; then
  model_route_marker_current=1
fi
if [[ "${model_route_head_current}" -eq 1 || \
      "${model_route_marker_current}" -eq 1 ]]; then
  model_route_schema_current=1
  git -C "${repo_root}" cat-file -e \
    "${model_route_design_sha}^{commit}" 2>/dev/null ||
    fail "fixed model-route design commit is unavailable"
  git -C "${repo_root}" cat-file -e \
    "${model_route_plan_sha}^{commit}" 2>/dev/null ||
    fail "fixed model-route plan commit is unavailable"
  git -C "${repo_root}" cat-file -e \
    "${model_route_design_sha}:docs/superpowers/specs/2026-08-13-cognitura-model-gate-routing-design.md" \
    2>/dev/null || fail "fixed model-route design blob is unavailable"
  git -C "${repo_root}" cat-file -e \
    "${model_route_plan_sha}:docs/superpowers/plans/2026-08-13-cognitura-model-gate-routing.md" \
    2>/dev/null || fail "fixed model-route plan blob is unavailable"
fi

# Recognize the one reviewable pending candidate before ordinary card/state
# diagnostics can mask chain-provenance failures.  A successful preflight does
# not return yet: current README/card/WriteSet contracts below must also pass.
receipt_correction_pending_preflight=0
pending_repository_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
  fail "repository HEAD is unavailable"
if [[ -z "${transition_base}" ]] &&
   git -C "${repo_root}" merge-base --is-ancestor \
    "${receipt_correction_origin_sha}" "${pending_repository_head}" 2>/dev/null; then
  pending_origin_blob="$(git -C "${repo_root}" rev-parse \
    "${receipt_correction_origin_sha}:${ledger_path}" 2>/dev/null)" ||
    fail "fixed receipt-correction origin ledger is missing"
  pending_working_blob="$(git -C "${repo_root}" hash-object "${state_file}")" ||
    fail "working receipt-correction ledger cannot be read"
  if [[ "${pending_working_blob}" == "${pending_origin_blob}" ]]; then
    validate_receipt_correction_pending_head "${pending_repository_head}"
    receipt_correction_pending_preflight=1
  fi
fi

