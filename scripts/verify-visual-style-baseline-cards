  printf '%s\n' \
    ReceiptCorrectionStatus ReceiptCorrectionSpecSHA \
    ReceiptCorrectionOriginReceiptSHA ReceiptCorrectionReviewedCandidateSHA \
    ReceiptCorrectionReviewLevel ReceiptCorrectionReviewRoute \
    ReceiptCorrectionReviewEffort ReceiptCorrectionReviewMultiplicity \
    ReceiptCorrectionReviewVerdict
}

model_gate_routing_fields() {
  printf '%s\n' \
    ReceiptCorrectionReviewLevel ReceiptCorrectionReviewRoute \
    ReceiptCorrectionReviewEffort ReceiptCorrectionReviewMultiplicity \
    ReceiptCorrectionReviewVerdict
}

receipt_correction_write_set() {
  printf '%s\n' \
    AGENTS.md \
    docs/superpowers/plans/2026-08-13-cognitura-model-gate-routing.md \
    docs/superpowers/plans/2026-08-13-cognitura-vsb-receipt-correction.md \
    docs/superpowers/specs/2026-08-13-cognitura-model-gate-routing-design.md \
    docs/superpowers/specs/2026-08-13-cognitura-vsb-receipt-correction-design.md \
    docs/task-cards/visual-style-baseline/README.md \
    docs/task-cards/visual-style-baseline/VSB-02-module-default-reading-visual.md \
    docs/task-cards/visual-style-baseline/VSB-03-fixed-visual-acceptance.md \
    scripts/verify-visual-style-baseline-cards \
    tests/task-cards/verify-visual-style-baseline-cards.sh
}

receipt_correction_path_bit() {
  case "$1" in
    AGENTS.md) printf '1\n' ;;
    docs/superpowers/plans/2026-08-13-cognitura-model-gate-routing.md) printf '2\n' ;;
    docs/superpowers/plans/2026-08-13-cognitura-vsb-receipt-correction.md) printf '4\n' ;;
    docs/superpowers/specs/2026-08-13-cognitura-model-gate-routing-design.md) printf '8\n' ;;
    docs/superpowers/specs/2026-08-13-cognitura-vsb-receipt-correction-design.md) printf '16\n' ;;
    docs/task-cards/visual-style-baseline/README.md) printf '32\n' ;;
    docs/task-cards/visual-style-baseline/VSB-02-module-default-reading-visual.md) printf '64\n' ;;
    docs/task-cards/visual-style-baseline/VSB-03-fixed-visual-acceptance.md) printf '128\n' ;;
    scripts/verify-visual-style-baseline-cards) printf '256\n' ;;
    tests/task-cards/verify-visual-style-baseline-cards.sh) printf '512\n' ;;
    *) return 1 ;;
  esac
}

receipt_correction_expected_mode() {
  case "$1" in
    scripts/verify-visual-style-baseline-cards|tests/task-cards/verify-visual-style-baseline-cards.sh)
      printf '100755\n'
      ;;
    *)
      receipt_correction_path_bit "$1" >/dev/null || return 1
      printf '100644\n'
      ;;
  esac
}

require_fixed_correction_authority_tip() {
  local candidate_sha="$1"
  local authority_sha="$2"
  local authority_path="$3"
  local fixed_mode fixed_blob candidate_mode candidate_blob
  git -C "${repo_root}" merge-base --is-ancestor \
    "${authority_sha}" "${candidate_sha}" 2>/dev/null || return 1
  fixed_mode="$(git -C "${repo_root}" ls-tree \
    "${authority_sha}" -- "${authority_path}" | awk '{print $1}')"
  candidate_mode="$(git -C "${repo_root}" ls-tree \
    "${candidate_sha}" -- "${authority_path}" | awk '{print $1}')"
  [[ "${candidate_mode}" == "${fixed_mode}" ]] ||
    fail "fixed correction authority mode drifted: ${authority_path}"
  fixed_blob="$(git -C "${repo_root}" rev-parse \
    "${authority_sha}:${authority_path}" 2>/dev/null)" ||
    fail "fixed correction authority blob is unavailable: ${authority_path}"
  candidate_blob="$(git -C "${repo_root}" rev-parse \
    "${candidate_sha}:${authority_path}" 2>/dev/null)" ||
    fail "fixed correction authority blob drifted: ${authority_path}"
  [[ "${candidate_blob}" == "${fixed_blob}" ]] ||
    fail "fixed correction authority blob drifted: ${authority_path}"
}

validate_receipt_correction_chain() {
  local candidate_sha="$1"
  local previous_sha chain_sha actual_parent correction_path path_bit
  local changed_path_count child_mode expected_mode content_file
  local raw_status_file raw_error_file changed_path_file changed_error_file
  local net_path_file net_error_file net_path_mask=0
  local actual_paths expected_paths origin_ledger candidate_ledger
  local chain_path_mask=0
  local authority_index authority_sha authority_path fixed_blob current_blob current_mode
  local -a authority_shas authority_paths
  authority_shas=(
    "${receipt_correction_spec_sha}"
    "${receipt_correction_plan_sha}"
    "${model_route_design_sha}"
    "${model_route_plan_sha}"
  )
  authority_paths=(
    docs/superpowers/specs/2026-08-13-cognitura-vsb-receipt-correction-design.md
    docs/superpowers/plans/2026-08-13-cognitura-vsb-receipt-correction.md
    docs/superpowers/specs/2026-08-13-cognitura-model-gate-routing-design.md
    docs/superpowers/plans/2026-08-13-cognitura-model-gate-routing.md
  )
  git -C "${repo_root}" merge-base --is-ancestor \
    "${receipt_correction_origin_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed receipt-correction origin is absent from candidate ancestry"
  [[ "${candidate_sha}" != "${receipt_correction_origin_sha}" ]] ||
    fail "fixed receipt-correction origin is not a pending governance candidate"
  net_path_file="$(mktemp \
    "${verifier_tmp_root}/correction-net-paths.XXXXXX")"
  net_error_file="$(mktemp \
    "${verifier_tmp_root}/correction-net-errors.XXXXXX")"
  if ! git -C "${repo_root}" diff --no-renames --name-only -z \
    "${receipt_correction_origin_sha}..${candidate_sha}" \
    > "${net_path_file}" 2> "${net_error_file}"; then
    fail "receipt correction governance path inspection failed"
  fi
  [[ ! -s "${net_error_file}" ]] ||
    fail "receipt correction governance path inspection was degraded"
  while IFS= read -r -d '' correction_path; do
    [[ "${correction_path}" != *$'\n'* ]] ||
      fail "receipt correction governance path must not contain a newline"
    if ! path_bit="$(receipt_correction_path_bit "${correction_path}")"; then
      fail "receipt correction chain contains a path outside the exact ten-path WriteSet"
    fi
    net_path_mask=$((net_path_mask | path_bit))
  done < "${net_path_file}"
  [[ "${net_path_mask}" -eq 1023 ]] ||
    fail "receipt correction chain must have the exact ten-path cumulative WriteSet"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${receipt_correction_spec_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed receipt-correction specification is absent from candidate ancestry"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${receipt_correction_plan_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed receipt-correction plan is absent from candidate ancestry"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${model_route_design_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed model-route design is absent from candidate ancestry"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${model_route_plan_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed model-route plan is absent from candidate ancestry"
  for authority_index in 0 1 2 3; do
    require_fixed_correction_authority_tip "${candidate_sha}" \
      "${authority_shas[${authority_index}]}" \
      "${authority_paths[${authority_index}]}"
  done

  # Inspect the whole chain for rename/copy evidence first.  This preserves
  # the load-bearing diagnostic even when a copy fixture deletes its target
  # in the immediately preceding commit.
  previous_sha="${receipt_correction_origin_sha}"
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    actual_parent="$(single_parent_of \
      "${chain_sha}" "receipt correction governance commit")"
    [[ "${actual_parent}" == "${previous_sha}" ]] ||
      fail "receipt correction governance commit must have exactly one parent"
    raw_status_file="$(mktemp \
      "${verifier_tmp_root}/correction-raw-status.XXXXXX")"
    raw_error_file="$(mktemp \
      "${verifier_tmp_root}/correction-raw-error.XXXXXX")"
    if ! git -C "${repo_root}" -c diff.renameLimit=0 \
      diff-tree --no-commit-id -r -M -C --find-copies-harder --name-status -z \
      "${previous_sha}" "${chain_sha}" \
      > "${raw_status_file}" 2> "${raw_error_file}"; then
      fail "receipt correction governance rename and copy inspection failed"
    fi
    [[ ! -s "${raw_error_file}" ]] ||
      fail "receipt correction governance rename and copy inspection was degraded"
    if LC_ALL=C tr '\000' '\n' < "${raw_status_file}" | \
       awk '$1 ~ /^[RC][0-9]+$/ { found = 1 } END { exit !found }'; then
      fail "receipt correction governance chain must not rename or copy paths"
    fi
    previous_sha="${chain_sha}"
  done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
    "${receipt_correction_origin_sha}..${candidate_sha}")
  [[ "${previous_sha}" == "${candidate_sha}" ]] ||
    fail "receipt correction candidate must be the governance chain tip"

  previous_sha="${receipt_correction_origin_sha}"
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    changed_path_file="$(mktemp \
      "${verifier_tmp_root}/correction-paths.XXXXXX")"
    changed_error_file="$(mktemp \
      "${verifier_tmp_root}/correction-path-errors.XXXXXX")"
    if ! git -C "${repo_root}" diff --no-renames --name-only -z \
      "${previous_sha}..${chain_sha}" \
      > "${changed_path_file}" 2> "${changed_error_file}"; then
      fail "receipt correction governance path inspection failed"
    fi
    [[ ! -s "${changed_error_file}" ]] ||
      fail "receipt correction governance path inspection was degraded"
    changed_path_count=0
    while IFS= read -r -d '' correction_path; do
      changed_path_count=$((changed_path_count + 1))
      [[ "${correction_path}" != *$'\n'* ]] ||
        fail "receipt correction governance path must not contain a newline"
      [[ "${correction_path}" != "${ledger_path}" ]] ||
        fail "receipt correction governance chain must not change the execution ledger"
      if ! path_bit="$(receipt_correction_path_bit "${correction_path}")"; then
        fail "receipt correction chain contains a path outside the exact ten-path WriteSet"
      fi
      chain_path_mask=$((chain_path_mask | path_bit))
      child_mode="$(git -C "${repo_root}" ls-tree \
        "${chain_sha}" -- "${correction_path}" | awk '{print $1}')"
      expected_mode="$(receipt_correction_expected_mode "${correction_path}")"
      [[ "${child_mode}" == "${expected_mode}" ]] ||
        fail "receipt correction governance commit changed path mode"
      content_file="$(mktemp \
        "${verifier_tmp_root}/correction-content.XXXXXX")"
      git -C "${repo_root}" show \
        "${chain_sha}:${correction_path}" > "${content_file}" 2>/dev/null ||
        fail "receipt correction governance path blob is unavailable"
      require_nul_free_file "${content_file}" \
        "receipt correction governance path must not contain NUL bytes"
    done < "${changed_path_file}"
    [[ "${changed_path_count}" -gt 0 ]] ||
      fail "receipt correction governance commit must be non-empty"
    previous_sha="${chain_sha}"
  done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
    "${receipt_correction_origin_sha}..${candidate_sha}")
  [[ "${chain_path_mask}" -eq 1023 ]] ||
    fail "receipt correction chain must have the exact ten-path cumulative WriteSet"
  actual_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
    "${receipt_correction_origin_sha}..${candidate_sha}" | LC_ALL=C sort)"
  expected_paths="$(receipt_correction_write_set | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "receipt correction chain must have the exact ten-path cumulative WriteSet"

  origin_ledger="$(git -C "${repo_root}" rev-parse \
    "${receipt_correction_origin_sha}:${ledger_path}" 2>/dev/null)" ||
    fail "fixed receipt-correction origin ledger is missing"
  candidate_ledger="$(git -C "${repo_root}" rev-parse \
    "${candidate_sha}:${ledger_path}" 2>/dev/null)" ||
    fail "receipt correction candidate ledger is missing"
  [[ "${candidate_ledger}" == "${origin_ledger}" ]] ||
    fail "receipt correction governance chain must preserve the origin ledger bytes"

  for authority_index in 0 1 2 3; do
    fixed_blob="$(git -C "${repo_root}" rev-parse \
      "${authority_shas[${authority_index}]}:${authority_paths[${authority_index}]}" \
      2>/dev/null)" || fail "fixed correction authority blob is unavailable"
    while IFS= read -r chain_sha; do
      [[ "${chain_sha}" != "${candidate_sha}" ]] || continue
      if git -C "${repo_root}" merge-base --is-ancestor \
          "${authority_shas[${authority_index}]}" "${chain_sha}" 2>/dev/null; then
        current_mode="$(git -C "${repo_root}" ls-tree \
          "${chain_sha}" -- "${authority_paths[${authority_index}]}" | awk '{print $1}')"
        current_blob="$(git -C "${repo_root}" rev-parse \
          "${chain_sha}:${authority_paths[${authority_index}]}" 2>/dev/null || true)"
        [[ "${current_mode}" == 100644 && "${current_blob}" == "${fixed_blob}" ]] ||
          fail "fixed correction authority changed in an intermediate governance commit: ${authority_paths[${authority_index}]}"
      fi
    done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
      "${receipt_correction_origin_sha}..${candidate_sha}")
  done
}

build_expected_receipt_correction_ledger() {
  local origin_file="$1"
  local expected_file="$2"
  local candidate_sha="$3"
  awk -v candidate_sha="${candidate_sha}" \
      -v spec_sha="${receipt_correction_spec_sha}" \
      -v origin_sha="${receipt_correction_origin_sha}" '
    /^ExecutionStateVersion = 2$/ {
      print "ExecutionStateVersion = 3"
      next
    }
    /^GovernanceRepairReviewVerdict = / {
      print
      print "ReceiptCorrectionStatus = PASS"
      print "ReceiptCorrectionSpecSHA = " spec_sha
      print "ReceiptCorrectionOriginReceiptSHA = " origin_sha
      print "ReceiptCorrectionReviewedCandidateSHA = " candidate_sha
      print "ReceiptCorrectionReviewLevel = L4"
      print "ReceiptCorrectionReviewRoute = deep_reviewer"
      print "ReceiptCorrectionReviewEffort = xhigh"
      print "ReceiptCorrectionReviewMultiplicity = ONE"
      print "ReceiptCorrectionReviewVerdict = FINAL_GO_P0_0_P1_0_P2_0"
      next
    }
    /^NextTaskCard = VSB-02$/ {
      print "NextTaskCard = VSB-03"
      next
    }
    /^TransitionSequence = 4$/ {
      print "TransitionSequence = 5"
      next
    }
    /^TransitionKind = ADVANCE$/ {
      print "TransitionKind = RECEIPT_CORRECTION"
      next
    }
    /^TransitionBaseSHA = / {
      print "TransitionBaseSHA = " candidate_sha
      next
    }
    { print }
  ' "${origin_file}" > "${expected_file}" ||
    fail "could not build the approved RECEIPT_CORRECTION ledger"
}

require_receipt_correction_state_values() {
  local file="$1"
  local candidate_sha="$2"
  local field field_count ultra_reason_count
  while IFS= read -r field; do
    field_count="$(grep -c "^${field} = " "${file}" || true)"
    [[ "${field_count}" -ne 0 ]] ||
      fail "missing receipt correction field: ${field}"
    [[ "${field_count}" -eq 1 ]] ||
      fail "duplicate receipt correction field: ${field}"
  done < <(receipt_correction_fields)
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionStatus)" == PASS ]] ||
    fail "ReceiptCorrectionStatus must be PASS"
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionSpecSHA)" == \
     "${receipt_correction_spec_sha}" ]] ||
    fail "receipt correction approved spec SHA mismatch"
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionOriginReceiptSHA)" == \
     "${receipt_correction_origin_sha}" ]] ||
    fail "receipt correction origin SHA mismatch"
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionReviewedCandidateSHA)" == \
     "${candidate_sha}" ]] ||
    fail "receipt correction reviewed candidate SHA mismatch"
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionReviewLevel)" == L4 ]] ||
    fail "receipt correction review level mismatch"
  ultra_reason_count="$(grep -c '^ReceiptCorrectionUltraEscalationReason = ' \
    "${file}" || true)"
  [[ "${ultra_reason_count}" -eq 0 ]] ||
    fail "fixed receipt correction does not authorize Ultra replacement"
  case "$(state_value_from_file "${file}" ReceiptCorrectionReviewRoute)" in
    deep_reviewer) ;;
    deep_reviewer+ultra_gatekeeper)
      fail "receipt correction must not use the historical stacked review route"
      ;;
    ultra_gatekeeper)
      fail "receipt correction must not claim an unexecuted Ultra review"
      ;;
    *) fail "receipt correction review route mismatch" ;;
  esac
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionReviewEffort)" == xhigh ]] ||
    fail "receipt correction review effort mismatch"
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionReviewMultiplicity)" == ONE ]] ||
    fail "receipt correction review multiplicity mismatch"
  [[ "$(state_value_from_file "${file}" ReceiptCorrectionReviewVerdict)" == \
     FINAL_GO_P0_0_P1_0_P2_0 ]] ||
    fail "receipt correction review verdict mismatch"
}

require_receipt_correction_fields_unchanged_between_files() {
  local base_file="$1"
  local head_file="$2"
  local field base_block head_block base_expected head_expected prefix_count
  base_block="$(mktemp \
    "${verifier_tmp_root}/base-correction-block.XXXXXX")"
  head_block="$(mktemp \
    "${verifier_tmp_root}/head-correction-block.XXXXXX")"
  base_expected="$(mktemp \
    "${verifier_tmp_root}/base-correction-expected.XXXXXX")"
  head_expected="$(mktemp \
    "${verifier_tmp_root}/head-correction-expected.XXXXXX")"
  grep '^ReceiptCorrection' "${base_file}" > "${base_block}" || true
  grep '^ReceiptCorrection' "${head_file}" > "${head_block}" || true
  prefix_count="$(wc -l < "${base_block}" | tr -d ' ')"
  [[ "${prefix_count}" -eq 9 ]] ||
    fail "ordinary version-3 transition requires the exact canonical ReceiptCorrection block"
  prefix_count="$(wc -l < "${head_block}" | tr -d ' ')"
  [[ "${prefix_count}" -eq 9 ]] ||
    fail "ordinary version-3 transition requires the exact canonical ReceiptCorrection block"
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${base_file}" || true)" -eq 1 &&
       "$(grep -c "^${field} = " "${head_file}" || true)" -eq 1 ]] ||
      fail "ordinary version-3 transition requires the exact canonical ReceiptCorrection block"
  done < <(receipt_correction_fields)
  {
    while IFS= read -r field; do
      printf '%s = %s\n' "${field}" \
        "$(state_value_from_file "${base_file}" "${field}")"
    done < <(receipt_correction_fields)
  } > "${base_expected}"
  {
    while IFS= read -r field; do
      printf '%s = %s\n' "${field}" \
        "$(state_value_from_file "${head_file}" "${field}")"
    done < <(receipt_correction_fields)
  } > "${head_expected}"
  cmp -s "${base_block}" "${base_expected}" ||
    fail "ordinary version-3 transition requires the exact canonical ReceiptCorrection block"
  cmp -s "${head_block}" "${head_expected}" ||
    fail "ordinary version-3 transition requires the exact canonical ReceiptCorrection block"
  cmp -s "${base_block}" "${head_block}" ||
    fail "ordinary version-3 transition must preserve ReceiptCorrection fields"
  while IFS= read -r field; do
    [[ "$(state_value_from_file "${head_file}" "${field}")" == \
       "$(state_value_from_file "${base_file}" "${field}")" ]] ||
      fail "ordinary version-3 transition must preserve ReceiptCorrection fields"
  done < <(receipt_correction_fields)
}

validate_receipt_correction_transition_files() {
  local pair_base="$1"
  local pair_head="$2"
  local base_file="$3"
  local head_file="$4"
  local field expected_file origin_file base_mode head_mode
  [[ "$(state_value_from_file "${base_file}" ExecutionStateVersion)" == 2 ]] ||
    fail "RECEIPT_CORRECTION is allowed exactly once"
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${base_file}" || true)" -eq 0 ]] ||
      fail "RECEIPT_CORRECTION is allowed exactly once"
  done < <(receipt_correction_fields)
  validate_receipt_correction_chain "${pair_base}"
  require_receipt_correction_state_values "${head_file}" "${pair_base}"
  [[ "$(state_value_from_file "${head_file}" ExecutionStateVersion)" == 3 ]] ||
    fail "RECEIPT_CORRECTION must upgrade ExecutionStateVersion from 2 to 3"
  [[ "$(state_value_from_file "${head_file}" NextTaskCard)" == VSB-03 ]] ||
    fail "receipt correction NextTaskCard must be VSB-03"
  [[ "$(state_value_from_file "${head_file}" TransitionSequence)" == 5 ]] ||
    fail "RECEIPT_CORRECTION TransitionSequence must be 5"
  [[ "$(state_value_from_file "${head_file}" TransitionKind)" == RECEIPT_CORRECTION ]] ||
    fail "receipt transition kind must be RECEIPT_CORRECTION"
  [[ "$(state_value_from_file "${head_file}" TransitionBaseSHA)" == "${pair_base}" ]] ||
    fail "receipt TransitionBaseSHA must equal its fixed BASE"
  origin_file="$(mktemp \
    "${verifier_tmp_root}/correction-origin-ledger.XXXXXX")"
  expected_file="$(mktemp \
    "${verifier_tmp_root}/expected-correction-ledger.XXXXXX")"
  git -C "${repo_root}" show \
    "${receipt_correction_origin_sha}:${ledger_path}" > "${origin_file}" 2>/dev/null ||
    fail "fixed receipt-correction origin ledger is missing"
  cmp -s "${origin_file}" "${base_file}" ||
    fail "RECEIPT_CORRECTION base must be the fixed origin version-2 ledger"
  build_expected_receipt_correction_ledger \
    "${origin_file}" "${expected_file}" "${pair_base}"
  cmp -s "${expected_file}" "${head_file}" ||
    fail "RECEIPT_CORRECTION receipt must be the exact approved ledger transform"
  base_mode="$(git -C "${repo_root}" ls-tree \
    "${pair_base}" -- "${ledger_path}" | awk '{print $1}')"
  head_mode="$(git -C "${repo_root}" ls-tree \
    "${pair_head}" -- "${ledger_path}" | awk '{print $1}')"
  [[ "${base_mode}" == 100644 && "${head_mode}" == 100644 ]] ||
    fail "RECEIPT_CORRECTION receipt ledger mode must remain canonical"
}

validate_receipt_correction_pending_head() {
  local candidate_sha="$1"
  local repository_head origin_file field
  repository_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
    fail "repository HEAD is unavailable"
  [[ "${candidate_sha}" == "${repository_head}" ]] ||
    fail "pending receipt-correction candidate must equal repository HEAD"
  origin_file="$(mktemp \
    "${verifier_tmp_root}/pending-correction-origin.XXXXXX")"
  git -C "${repo_root}" show \
    "${receipt_correction_origin_sha}:${ledger_path}" > "${origin_file}" 2>/dev/null ||
    fail "fixed receipt-correction origin ledger is missing"
  cmp -s "${origin_file}" "${state_file}" ||
    fail "pending receipt-correction ledger must be byte-identical to the fixed origin"
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${state_file}" || true)" -eq 0 ]] ||
      fail "pending receipt-correction ledger must not contain correction fields"
  done < <(receipt_correction_fields)
  validate_receipt_correction_chain "${candidate_sha}"
}

validate_receipt_correction_static_replay() {
  local candidate_sha repository_head correction_receipt correction_count=0
  local chain_sha chain_kind chain_parent receipt_file receipt_block chain_file chain_block
  local prefix_count
  candidate_sha="$(state_value_from_file \
    "${state_file}" ReceiptCorrectionReviewedCandidateSHA)"
  repository_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
    fail "repository HEAD is unavailable"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${candidate_sha}" "${repository_head}" 2>/dev/null ||
    fail "receipt correction reviewed candidate is not an ancestor of HEAD"
  validate_receipt_correction_chain "${candidate_sha}"
  correction_receipt="$(git -C "${repo_root}" rev-list \
    --reverse --first-parent "${candidate_sha}..${repository_head}" | sed -n '1p')"
  [[ -n "${correction_receipt}" ]] || fail "RECEIPT_CORRECTION receipt is missing"
  [[ "$(single_parent_of "${correction_receipt}" \
      "RECEIPT_CORRECTION receipt")" == "${candidate_sha}" ]] ||
    fail "RECEIPT_CORRECTION receipt must be the direct child of G2"
  receipt_file="$(mktemp \
    "${verifier_tmp_root}/static-correction-receipt.XXXXXX")"
  receipt_block="$(mktemp \
    "${verifier_tmp_root}/static-correction-block.XXXXXX")"
  git -C "${repo_root}" show \
    "${correction_receipt}:${ledger_path}" > "${receipt_file}" 2>/dev/null ||
    fail "RECEIPT_CORRECTION receipt ledger is missing"
  grep '^ReceiptCorrection' "${receipt_file}" > "${receipt_block}" || true
  prefix_count="$(wc -l < "${receipt_block}" | tr -d ' ')"
  [[ "${prefix_count}" -eq 9 ]] ||
    fail "RECEIPT_CORRECTION receipt must contain the canonical correction block"
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    chain_parent="$(single_parent_of \
      "${chain_sha}" "post-correction first-parent commit")"
    chain_file="$(mktemp \
      "${verifier_tmp_root}/post-correction-ledger.XXXXXX")"
    chain_block="$(mktemp \
      "${verifier_tmp_root}/post-correction-block.XXXXXX")"
    git -C "${repo_root}" show \
      "${chain_sha}:${ledger_path}" > "${chain_file}" 2>/dev/null ||
      fail "post-R2 ledger is missing"
    grep '^ReceiptCorrection' "${chain_file}" > "${chain_block}" || true
    prefix_count="$(wc -l < "${chain_block}" | tr -d ' ')"
    [[ "${prefix_count}" -eq 9 ]] ||
      fail "post-R2 history must preserve the exact canonical ReceiptCorrection block at every commit"
    cmp -s "${receipt_block}" "${chain_block}" ||
      fail "post-R2 history must preserve the exact canonical ReceiptCorrection block at every commit"
    if commit_is_ledger_only "${chain_parent}" "${chain_sha}"; then
      chain_kind="$(commit_ledger_field "${chain_sha}" TransitionKind || true)"
      [[ "${chain_kind}" == RECEIPT_CORRECTION ]] &&
        correction_count=$((correction_count + 1))
    fi
  done < <(git -C "${repo_root}" rev-list --first-parent \
    "${candidate_sha}..${repository_head}")
  [[ "${correction_count}" -eq 1 ]] ||
    fail "RECEIPT_CORRECTION is allowed exactly once"
  validate_parent_receipt_transition_pair \
    "${candidate_sha}" "${correction_receipt}" 0
  require_receipt_correction_fields_unchanged_between_files \
    "${receipt_file}" "${state_file}"
}

receipt_fields_for_index() {
  case "$1" in
    0) printf '%s\n' VSB00CandidateSHA VSB00GateStatus VSB00ReviewRoute VSB00ReviewVerdict ;;
    1) printf '%s\n' VSB01CandidateSHA VSB01GateStatus VSB01ReviewRoute VSB01ReviewVerdict ;;
    2) printf '%s\n' VSB02CandidateSHA VSB02GateStatus VSB02ReviewRoute VSB02ReviewVerdict ;;
    3) printf '%s\n' VSB03CandidateSHA VSB03GateStatus VSB03ReviewRoute VSB03DeepReviewVerdict VSB03UltraReviewVerdict ;;
    *) fail "unknown receipt index: $1" ;;
  esac
}

require_receipt_unchanged_between_files() {
  local base_file="$1"
  local head_file="$2"
  local index="$3"
  local message="$4"
  local field
  while IFS= read -r field; do
    [[ "$(state_value_from_file "${head_file}" "${field}")" == \
       "$(state_value_from_file "${base_file}" "${field}")" ]] || fail "${message}"
  done < <(receipt_fields_for_index "${index}")
}

require_receipt_empty_in_file() {
  local file="$1"
  local index="$2"
  local message="$3"
  local field expected
  while IFS= read -r field; do
    case "${field}" in
      *CandidateSHA) expected=NONE ;;
      *ReviewRoute)
        if [[ "${index}" -eq 3 ]]; then expected=deep_reviewer+ultra_gatekeeper;
        else expected=deep_reviewer; fi
        ;;
      *) expected=NOT_RUN ;;
    esac
    [[ "$(state_value_from_file "${file}" "${field}")" == "${expected}" ]] ||
      fail "${message}"
  done < <(receipt_fields_for_index "${index}")
}

is_nonzero_finding_verdict() {
  local verdict="$1"
  if [[ "${verdict}" == VISUAL_ACCEPTANCE_FAIL ]]; then
    return 0
  fi
  if [[ "${verdict}" =~ ^FINDING_P0_([0-9]+)_P1_([0-9]+)_P2_([0-9]+)$ ]]; then
    [[ $((10#${BASH_REMATCH[1]} + 10#${BASH_REMATCH[2]} + 10#${BASH_REMATCH[3]})) -gt 0 ]]
    return
  fi
  return 1
}

completed_count_from_file() {
  local file="$1"
  case "$(state_value_from_file "${file}" CompletedTaskCards)" in
    NONE) printf '0\n' ;;
    VSB-00) printf '1\n' ;;
    VSB-00,VSB-01) printf '2\n' ;;
    VSB-00,VSB-01,VSB-02) printf '3\n' ;;
    VSB-00,VSB-01,VSB-02,VSB-03) printf '4\n' ;;
    *) fail "transition CompletedTaskCards must be an exact card prefix" ;;
  esac
}

owner_index_from_id() {
  case "$1" in
    VSB-00) printf '0\n' ;;
    VSB-01) printf '1\n' ;;
    VSB-02) printf '2\n' ;;
    VSB-03) printf '3\n' ;;
    *) fail "transition Owner must be a known VSB card" ;;
  esac
}

validate_fixed_vsb_tree() {
  local commit="$1"
  local fixed_checkout validation_output
  fixed_checkout="$(mktemp -d "${verifier_tmp_root}/transition-base.XXXXXX")"
  if ! git clone --shared -q "${repo_root}" "${fixed_checkout}"; then
    rm -rf -- "${fixed_checkout}"
    fail "could not create isolated transition BASE checkout"
  fi
  if ! git -C "${fixed_checkout}" -c advice.detachedHead=false \
    checkout -q --detach "${commit}"; then
    rm -rf -- "${fixed_checkout}"
    fail "could not check out transition BASE"
  fi
  if ! validation_output="$(
    "${self_verifier}" \
      --repo-root "${fixed_checkout}" \
      --cards-dir "${fixed_checkout}/docs/task-cards/visual-style-baseline" 2>&1
  )"; then
    rm -rf -- "${fixed_checkout}"
    fail "transition BASE failed full VSB state validation: ${validation_output}"
  fi
  rm -rf -- "${fixed_checkout}"
}

require_governance_pass_state() {
  [[ "$(field_value "${state_file}" GovernanceBootstrapStatus)" == PASS &&
     "$(field_value "${state_file}" GovernanceReviewVerdict)" == GO_P0_0_P1_0_P2_0 ]] ||
    fail "terminal VSB state requires governance zero-finding GO"
  is_commit_sha "$(field_value "${state_file}" GovernanceReviewedCandidateSHA)" ||
    fail "terminal VSB state requires a resolvable governance candidate"
}

validate_terminal_receipt_provenance() {
  local repository_head base_sha head_parent terminal_sha terminal_parent ledger_path
  local replay_output restore_output ledger_compare_dir tree_ledger_file
  local receipt_checkout replay_root replay_cards
  repository_head="$(git -C "${repo_root}" rev-parse HEAD)"
  base_sha="$(field_value "${state_file}" TransitionBaseSHA)"
  is_commit_sha "${base_sha}" ||
    fail "terminal VSB state requires a resolvable TransitionBaseSHA"
  head_parent="$(single_parent_of "${repository_head}" "terminal VSB state HEAD")"
  if [[ "${head_parent}" == "${base_sha}" ]]; then
    terminal_sha="${repository_head}"
  else
    terminal_sha="${head_parent}"
  fi
  terminal_parent="$(single_parent_of "${terminal_sha}" "terminal VSB receipt")"
  [[ "${terminal_parent}" == "${base_sha}" ]] ||
    fail "terminal VSB state must be the exact direct-child receipt commit or its exact Wave 1 restore"
  ledger_path="docs/task-cards/visual-style-baseline/execution-state.md"
  ledger_compare_dir="$(mktemp -d "${verifier_tmp_root}/terminal-ledger.XXXXXX")"
  temporary_paths+=("${ledger_compare_dir}")
  tree_ledger_file="${ledger_compare_dir}/receipt-ledger"
  if ! git -C "${repo_root}" show "${terminal_sha}:${ledger_path}" > \
    "${tree_ledger_file}" 2>/dev/null; then
    fail "terminal VSB receipt ledger is missing"
  fi
  require_nul_free_file \
    "${tree_ledger_file}" "terminal VSB ledger must not contain NUL bytes"
  cmp -s "${tree_ledger_file}" "${state_file}" ||
    fail "terminal VSB working ledger must match the exact receipt tree"

  if [[ "$(field_value "${state_file}" TransitionKind)" == COMPLETE ]]; then
    if ! replay_output="$(
      validate_parent_receipt_transition_pair "${base_sha}" "${terminal_sha}" 1 2>&1
    )"; then
      fail "terminal VSB receipt failed exact transition replay"
    fi
  else
    receipt_checkout=""
    replay_root="${repo_root}"
    replay_cards="${cards_dir}"
    if [[ "${terminal_sha}" != "${repository_head}" ]]; then
      receipt_checkout="$(mktemp -d "${verifier_tmp_root}/terminal-receipt.XXXXXX")"
      if ! git clone --shared -q "${repo_root}" "${receipt_checkout}"; then
        rm -rf -- "${receipt_checkout}"
        fail "could not create isolated terminal receipt checkout"
      fi
      if ! git -C "${receipt_checkout}" checkout -q --detach "${terminal_sha}"; then
        rm -rf -- "${receipt_checkout}"
        fail "could not check out the terminal receipt"
      fi
      replay_root="${receipt_checkout}"
      replay_cards="${receipt_checkout}/docs/task-cards/visual-style-baseline"
    fi
    if [[ -z "${transition_base}" ]]; then
      if ! replay_output="$(
        "${self_verifier}" \
          --repo-root "${replay_root}" \
          --cards-dir "${replay_cards}" \
          --transition-base "${base_sha}" \
          --transition-head "${terminal_sha}" 2>&1
      )"; then
        [[ -z "${receipt_checkout}" ]] || rm -rf -- "${receipt_checkout}"
        fail "terminal VSB receipt failed exact transition replay"
      fi
    fi
    [[ -z "${receipt_checkout}" ]] || rm -rf -- "${receipt_checkout}"
  fi

  if [[ "${terminal_sha}" != "${repository_head}" ]]; then
    if ! restore_output="$(
      "${wave1_verifier}" \
        --repo-root "${repo_root}" \
        --cards-dir "${repo_root}/docs/task-cards/wave-1-implementation" \
        --transition-base "${terminal_sha}" \
        --transition-head "${repository_head}" 2>&1
    )"; then
      fail "terminal VSB state must be the exact direct-child receipt commit or its exact Wave 1 restore"
    fi
  fi
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --repo-root)
      [[ "$#" -ge 2 ]] || usage
      repo_root="$2"
      shift 2
      ;;
    --cards-dir)
      [[ "$#" -ge 2 ]] || usage
      cards_dir="$2"
      shift 2
      ;;
    --transition-base)
      [[ "$#" -ge 2 ]] || usage
      transition_base="$2"
      shift 2
      ;;
    --transition-head)
      [[ "$#" -ge 2 ]] || usage
      transition_head="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

[[ -n "${cards_dir}" ]] || usage
[[ -d "${repo_root}" ]] || fail "repo root does not exist: ${repo_root}"
repo_root="$(cd "${repo_root}" && pwd -P)"
[[ -d "${cards_dir}" ]] || fail "cards directory does not exist: ${cards_dir}"
cards_dir="$(cd "${cards_dir}" && pwd -P)"
