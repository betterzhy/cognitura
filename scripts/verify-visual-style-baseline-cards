#!/usr/bin/env bash

set -euo pipefail

script_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
self_verifier="${script_repo_root}/scripts/verify-visual-style-baseline-cards"
wave1_verifier="${script_repo_root}/scripts/verify-wave1-implementation-cards"
repo_root="${script_repo_root}"
cards_dir=""
transition_base=""
transition_head=""
governance_repair_origin_sha="d47c8c7bd7355947b5e8e1de6c264d80c2e27c9a"
governance_repair_spec_sha="2123594540c91341c480f504949315a6abec316c"
governance_repair_vsb00_candidate_sha="737c053483d1f3d084d5f90d5c36f76b0ae8f5a3"
model_route_design_sha="1199e76a18db1d168c67c328ce7f195f3cdac7d9"
model_route_plan_sha="fac5f50c6a3f1afb743f95f40ac6b7f5e4e888e1"
receipt_correction_spec_sha="dc4a105bbe95b1b07fa0e734cec1148eab15279c"
receipt_correction_plan_sha="f4bd848186a4a4d2d771d0d031340483bfa5de9b"
receipt_correction_origin_sha="0ff410961b0f3865652e54ae46453646ed87f69e"
receipt_correction_reviewed_vsb01_sha="108592b757ba50ea6ded7b901bd2b623737a7048"
verifier_recovery_spec_sha="5799d873791694f7e4cb4a2dbe65c8fa27495beb"
verifier_recovery_origin_sha="9904d3deb87e4a3e2820c5a12463929916057c36"
verifier_recovery_failed_candidate_sha="b16f867bfb951bf969ac8c4a8697c8b8913325bd"
governance_repair_status_output=""
receipt_correction_status_output=""
verifier_recovery_status_output=""
verifier_tmp_root="$(
  mktemp -d "${TMPDIR:-/tmp}/cognitura-vsb-verifier.XXXXXX"
)"
temporary_paths=("${verifier_tmp_root}")

cleanup_temporary_paths() {
  local temporary_path
  for temporary_path in "${temporary_paths[@]}"; do
    [[ -z "${temporary_path}" ]] || rm -rf -- "${temporary_path}"
  done
}
trap cleanup_temporary_paths EXIT

usage() {
  printf '%s\n' \
    'Usage: scripts/verify-visual-style-baseline-cards [--repo-root PATH] --cards-dir PATH [--transition-base SHA --transition-head SHA]' >&2
  exit 2
}

fail() {
  printf 'VisualStyleBaselineTaskCardValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

field_value() {
  local file="$1"
  local key="$2"
  sed -n "s/^${key} = //p" "${file}"
}

one_field_value() {
  local file="$1"
  local key="$2"
  local label="$3"
  local count
  count="$(grep -c "^${key} = " "${file}" || true)"
  [[ "${count}" -eq 1 ]] || fail "${label}: ${key} must occur exactly once"
  field_value "${file}" "${key}"
}

require_exact_block_once() {
  local file="$1"
  local expected="$2"
  local failure_message="$3"
  local content suffix
  content="$(cat "${file}"; printf '\034')" || fail "${failure_message}"
  [[ "${content}" == *"${expected}"* ]] || fail "${failure_message}"
  suffix="${content#*"${expected}"}"
  [[ "${suffix}" != *"${expected}"* ]] || fail "${failure_message}"
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    fail "SHA-256 tool is unavailable"
  fi
}

normalized_card_digest() {
  sed -E 's/^Status = .*/Status = __MUTABLE__/' "$1" | sha256_stream
}

is_commit_sha() {
  local sha="$1"
  [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] &&
    git -C "${repo_root}" rev-parse --verify "${sha}^{commit}" >/dev/null 2>&1
}

single_parent_of() {
  local commit="$1"
  local label="$2"
  local parent_line
  parent_line="$(git -C "${repo_root}" rev-list --parents -n 1 "${commit}" 2>/dev/null)" ||
    fail "${label} must resolve to a commit"
  set -- ${parent_line}
  [[ "$#" -eq 2 ]] || fail "${label} must have exactly one parent"
  printf '%s\n' "$2"
}

require_nul_free_file() {
  local input_file="$1"
  local failure_context="$2"
  local nul_free_file
  nul_free_file="$(mktemp "${verifier_tmp_root}/nul-free.XXXXXX")"
  temporary_paths+=("${nul_free_file}")
  if ! LC_ALL=C tr -d '\000' < "${input_file}" > "${nul_free_file}"; then
    fail "${failure_context}"
  fi
  cmp -s "${input_file}" "${nul_free_file}" || fail "${failure_context}"
}

state_value_from_file() {
  local file="$1"
  local key="$2"
  local count
  count="$(grep -c "^${key} = " "${file}" || true)"
  [[ "${count}" -eq 1 ]] || fail "transition ledger: ${key} must occur exactly once"
  sed -n "s/^${key} = //p" "${file}"
}

governance_repair_fields() {
  printf '%s\n' \
    GovernanceRepairStatus GovernanceRepairSpecSHA \
    GovernanceRepairOriginReceiptSHA GovernanceRepairReviewedCandidateSHA \
    GovernanceRepairReviewRoute GovernanceRepairReviewVerdict
}

governance_repair_write_set() {
  printf '%s\n' \
    docs/superpowers/specs/2026-08-13-cognitura-vsb-governance-repair-design.md \
    docs/superpowers/plans/2026-08-13-cognitura-vsb-governance-repair.md \
    docs/task-cards/visual-style-baseline/README.md \
    scripts/verify-visual-style-baseline-cards \
    tests/task-cards/verify-visual-style-baseline-cards.sh
}

path_is_in_governance_repair_write_set() {
  local candidate_path="$1"
  local repair_path
  while IFS= read -r repair_path; do
    [[ "${candidate_path}" == "${repair_path}" ]] && return 0
  done < <(governance_repair_write_set)
  return 1
}

validate_governance_repair_mode_history() {
  local candidate_sha="$1"
  local repair_path origin_mode expected_mode current_mode chain_sha
  while IFS= read -r repair_path; do
    origin_mode="$(git -C "${repo_root}" ls-tree \
      "${governance_repair_origin_sha}" -- "${repair_path}" | awk '{print $1}')"
    expected_mode="${origin_mode}"
    while IFS= read -r chain_sha; do
      [[ -n "${chain_sha}" ]] || continue
      current_mode="$(git -C "${repo_root}" ls-tree \
        "${chain_sha}" -- "${repair_path}" | awk '{print $1}')"
      [[ -n "${current_mode}" ]] || continue
      if [[ -z "${expected_mode}" ]]; then
        expected_mode="${current_mode}"
      else
        [[ "${current_mode}" == "${expected_mode}" ]] ||
          fail "governance repair chain must preserve file mode history"
      fi
    done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
      "${governance_repair_origin_sha}..${candidate_sha}")
    current_mode="$(git -C "${repo_root}" ls-tree \
      "${candidate_sha}" -- "${repair_path}" | awk '{print $1}')"
    [[ -n "${expected_mode}" && "${current_mode}" == "${expected_mode}" ]] ||
      fail "governance repair chain must preserve file mode history"
  done < <(governance_repair_write_set)
}

validate_governance_repair_chain() {
  local candidate_sha="$1"
  local expected_origin="${2:-${governance_repair_origin_sha}}"
  local previous_sha chain_sha actual_parent changed_paths repair_path
  local actual_paths expected_paths origin_ledger candidate_ledger
  local raw_status_file raw_error_file parent_mode child_mode
  local spec_path approved_spec_blob candidate_spec_blob
  [[ "${expected_origin}" == "${governance_repair_origin_sha}" ]] ||
    fail "governance repair origin SHA mismatch"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${governance_repair_origin_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "governance repair origin is not an ancestor of the candidate"
  [[ "${candidate_sha}" != "${governance_repair_origin_sha}" ]] ||
    fail "fixed governance repair origin is not a valid current receipt"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${governance_repair_spec_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "approved governance repair spec commit must be an ancestor of G"
  spec_path=docs/superpowers/specs/2026-08-13-cognitura-vsb-governance-repair-design.md
  approved_spec_blob="$(git -C "${repo_root}" rev-parse \
    "${governance_repair_spec_sha}:${spec_path}" 2>/dev/null)" ||
    fail "approved governance repair spec blob is missing"
  candidate_spec_blob="$(git -C "${repo_root}" rev-parse \
    "${candidate_sha}:${spec_path}" 2>/dev/null)" ||
    fail "governance repair candidate spec blob is missing"
  [[ "${candidate_spec_blob}" == "${approved_spec_blob}" ]] ||
    fail "governance repair spec blob must match the approved spec commit"
  previous_sha="${governance_repair_origin_sha}"
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    actual_parent="$(single_parent_of "${chain_sha}" \
      "governance repair chain commit")"
    [[ "${actual_parent}" == "${previous_sha}" ]] ||
      fail "governance repair chain commit must have exactly one parent"
    changed_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
      "${previous_sha}..${chain_sha}")"
    [[ -n "${changed_paths}" ]] ||
      fail "governance repair chain commit must not be empty"
    raw_status_file="$(mktemp \
      "${verifier_tmp_root}/repair-raw-status.XXXXXX")"
    raw_error_file="$(mktemp \
      "${verifier_tmp_root}/repair-raw-error.XXXXXX")"
    if ! git -C "${repo_root}" -c diff.renameLimit=0 \
      diff-tree --no-commit-id -r -M -C --find-copies-harder --name-status \
      "${previous_sha}" "${chain_sha}" \
      > "${raw_status_file}" 2> "${raw_error_file}"; then
      fail "governance repair chain rename and copy inspection failed"
    fi
    [[ ! -s "${raw_error_file}" ]] ||
      fail "governance repair chain rename and copy inspection was degraded"
    if awk '$1 ~ /^[RC][0-9]+$/ { found = 1 } END { exit !found }' \
      "${raw_status_file}"; then
      fail "governance repair chain must not rename or copy paths"
    fi
    while IFS= read -r repair_path; do
      [[ "${repair_path}" != "${ledger_path}" ]] ||
        fail "governance repair chain must preserve the origin ledger bytes"
      path_is_in_governance_repair_write_set "${repair_path}" ||
        fail "governance repair chain changed an unauthorized path"
      parent_mode="$(git -C "${repo_root}" ls-tree \
        "${previous_sha}" -- "${repair_path}" | awk '{print $1}')"
      child_mode="$(git -C "${repo_root}" ls-tree \
        "${chain_sha}" -- "${repair_path}" | awk '{print $1}')"
      if [[ -n "${parent_mode}" && -n "${child_mode}" ]]; then
        [[ "${parent_mode}" == "${child_mode}" ]] ||
          fail "governance repair chain must preserve file modes"
      fi
      case "${child_mode}" in
        ""|100644|100755) ;;
        *) fail "governance repair chain must preserve file modes" ;;
      esac
    done <<< "${changed_paths}"
    previous_sha="${chain_sha}"
  done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
    "${governance_repair_origin_sha}..${candidate_sha}")
  [[ "${previous_sha}" == "${candidate_sha}" ]] ||
    fail "governance repair candidate must be the chain tip"
  actual_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
    "${governance_repair_origin_sha}..${candidate_sha}" | LC_ALL=C sort)"
  expected_paths="$(governance_repair_write_set | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "governance repair chain must have the exact repair WriteSet"
  validate_governance_repair_mode_history "${candidate_sha}"
  origin_ledger="$(git -C "${repo_root}" rev-parse \
    "${governance_repair_origin_sha}:${ledger_path}" 2>/dev/null)" ||
    fail "governance repair origin ledger is missing"
  candidate_ledger="$(git -C "${repo_root}" rev-parse \
    "${candidate_sha}:${ledger_path}" 2>/dev/null)" ||
    fail "governance repair candidate ledger is missing"
  [[ "${origin_ledger}" == "${candidate_ledger}" ]] ||
    fail "governance repair chain must preserve the origin ledger bytes"
}

build_expected_governance_repair_ledger() {
  local origin_file="$1"
  local expected_file="$2"
  local candidate_sha="$3"
  awk -v candidate_sha="${candidate_sha}" \
      -v spec_sha="${governance_repair_spec_sha}" \
      -v origin_sha="${governance_repair_origin_sha}" '
    /^ExecutionStateVersion = 1$/ {
      print "ExecutionStateVersion = 2"
      next
    }
    /^GovernanceReviewVerdict = / {
      print
      print "GovernanceRepairStatus = PASS"
      print "GovernanceRepairSpecSHA = " spec_sha
      print "GovernanceRepairOriginReceiptSHA = " origin_sha
      print "GovernanceRepairReviewedCandidateSHA = " candidate_sha
      print "GovernanceRepairReviewRoute = deep_reviewer+ultra_gatekeeper"
      print "GovernanceRepairReviewVerdict = FINAL_GO_P0_0_P1_0_P2_0"
      next
    }
    /^TransitionSequence = 2$/ {
      print "TransitionSequence = 3"
      next
    }
    /^TransitionKind = ADVANCE$/ {
      print "TransitionKind = GOVERNANCE_REPAIR"
      next
    }
    /^TransitionBaseSHA = / {
      print "TransitionBaseSHA = " candidate_sha
      next
    }
    { print }
  ' "${origin_file}" > "${expected_file}" ||
    fail "could not build the approved GOVERNANCE_REPAIR ledger"
}

