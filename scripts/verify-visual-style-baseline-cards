commit_ledger_field() {
  local commit_sha="$1"
  local key="$2"
  git -C "${repo_root}" show "${commit_sha}:${ledger_path}" 2>/dev/null | \
    sed -n "s/^${key} = //p"
}

path_is_in_owner_write_set() {
  local owner_index="$1"
  local candidate_path="$2"
  local allowed_path
  while IFS= read -r allowed_path; do
    [[ "${candidate_path}" == "${allowed_path}" ]] && return 0
  done <<< "${expected_write_sets[${owner_index}]}"
  return 1
}

validate_canonical_visual_reference_html() {
  local child_sha="$1"
  local copy_target=web/visual-reference.html
  local html_file expected_html_file
  html_file="$(mktemp "${verifier_tmp_root}/visual-reference-html.XXXXXX")"
  expected_html_file="$(mktemp "${verifier_tmp_root}/expected-visual-reference-html.XXXXXX")"
  git -C "${repo_root}" show "${child_sha}:${copy_target}" > "${html_file}" 2>/dev/null ||
    fail "literal C053 target HTML is unavailable"
  require_nul_free_file "${html_file}" "literal C053 target HTML must not contain NUL bytes"
  printf '%s\n' \
    '<!doctype html>' \
    '<html lang="zh-CN">' \
    '  <head>' \
    '    <meta charset="UTF-8" />' \
    '    <meta name="viewport" content="width=device-width, initial-scale=1.0" />' \
    '    <title>Cognitura Visual Reference</title>' \
    '  </head>' \
    '  <body>' \
    '    <div id="visual-reference-root"></div>' \
    '    <script type="module" src="/src/visual-reference/main.tsx"></script>' \
    '  </body>' \
    '</html>' > "${expected_html_file}"
  cmp -s "${html_file}" "${expected_html_file}" ||
    fail "literal C053 target HTML must match the exact canonical document"
}

validate_literal_visual_reference_copy() {
  local owner_index="$1"
  local parent_sha="$2"
  local child_sha="$3"
  local copy_status="$4"
  local copy_source="$5"
  local copy_target="$6"
  local parent_source child_source parent_target child_target
  local source_mode source_blob child_source_mode child_source_blob
  local target_mode target_blob
  [[ "${copy_status}" == C053 &&
     "${copy_source}" == web/index.html &&
     "${copy_target}" == web/visual-reference.html &&
     "${owner_index}" -eq 2 ]] ||
    fail "candidate chain commit must not rename or copy paths"
  path_is_in_owner_write_set "${owner_index}" "${copy_target}" ||
    fail "candidate chain commit must not rename or copy paths"
  parent_source="$(git -C "${repo_root}" ls-tree \
    "${parent_sha}" -- "${copy_source}")"
  child_source="$(git -C "${repo_root}" ls-tree \
    "${child_sha}" -- "${copy_source}")"
  parent_target="$(git -C "${repo_root}" ls-tree \
    "${parent_sha}" -- "${copy_target}")"
  child_target="$(git -C "${repo_root}" ls-tree \
    "${child_sha}" -- "${copy_target}")"
  [[ -n "${parent_source}" && "${parent_source}" == "${child_source}" ]] ||
    fail "literal C053 source must be unchanged in parent and child"
  [[ -z "${parent_target}" && -n "${child_target}" ]] ||
    fail "literal C053 target must be absent in the parent and added in the child"
  read -r source_mode _ source_blob _ <<< "${parent_source}"
  read -r child_source_mode _ child_source_blob _ <<< "${child_source}"
  read -r target_mode _ target_blob _ <<< "${child_target}"
  [[ "${source_mode}" == 100644 && "${child_source_mode}" == 100644 &&
     "${source_blob}" == "${child_source_blob}" ]] ||
    fail "literal C053 source blob and mode must remain unchanged"
  [[ "${target_mode}" == 100644 && "${target_blob}" != "${source_blob}" ]] ||
    fail "literal C053 target must be a distinct canonical file"
  validate_canonical_visual_reference_html "${child_sha}"
}

commit_is_ledger_only() {
  local parent_sha="$1"
  local child_sha="$2"
  local changed_paths
  changed_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
    "${parent_sha}..${child_sha}")"
  [[ "${changed_paths}" == "${ledger_path}" ]]
}

require_governance_repair_state_values() {
  local file="$1"
  local candidate_sha="$2"
  case "$(state_value_from_file "${file}" ExecutionStateVersion)" in
    2|3|4) ;;
    *)
    fail "GOVERNANCE_REPAIR must upgrade ExecutionStateVersion from 1 to 2"
      ;;
  esac
  [[ "$(state_value_from_file "${file}" GovernanceRepairStatus)" == PASS ]] ||
    fail "GOVERNANCE_REPAIR status must be PASS"
  [[ "$(state_value_from_file "${file}" GovernanceRepairSpecSHA)" == \
     "${governance_repair_spec_sha}" ]] ||
    fail "GOVERNANCE_REPAIR approved spec SHA mismatch"
  [[ "$(state_value_from_file "${file}" GovernanceRepairOriginReceiptSHA)" == \
     "${governance_repair_origin_sha}" ]] ||
    fail "GOVERNANCE_REPAIR origin SHA mismatch"
  [[ "$(state_value_from_file "${file}" GovernanceRepairReviewedCandidateSHA)" == \
     "${candidate_sha}" ]] ||
    fail "GOVERNANCE_REPAIR reviewed candidate SHA mismatch"
  [[ "$(state_value_from_file "${file}" GovernanceRepairReviewRoute)" == \
     deep_reviewer+ultra_gatekeeper ]] ||
    fail "GOVERNANCE_REPAIR review route mismatch"
  [[ "$(state_value_from_file "${file}" GovernanceRepairReviewVerdict)" == \
     FINAL_GO_P0_0_P1_0_P2_0 ]] ||
    fail "GOVERNANCE_REPAIR review verdict mismatch"
}

require_repair_fields_unchanged_between_files() {
  local base_file="$1"
  local head_file="$2"
  local field
  while IFS= read -r field; do
    [[ "$(state_value_from_file "${head_file}" "${field}")" == \
       "$(state_value_from_file "${base_file}" "${field}")" ]] ||
      fail "receipt transition must preserve ${field}"
  done < <(governance_repair_fields)
}

require_governance_repair_business_state_preserved() {
  local base_file="$1"
  local head_file="$2"
  local preserved_field
  for preserved_field in \
    GovernanceBootstrapStatus GovernanceReviewedCandidateSHA GovernanceReviewVerdict \
    SetAuthorizationStatus SetAuthorizationScope HumanCheckpointRequirement \
    TaskCardSetStatus ActiveTaskCard ReleasedTaskCard CompletedTaskCards \
    CurrentCandidateSHA CurrentGateStatus CurrentReviewRoute CurrentReviewVerdict \
    VSB00CandidateSHA VSB00GateStatus VSB00ReviewRoute VSB00ReviewVerdict \
    VSB01CandidateSHA VSB01GateStatus VSB01ReviewRoute VSB01ReviewVerdict \
    VSB02CandidateSHA VSB02GateStatus VSB02ReviewRoute VSB02ReviewVerdict \
    VSB03CandidateSHA VSB03GateStatus VSB03ReviewRoute \
    VSB03DeepReviewVerdict VSB03UltraReviewVerdict NextTaskCard \
    FrozenWave1TaskCard FrozenWave1CandidateSHA HistoricalVisualEvidenceBaselineSHA \
    VisualImplementation FullProductImplementation UserStopAuthorization \
    FormalDatabaseWrite RemotePush; do
    [[ "$(state_value_from_file "${head_file}" "${preserved_field}")" == \
       "$(state_value_from_file "${base_file}" "${preserved_field}")" ]] ||
      fail "GOVERNANCE_REPAIR must preserve the failed receipt business state"
  done
  [[ "$(state_value_from_file "${head_file}" TaskCardSetStatus)" == IN_PROGRESS &&
     "$(state_value_from_file "${head_file}" ActiveTaskCard)" == VSB-01 &&
     "$(state_value_from_file "${head_file}" ReleasedTaskCard)" == VSB-01 &&
     "$(state_value_from_file "${head_file}" CompletedTaskCards)" == VSB-00 &&
     "$(state_value_from_file "${head_file}" CurrentCandidateSHA)" == \
       "${governance_repair_vsb00_candidate_sha}" &&
     "$(state_value_from_file "${head_file}" VSB00CandidateSHA)" == \
       "${governance_repair_vsb00_candidate_sha}" &&
     "$(state_value_from_file "${head_file}" NextTaskCard)" == VSB-02 ]] ||
    fail "GOVERNANCE_REPAIR must preserve the failed receipt business state"
}

validate_governance_repair_transition_files() {
  local pair_base="$1"
  local pair_head="$2"
  local base_file="$3"
  local head_file="$4"
  local field expected_head_file base_mode head_mode
  [[ "$(state_value_from_file "${base_file}" ExecutionStateVersion)" == 1 ]] ||
    fail "GOVERNANCE_REPAIR is allowed exactly once"
  [[ "$(state_value_from_file "${head_file}" ExecutionStateVersion)" == 2 ]] ||
    fail "GOVERNANCE_REPAIR must upgrade ExecutionStateVersion from 1 to 2"
  for field in $(governance_repair_fields); do
    [[ "$(grep -c "^${field} = " "${base_file}" || true)" -eq 0 ]] ||
      fail "GOVERNANCE_REPAIR is allowed exactly once"
  done
  validate_governance_repair_chain "${pair_base}"
  [[ "$(state_value_from_file "${head_file}" TransitionKind)" == GOVERNANCE_REPAIR ]] ||
    fail "GOVERNANCE_REPAIR transition kind mismatch"
  [[ "$(state_value_from_file "${head_file}" TransitionBaseSHA)" == "${pair_base}" ]] ||
    fail "TransitionBaseSHA must equal the fixed transition BASE"
  [[ "$(state_value_from_file "${base_file}" TransitionSequence)" == 2 &&
     "$(state_value_from_file "${head_file}" TransitionSequence)" == 3 ]] ||
    fail "GOVERNANCE_REPAIR TransitionSequence must be 3"
  require_governance_repair_state_values "${head_file}" "${pair_base}"
  require_governance_repair_business_state_preserved "${base_file}" "${head_file}"
  expected_head_file="$(mktemp \
    "${verifier_tmp_root}/expected-repair-ledger.XXXXXX")"
  temporary_paths+=("${expected_head_file}")
  build_expected_governance_repair_ledger \
    "${base_file}" "${expected_head_file}" "${pair_base}"
  cmp -s "${expected_head_file}" "${head_file}" ||
    fail "GOVERNANCE_REPAIR receipt must be the exact approved ledger transform"
  base_mode="$(git -C "${repo_root}" ls-tree \
    "${pair_base}" -- "${ledger_path}" | awk '{print $1}')"
  head_mode="$(git -C "${repo_root}" ls-tree \
    "${pair_head}" -- "${ledger_path}" | awk '{print $1}')"
  [[ "${base_mode}" == 100644 && "${head_mode}" == 100644 ]] ||
    fail "GOVERNANCE_REPAIR receipt ledger mode must remain canonical"
}

ledger_receipt_claims_owner_release() {
  local receipt_sha="$1"
  local receipt_parent_sha="$2"
  local owner_id="$3"
  local transition_kind
  transition_kind="$(commit_ledger_field "${receipt_sha}" TransitionKind)"
  case "${transition_kind}" in
    ACTIVATE_SET|ADVANCE|RETURN_TO_OWNER) ;;
    GOVERNANCE_REPAIR)
      [[ "${owner_id}" == VSB-01 ]] || return 1
      ;;
    RECEIPT_CORRECTION)
      [[ "${owner_id}" == VSB-02 ]] || return 1
      ;;
    VERIFIER_RECOVERY)
      [[ "${owner_id}" == VSB-02 ]] || return 1
      ;;
    *) return 1 ;;
  esac
  [[ "$(commit_ledger_field "${receipt_sha}" TransitionBaseSHA)" == \
       "${receipt_parent_sha}" &&
     "$(commit_ledger_field "${receipt_sha}" ActiveTaskCard)" == "${owner_id}" &&
     "$(commit_ledger_field "${receipt_sha}" ReleasedTaskCard)" == "${owner_id}" ]]
}

find_nearest_owner_release_receipt() {
  local candidate_sha="$1"
  local owner_index="$2"
  local owner_id="${expected_ids[${owner_index}]}"
  local cursor_sha parent_sha replay_output
  cursor_sha="${candidate_sha}"
  while :; do
    if ! parent_sha="$(single_parent_of "${cursor_sha}" \
      "candidate chain commit")"; then
      fail "candidate chain must start at the nearest valid Owner release receipt"
    fi
    if commit_is_ledger_only "${parent_sha}" "${cursor_sha}" &&
       ledger_receipt_claims_owner_release \
         "${cursor_sha}" "${parent_sha}" "${owner_id}"; then
      if ! replay_output="$(
        validate_parent_receipt_transition_pair \
          "${parent_sha}" "${cursor_sha}" 0 2>&1
      )"; then
        fail "candidate chain must start at the nearest valid Owner release receipt"
      fi
      printf '%s\n' "${cursor_sha}"
      return 0
    fi
    cursor_sha="${parent_sha}"
  done
}

validate_candidate_chain_commit() {
  local owner_index="$1"
  local parent_sha="$2"
  local child_sha="$3"
  local actual_parent changed_paths candidate_path parent_mode child_mode
  local raw_status_file raw_error_file status_token status_path status_target
  actual_parent="$(single_parent_of "${child_sha}" \
    "candidate chain commit")"
  [[ "${actual_parent}" == "${parent_sha}" ]] ||
    fail "candidate chain commit must have exactly one parent"
  changed_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
    "${parent_sha}..${child_sha}")"
  [[ -n "${changed_paths}" ]] ||
    fail "candidate chain commit must not be empty"
  raw_status_file="$(mktemp \
    "${verifier_tmp_root}/candidate-raw-status.XXXXXX")"
  raw_error_file="$(mktemp \
    "${verifier_tmp_root}/candidate-raw-error.XXXXXX")"
  if ! git -C "${repo_root}" -c diff.renameLimit=0 \
    diff-tree --no-commit-id -r -M -C --find-copies-harder --name-status -z \
    "${parent_sha}" "${child_sha}" \
    > "${raw_status_file}" 2> "${raw_error_file}"; then
    fail "candidate chain rename and copy inspection failed"
  fi
  [[ ! -s "${raw_error_file}" ]] ||
    fail "candidate chain rename and copy inspection was degraded"
  while IFS= read -r -d '' status_token; do
    IFS= read -r -d '' status_path ||
      fail "candidate chain rename and copy inspection failed"
    case "${status_token}" in
      R*)
        IFS= read -r -d '' status_target ||
          fail "candidate chain rename and copy inspection failed"
        fail "candidate chain commit must not rename or copy paths"
        ;;
      C*)
        IFS= read -r -d '' status_target ||
          fail "candidate chain rename and copy inspection failed"
        validate_literal_visual_reference_copy \
          "${owner_index}" "${parent_sha}" "${child_sha}" \
          "${status_token}" "${status_path}" "${status_target}"
        ;;
    esac
  done < "${raw_status_file}"
  while IFS= read -r candidate_path; do
    [[ "${candidate_path}" != "${ledger_path}" ]] ||
      fail "candidate chain must not modify the execution ledger"
    path_is_in_owner_write_set "${owner_index}" "${candidate_path}" ||
      fail "candidate chain commit changed a path outside the Owner WriteSet"
    parent_mode="$(git -C "${repo_root}" ls-tree \
      "${parent_sha}" -- "${candidate_path}" | awk '{print $1}')"
    child_mode="$(git -C "${repo_root}" ls-tree \
      "${child_sha}" -- "${candidate_path}" | awk '{print $1}')"
    if [[ -n "${parent_mode}" && -n "${child_mode}" ]]; then
      [[ "${parent_mode}" == "${child_mode}" ]] ||
        fail "candidate chain commit must preserve existing file modes"
    fi
    case "${child_mode}" in
      ""|100644|100755) ;;
      *) fail "candidate chain commit must preserve existing file modes" ;;
    esac
  done <<< "${changed_paths}"
}

verifier_recovery_fields() {
  printf '%s\n' \
    VerifierRecoveryStatus VerifierRecoverySpecSHA \
    VerifierRecoveryOriginReceiptSHA VerifierRecoveryFailedCandidateSHA \
    VerifierRecoveryReviewedCandidateSHA VerifierRecoveryReviewLevel \
    VerifierRecoveryReviewRoute VerifierRecoveryReviewEffort \
    VerifierRecoveryReviewMultiplicity VerifierRecoveryReviewVerdict
}

verifier_recovery_write_set() {
  printf '%s\n' \
    docs/superpowers/specs/2026-08-14-cognitura-vsb-copy-classification-recovery-design.md \
    docs/superpowers/plans/2026-08-14-cognitura-vsb-copy-classification-recovery.md \
    docs/task-cards/visual-style-baseline/README.md \
    scripts/verify-visual-style-baseline-cards \
    tests/task-cards/verify-visual-style-baseline-cards.sh
}

verifier_recovery_expected_mode() {
  case "$1" in
    scripts/verify-visual-style-baseline-cards|tests/task-cards/verify-visual-style-baseline-cards.sh)
      printf '100755\n'
      ;;
    docs/superpowers/specs/2026-08-14-cognitura-vsb-copy-classification-recovery-design.md|\
    docs/superpowers/plans/2026-08-14-cognitura-vsb-copy-classification-recovery.md|\
    docs/task-cards/visual-style-baseline/README.md)
      printf '100644\n'
      ;;
    *) return 1 ;;
  esac
}

validate_verifier_recovery_chain() {
  local candidate_sha="$1"
  local previous_sha chain_sha actual_parent path_count recovery_path expected_mode
  local origin_ledger chain_ledger actual_paths expected_paths
  local status_file error_file status_token status_path status_target content_file
  local authority_path authority_blob chain_blob chain_mode
  git -C "${repo_root}" merge-base --is-ancestor \
    "${verifier_recovery_origin_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed verifier-recovery origin is absent from G3 ancestry"
  [[ "${candidate_sha}" != "${verifier_recovery_origin_sha}" ]] ||
    fail "fixed verifier-recovery origin is not a pending G3 candidate"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${verifier_recovery_spec_sha}" "${candidate_sha}" 2>/dev/null ||
    fail "fixed revised verifier-recovery Authority is absent from G3 ancestry"
  origin_ledger="$(git -C "${repo_root}" rev-parse \
    "${verifier_recovery_origin_sha}:${ledger_path}" 2>/dev/null)" ||
    fail "fixed verifier-recovery origin ledger is missing"
  previous_sha="${verifier_recovery_origin_sha}"
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    actual_parent="$(single_parent_of "${chain_sha}" \
      "verifier recovery governance commit")"
    [[ "${actual_parent}" == "${previous_sha}" ]] ||
      fail "verifier recovery governance commit must have exactly one parent"
    status_file="$(mktemp "${verifier_tmp_root}/recovery-status.XXXXXX")"
    error_file="$(mktemp "${verifier_tmp_root}/recovery-error.XXXXXX")"
    if ! git -C "${repo_root}" -c diff.renameLimit=0 diff-tree \
      --no-commit-id -r -M -C --find-copies-harder --name-status -z \
      "${previous_sha}" "${chain_sha}" > "${status_file}" 2> "${error_file}"; then
      fail "verifier recovery governance rename and copy inspection failed"
    fi
    [[ ! -s "${error_file}" ]] ||
      fail "verifier recovery governance rename and copy inspection was degraded"
    path_count=0
    while IFS= read -r -d '' status_token; do
      IFS= read -r -d '' status_path ||
        fail "verifier recovery governance path inspection failed"
      case "${status_token}" in
        R*|C*)
          IFS= read -r -d '' status_target ||
            fail "verifier recovery governance path inspection failed"
          fail "verifier recovery governance chain must not rename or copy paths"
          ;;
      esac
    done < "${status_file}"
    while IFS= read -r -d '' recovery_path; do
      path_count=$((path_count + 1))
      expected_mode="$(verifier_recovery_expected_mode "${recovery_path}")" ||
        fail "verifier recovery governance chain changed a path outside the exact five-path WriteSet"
      chain_mode="$(git -C "${repo_root}" ls-tree \
        "${chain_sha}" -- "${recovery_path}" | awk '{print $1}')"
      [[ "${chain_mode}" == "${expected_mode}" ]] ||
        fail "verifier recovery governance path mode drifted"
      content_file="$(mktemp "${verifier_tmp_root}/recovery-content.XXXXXX")"
      git -C "${repo_root}" show \
        "${chain_sha}:${recovery_path}" > "${content_file}" 2>/dev/null ||
        fail "verifier recovery governance path blob is unavailable"
      require_nul_free_file "${content_file}" \
        "verifier recovery governance path must not contain NUL bytes"
    done < <(git -C "${repo_root}" diff --no-renames --name-only -z \
      "${previous_sha}..${chain_sha}")
    [[ "${path_count}" -gt 0 ]] ||
      fail "verifier recovery governance commit must not be empty"
    chain_ledger="$(git -C "${repo_root}" rev-parse \
      "${chain_sha}:${ledger_path}" 2>/dev/null)" ||
      fail "verifier recovery governance ledger is missing"
    [[ "${chain_ledger}" == "${origin_ledger}" ]] ||
      fail "verifier recovery governance chain must preserve the origin ledger bytes"
    for authority_path in \
      docs/superpowers/specs/2026-08-14-cognitura-vsb-copy-classification-recovery-design.md \
      docs/superpowers/plans/2026-08-14-cognitura-vsb-copy-classification-recovery.md; do
      if git -C "${repo_root}" merge-base --is-ancestor \
          "${verifier_recovery_spec_sha}" "${chain_sha}" 2>/dev/null; then
        authority_blob="$(git -C "${repo_root}" rev-parse \
          "${verifier_recovery_spec_sha}:${authority_path}" 2>/dev/null)" ||
          fail "fixed verifier-recovery Authority blob is unavailable"
        chain_blob="$(git -C "${repo_root}" rev-parse \
          "${chain_sha}:${authority_path}" 2>/dev/null)" ||
          fail "fixed verifier-recovery Authority blob drifted"
        chain_mode="$(git -C "${repo_root}" ls-tree \
          "${chain_sha}" -- "${authority_path}" | awk '{print $1}')"
        [[ "${chain_blob}" == "${authority_blob}" && "${chain_mode}" == 100644 ]] ||
          fail "fixed verifier-recovery Authority blob or mode drifted"
      fi
    done
    previous_sha="${chain_sha}"
  done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
    "${verifier_recovery_origin_sha}..${candidate_sha}")
  [[ "${previous_sha}" == "${candidate_sha}" ]] ||
    fail "G3 must be the verifier recovery governance chain tip"
  actual_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
    "${verifier_recovery_origin_sha}..${candidate_sha}" | LC_ALL=C sort)"
  expected_paths="$(verifier_recovery_write_set | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "verifier recovery governance chain must have the exact five-path cumulative WriteSet"
}

validate_verifier_recovery_pending_head() {
  local candidate_sha="$1"
  local repository_head origin_blob head_blob working_blob field
  repository_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
    fail "repository HEAD is unavailable"
  [[ "${candidate_sha}" == "${repository_head}" ]] ||
    fail "pending G3 must equal repository HEAD"
  origin_blob="$(git -C "${repo_root}" rev-parse \
    "${verifier_recovery_origin_sha}:${ledger_path}")"
  head_blob="$(git -C "${repo_root}" rev-parse \
    "${candidate_sha}:${ledger_path}")"
  working_blob="$(git -C "${repo_root}" hash-object "${state_file}")"
  [[ "${origin_blob}" == "${head_blob}" && "${head_blob}" == "${working_blob}" ]] ||
    fail "pending G3 must preserve the fixed origin ledger bytes"
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${state_file}" || true)" -eq 0 ]] ||
      fail "pending G3 ledger must not contain verifier recovery fields"
  done < <(verifier_recovery_fields)
  [[ "$(state_value_from_file "${state_file}" ExecutionStateVersion)" == 3 &&
     "$(state_value_from_file "${state_file}" TransitionSequence)" == 6 &&
     "$(state_value_from_file "${state_file}" TransitionKind)" == RETURN_TO_OWNER &&
     "$(state_value_from_file "${state_file}" TransitionBaseSHA)" == "${verifier_recovery_failed_candidate_sha}" &&
     "$(state_value_from_file "${state_file}" Owner)" == VSB-02 &&
     "$(state_value_from_file "${state_file}" CurrentCandidateSHA)" == "${verifier_recovery_failed_candidate_sha}" &&
     "$(state_value_from_file "${state_file}" CurrentGateStatus)" == FAIL &&
     "$(state_value_from_file "${state_file}" CurrentReviewVerdict)" == FINDING_P0_0_P1_1_P2_1 ]] ||
    fail "pending G3 must preserve the fixed VSB-02 finding state"
  validate_verifier_recovery_chain "${candidate_sha}"
  validate_candidate_chain_commit 2 \
    "$(single_parent_of "${verifier_recovery_failed_candidate_sha}" \
      "failed VSB-02 candidate")" "${verifier_recovery_failed_candidate_sha}"
}

build_expected_verifier_recovery_ledger() {
  local origin_file="$1"
  local expected_file="$2"
  local candidate_sha="$3"
  awk -v candidate_sha="${candidate_sha}" \
      -v spec_sha="${verifier_recovery_spec_sha}" '
    /^ExecutionStateVersion = 3$/ { print "ExecutionStateVersion = 4"; next }
    { print }
    /^ReceiptCorrectionReviewVerdict = FINAL_GO_P0_0_P1_0_P2_0$/ {
      print "VerifierRecoveryStatus = PASS"
      print "VerifierRecoverySpecSHA = " spec_sha
      print "VerifierRecoveryOriginReceiptSHA = 9904d3deb87e4a3e2820c5a12463929916057c36"
      print "VerifierRecoveryFailedCandidateSHA = b16f867bfb951bf969ac8c4a8697c8b8913325bd"
      print "VerifierRecoveryReviewedCandidateSHA = " candidate_sha
      print "VerifierRecoveryReviewLevel = L3"
      print "VerifierRecoveryReviewRoute = deep_reviewer"
      print "VerifierRecoveryReviewEffort = xhigh"
      print "VerifierRecoveryReviewMultiplicity = ONE"
      print "VerifierRecoveryReviewVerdict = GO_P0_0_P1_0_P2_0"
    }
  ' "${origin_file}" | awk -v candidate_sha="${candidate_sha}" '
    /^TransitionSequence = 6$/ { print "TransitionSequence = 7"; next }
    /^TransitionKind = RETURN_TO_OWNER$/ { print "TransitionKind = VERIFIER_RECOVERY"; next }
    /^TransitionBaseSHA = b16f867bfb951bf969ac8c4a8697c8b8913325bd$/ {
      print "TransitionBaseSHA = " candidate_sha; next
    }
    /^Owner = VSB-02$/ { next }
    { print }
  ' > "${expected_file}" ||
    fail "could not build the approved VERIFIER_RECOVERY ledger"
}

require_verifier_recovery_state_values() {
  local file="$1"
  local candidate_sha="$2"
  local field
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${file}" || true)" -eq 1 ]] ||
      fail "verifier recovery field must occur exactly once: ${field}"
  done < <(verifier_recovery_fields)
  [[ "$(state_value_from_file "${file}" VerifierRecoveryStatus)" == PASS &&
     "$(state_value_from_file "${file}" VerifierRecoverySpecSHA)" == "${verifier_recovery_spec_sha}" &&
     "$(state_value_from_file "${file}" VerifierRecoveryOriginReceiptSHA)" == "${verifier_recovery_origin_sha}" &&
     "$(state_value_from_file "${file}" VerifierRecoveryFailedCandidateSHA)" == "${verifier_recovery_failed_candidate_sha}" &&
     "$(state_value_from_file "${file}" VerifierRecoveryReviewedCandidateSHA)" == "${candidate_sha}" &&
     "$(state_value_from_file "${file}" VerifierRecoveryReviewLevel)" == L3 &&
     "$(state_value_from_file "${file}" VerifierRecoveryReviewRoute)" == deep_reviewer &&
     "$(state_value_from_file "${file}" VerifierRecoveryReviewEffort)" == xhigh &&
     "$(state_value_from_file "${file}" VerifierRecoveryReviewMultiplicity)" == ONE &&
     "$(state_value_from_file "${file}" VerifierRecoveryReviewVerdict)" == GO_P0_0_P1_0_P2_0 ]] ||
    fail "verifier recovery canonical block mismatch"
}

require_verifier_recovery_fields_unchanged_between_files() {
  local base_file="$1"
  local head_file="$2"
  local field base_block head_block
  base_block="$(mktemp "${verifier_tmp_root}/base-recovery-block.XXXXXX")"
  head_block="$(mktemp "${verifier_tmp_root}/head-recovery-block.XXXXXX")"
  grep '^VerifierRecovery' "${base_file}" > "${base_block}" || true
  grep '^VerifierRecovery' "${head_file}" > "${head_block}" || true
  [[ "$(wc -l < "${base_block}" | tr -d ' ')" -eq 10 &&
     "$(wc -l < "${head_block}" | tr -d ' ')" -eq 10 ]] ||
    fail "ordinary version-4 transition must preserve VerifierRecovery fields"
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${base_file}" || true)" -eq 1 &&
       "$(grep -c "^${field} = " "${head_file}" || true)" -eq 1 ]] ||
      fail "ordinary version-4 transition must preserve VerifierRecovery fields"
  done < <(verifier_recovery_fields)
  cmp -s "${base_block}" "${head_block}" ||
    fail "ordinary version-4 transition must preserve VerifierRecovery fields"
}

validate_verifier_recovery_transition_files() {
  local pair_base="$1"
  local pair_head="$2"
  local base_file="$3"
  local head_file="$4"
  local field origin_file expected_file base_mode head_mode
  [[ "$(state_value_from_file "${base_file}" ExecutionStateVersion)" == 3 ]] ||
    fail "VERIFIER_RECOVERY is allowed exactly once"
  while IFS= read -r field; do
    [[ "$(grep -c "^${field} = " "${base_file}" || true)" -eq 0 ]] ||
      fail "VERIFIER_RECOVERY is allowed exactly once"
  done < <(verifier_recovery_fields)
  validate_verifier_recovery_chain "${pair_base}"
  require_verifier_recovery_state_values "${head_file}" "${pair_base}"
  [[ "$(state_value_from_file "${head_file}" ExecutionStateVersion)" == 4 &&
     "$(state_value_from_file "${head_file}" TransitionSequence)" == 7 &&
     "$(state_value_from_file "${head_file}" TransitionKind)" == VERIFIER_RECOVERY &&
     "$(state_value_from_file "${head_file}" TransitionBaseSHA)" == "${pair_base}" &&
     "$(grep -c '^Owner = ' "${head_file}" || true)" -eq 0 ]] ||
    fail "VERIFIER_RECOVERY transition fields mismatch"
  origin_file="$(mktemp "${verifier_tmp_root}/recovery-origin-ledger.XXXXXX")"
  expected_file="$(mktemp "${verifier_tmp_root}/expected-recovery-ledger.XXXXXX")"
  git -C "${repo_root}" show \
    "${verifier_recovery_origin_sha}:${ledger_path}" > "${origin_file}" 2>/dev/null ||
    fail "fixed verifier-recovery origin ledger is missing"
  cmp -s "${origin_file}" "${base_file}" ||
    fail "G3 ledger must be byte-identical to the fixed recovery origin"
  build_expected_verifier_recovery_ledger \
    "${origin_file}" "${expected_file}" "${pair_base}"
  require_nul_free_file "${head_file}" "VERIFIER_RECOVERY ledger must not contain NUL bytes"
  cmp -s "${expected_file}" "${head_file}" ||
    fail "VERIFIER_RECOVERY receipt must be the exact approved ledger transform"
  base_mode="$(git -C "${repo_root}" ls-tree \
    "${pair_base}" -- "${ledger_path}" | awk '{print $1}')"
  head_mode="$(git -C "${repo_root}" ls-tree \
    "${pair_head}" -- "${ledger_path}" | awk '{print $1}')"
  [[ "${base_mode}" == 100644 && "${head_mode}" == 100644 ]] ||
    fail "VERIFIER_RECOVERY receipt ledger mode must remain canonical"
}

validate_verifier_recovery_static_replay() {
  local candidate_sha repository_head recovery_receipt receipt_file receipt_block
  local chain_sha chain_parent chain_file chain_block chain_kind recovery_count=0
  candidate_sha="$(state_value_from_file \
    "${state_file}" VerifierRecoveryReviewedCandidateSHA)"
  repository_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
    fail "repository HEAD is unavailable"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${candidate_sha}" "${repository_head}" 2>/dev/null ||
    fail "verifier recovery reviewed candidate is not an ancestor of HEAD"
  validate_verifier_recovery_chain "${candidate_sha}"
  recovery_receipt="$(git -C "${repo_root}" rev-list \
    --reverse --first-parent "${candidate_sha}..${repository_head}" | sed -n '1p')"
  [[ -n "${recovery_receipt}" &&
     "$(single_parent_of "${recovery_receipt}" "VERIFIER_RECOVERY receipt")" == \
       "${candidate_sha}" ]] ||
    fail "VERIFIER_RECOVERY receipt must be the direct child of G3"
  receipt_file="$(mktemp "${verifier_tmp_root}/static-recovery-receipt.XXXXXX")"
  receipt_block="$(mktemp "${verifier_tmp_root}/static-recovery-block.XXXXXX")"
  git -C "${repo_root}" show \
    "${recovery_receipt}:${ledger_path}" > "${receipt_file}" 2>/dev/null ||
    fail "VERIFIER_RECOVERY receipt ledger is missing"
  grep '^VerifierRecovery' "${receipt_file}" > "${receipt_block}" || true
  [[ "$(wc -l < "${receipt_block}" | tr -d ' ')" -eq 10 ]] ||
    fail "VERIFIER_RECOVERY receipt must contain the canonical recovery block"
  validate_parent_receipt_transition_pair \
    "${candidate_sha}" "${recovery_receipt}" 0
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    chain_parent="$(single_parent_of "${chain_sha}" "post-recovery first-parent commit")"
    chain_file="$(mktemp "${verifier_tmp_root}/post-recovery-ledger.XXXXXX")"
    chain_block="$(mktemp "${verifier_tmp_root}/post-recovery-block.XXXXXX")"
    git -C "${repo_root}" show \
      "${chain_sha}:${ledger_path}" > "${chain_file}" 2>/dev/null ||
      fail "post-R3 ledger is missing"
    grep '^VerifierRecovery' "${chain_file}" > "${chain_block}" || true
    [[ "$(wc -l < "${chain_block}" | tr -d ' ')" -eq 10 ]] ||
      fail "post-R3 history must preserve the canonical VerifierRecovery block"
    cmp -s "${receipt_block}" "${chain_block}" ||
      fail "post-R3 history must preserve the canonical VerifierRecovery block"
    if commit_is_ledger_only "${chain_parent}" "${chain_sha}"; then
      chain_kind="$(commit_ledger_field "${chain_sha}" TransitionKind || true)"
      [[ "${chain_kind}" == VERIFIER_RECOVERY ]] &&
        recovery_count=$((recovery_count + 1))
    fi
  done < <(git -C "${repo_root}" rev-list --first-parent \
    "${candidate_sha}..${repository_head}")
  [[ "${recovery_count}" -eq 1 ]] ||
    fail "VERIFIER_RECOVERY is allowed exactly once"
  require_verifier_recovery_fields_unchanged_between_files \
    "${receipt_file}" "${state_file}"
}

validate_latest_nonterminal_receipt_static() {
  local latest_receipt latest_parent latest_file latest_kind
  latest_receipt="$(git -C "${repo_root}" log -1 --first-parent \
    --format=%H HEAD -- "${ledger_path}")"
  [[ -n "${latest_receipt}" ]] || fail "static ledger receipt is missing"
  latest_parent="$(single_parent_of "${latest_receipt}" "latest static ledger receipt")"
  latest_file="$(mktemp "${verifier_tmp_root}/latest-static-ledger.XXXXXX")"
  git -C "${repo_root}" show \
    "${latest_receipt}:${ledger_path}" > "${latest_file}" 2>/dev/null ||
    fail "latest static ledger receipt is missing"
  cmp -s "${latest_file}" "${state_file}" ||
    fail "working ledger must match the latest first-parent receipt"
  latest_kind="$(state_value_from_file "${latest_file}" TransitionKind)"
  case "${latest_kind}" in
    ACTIVATE_SET|ADVANCE|RETURN_TO_OWNER|GOVERNANCE_REPAIR|RECEIPT_CORRECTION|VERIFIER_RECOVERY)
      validate_parent_receipt_transition_pair \
        "${latest_parent}" "${latest_receipt}" 0
      ;;
    *) fail "latest static ledger-changing commit is not an ordinary receipt" ;;
  esac
}

validate_candidate_mode_history() {
  local candidate_sha="$1"
  local owner_index="$2"
  local release_sha="$3"
  local owner_path release_mode expected_mode current_mode chain_sha mode_error
  while IFS= read -r owner_path; do
    release_mode="$(git -C "${repo_root}" ls-tree \
      "${release_sha}" -- "${owner_path}" | awk '{print $1}')"
    expected_mode="${release_mode}"
    if [[ -n "${release_mode}" ]]; then
      mode_error="candidate chain commit must preserve release file modes"
    else
      mode_error="candidate chain commit must preserve candidate file modes"
    fi
    while IFS= read -r chain_sha; do
      [[ -n "${chain_sha}" ]] || continue
      current_mode="$(git -C "${repo_root}" ls-tree \
        "${chain_sha}" -- "${owner_path}" | awk '{print $1}')"
      [[ -n "${current_mode}" ]] || continue
      if [[ -z "${expected_mode}" ]]; then
        expected_mode="${current_mode}"
      else
        [[ "${current_mode}" == "${expected_mode}" ]] ||
          fail "${mode_error}"
      fi
    done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
      "${release_sha}..${candidate_sha}")
    current_mode="$(git -C "${repo_root}" ls-tree \
      "${candidate_sha}" -- "${owner_path}" | awk '{print $1}')"
    [[ -n "${expected_mode}" && "${current_mode}" == "${expected_mode}" ]] ||
      fail "${mode_error}"
  done <<< "${expected_write_sets[${owner_index}]}"
}

validate_linear_cumulative_candidate() {
  local candidate_sha="$1"
  local owner_index="$2"
  local release_sha previous_sha chain_sha actual_paths expected_paths
  if ! release_sha="$(find_nearest_owner_release_receipt \
    "${candidate_sha}" "${owner_index}")"; then
    fail "candidate chain must start at the nearest valid Owner release receipt"
  fi
  previous_sha="${release_sha}"
  while IFS= read -r chain_sha; do
    [[ -n "${chain_sha}" ]] || continue
    validate_candidate_chain_commit \
      "${owner_index}" "${previous_sha}" "${chain_sha}"
    previous_sha="${chain_sha}"
  done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
    "${release_sha}..${candidate_sha}")
  [[ "${previous_sha}" == "${candidate_sha}" ]] ||
    fail "reviewed candidate must be the candidate chain tip"
  actual_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
    "${release_sha}..${candidate_sha}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' \
    "${expected_write_sets[${owner_index}]}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "candidate cumulative diff must equal the exact Owner WriteSet"
  validate_candidate_mode_history \
    "${candidate_sha}" "${owner_index}" "${release_sha}"
  verified_candidate_sha="${candidate_sha}"
  verified_candidate_owner_index="${owner_index}"
  verified_candidate_release_sha="${release_sha}"
}

verify_candidate_write_set() {
  validate_linear_cumulative_candidate "$1" "$2"
}

validate_parent_receipt_transition_pair() {
  local pair_base="$1"
  local pair_head="$2"
  local allow_terminal="${3:-0}"
  local ledger_path pair_dir pair_base_file pair_head_file pair_paths
  local base_sequence head_sequence head_kind immutable_field governance_field
  local receipt_index base_active owner_index base_completed head_completed
  local correction_intent=0 correction_field recovery_intent=0 recovery_field
  local expected_base_prefix expected_head_prefix expected_head_active expected_head_next
  local head_owner return_owner_index failed_owner_index expected_return_prefix expected_return_next
  [[ "${pair_head}" != "${governance_repair_origin_sha}" ]] ||
    fail "fixed governance repair origin is not a valid ordinary VSB receipt"
  [[ "${pair_head}" != "${verifier_recovery_origin_sha}" ]] ||
    fail "fixed verifier-recovery origin is not a valid ordinary VSB receipt"
  [[ "$(single_parent_of "${pair_head}" "candidate-parent ledger receipt")" == "${pair_base}" ]] ||
    fail "receipt HEAD must be the direct child of its BASE"
  ledger_path=docs/task-cards/visual-style-baseline/execution-state.md
  pair_paths="$(git -C "${repo_root}" diff --no-renames --name-only "${pair_base}..${pair_head}")"
  [[ "${pair_paths}" == "${ledger_path}" ]] ||
    fail "receipt diff must contain only execution-state.md"
  pair_dir="$(mktemp -d "${verifier_tmp_root}/receipt-pair.XXXXXX")"
  temporary_paths+=("${pair_dir}")
  pair_base_file="${pair_dir}/base-ledger"
  pair_head_file="${pair_dir}/head-ledger"
  git -C "${repo_root}" show "${pair_base}:${ledger_path}" > "${pair_base_file}" 2>/dev/null ||
    fail "receipt BASE ledger is missing"
  git -C "${repo_root}" show "${pair_head}:${ledger_path}" > "${pair_head_file}" 2>/dev/null ||
    fail "receipt HEAD ledger is missing"
  require_nul_free_file "${pair_base_file}" "receipt ledger must not contain NUL bytes"
  require_nul_free_file "${pair_head_file}" "receipt ledger must not contain NUL bytes"
  [[ "$(state_value_from_file "${pair_head_file}" TransitionBaseSHA)" == "${pair_base}" ]] ||
    fail "receipt TransitionBaseSHA must equal its fixed BASE"
  base_sequence="$(state_value_from_file "${pair_base_file}" TransitionSequence)"
  head_sequence="$(state_value_from_file "${pair_head_file}" TransitionSequence)"
  head_kind="$(state_value_from_file "${pair_head_file}" TransitionKind)"
  if [[ "${head_kind}" == VERIFIER_RECOVERY ]]; then
    recovery_intent=1
  elif [[ "$(state_value_from_file "${pair_base_file}" ExecutionStateVersion)" == 3 ]]; then
    while IFS= read -r recovery_field; do
      if grep -q "^${recovery_field} = " "${pair_head_file}"; then
        recovery_intent=1
        break
      fi
    done < <(verifier_recovery_fields)
  fi
  if [[ "${recovery_intent}" -eq 1 ]]; then
    validate_verifier_recovery_transition_files \
      "${pair_base}" "${pair_head}" "${pair_base_file}" "${pair_head_file}"
    rm -rf -- "${pair_dir}"
    return 0
  fi
  if [[ "${head_kind}" == RECEIPT_CORRECTION ]]; then
    correction_intent=1
  elif [[ "$(state_value_from_file "${pair_base_file}" ExecutionStateVersion)" == 2 ]]; then
    while IFS= read -r correction_field; do
      if grep -q "^${correction_field} = " "${pair_head_file}"; then
        correction_intent=1
        break
      fi
    done < <(receipt_correction_fields)
  fi
  if [[ "${correction_intent}" -eq 1 ]]; then
    validate_receipt_correction_transition_files \
      "${pair_base}" "${pair_head}" "${pair_base_file}" "${pair_head_file}"
    rm -rf -- "${pair_dir}"
    return 0
  fi
  if [[ "${head_kind}" == GOVERNANCE_REPAIR &&
        "$(state_value_from_file "${pair_base_file}" ExecutionStateVersion)" == 2 ]]; then
    fail "GOVERNANCE_REPAIR is allowed exactly once"
  fi
  if [[ "${head_kind}" == GOVERNANCE_REPAIR &&
        "${head_sequence}" != 3 ]]; then
    fail "GOVERNANCE_REPAIR TransitionSequence must be 3"
  fi
  [[ "${base_sequence}" =~ ^[0-9]+$ && "${head_sequence}" -eq $((base_sequence + 1)) ]] ||
    fail "receipt TransitionSequence must increment by exactly one"
  if [[ "${head_kind}" == GOVERNANCE_REPAIR ]]; then
    validate_governance_repair_transition_files \
      "${pair_base}" "${pair_head}" "${pair_base_file}" "${pair_head_file}"
    rm -rf -- "${pair_dir}"
    return 0
  fi
  for immutable_field in \
    CanonicalProjectName TaskCardSet ExecutionStateVersion ExecutionStateAuthority \
    ApprovedSpecSHA GovernanceReviewRoute SetAuthorizationStatus SetAuthorizationScope \
    HumanCheckpointRequirement FrozenWave1TaskCard FrozenWave1CandidateSHA \
    HistoricalVisualEvidenceBaselineSHA FullProductImplementation FormalDatabaseWrite RemotePush; do
    [[ "$(state_value_from_file "${pair_head_file}" "${immutable_field}")" == \
       "$(state_value_from_file "${pair_base_file}" "${immutable_field}")" ]] ||
      fail "receipt transition must preserve ${immutable_field}"
  done
  if [[ "$(state_value_from_file "${pair_base_file}" ExecutionStateVersion)" == 2 ]]; then
    require_repair_fields_unchanged_between_files \
      "${pair_base_file}" "${pair_head_file}"
  elif [[ "$(state_value_from_file "${pair_base_file}" ExecutionStateVersion)" == 3 ]]; then
    require_repair_fields_unchanged_between_files \
      "${pair_base_file}" "${pair_head_file}"
    require_receipt_correction_fields_unchanged_between_files \
      "${pair_base_file}" "${pair_head_file}"
  elif [[ "$(state_value_from_file "${pair_base_file}" ExecutionStateVersion)" == 4 ]]; then
    require_repair_fields_unchanged_between_files \
      "${pair_base_file}" "${pair_head_file}"
    require_receipt_correction_fields_unchanged_between_files \
      "${pair_base_file}" "${pair_head_file}"
    require_verifier_recovery_fields_unchanged_between_files \
      "${pair_base_file}" "${pair_head_file}"
  fi
  if [[ "${head_kind}" != ACTIVATE_SET ]]; then
    for governance_field in GovernanceBootstrapStatus GovernanceReviewedCandidateSHA GovernanceReviewVerdict; do
      [[ "$(state_value_from_file "${pair_head_file}" "${governance_field}")" == \
         "$(state_value_from_file "${pair_base_file}" "${governance_field}")" ]] ||
        fail "receipt transition must preserve ${governance_field}"
    done
  fi
  [[ "$(state_value_from_file "${pair_head_file}" UserStopAuthorization)" == \
     "$(state_value_from_file "${pair_base_file}" UserStopAuthorization)" ]] ||
    fail "receipt transition must preserve UserStopAuthorization"
  case "${head_kind}" in
    ACTIVATE_SET)
      [[ "$(state_value_from_file "${pair_base_file}" TaskCardSetStatus)" == USER_AUTHORIZED_AWAITING_GOVERNANCE_REVIEW &&
         "$(state_value_from_file "${pair_base_file}" GovernanceBootstrapStatus)" == AWAITING_FIXED_COMMIT_REVIEW &&
         "$(state_value_from_file "${pair_base_file}" GovernanceReviewedCandidateSHA)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" GovernanceReviewVerdict)" == NOT_RUN &&
         "$(state_value_from_file "${pair_base_file}" ActiveTaskCard)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" ReleasedTaskCard)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" CompletedTaskCards)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" NextTaskCard)" == VSB-00 &&
         "$(state_value_from_file "${pair_base_file}" CurrentCandidateSHA)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" CurrentGateStatus)" == NOT_RUN &&
         "$(state_value_from_file "${pair_base_file}" CurrentReviewRoute)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" CurrentReviewVerdict)" == NOT_RUN &&
         "$(state_value_from_file "${pair_base_file}" TransitionSequence)" == 0 &&
         "$(state_value_from_file "${pair_base_file}" TransitionKind)" == BOOTSTRAP &&
         "$(state_value_from_file "${pair_base_file}" TransitionBaseSHA)" == NONE &&
         "$(state_value_from_file "${pair_base_file}" VisualImplementation)" == USER_AUTHORIZED_PENDING_GOVERNANCE_REVIEW ]] ||
        fail "ACTIVATE_SET receipt must start from the exact bootstrap card state"
      [[ "$(state_value_from_file "${pair_head_file}" TaskCardSetStatus)" == IN_PROGRESS &&
         "$(state_value_from_file "${pair_head_file}" ActiveTaskCard)" == VSB-00 &&
         "$(state_value_from_file "${pair_head_file}" ReleasedTaskCard)" == VSB-00 &&
         "$(state_value_from_file "${pair_head_file}" CompletedTaskCards)" == NONE &&
         "$(state_value_from_file "${pair_head_file}" NextTaskCard)" == VSB-01 &&
         "$(state_value_from_file "${pair_head_file}" GovernanceBootstrapStatus)" == PASS &&
         "$(state_value_from_file "${pair_head_file}" GovernanceReviewedCandidateSHA)" == "${pair_base}" &&
         "$(state_value_from_file "${pair_head_file}" GovernanceReviewVerdict)" == GO_P0_0_P1_0_P2_0 &&
         "$(state_value_from_file "${pair_head_file}" CurrentCandidateSHA)" == NONE &&
         "$(state_value_from_file "${pair_head_file}" CurrentGateStatus)" == NOT_RUN &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewRoute)" == NONE &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewVerdict)" == NOT_RUN &&
         "$(state_value_from_file "${pair_head_file}" VisualImplementation)" == USER_AUTHORIZED ]] ||
        fail "ACTIVATE_SET receipt must produce the exact VSB-00 active state"
      [[ "$(grep -c '^Owner = ' "${pair_head_file}" || true)" -eq 0 ]] ||
        fail "ACTIVATE_SET receipt must not contain Owner"
      for receipt_index in 0 1 2 3; do
        require_receipt_empty_in_file "${pair_base_file}" "${receipt_index}" \
          "ACTIVATE_SET base must have empty per-card receipts"
        require_receipt_empty_in_file "${pair_head_file}" "${receipt_index}" \
          "ACTIVATE_SET head must have empty per-card receipts"
      done
      ;;
    ADVANCE)
      [[ "$(state_value_from_file "${pair_base_file}" TaskCardSetStatus)" == IN_PROGRESS &&
         "$(state_value_from_file "${pair_head_file}" TaskCardSetStatus)" == IN_PROGRESS &&
         "$(state_value_from_file "${pair_head_file}" CurrentCandidateSHA)" == "${pair_base}" ]] ||
        fail "ADVANCE receipt must bind an IN_PROGRESS candidate"
      base_active="$(state_value_from_file "${pair_base_file}" ActiveTaskCard)"
      owner_index="$(owner_index_from_id "${base_active}")"
      [[ "${owner_index}" -lt 3 &&
         "$(state_value_from_file "${pair_base_file}" ReleasedTaskCard)" == "${base_active}" &&
         "$(completed_count_from_file "${pair_base_file}")" -eq "${owner_index}" ]] ||
        fail "ADVANCE receipt BASE active Owner must match its completed prefix"
      case "${base_active}" in
        VSB-00) expected_base_prefix=NONE; expected_head_prefix=VSB-00; expected_head_active=VSB-01; expected_head_next=VSB-02 ;;
        VSB-01) expected_base_prefix=VSB-00; expected_head_prefix=VSB-00,VSB-01; expected_head_active=VSB-02; expected_head_next=VSB-03 ;;
        VSB-02) expected_base_prefix=VSB-00,VSB-01; expected_head_prefix=VSB-00,VSB-01,VSB-02; expected_head_active=VSB-03; expected_head_next=NONE ;;
        *) fail "ADVANCE receipt must complete a non-terminal Owner" ;;
      esac
      base_completed="$(state_value_from_file "${pair_base_file}" CompletedTaskCards)"
      head_completed="$(state_value_from_file "${pair_head_file}" CompletedTaskCards)"
      [[ "${base_completed}" == "${expected_base_prefix}" && "${head_completed}" == "${expected_head_prefix}" &&
         "$(state_value_from_file "${pair_head_file}" ActiveTaskCard)" == "${expected_head_active}" &&
         "$(state_value_from_file "${pair_head_file}" ReleasedTaskCard)" == "${expected_head_active}" &&
         "$(state_value_from_file "${pair_head_file}" NextTaskCard)" == "${expected_head_next}" &&
         "$(state_value_from_file "${pair_head_file}" VisualImplementation)" == USER_AUTHORIZED ]] ||
        fail "ADVANCE receipt must extend the prefix and release the unique successor"
      [[ "$(grep -c '^Owner = ' "${pair_head_file}" || true)" -eq 0 ]] ||
        fail "ADVANCE receipt must not contain Owner"
      [[ "$(state_value_from_file "${pair_head_file}" CurrentGateStatus)" == "VSB-G${owner_index}_PASS" &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewRoute)" == "${expected_routes[${owner_index}]}" &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewVerdict)" == GO_P0_0_P1_0_P2_0 ]] ||
        fail "ADVANCE receipt must contain the Owner zero-finding Gate receipt"
      for receipt_index in 0 1 2 3; do
        if [[ "${receipt_index}" -lt "${owner_index}" ]]; then
          require_receipt_unchanged_between_files "${pair_base_file}" "${pair_head_file}" "${receipt_index}" \
            "ADVANCE receipt must preserve predecessor receipts"
        elif [[ "${receipt_index}" -eq "${owner_index}" ]]; then
          require_receipt_empty_in_file "${pair_base_file}" "${receipt_index}" \
            "ADVANCE receipt BASE Owner receipt must be empty"
          [[ "$(state_value_from_file "${pair_head_file}" "VSB0${receipt_index}CandidateSHA")" == "${pair_base}" &&
             "$(state_value_from_file "${pair_head_file}" "VSB0${receipt_index}GateStatus")" == "VSB-G${receipt_index}_PASS" &&
             "$(state_value_from_file "${pair_head_file}" "VSB0${receipt_index}ReviewRoute")" == deep_reviewer &&
             "$(state_value_from_file "${pair_head_file}" "VSB0${receipt_index}ReviewVerdict")" == GO_P0_0_P1_0_P2_0 ]] ||
            fail "ADVANCE receipt must bind the just-completed Owner candidate"
        else
          require_receipt_unchanged_between_files "${pair_base_file}" "${pair_head_file}" "${receipt_index}" \
            "ADVANCE receipt must preserve successor receipts"
        fi
      done
      verify_candidate_write_set "${pair_base}" "${owner_index}"
      verify_candidate_parent_receipt "${pair_base}"
      ;;
    RETURN_TO_OWNER)
      [[ "$(state_value_from_file "${pair_base_file}" TaskCardSetStatus)" == IN_PROGRESS &&
         "$(state_value_from_file "${pair_head_file}" TaskCardSetStatus)" == IN_PROGRESS &&
         "$(state_value_from_file "${pair_head_file}" CurrentCandidateSHA)" == "${pair_base}" &&
         "$(state_value_from_file "${pair_head_file}" CurrentGateStatus)" == FAIL ]] ||
        fail "RETURN_TO_OWNER receipt must bind a failed IN_PROGRESS candidate"
      head_owner="$(state_value_from_file "${pair_head_file}" Owner)"
      base_active="$(state_value_from_file "${pair_base_file}" ActiveTaskCard)"
      return_owner_index="$(owner_index_from_id "${head_owner}")"
      failed_owner_index="$(owner_index_from_id "${base_active}")"
      [[ "${return_owner_index}" -le "${failed_owner_index}" &&
         "$(state_value_from_file "${pair_base_file}" ReleasedTaskCard)" == "${base_active}" &&
         "$(completed_count_from_file "${pair_base_file}")" -eq "${failed_owner_index}" &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewRoute)" == "${expected_routes[${failed_owner_index}]}" ]] ||
        fail "RETURN_TO_OWNER receipt must reopen the failed Owner or its predecessor"
      is_nonzero_finding_verdict "$(state_value_from_file "${pair_head_file}" CurrentReviewVerdict)" ||
        fail "RETURN_TO_OWNER receipt requires a non-zero finding verdict"
      case "${head_owner}" in
        VSB-00) expected_return_prefix=NONE; expected_return_next=VSB-01 ;;
        VSB-01) expected_return_prefix=VSB-00; expected_return_next=VSB-02 ;;
        VSB-02) expected_return_prefix=VSB-00,VSB-01; expected_return_next=VSB-03 ;;
        VSB-03) expected_return_prefix=VSB-00,VSB-01,VSB-02; expected_return_next=NONE ;;
      esac
      [[ "$(state_value_from_file "${pair_head_file}" ActiveTaskCard)" == "${head_owner}" &&
         "$(state_value_from_file "${pair_head_file}" ReleasedTaskCard)" == "${head_owner}" &&
         "$(state_value_from_file "${pair_head_file}" CompletedTaskCards)" == "${expected_return_prefix}" &&
         "$(state_value_from_file "${pair_head_file}" NextTaskCard)" == "${expected_return_next}" &&
         "$(state_value_from_file "${pair_head_file}" VisualImplementation)" == USER_AUTHORIZED ]] ||
        fail "RETURN_TO_OWNER receipt must truncate to the Owner predecessor prefix"
      for receipt_index in 0 1 2 3; do
        if [[ "${receipt_index}" -lt "${return_owner_index}" ]]; then
          require_receipt_unchanged_between_files "${pair_base_file}" "${pair_head_file}" "${receipt_index}" \
            "RETURN_TO_OWNER receipt must preserve strict predecessor receipts"
        else
          require_receipt_empty_in_file "${pair_head_file}" "${receipt_index}" \
            "RETURN_TO_OWNER receipt must reset Owner and successor receipts"
        fi
        if [[ "${receipt_index}" -ge "${failed_owner_index}" ]]; then
          require_receipt_empty_in_file "${pair_base_file}" "${receipt_index}" \
            "RETURN_TO_OWNER receipt BASE Owner and successor receipts must be empty"
        fi
      done
      verify_candidate_write_set "${pair_base}" "${failed_owner_index}"
      verify_candidate_parent_receipt "${pair_base}"
      ;;
    COMPLETE)
      [[ "${allow_terminal}" -eq 1 ]] ||
        fail "candidate parent receipt must not be terminal"
      [[ "$(state_value_from_file "${pair_base_file}" TaskCardSetStatus)" == IN_PROGRESS &&
         "$(state_value_from_file "${pair_base_file}" ActiveTaskCard)" == VSB-03 &&
         "$(state_value_from_file "${pair_base_file}" ReleasedTaskCard)" == VSB-03 &&
         "$(state_value_from_file "${pair_base_file}" CompletedTaskCards)" == VSB-00,VSB-01,VSB-02 &&
         "$(state_value_from_file "${pair_head_file}" TaskCardSetStatus)" == COMPLETE &&
         "$(state_value_from_file "${pair_head_file}" ActiveTaskCard)" == NONE &&
         "$(state_value_from_file "${pair_head_file}" ReleasedTaskCard)" == NONE &&
         "$(state_value_from_file "${pair_head_file}" CompletedTaskCards)" == VSB-00,VSB-01,VSB-02,VSB-03 &&
         "$(state_value_from_file "${pair_head_file}" NextTaskCard)" == NONE ]] ||
        fail "COMPLETE receipt must close VSB-03 after the exact predecessor prefix"
      expected_pair_complete_route=deep_reviewer+ultra_gatekeeper
      if [[ "${model_route_schema_current}" -eq 1 &&
            "$(state_value_from_file "${pair_head_file}" ExecutionStateVersion)" =~ ^(3|4)$ ]]; then
        expected_pair_complete_route=deep_reviewer
      fi
      [[ "$(state_value_from_file "${pair_head_file}" CurrentCandidateSHA)" == "${pair_base}" &&
         "$(state_value_from_file "${pair_head_file}" CurrentGateStatus)" == VSB-G3_PASS &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewRoute)" == \
           "${expected_pair_complete_route}" &&
         "$(state_value_from_file "${pair_head_file}" CurrentReviewVerdict)" == FINAL_GO_P0_0_P1_0_P2_0 &&
         "$(state_value_from_file "${pair_head_file}" VisualImplementation)" == COMPLETE ]] ||
        fail "COMPLETE receipt must bind the fixed VSB-03 final GO"
      for receipt_index in 0 1 2; do
        require_receipt_unchanged_between_files "${pair_base_file}" "${pair_head_file}" "${receipt_index}" \
          "COMPLETE receipt must preserve every predecessor receipt"
      done
      require_receipt_empty_in_file "${pair_base_file}" 3 \
        "COMPLETE receipt BASE VSB-03 receipt must be empty"
      [[ "$(state_value_from_file "${pair_head_file}" VSB03CandidateSHA)" == "${pair_base}" &&
         "$(state_value_from_file "${pair_head_file}" VSB03GateStatus)" == VSB-G3_PASS ]] ||
        fail "COMPLETE receipt must fill the exact VSB-03 receipt"
      if [[ "${model_route_schema_current}" -eq 1 &&
            "$(state_value_from_file "${pair_head_file}" ExecutionStateVersion)" =~ ^(3|4)$ ]]; then
        [[ "$(state_value_from_file "${pair_head_file}" VSB03ReviewRoute)" == deep_reviewer &&
           "$(state_value_from_file "${pair_head_file}" VSB03DeepReviewVerdict)" == \
             FINAL_GO_P0_0_P1_0_P2_0 &&
           "$(state_value_from_file "${pair_head_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
          fail "current VSB-03 completion must use one deep_reviewer xhigh final gate"
      else
        [[ "$(state_value_from_file "${pair_head_file}" VSB03ReviewRoute)" == \
             deep_reviewer+ultra_gatekeeper &&
           "$(state_value_from_file "${pair_head_file}" VSB03DeepReviewVerdict)" == \
             GO_P0_0_P1_0_P2_0 &&
           "$(state_value_from_file "${pair_head_file}" VSB03UltraReviewVerdict)" == \
             FINAL_GO_P0_0_P1_0_P2_0 ]] ||
          fail "COMPLETE receipt must fill the exact VSB-03 receipt"
      fi
      verify_candidate_write_set "${pair_base}" 3
      verify_candidate_parent_receipt "${pair_base}"
      ;;
    GOVERNANCE_REPAIR)
      validate_governance_repair_transition_files \
        "${pair_base}" "${pair_head}" "${pair_base_file}" "${pair_head_file}"
      ;;
    *) fail "candidate parent receipt kind must be ACTIVATE_SET, ADVANCE, RETURN_TO_OWNER, GOVERNANCE_REPAIR, or RECEIPT_CORRECTION" ;;
  esac
  rm -rf -- "${pair_dir}"
}

verify_candidate_parent_receipt() {
  local candidate_sha="$1"
  [[ "${verified_candidate_sha}" == "${candidate_sha}" &&
     -n "${verified_candidate_release_sha}" ]] ||
    fail "candidate chain must start at the nearest valid Owner release receipt"
}

for index in 0 1 2 3; do
  file="${cards_dir}/${expected_files[${index}]}"
  actual_write_set="$(sed -n 's/^WriteSet = //p' "${file}")"
  [[ "${actual_write_set}" == "${expected_write_sets[${index}]}" ]] ||
    fail "WriteSet mismatch for ${expected_ids[${index}]}"
  while IFS= read -r write_path; do
    case "${write_path}" in
      server/*|schemas/*|raw/*|web/src/App.tsx|web/src/main.tsx|web/src/routes/*|docs/design/high-fidelity/evidence/*|.idea/*|FORMAL_DATABASE_WRITE|REMOTE_PUSH)
        fail "forbidden path in ${expected_ids[${index}]} WriteSet: ${write_path}"
        ;;
    esac
  done <<< "${actual_write_set}"
done

if [[ -z "${transition_base}" ]]; then
  pending_recovery_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
    fail "repository HEAD is unavailable"
  if [[ "${pending_recovery_head}" != "${verifier_recovery_origin_sha}" ]] &&
     git -C "${repo_root}" merge-base --is-ancestor \
       "${verifier_recovery_origin_sha}" "${pending_recovery_head}" 2>/dev/null; then
    pending_recovery_origin_blob="$(git -C "${repo_root}" rev-parse \
      "${verifier_recovery_origin_sha}:${ledger_path}" 2>/dev/null)" ||
      fail "fixed verifier-recovery origin ledger is missing"
    pending_recovery_head_blob="$(git -C "${repo_root}" rev-parse \
      "${pending_recovery_head}:${ledger_path}" 2>/dev/null || true)"
    pending_recovery_working_blob="$(git -C "${repo_root}" hash-object \
      "${state_file}")" || fail "working verifier-recovery ledger cannot be read"
    if [[ "${pending_recovery_origin_blob}" == "${pending_recovery_head_blob}" &&
          "${pending_recovery_head_blob}" == "${pending_recovery_working_blob}" ]]; then
      validate_verifier_recovery_pending_head "${pending_recovery_head}"
      printf '%s\n' \
        'VisualStyleBaselineTaskCardValidation = PASS' \
        'TaskCardCount = 4' \
        'TaskCardSetStatus = IN_PROGRESS' \
        'ActiveTaskCard = VSB-02' \
        'VerifierRecoveryStatus = PENDING'
      exit 0
    fi
  fi
fi

if [[ "${receipt_correction_pending_preflight}" -eq 1 && \
      -z "${transition_base}" ]]; then
  printf '%s\n' \
    'VisualStyleBaselineTaskCardValidation = PASS' \
    'TaskCardCount = 4' \
    'TaskCardSetStatus = IN_PROGRESS' \
    'ActiveTaskCard = VSB-02' \
    'ReceiptCorrectionStatus = PENDING'
  exit 0
fi

# RECEIPT_CORRECTION has one deliberately exceptional version transition.
# Dispatch it before the ordinary immutable-version and business-state rules,
# while still requiring the current card contracts and exact WriteSets above.
if [[ -n "${transition_base}" ]]; then
  early_base="$(git -C "${repo_root}" rev-parse --verify \
    "${transition_base}^{commit}" 2>/dev/null)" ||
    fail "transition BASE is not a commit"
  early_head="$(git -C "${repo_root}" rev-parse --verify \
    "${transition_head}^{commit}" 2>/dev/null)" ||
    fail "transition HEAD is not a commit"
  early_head_probe="$(mktemp \
    "${verifier_tmp_root}/early-head-ledger.XXXXXX")"
  early_base_probe="$(mktemp \
    "${verifier_tmp_root}/early-base-ledger.XXXXXX")"
  git -C "${repo_root}" show \
    "${early_base}:${ledger_path}" > "${early_base_probe}" 2>/dev/null ||
    fail "transition BASE ledger is missing"
  git -C "${repo_root}" show \
    "${early_head}:${ledger_path}" > "${early_head_probe}" 2>/dev/null ||
    fail "transition HEAD ledger is missing"
  if grep -q '^TransitionKind = VERIFIER_RECOVERY$' "${early_head_probe}" ||
     { [[ "$(state_value_from_file "${early_base_probe}" ExecutionStateVersion)" == 3 ]] &&
       grep -q '^VerifierRecovery[A-Za-z]* = ' "${early_head_probe}"; }; then
    [[ "${early_head}" == "$(git -C "${repo_root}" rev-parse HEAD)" ]] ||
      fail "transition HEAD must equal repository HEAD"
    [[ "$(single_parent_of "${early_head}" "transition HEAD")" == \
       "${early_base}" ]] ||
      fail "transition HEAD must be a direct child of transition BASE"
    early_diff_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
      "${early_base}..${early_head}")"
    [[ "${early_diff_paths}" == "${ledger_path}" ]] ||
      fail "receipt diff must contain only execution-state.md"
    require_nul_free_file \
      "${early_base_probe}" "transition ledger must not contain NUL bytes"
    require_nul_free_file \
      "${early_head_probe}" "transition ledger must not contain NUL bytes"
    cmp -s "${state_file}" "${early_head_probe}" ||
      fail "working ledger must match transition HEAD tree"
    validate_verifier_recovery_transition_files \
      "${early_base}" "${early_head}" \
      "${early_base_probe}" "${early_head_probe}"
    printf '%s\n' \
      'VisualStyleBaselineTaskCardValidation = PASS' \
      'TaskCardCount = 4' \
      'TaskCardSetStatus = IN_PROGRESS' \
      'ActiveTaskCard = VSB-02' \
      'VerifierRecoveryStatus = PASS'
    exit 0
  fi
  if grep -q '^TransitionKind = RECEIPT_CORRECTION$' "${early_head_probe}" ||
     { [[ "$(state_value_from_file "${early_base_probe}" ExecutionStateVersion)" == 2 ]] &&
       grep -q '^ReceiptCorrection[A-Za-z]* = ' "${early_head_probe}"; }; then
    [[ "${early_head}" == "$(git -C "${repo_root}" rev-parse HEAD)" ]] ||
      fail "transition HEAD must equal repository HEAD"
    [[ "$(single_parent_of "${early_head}" "transition HEAD")" == \
       "${early_base}" ]] ||
      fail "transition HEAD must be a direct child of transition BASE"
    early_diff_paths="$(git -C "${repo_root}" diff --no-renames --name-only \
      "${early_base}..${early_head}")"
    [[ "${early_diff_paths}" == "${ledger_path}" ]] ||
      fail "receipt diff must contain only execution-state.md"
    early_pair_dir="$(mktemp -d \
      "${verifier_tmp_root}/early-correction-pair.XXXXXX")"
    early_base_file="${early_pair_dir}/base-ledger"
    early_head_file="${early_pair_dir}/head-ledger"
    git -C "${repo_root}" show \
      "${early_base}:${ledger_path}" > "${early_base_file}" 2>/dev/null ||
      fail "transition BASE ledger is missing"
    cp "${early_head_probe}" "${early_head_file}"
    require_nul_free_file \
      "${early_base_file}" "transition ledger must not contain NUL bytes"
    require_nul_free_file \
      "${early_head_file}" "transition ledger must not contain NUL bytes"
    cmp -s "${state_file}" "${early_head_file}" ||
      fail "working ledger must match transition HEAD tree"
    validate_receipt_correction_transition_files \
      "${early_base}" "${early_head}" \
      "${early_base_file}" "${early_head_file}"
    printf '%s\n' \
      'VisualStyleBaselineTaskCardValidation = PASS' \
      'TaskCardCount = 4' \
      "TaskCardSetStatus = $(state_value_from_file "${early_head_file}" TaskCardSetStatus)" \
      "ActiveTaskCard = $(state_value_from_file "${early_head_file}" ActiveTaskCard)" \
      'ReceiptCorrectionStatus = PASS'
    exit 0
  fi
fi

required_state_fields=(
  CanonicalProjectName TaskCardSet ExecutionStateVersion ExecutionStateAuthority
  ApprovedSpecSHA GovernanceBootstrapStatus GovernanceReviewedCandidateSHA
  GovernanceReviewRoute GovernanceReviewVerdict SetAuthorizationStatus
  SetAuthorizationScope HumanCheckpointRequirement TaskCardSetStatus ActiveTaskCard
  ReleasedTaskCard CompletedTaskCards CurrentCandidateSHA CurrentGateStatus
  CurrentReviewRoute CurrentReviewVerdict VSB00CandidateSHA VSB00GateStatus
  VSB00ReviewRoute VSB00ReviewVerdict VSB01CandidateSHA VSB01GateStatus
  VSB01ReviewRoute VSB01ReviewVerdict VSB02CandidateSHA VSB02GateStatus
  VSB02ReviewRoute VSB02ReviewVerdict VSB03CandidateSHA VSB03GateStatus
  VSB03ReviewRoute VSB03DeepReviewVerdict VSB03UltraReviewVerdict NextTaskCard
  TransitionSequence TransitionKind TransitionBaseSHA FrozenWave1TaskCard
  FrozenWave1CandidateSHA HistoricalVisualEvidenceBaselineSHA VisualImplementation
  FullProductImplementation UserStopAuthorization FormalDatabaseWrite RemotePush
)
for field in "${required_state_fields[@]}"; do
  one_field_value "${state_file}" "${field}" execution-state.md >/dev/null
done
execution_state_version="$(field_value "${state_file}" ExecutionStateVersion)"
case "${execution_state_version}" in
  1)
    for field in $(governance_repair_fields); do
      [[ "$(grep -c "^${field} = " "${state_file}" || true)" -eq 0 ]] ||
        fail "ExecutionStateVersion 1 must not contain governance repair fields"
    done
    ;;
  2)
    while IFS= read -r field; do
      one_field_value "${state_file}" "${field}" execution-state.md >/dev/null
    done < <(governance_repair_fields)
    ;;
  3)
    while IFS= read -r field; do
      one_field_value "${state_file}" "${field}" execution-state.md >/dev/null
    done < <(governance_repair_fields)
    if [[ -z "${transition_base}" ]]; then
      require_receipt_correction_state_values "${state_file}" \
        "$(field_value "${state_file}" ReceiptCorrectionReviewedCandidateSHA)"
    fi
    ;;
  4)
    while IFS= read -r field; do
      one_field_value "${state_file}" "${field}" execution-state.md >/dev/null
    done < <(governance_repair_fields)
    while IFS= read -r field; do
      one_field_value "${state_file}" "${field}" execution-state.md >/dev/null
    done < <(receipt_correction_fields)
    while IFS= read -r field; do
      one_field_value "${state_file}" "${field}" execution-state.md >/dev/null
    done < <(verifier_recovery_fields)
    if [[ -z "${transition_base}" ]]; then
      require_receipt_correction_state_values "${state_file}" \
        "$(field_value "${state_file}" ReceiptCorrectionReviewedCandidateSHA)"
      require_verifier_recovery_state_values "${state_file}" \
        "$(field_value "${state_file}" VerifierRecoveryReviewedCandidateSHA)"
    fi
    ;;
  *)
    if [[ "$(field_value "${state_file}" TransitionKind)" == GOVERNANCE_REPAIR ]]; then
      fail "GOVERNANCE_REPAIR must upgrade ExecutionStateVersion from 1 to 2"
    fi
    fail "ExecutionStateVersion mismatch"
    ;;
esac

[[ "$(field_value "${state_file}" CanonicalProjectName)" == Cognitura ]] || fail "CanonicalProjectName mismatch"
[[ "$(field_value "${state_file}" TaskCardSet)" == VISUAL_STYLE_BASELINE ]] || fail "TaskCardSet mismatch"
[[ "$(field_value "${state_file}" ExecutionStateAuthority)" == THIS_DOCUMENT ]] || fail "ExecutionStateAuthority mismatch"
[[ "$(field_value "${state_file}" ApprovedSpecSHA)" == 70eefba5912e6884e4e7e1d6477a65f4091d6590 ]] || fail "ApprovedSpecSHA mismatch"
[[ "$(field_value "${state_file}" FrozenWave1TaskCard)" == W1-I03 ]] || fail "FrozenWave1TaskCard mismatch"
[[ "$(field_value "${state_file}" FrozenWave1CandidateSHA)" == 4e63936c631ab34807e714b90d30415a959bc13d ]] || fail "FrozenWave1CandidateSHA mismatch"
[[ "$(field_value "${state_file}" HistoricalVisualEvidenceBaselineSHA)" == 70eefba5912e6884e4e7e1d6477a65f4091d6590 ]] || fail "HistoricalVisualEvidenceBaselineSHA mismatch"
[[ "$(field_value "${state_file}" GovernanceReviewRoute)" == deep_reviewer ]] || fail "GovernanceReviewRoute mismatch"
[[ "$(field_value "${state_file}" SetAuthorizationStatus)" == USER_AUTHORIZED ]] || fail "SetAuthorizationStatus mismatch"
[[ "$(field_value "${state_file}" SetAuthorizationScope)" == VSB-00..VSB-03_AUTOMATIC_SERIAL ]] || fail "SetAuthorizationScope mismatch"
[[ "$(field_value "${state_file}" HumanCheckpointRequirement)" == NONE_WITHIN_AUTHORIZED_SET ]] || fail "HumanCheckpointRequirement mismatch"
[[ "$(field_value "${state_file}" FullProductImplementation)" == NOT_AUTHORIZED ]] || fail "FullProductImplementation must remain NOT_AUTHORIZED"
[[ "$(field_value "${state_file}" FormalDatabaseWrite)" == NOT_AUTHORIZED ]] || fail "FormalDatabaseWrite must remain NOT_AUTHORIZED"
[[ "$(field_value "${state_file}" RemotePush)" == NOT_AUTHORIZED ]] || fail "RemotePush must remain NOT_AUTHORIZED"
[[ "$(field_value "${state_file}" VSB00ReviewRoute)" == deep_reviewer ]] || fail "VSB00ReviewRoute mismatch"
[[ "$(field_value "${state_file}" VSB01ReviewRoute)" == deep_reviewer ]] || fail "VSB01ReviewRoute mismatch"
[[ "$(field_value "${state_file}" VSB02ReviewRoute)" == deep_reviewer ]] || fail "VSB02ReviewRoute mismatch"
if [[ "${execution_state_version}" == 2 || "${execution_state_version}" == 3 ||
      "${execution_state_version}" == 4 ]]; then
  require_governance_repair_state_values \
    "${state_file}" "$(field_value "${state_file}" GovernanceRepairReviewedCandidateSHA)"
  is_commit_sha "$(field_value "${state_file}" GovernanceRepairReviewedCandidateSHA)" ||
    fail "GovernanceRepairReviewedCandidateSHA must resolve to a 40-character commit"
  governance_repair_status_output=PASS
fi

if [[ "${execution_state_version}" == 3 && -z "${transition_base}" ]]; then
  validate_receipt_correction_static_replay
  receipt_correction_status_output=PASS
fi
if [[ "${execution_state_version}" == 4 && -z "${transition_base}" ]]; then
  validate_receipt_correction_static_replay
  validate_verifier_recovery_static_replay
  receipt_correction_status_output=PASS
  verifier_recovery_status_output=PASS
fi

set_status="$(field_value "${state_file}" TaskCardSetStatus)"
active="$(field_value "${state_file}" ActiveTaskCard)"
released="$(field_value "${state_file}" ReleasedTaskCard)"
completed="$(field_value "${state_file}" CompletedTaskCards)"
next="$(field_value "${state_file}" NextTaskCard)"
sequence="$(field_value "${state_file}" TransitionSequence)"
kind="$(field_value "${state_file}" TransitionKind)"
if [[ "${model_route_schema_current}" -eq 1 && \
      "${execution_state_version}" =~ ^(3|4)$ ]]; then
  case "${set_status}" in
    COMPLETE|FINAL_NO_GO)
      [[ "$(field_value "${state_file}" VSB03ReviewRoute)" == deep_reviewer ]] ||
        fail "current VSB-03 completion must use one deep_reviewer xhigh final gate"
      [[ "$(field_value "${state_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
        fail "current VSB-03 completion must leave Ultra verdict NOT_RUN"
      ;;
    *)
      [[ "$(field_value "${state_file}" VSB03ReviewRoute)" == \
           deep_reviewer+ultra_gatekeeper &&
         "$(field_value "${state_file}" VSB03DeepReviewVerdict)" == NOT_RUN &&
         "$(field_value "${state_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
        fail "unfinished current VSB-03 must preserve the frozen review placeholder"
      ;;
  esac
else
  [[ "$(field_value "${state_file}" VSB03ReviewRoute)" == \
       deep_reviewer+ultra_gatekeeper ]] || fail "VSB03ReviewRoute mismatch"
fi
[[ "${sequence}" =~ ^[0-9]+$ ]] || fail "TransitionSequence must be a non-negative integer"
if [[ "${set_status}" != STOPPED_BY_USER ]]; then
  [[ "$(field_value "${state_file}" UserStopAuthorization)" == NONE ]] ||
    fail "UserStopAuthorization is allowed only for STOPPED_BY_USER"
fi
case "${active}" in NONE|VSB-00|VSB-01|VSB-02|VSB-03) ;; *) fail "ActiveTaskCard must name one known card or NONE" ;; esac
case "${released}" in NONE|VSB-00|VSB-01|VSB-02|VSB-03) ;; *) fail "ReleasedTaskCard must name one known card or NONE" ;; esac
case "${completed}" in NONE|VSB-00|VSB-00,VSB-01|VSB-00,VSB-01,VSB-02|VSB-00,VSB-01,VSB-02,VSB-03) ;;
  *) fail "CompletedTaskCards must be an exact card prefix" ;;
esac

receipt_candidate() { field_value "${state_file}" "VSB0${1}CandidateSHA"; }
receipt_gate() { field_value "${state_file}" "VSB0${1}GateStatus"; }
receipt_deep_verdict() {
  if [[ "$1" -eq 3 ]]; then field_value "${state_file}" VSB03DeepReviewVerdict;
  else field_value "${state_file}" "VSB0${1}ReviewVerdict"; fi
}
require_empty_receipt() {
  local i="$1"
  [[ "$(receipt_candidate "${i}")" == NONE && "$(receipt_gate "${i}")" == NOT_RUN && "$(receipt_deep_verdict "${i}")" == NOT_RUN ]] ||
    fail "bootstrap receipts must remain NONE or NOT_RUN"
  if [[ "${i}" -eq 3 ]]; then
    [[ "$(field_value "${state_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
      fail "bootstrap receipts must remain NONE or NOT_RUN"
  fi
}
require_pass_receipt() {
  local i="$1"
  local candidate gate verdict
  candidate="$(receipt_candidate "${i}")"
  gate="$(receipt_gate "${i}")"
  verdict="$(receipt_deep_verdict "${i}")"
  is_commit_sha "${candidate}" || fail "VSB0${i}CandidateSHA must resolve to a 40-character commit"
  if [[ -z "${transition_base}" ]]; then
    verify_candidate_write_set "${candidate}" "${i}"
  fi
  [[ "${gate}" == "VSB-G${i}_PASS" ]] || fail "VSB0${i}GateStatus mismatch"
  if [[ "${i}" -eq 3 ]]; then
    if [[ "${model_route_schema_current}" -eq 1 && \
          "${execution_state_version}" =~ ^(3|4)$ ]]; then
      [[ "${verdict}" == FINAL_GO_P0_0_P1_0_P2_0 ]] ||
        fail "VSB03 deep review must be final zero-finding GO"
      [[ "$(field_value "${state_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
        fail "current VSB-03 completion must leave Ultra verdict NOT_RUN"
    else
      [[ "${verdict}" == GO_P0_0_P1_0_P2_0 ]] ||
        fail "VSB03 deep review must be zero-finding GO"
      [[ "$(field_value "${state_file}" VSB03UltraReviewVerdict)" == \
         FINAL_GO_P0_0_P1_0_P2_0 ]] ||
        fail "VSB03 ultra review must be final zero-finding GO"
    fi
  else
    [[ "${verdict}" == GO_P0_0_P1_0_P2_0 ]] ||
      fail "VSB0${i} deep review must be zero-finding GO"
  fi
}

completed_count=0
case "${completed}" in
  NONE) completed_count=0 ;;
  VSB-00) completed_count=1 ;;
  VSB-00,VSB-01) completed_count=2 ;;
  VSB-00,VSB-01,VSB-02) completed_count=3 ;;
  VSB-00,VSB-01,VSB-02,VSB-03) completed_count=4 ;;
esac

governance_status="$(field_value "${state_file}" GovernanceBootstrapStatus)"
governance_candidate="$(field_value "${state_file}" GovernanceReviewedCandidateSHA)"
governance_verdict="$(field_value "${state_file}" GovernanceReviewVerdict)"
if [[ "${set_status}" == USER_AUTHORIZED_AWAITING_GOVERNANCE_REVIEW ]]; then
  [[ "${governance_status}" == AWAITING_FIXED_COMMIT_REVIEW && "${governance_candidate}" == NONE && "${governance_verdict}" == NOT_RUN ]] ||
    fail "bootstrap governance fields mismatch"
  [[ "${active}" == NONE && "${released}" == NONE && "${completed}" == NONE && "${next}" == VSB-00 ]] ||
    fail "bootstrap card state mismatch"
  [[ "${sequence}" == 0 && "${kind}" == BOOTSTRAP && "$(field_value "${state_file}" TransitionBaseSHA)" == NONE ]] ||
    fail "bootstrap transition fields mismatch"
  [[ "$(field_value "${state_file}" CurrentCandidateSHA)" == NONE && "$(field_value "${state_file}" CurrentGateStatus)" == NOT_RUN && "$(field_value "${state_file}" CurrentReviewRoute)" == NONE && "$(field_value "${state_file}" CurrentReviewVerdict)" == NOT_RUN ]] ||
    fail "bootstrap current receipt mismatch"
  for i in 0 1 2 3; do require_empty_receipt "${i}"; done
  [[ "$(field_value "${state_file}" VisualImplementation)" == USER_AUTHORIZED_PENDING_GOVERNANCE_REVIEW ]] ||
    fail "bootstrap VisualImplementation mismatch"
elif [[ "${set_status}" == IN_PROGRESS ]]; then
  [[ "${governance_status}" == PASS && "${governance_verdict}" == GO_P0_0_P1_0_P2_0 ]] ||
    fail "activation requires governance zero-finding GO"
  is_commit_sha "${governance_candidate}" || fail "GovernanceReviewedCandidateSHA must resolve to a 40-character commit"
  case "${completed_count}" in
    0) expected_active=VSB-00; expected_next=VSB-01 ;;
    1) expected_active=VSB-01; expected_next=VSB-02 ;;
    2) expected_active=VSB-02; expected_next=VSB-03 ;;
    3) expected_active=VSB-03; expected_next=NONE ;;
    *) fail "IN_PROGRESS cannot have all four cards completed" ;;
  esac
  [[ "${active}" == "${expected_active}" && "${released}" == "${expected_active}" && "${next}" == "${expected_next}" ]] ||
    fail "IN_PROGRESS active, released, or next card mismatch"
  for i in 0 1 2 3; do
    if [[ "${i}" -lt "${completed_count}" ]]; then require_pass_receipt "${i}"; else require_empty_receipt "${i}"; fi
  done
  case "${kind}" in
    ACTIVATE_SET)
      [[ "${completed_count}" -eq 0 && "$(field_value "${state_file}" CurrentCandidateSHA)" == NONE && "$(field_value "${state_file}" CurrentGateStatus)" == NOT_RUN && "$(field_value "${state_file}" CurrentReviewRoute)" == NONE && "$(field_value "${state_file}" CurrentReviewVerdict)" == NOT_RUN ]] ||
        fail "ACTIVATE_SET cannot contain a card receipt"
      [[ "$(grep -c '^Owner = ' "${state_file}" || true)" -eq 0 ]] ||
        fail "Owner is allowed only for RETURN_TO_OWNER"
      ;;
    ADVANCE)
      [[ "${completed_count}" -ge 1 ]] || fail "ADVANCE requires one newly completed card"
      [[ "$(field_value "${state_file}" CurrentCandidateSHA)" == NONE || "$(field_value "${state_file}" CurrentCandidateSHA)" =~ ^[0-9a-f]{40}$ ]] ||
        fail "CurrentCandidateSHA must be NONE or a 40-character commit"
      completed_index=$((completed_count - 1))
      [[ "$(field_value "${state_file}" CurrentCandidateSHA)" == "$(receipt_candidate "${completed_index}")" &&
         "$(field_value "${state_file}" CurrentGateStatus)" == "$(receipt_gate "${completed_index}")" &&
         "$(field_value "${state_file}" CurrentReviewRoute)" == deep_reviewer &&
         "$(field_value "${state_file}" CurrentReviewVerdict)" == "$(receipt_deep_verdict "${completed_index}")" ]] ||
        fail "ADVANCE current receipt must equal the just-completed card receipt"
      [[ "$(grep -c '^Owner = ' "${state_file}" || true)" -eq 0 ]] ||
        fail "Owner is allowed only for RETURN_TO_OWNER"
      ;;
    GOVERNANCE_REPAIR)
      static_repair_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
        fail "repository HEAD is unavailable"
      static_repair_parent="$(single_parent_of \
        "${static_repair_head}" "transition HEAD")"
      if commit_is_ledger_only \
          "${static_repair_parent}" "${static_repair_head}"; then
        validate_parent_receipt_transition_pair \
          "${static_repair_parent}" "${static_repair_head}" 0
        static_repair_receipt="${static_repair_head}"
      else
        static_repair_candidate="$(field_value \
          "${state_file}" GovernanceRepairReviewedCandidateSHA)"
        git -C "${repo_root}" merge-base --is-ancestor \
          "${static_repair_candidate}" "${static_repair_head}" 2>/dev/null ||
          fail "GOVERNANCE_REPAIR reviewed candidate is not an ancestor"
        static_repair_receipt="$(git -C "${repo_root}" rev-list \
          --reverse --first-parent \
          "${static_repair_candidate}..${static_repair_head}" | \
          sed -n '1p')"
        [[ -n "${static_repair_receipt}" ]] ||
          fail "GOVERNANCE_REPAIR receipt is missing"
        [[ "$(single_parent_of "${static_repair_receipt}" \
            "GOVERNANCE_REPAIR receipt")" == \
           "${static_repair_candidate}" ]] ||
          fail "GOVERNANCE_REPAIR receipt must be the direct child of G"
        validate_parent_receipt_transition_pair \
          "${static_repair_candidate}" "${static_repair_receipt}" 0
        static_repair_receipt_file="$(mktemp \
          "${verifier_tmp_root}/repair-receipt-ledger.XXXXXX")"
        temporary_paths+=("${static_repair_receipt_file}")
        git -C "${repo_root}" show \
          "${static_repair_receipt}:${ledger_path}" > \
          "${static_repair_receipt_file}" 2>/dev/null ||
          fail "GOVERNANCE_REPAIR receipt ledger is missing"
        cmp -s "${static_repair_receipt_file}" "${state_file}" ||
          fail "GOVERNANCE_REPAIR is allowed exactly once"
      fi
      static_repair_origin_file="$(mktemp \
        "${verifier_tmp_root}/repair-origin-ledger.XXXXXX")"
      temporary_paths+=("${static_repair_origin_file}")
      git -C "${repo_root}" show \
        "${governance_repair_origin_sha}:${ledger_path}" > \
        "${static_repair_origin_file}" 2>/dev/null ||
        fail "governance repair origin ledger is missing"
      require_governance_repair_business_state_preserved \
        "${static_repair_origin_file}" "${state_file}"
      [[ "${execution_state_version}" == 2 && "${completed_count}" -eq 1 &&
         "${active}" == VSB-01 && "${released}" == VSB-01 &&
         "$(field_value "${state_file}" CurrentCandidateSHA)" == \
           "${governance_repair_vsb00_candidate_sha}" &&
         "$(field_value "${state_file}" CurrentGateStatus)" == VSB-G0_PASS &&
         "$(field_value "${state_file}" CurrentReviewRoute)" == deep_reviewer &&
         "$(field_value "${state_file}" CurrentReviewVerdict)" == GO_P0_0_P1_0_P2_0 &&
         "${sequence}" == 3 ]] ||
        fail "GOVERNANCE_REPAIR static state mismatch"
      require_governance_repair_state_values \
        "${state_file}" "$(field_value "${state_file}" TransitionBaseSHA)"
      [[ "$(grep -c '^Owner = ' "${state_file}" || true)" -eq 0 ]] ||
        fail "Owner is allowed only for RETURN_TO_OWNER"
      ;;
    RECEIPT_CORRECTION)
      [[ "${execution_state_version}" == 3 && "${completed_count}" -eq 2 &&
         "${active}" == VSB-02 && "${released}" == VSB-02 &&
         "${next}" == VSB-03 && "${sequence}" == 5 ]] ||
        fail "RECEIPT_CORRECTION static state mismatch"
      [[ "$(grep -c '^Owner = ' "${state_file}" || true)" -eq 0 ]] ||
        fail "Owner is allowed only for RETURN_TO_OWNER"
      ;;
    VERIFIER_RECOVERY)
      [[ "${execution_state_version}" == 4 && "${completed_count}" -eq 2 &&
         "${active}" == VSB-02 && "${released}" == VSB-02 &&
         "${next}" == VSB-03 && "${sequence}" == 7 &&
         "$(grep -c '^Owner = ' "${state_file}" || true)" -eq 0 ]] ||
        fail "VERIFIER_RECOVERY static state mismatch"
      ;;
    RETURN_TO_OWNER)
      owner="$(one_field_value "${state_file}" Owner execution-state.md)"
      [[ "${owner}" == "${active}" && "${owner}" == "${released}" ]] ||
        fail "RETURN_TO_OWNER Owner must equal ActiveTaskCard and ReleasedTaskCard"
      [[ "$(field_value "${state_file}" CurrentGateStatus)" == FAIL ]] ||
        fail "RETURN_TO_OWNER requires CurrentGateStatus FAIL"
      review="$(field_value "${state_file}" CurrentReviewVerdict)"
      is_nonzero_finding_verdict "${review}" ||
        fail "finding verdict must contain at least one non-zero count"
      ;;
    *) fail "unsupported IN_PROGRESS TransitionKind: ${kind}" ;;
  esac
  [[ "$(field_value "${state_file}" VisualImplementation)" == USER_AUTHORIZED ]] ||
    fail "IN_PROGRESS VisualImplementation mismatch"
elif [[ "${set_status}" == STOPPED_BY_USER ]]; then
  require_governance_pass_state
  [[ "${active}" == NONE && "${released}" == NONE && "${next}" == NONE ]] ||
    fail "STOPPED_BY_USER cannot have an active, released, or next card"
  [[ "$(field_value "${state_file}" UserStopAuthorization)" == EXPLICIT_USER_INSTRUCTION ]] ||
    fail "STOPPED_BY_USER requires explicit user-stop authorization"
  [[ "${kind}" == STOP_BY_USER && "$(field_value "${state_file}" CurrentGateStatus)" == STOPPED_BY_USER && "$(field_value "${state_file}" CurrentReviewRoute)" == NONE && "$(field_value "${state_file}" CurrentReviewVerdict)" == NOT_APPLICABLE_USER_STOP ]] ||
    fail "STOPPED_BY_USER transition fields mismatch"
  [[ "$(field_value "${state_file}" VisualImplementation)" == STOPPED_BY_USER ]] || fail "STOPPED_BY_USER VisualImplementation mismatch"
  for i in 0 1 2 3; do
    if [[ "${i}" -lt "${completed_count}" ]]; then require_pass_receipt "${i}"; else require_empty_receipt "${i}"; fi
  done
elif [[ "${set_status}" == FINAL_NO_GO ]]; then
  require_governance_pass_state
  [[ "${active}" == NONE && "${released}" == NONE && "${next}" == NONE ]] ||
    fail "FINAL_NO_GO cannot have an active, released, or next card"
  [[ "$(field_value "${state_file}" CurrentGateStatus)" == FAIL ]] || fail "FINAL_NO_GO requires FAIL Gate"
  expected_final_route=deep_reviewer+ultra_gatekeeper
  if [[ "${model_route_schema_current}" -eq 1 && \
        "${execution_state_version}" =~ ^(3|4)$ ]]; then
    expected_final_route=deep_reviewer
  fi
  [[ "$(field_value "${state_file}" CurrentReviewRoute)" == \
     "${expected_final_route}" ]] ||
    fail "FINAL_NO_GO requires the fixed visual acceptance review route"
  [[ "${kind}" == FINAL_NO_GO ]] || fail "FINAL_NO_GO requires TransitionKind FINAL_NO_GO"
  [[ "${completed_count}" -eq 3 &&
     "$(field_value "${state_file}" CurrentCandidateSHA)" == "$(field_value "${state_file}" TransitionBaseSHA)" ]] ||
    fail "FINAL_NO_GO requires the VSB-03 candidate and exact predecessor prefix"
  [[ "$(field_value "${state_file}" VisualImplementation)" == FINAL_NO_GO ]] ||
    fail "FINAL_NO_GO VisualImplementation mismatch"
  is_nonzero_finding_verdict "$(field_value "${state_file}" CurrentReviewVerdict)" ||
    fail "FINAL_NO_GO requires a non-zero finding verdict"
  if [[ "${model_route_schema_current}" -eq 1 && \
        "${execution_state_version}" =~ ^(3|4)$ ]]; then
    for i in 0 1 2; do require_pass_receipt "${i}"; done
    [[ "$(field_value "${state_file}" VSB03CandidateSHA)" == \
         "$(field_value "${state_file}" CurrentCandidateSHA)" &&
       "$(field_value "${state_file}" VSB03GateStatus)" == FAIL &&
       "$(field_value "${state_file}" VSB03ReviewRoute)" == deep_reviewer &&
       "$(field_value "${state_file}" VSB03DeepReviewVerdict)" == \
         "$(field_value "${state_file}" CurrentReviewVerdict)" &&
       "$(field_value "${state_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
      fail "FINAL_NO_GO must atomically record the current VSB-03 final finding"
  else
    for i in 0 1 2 3; do
      if [[ "${i}" -lt "${completed_count}" ]]; then
        require_pass_receipt "${i}"
      else
        require_empty_receipt "${i}"
      fi
    done
  fi
elif [[ "${set_status}" == COMPLETE ]]; then
  require_governance_pass_state
  [[ "${active}" == NONE && "${released}" == NONE && "${next}" == NONE && "${completed_count}" -eq 4 ]] ||
    fail "COMPLETE requires all four cards and no active, released, or next card"
  for i in 0 1 2 3; do require_pass_receipt "${i}"; done
  expected_complete_route=deep_reviewer+ultra_gatekeeper
  if [[ "${model_route_schema_current}" -eq 1 && \
        "${execution_state_version}" =~ ^(3|4)$ ]]; then
    expected_complete_route=deep_reviewer
  fi
  [[ "${kind}" == COMPLETE && "$(field_value "${state_file}" CurrentGateStatus)" == VSB-G3_PASS && "$(field_value "${state_file}" CurrentReviewRoute)" == "${expected_complete_route}" && "$(field_value "${state_file}" CurrentReviewVerdict)" == FINAL_GO_P0_0_P1_0_P2_0 ]] ||
    fail "COMPLETE current Gate or review receipt mismatch"
  [[ "$(field_value "${state_file}" CurrentCandidateSHA)" == "$(field_value "${state_file}" TransitionBaseSHA)" &&
     "$(field_value "${state_file}" CurrentCandidateSHA)" == "$(receipt_candidate 3)" ]] ||
    fail "COMPLETE requires the exact VSB-03 terminal candidate"
  [[ "$(field_value "${state_file}" VisualImplementation)" == COMPLETE ]] || fail "COMPLETE VisualImplementation mismatch"
else
  fail "unsupported TaskCardSetStatus: ${set_status}"
fi

if [[ -z "${transition_base}" && "${set_status}" == IN_PROGRESS &&
      "${execution_state_version}" =~ ^(3|4)$ ]]; then
  validate_latest_nonterminal_receipt_static
fi

if [[ "${execution_state_version}" == 2 || "${execution_state_version}" == 3 ||
      "${execution_state_version}" == 4 ]]; then
  validate_governance_repair_chain \
    "$(field_value "${state_file}" GovernanceRepairReviewedCandidateSHA)"
fi

if [[ -z "${transition_base}" ]]; then
  case "${set_status}" in
    STOPPED_BY_USER|FINAL_NO_GO|COMPLETE) validate_terminal_receipt_provenance ;;
  esac
fi

w1_index="${repo_root}/docs/task-cards/wave-1-implementation/README.md"
w1_card="${repo_root}/docs/task-cards/wave-1-implementation/W1-I03-docx-security-gate.md"
[[ -f "${w1_index}" && -f "${w1_card}" ]] || fail "Wave 1 suspension authority is missing"
w1_set_status="$(one_field_value "${w1_index}" TaskCardSetStatus Wave1-README.md)"
w1_active="$(one_field_value "${w1_index}" ActiveTaskCard Wave1-README.md)"
w1_suspended="$(one_field_value "${w1_index}" SuspendedTaskCard Wave1-README.md)"
w1_candidate="$(one_field_value "${w1_index}" SuspendedCandidateSHA Wave1-README.md)"
w1_mutation="$(one_field_value "${w1_index}" SuspendedCandidateMutation Wave1-README.md)"
w1_i03_status="$(one_field_value "${w1_card}" Status W1-I03)"
w1_is_suspended=0
w1_is_restored=0
if [[ "${w1_set_status}" == SUSPENDED_BY_USER && "${w1_active}" == NONE && "${w1_suspended}" == W1-I03 && "${w1_candidate}" == 4e63936c631ab34807e714b90d30415a959bc13d && "${w1_mutation}" == FORBIDDEN && "${w1_i03_status}" == SUSPENDED_BY_USER ]]; then
  w1_is_suspended=1
fi
if [[ "${w1_set_status}" == READY_FOR_EXECUTION && "${w1_active}" == W1-I03 && "${w1_suspended}" == NONE && "${w1_candidate}" == NONE && "${w1_mutation}" == NONE && "${w1_i03_status}" == READY ]]; then
  w1_is_restored=1
fi
if [[ "${set_status}" == COMPLETE || "${set_status}" == STOPPED_BY_USER ]]; then
  [[ "${w1_is_suspended}" -eq 1 || "${w1_is_restored}" -eq 1 ]] ||
    fail "terminal VSB state requires exact suspended or restored W1-I03"
else
  [[ "${w1_is_suspended}" -eq 1 ]] || fail "VSB in progress requires exact W1-I03 suspension"
fi
if ! "${wave1_verifier}" \
  --repo-root "${repo_root}" \
  --cards-dir "${repo_root}/docs/task-cards/wave-1-implementation" >/dev/null 2>&1; then
  fail "Wave 1 static suspension validation failed"
fi

if [[ "${execution_state_version}" == 1 ]]; then
  repository_head="$(git -C "${repo_root}" rev-parse HEAD 2>/dev/null)" ||
    fail "repository HEAD is unavailable"
  if git -C "${repo_root}" merge-base --is-ancestor \
      "${governance_repair_origin_sha}" "${repository_head}" 2>/dev/null &&
     [[ "${repository_head}" != "${governance_repair_origin_sha}" ]]; then
    head_ledger_blob="$(git -C "${repo_root}" rev-parse \
      "${repository_head}:${ledger_path}" 2>/dev/null)" ||
      fail "governance repair candidate ledger is missing"
    working_ledger_blob="$(git hash-object "${state_file}")" ||
      fail "working governance repair ledger cannot be read"
    if [[ "${working_ledger_blob}" == "${head_ledger_blob}" ]]; then
      validate_governance_repair_chain "${repository_head}"
      governance_repair_status_output=PENDING
    fi
  fi
fi

if [[ -n "${transition_base}" ]]; then
  resolved_base="$(git -C "${repo_root}" rev-parse --verify "${transition_base}^{commit}" 2>/dev/null)" ||
    fail "transition BASE is not a commit"
  resolved_head="$(git -C "${repo_root}" rev-parse --verify "${transition_head}^{commit}" 2>/dev/null)" ||
    fail "transition HEAD is not a commit"
  [[ "${resolved_head}" != "${governance_repair_origin_sha}" ]] ||
    fail "fixed governance repair origin is not a valid ordinary VSB receipt"
  [[ "${resolved_head}" != "${verifier_recovery_origin_sha}" ]] ||
    fail "fixed verifier-recovery origin is not a valid ordinary VSB receipt"
  [[ "$(single_parent_of "${resolved_head}" "transition HEAD")" == "${resolved_base}" ]] ||
    fail "transition HEAD must be the direct child of BASE"
  ledger_path="docs/task-cards/visual-style-baseline/execution-state.md"
  diff_paths="$(git -C "${repo_root}" diff --name-only "${resolved_base}..${resolved_head}")"
  [[ "${diff_paths}" == "${ledger_path}" ]] ||
    fail "state transition fixed diff must contain only execution-state.md"
  transition_ledger_dir="$(
    mktemp -d "${verifier_tmp_root}/transition-ledgers.XXXXXX"
  )"
  temporary_paths+=("${transition_ledger_dir}")
  base_ledger_file="${transition_ledger_dir}/base-ledger"
  head_ledger_file="${transition_ledger_dir}/head-ledger"
  if ! git -C "${repo_root}" show "${resolved_base}:${ledger_path}" > \
    "${base_ledger_file}" 2>/dev/null; then
    fail "transition BASE ledger is missing"
  fi
  if ! git -C "${repo_root}" show "${resolved_head}:${ledger_path}" > \
    "${head_ledger_file}" 2>/dev/null; then
    fail "transition HEAD ledger is missing"
  fi
  require_nul_free_file \
    "${base_ledger_file}" "transition ledger must not contain NUL bytes"
  require_nul_free_file \
    "${head_ledger_file}" "transition ledger must not contain NUL bytes"
  cmp -s "${state_file}" "${head_ledger_file}" ||
    fail "working ledger must match transition HEAD tree"
  [[ "$(state_value_from_file "${head_ledger_file}" TransitionBaseSHA)" == "${resolved_base}" ]] ||
    fail "TransitionBaseSHA must equal the fixed transition BASE"
  base_sequence="$(state_value_from_file "${base_ledger_file}" TransitionSequence)"
  head_sequence="$(state_value_from_file "${head_ledger_file}" TransitionSequence)"
  [[ "${base_sequence}" =~ ^[0-9]+$ && "${head_sequence}" -eq $((base_sequence + 1)) ]] ||
    fail "TransitionSequence must increment by exactly one"
  head_kind="$(state_value_from_file "${head_ledger_file}" TransitionKind)"
  if [[ "${head_kind}" == GOVERNANCE_REPAIR ]]; then
    validate_governance_repair_transition_files \
      "${resolved_base}" "${resolved_head}" \
      "${base_ledger_file}" "${head_ledger_file}"
    printf '%s\n' \
      'VisualStyleBaselineTaskCardValidation = PASS' \
      'TaskCardCount = 4' \
      "TaskCardSetStatus = ${set_status}" \
      "ActiveTaskCard = ${active}" \
      'GovernanceRepairStatus = PASS'
    exit 0
  fi
  validate_fixed_vsb_tree "${resolved_base}"
  immutable_transition_fields=(
    CanonicalProjectName TaskCardSet ExecutionStateVersion ExecutionStateAuthority
    ApprovedSpecSHA GovernanceReviewRoute SetAuthorizationStatus SetAuthorizationScope
    HumanCheckpointRequirement FrozenWave1TaskCard FrozenWave1CandidateSHA
    HistoricalVisualEvidenceBaselineSHA FullProductImplementation FormalDatabaseWrite RemotePush
  )
  for immutable_field in "${immutable_transition_fields[@]}"; do
    [[ "$(state_value_from_file "${head_ledger_file}" "${immutable_field}")" == \
       "$(state_value_from_file "${base_ledger_file}" "${immutable_field}")" ]] ||
      fail "state transition must preserve ${immutable_field}"
  done
  if [[ "$(state_value_from_file "${base_ledger_file}" ExecutionStateVersion)" == 2 ]]; then
    require_repair_fields_unchanged_between_files \
      "${base_ledger_file}" "${head_ledger_file}"
  elif [[ "$(state_value_from_file "${base_ledger_file}" ExecutionStateVersion)" == 3 ]]; then
    require_repair_fields_unchanged_between_files \
      "${base_ledger_file}" "${head_ledger_file}"
    require_receipt_correction_fields_unchanged_between_files \
      "${base_ledger_file}" "${head_ledger_file}"
  elif [[ "$(state_value_from_file "${base_ledger_file}" ExecutionStateVersion)" == 4 ]]; then
    require_repair_fields_unchanged_between_files \
      "${base_ledger_file}" "${head_ledger_file}"
    require_receipt_correction_fields_unchanged_between_files \
      "${base_ledger_file}" "${head_ledger_file}"
    require_verifier_recovery_fields_unchanged_between_files \
      "${base_ledger_file}" "${head_ledger_file}"
  fi
  if [[ "${head_kind}" != ACTIVATE_SET ]]; then
    for governance_field in GovernanceBootstrapStatus GovernanceReviewedCandidateSHA GovernanceReviewVerdict; do
      [[ "$(state_value_from_file "${head_ledger_file}" "${governance_field}")" == \
         "$(state_value_from_file "${base_ledger_file}" "${governance_field}")" ]] ||
        fail "state transition must preserve ${governance_field}"
    done
  fi
  if [[ "${head_kind}" != STOP_BY_USER ]]; then
    [[ "$(state_value_from_file "${head_ledger_file}" UserStopAuthorization)" == \
       "$(state_value_from_file "${base_ledger_file}" UserStopAuthorization)" ]] ||
      fail "state transition must preserve UserStopAuthorization"
  fi
  case "${head_kind}" in
    ACTIVATE_SET)
      [[ "$(state_value_from_file "${base_ledger_file}" TaskCardSetStatus)" == USER_AUTHORIZED_AWAITING_GOVERNANCE_REVIEW ]] ||
        fail "ACTIVATE_SET must start from the governance-review bootstrap state"
      [[ "$(state_value_from_file "${head_ledger_file}" GovernanceReviewedCandidateSHA)" == "${resolved_base}" ]] ||
        fail "activation candidate must equal TransitionBaseSHA"
      for receipt_index in 0 1 2 3; do
        require_receipt_empty_in_file \
          "${base_ledger_file}" "${receipt_index}" \
          "ACTIVATE_SET base must have empty per-card receipts"
      done
      ;;
    ADVANCE|COMPLETE)
      [[ "$(state_value_from_file "${head_ledger_file}" CurrentCandidateSHA)" == "${resolved_base}" ]] ||
        fail "reviewed candidate must be the candidate chain tip"
      [[ "$(state_value_from_file "${base_ledger_file}" TaskCardSetStatus)" == IN_PROGRESS ]] ||
        fail "ADVANCE or COMPLETE must start from IN_PROGRESS"
      base_completed="$(state_value_from_file "${base_ledger_file}" CompletedTaskCards)"
      base_active="$(state_value_from_file "${base_ledger_file}" ActiveTaskCard)"
      head_completed="$(state_value_from_file "${head_ledger_file}" CompletedTaskCards)"
      case "${base_active}" in
        VSB-00) candidate_owner_index=0 ;;
        VSB-01) candidate_owner_index=1 ;;
        VSB-02) candidate_owner_index=2 ;;
        VSB-03) candidate_owner_index=3 ;;
        *) fail "candidate transition BASE must name one active Owner" ;;
      esac
      verify_candidate_write_set "${resolved_base}" "${candidate_owner_index}"
      verify_candidate_parent_receipt "${resolved_base}"
      for receipt_index in 0 1 2 3; do
        if [[ "${receipt_index}" -lt "${candidate_owner_index}" ]]; then
          require_receipt_unchanged_between_files \
            "${base_ledger_file}" "${head_ledger_file}" "${receipt_index}" \
            "${head_kind} must preserve every predecessor receipt"
        elif [[ "${receipt_index}" -eq "${candidate_owner_index}" ]]; then
          require_receipt_empty_in_file \
            "${base_ledger_file}" "${receipt_index}" \
            "${head_kind} must fill only the just-completed Owner receipt"
        else
          require_receipt_unchanged_between_files \
            "${base_ledger_file}" "${head_ledger_file}" "${receipt_index}" \
            "${head_kind} must preserve every successor receipt"
        fi
      done
      if [[ "${head_kind}" == ADVANCE ]]; then
        case "${base_active}" in
          VSB-00) expected_base_prefix=NONE; expected_head_prefix=VSB-00; expected_head_active=VSB-01 ;;
          VSB-01) expected_base_prefix=VSB-00; expected_head_prefix=VSB-00,VSB-01; expected_head_active=VSB-02 ;;
          VSB-02) expected_base_prefix=VSB-00,VSB-01; expected_head_prefix=VSB-00,VSB-01,VSB-02; expected_head_active=VSB-03 ;;
          *) fail "ADVANCE must complete the unique active predecessor" ;;
        esac
        [[ "${base_completed}" == "${expected_base_prefix}" && "${head_completed}" == "${expected_head_prefix}" && "$(state_value_from_file "${head_ledger_file}" ActiveTaskCard)" == "${expected_head_active}" && "$(state_value_from_file "${head_ledger_file}" ReleasedTaskCard)" == "${expected_head_active}" ]] ||
          fail "ADVANCE must extend the completed prefix by exactly the active card"
      else
        [[ "${base_active}" == VSB-03 && "${base_completed}" == VSB-00,VSB-01,VSB-02 && "${head_completed}" == VSB-00,VSB-01,VSB-02,VSB-03 ]] ||
          fail "COMPLETE must close VSB-03 after the exact predecessor prefix"
      fi
      ;;
    RETURN_TO_OWNER)
      [[ "$(state_value_from_file "${head_ledger_file}" CurrentCandidateSHA)" == "${resolved_base}" ]] ||
        fail "reviewed candidate must be the candidate chain tip"
      [[ "$(state_value_from_file "${base_ledger_file}" TaskCardSetStatus)" == IN_PROGRESS ]] ||
        fail "RETURN_TO_OWNER must start from IN_PROGRESS"
      head_owner="$(state_value_from_file "${head_ledger_file}" Owner)"
      base_owner="$(state_value_from_file "${base_ledger_file}" ActiveTaskCard)"
      return_owner_index="$(owner_index_from_id "${head_owner}")"
      failed_owner_index="$(owner_index_from_id "${base_owner}")"
      [[ "${return_owner_index}" -le "${failed_owner_index}" ]] ||
        fail "RETURN_TO_OWNER target must be the base active Owner or a strict predecessor"
      verify_candidate_write_set "${resolved_base}" "${failed_owner_index}"
      verify_candidate_parent_receipt "${resolved_base}"
      [[ "$(completed_count_from_file "${base_ledger_file}")" -eq "${failed_owner_index}" ]] ||
        fail "RETURN_TO_OWNER base active Owner must match its completed prefix"
      [[ "$(state_value_from_file "${head_ledger_file}" CurrentGateStatus)" == FAIL &&
         "$(state_value_from_file "${head_ledger_file}" CurrentReviewRoute)" == "${expected_routes[${failed_owner_index}]}" ]] ||
        fail "RETURN_TO_OWNER current review route must match the base active Owner"
      for receipt_index in 0 1 2 3; do
        if [[ "${receipt_index}" -ge "${failed_owner_index}" ]]; then
          require_receipt_empty_in_file \
            "${base_ledger_file}" "${receipt_index}" \
            "RETURN_TO_OWNER base active Owner and successor receipts must be empty"
        fi
      done
      case "${head_owner}" in
        VSB-00) expected_return_prefix=NONE; expected_return_next=VSB-01 ;;
        VSB-01) expected_return_prefix=VSB-00; expected_return_next=VSB-02 ;;
        VSB-02) expected_return_prefix=VSB-00,VSB-01; expected_return_next=VSB-03 ;;
        VSB-03) expected_return_prefix=VSB-00,VSB-01,VSB-02; expected_return_next=NONE ;;
        *) fail "RETURN_TO_OWNER must reopen a known owner" ;;
      esac
      [[ "$(state_value_from_file "${head_ledger_file}" ActiveTaskCard)" == "${head_owner}" &&
         "$(state_value_from_file "${head_ledger_file}" ReleasedTaskCard)" == "${head_owner}" &&
         "$(state_value_from_file "${head_ledger_file}" CompletedTaskCards)" == "${expected_return_prefix}" &&
         "$(state_value_from_file "${head_ledger_file}" NextTaskCard)" == "${expected_return_next}" ]] ||
        fail "RETURN_TO_OWNER must reopen owner, truncate to its strict predecessor prefix, and select its successor"
      is_nonzero_finding_verdict "$(state_value_from_file "${head_ledger_file}" CurrentReviewVerdict)" ||
        fail "finding verdict must contain at least one non-zero count"
      for receipt_index in 0 1 2 3; do
        if [[ "${receipt_index}" -lt "${return_owner_index}" ]]; then
          require_receipt_unchanged_between_files \
            "${base_ledger_file}" "${head_ledger_file}" "${receipt_index}" \
            "RETURN_TO_OWNER must preserve strict predecessor receipts"
        else
          require_receipt_empty_in_file \
            "${head_ledger_file}" "${receipt_index}" \
            "RETURN_TO_OWNER must reset Owner and successor receipts"
        fi
      done
      ;;
    STOP_BY_USER)
      [[ "$(state_value_from_file "${head_ledger_file}" UserStopAuthorization)" == EXPLICIT_USER_INSTRUCTION ]] ||
        fail "STOP_BY_USER requires explicit user instruction"
      base_status="$(state_value_from_file "${base_ledger_file}" TaskCardSetStatus)"
      case "${base_status}" in
        IN_PROGRESS|FINAL_NO_GO) ;;
        *) fail "STOP_BY_USER must start from IN_PROGRESS or FINAL_NO_GO" ;;
      esac
      [[ "$(state_value_from_file "${head_ledger_file}" CompletedTaskCards)" == \
         "$(state_value_from_file "${base_ledger_file}" CompletedTaskCards)" ]] ||
        fail "STOP_BY_USER must preserve the reviewed completed prefix"
      stop_completed_count="$(completed_count_from_file "${base_ledger_file}")"
      if [[ "${base_status}" == IN_PROGRESS ]]; then
        case "${stop_completed_count}" in
          0) expected_stop_owner=VSB-00 ;;
          1) expected_stop_owner=VSB-01 ;;
          2) expected_stop_owner=VSB-02 ;;
          3) expected_stop_owner=VSB-03 ;;
          *) fail "STOP_BY_USER active base cannot have every card complete" ;;
        esac
        [[ "$(state_value_from_file "${base_ledger_file}" ActiveTaskCard)" == "${expected_stop_owner}" ]] ||
          fail "STOP_BY_USER base active Owner must match its completed prefix"
      fi
      for receipt_index in 0 1 2 3; do
        if [[ "${receipt_index}" -lt "${stop_completed_count}" ]]; then
          require_receipt_unchanged_between_files \
            "${base_ledger_file}" "${head_ledger_file}" "${receipt_index}" \
            "STOP_BY_USER must preserve strict predecessor receipts"
        else
          require_receipt_empty_in_file \
            "${base_ledger_file}" "${receipt_index}" \
            "STOP_BY_USER base Owner and successor receipts must be empty"
          require_receipt_empty_in_file \
            "${head_ledger_file}" "${receipt_index}" \
            "STOP_BY_USER must reset interrupted Owner and successor receipts"
        fi
      done
      ;;
    FINAL_NO_GO)
      [[ "$(state_value_from_file "${base_ledger_file}" TaskCardSetStatus)" == IN_PROGRESS ]] ||
        fail "FINAL_NO_GO must start from IN_PROGRESS"
      final_owner="$(state_value_from_file "${base_ledger_file}" ActiveTaskCard)"
      expected_pair_final_route=deep_reviewer+ultra_gatekeeper
      if [[ "${model_route_schema_current}" -eq 1 &&
            "$(state_value_from_file "${head_ledger_file}" ExecutionStateVersion)" =~ ^(3|4)$ ]]; then
        expected_pair_final_route=deep_reviewer
      fi
      [[ "${final_owner}" == VSB-03 &&
         "$(state_value_from_file "${head_ledger_file}" CurrentReviewRoute)" == \
           "${expected_pair_final_route}" ]] ||
        fail "FINAL_NO_GO is allowed only for VSB-03 fixed visual acceptance"
      final_owner_index="$(owner_index_from_id "${final_owner}")"
      [[ "$(completed_count_from_file "${base_ledger_file}")" -eq "${final_owner_index}" ]] ||
        fail "FINAL_NO_GO base active Owner must match its completed prefix"
      require_receipt_empty_in_file \
        "${base_ledger_file}" "${final_owner_index}" \
        "FINAL_NO_GO base active Owner receipt must be empty"
      verify_candidate_write_set "${resolved_base}" "${final_owner_index}"
      verify_candidate_parent_receipt "${resolved_base}"
      [[ "$(state_value_from_file "${head_ledger_file}" TaskCardSetStatus)" == FINAL_NO_GO &&
         "$(state_value_from_file "${head_ledger_file}" ActiveTaskCard)" == NONE &&
         "$(state_value_from_file "${head_ledger_file}" ReleasedTaskCard)" == NONE &&
         "$(state_value_from_file "${head_ledger_file}" NextTaskCard)" == NONE &&
         "$(state_value_from_file "${head_ledger_file}" CompletedTaskCards)" == "$(state_value_from_file "${base_ledger_file}" CompletedTaskCards)" &&
         "$(state_value_from_file "${head_ledger_file}" CurrentCandidateSHA)" == "${resolved_base}" &&
         "$(state_value_from_file "${head_ledger_file}" CurrentGateStatus)" == FAIL ]] ||
        fail "FINAL_NO_GO transition fields mismatch"
      is_nonzero_finding_verdict "$(state_value_from_file "${head_ledger_file}" CurrentReviewVerdict)" ||
        fail "FINAL_NO_GO requires a non-zero finding verdict"
      if [[ "${model_route_schema_current}" -eq 1 &&
            "$(state_value_from_file "${head_ledger_file}" ExecutionStateVersion)" =~ ^(3|4)$ ]]; then
        for receipt_index in 0 1 2; do
          require_receipt_unchanged_between_files \
            "${base_ledger_file}" "${head_ledger_file}" "${receipt_index}" \
            "FINAL_NO_GO must preserve predecessor receipts"
        done
        require_receipt_empty_in_file \
          "${base_ledger_file}" 3 \
          "FINAL_NO_GO base VSB-03 receipt must be empty"
        [[ "$(state_value_from_file "${head_ledger_file}" VSB03CandidateSHA)" == \
             "${resolved_base}" &&
           "$(state_value_from_file "${head_ledger_file}" VSB03GateStatus)" == FAIL &&
           "$(state_value_from_file "${head_ledger_file}" VSB03ReviewRoute)" == deep_reviewer &&
           "$(state_value_from_file "${head_ledger_file}" VSB03DeepReviewVerdict)" == \
             "$(state_value_from_file "${head_ledger_file}" CurrentReviewVerdict)" &&
           "$(state_value_from_file "${head_ledger_file}" VSB03UltraReviewVerdict)" == NOT_RUN ]] ||
          fail "FINAL_NO_GO must atomically record the current VSB-03 final finding"
      else
        for receipt_index in 0 1 2 3; do
          require_receipt_unchanged_between_files \
            "${base_ledger_file}" "${head_ledger_file}" "${receipt_index}" \
            "FINAL_NO_GO must preserve all per-card receipts"
        done
      fi
      ;;
    *) fail "unsupported transition kind: ${head_kind}" ;;
  esac
fi

printf '%s\n' \
  'VisualStyleBaselineTaskCardValidation = PASS' \
  'TaskCardCount = 4' \
  "TaskCardSetStatus = ${set_status}" \
  "ActiveTaskCard = ${active}"
if [[ -n "${governance_repair_status_output}" ]]; then
  printf 'GovernanceRepairStatus = %s\n' \
    "${governance_repair_status_output}"
fi
if [[ -n "${receipt_correction_status_output}" ]]; then
  printf 'ReceiptCorrectionStatus = %s\n' \
    "${receipt_correction_status_output}"
fi
if [[ -n "${verifier_recovery_status_output}" ]]; then
  printf 'VerifierRecoveryStatus = %s\n' \
    "${verifier_recovery_status_output}"
fi
