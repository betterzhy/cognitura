        'I00、I01、I02、I03、I04、I05、I06 和 I07 已关闭；I08 已释放为唯一 `READY` 业务卡，I09 保持 `QUEUED`。' \
        'I00、I01、I02、I03、I04、I05、I06、I07 和 I08 已关闭；I09 已释放为唯一 `READY` 业务卡。' "${path}"
      ;;
    docs/task-cards/wave-1-implementation/README.md)
      replace_w1_i08_expected_text "${output_file}" 'ActiveTaskCard = W1-I08' \
        'ActiveTaskCard = W1-I09' "${path}"
      replace_w1_i08_expected_text "${output_file}" \
        '| `W1-I08` | [稳定引用与 lineage](W1-I08-stable-reference-reparse-lineage.md) | `READY` | `W1-I07` | `W1-IG8` | `HIGH` |' \
        '| `W1-I08` | [稳定引用与 lineage](W1-I08-stable-reference-reparse-lineage.md) | `DONE` | `W1-I07` | `W1-IG8` | `HIGH` |' "${path}"
      replace_w1_i08_expected_text "${output_file}" \
        '| `W1-I09` | [上传与处理命令](W1-I09-upload-processing-command-api.md) | `QUEUED` | `W1-I07` | `W1-IG9` | `HIGH` |' \
        '| `W1-I09` | [上传与处理命令](W1-I09-upload-processing-command-api.md) | `READY` | `W1-I07` | `W1-IG9` | `HIGH` |' "${path}"
      replace_w1_i08_expected_text "${output_file}" \
        '完成零发现深审并关闭；I02、I03、I04、I05、I06 和 I07 已关闭，I08 已释放为唯一 `READY` 卡，I09 保持 `QUEUED`。' \
        '完成零发现深审并关闭；I02、I03、I04、I05、I06、I07 和 I08 已关闭，I09 已释放为唯一 `READY` 卡。' "${path}"
      ;;
    "${w1_i08_card_path}")
      replace_w1_i08_expected_text "${output_file}" 'Status = READY' \
        'Status = DONE' "${path}"
      ;;
    "${w1_i09_card_path}")
      replace_w1_i08_expected_text "${output_file}" 'Status = QUEUED' \
        'Status = READY' "${path}"
      replace_w1_i08_expected_text "${output_file}" \
        'BusinessImplementationAuthorization = REQUIRED_BEFORE_READY' \
        'BusinessImplementationAuthorization = USER_AUTHORIZED' "${path}"
      ;;
    *) fail "I08_CLOSURE_PROJECTION_MISMATCH:unexpected path:${path}" ;;
  esac
}

require_exact_w1_i08_closure_projection() {
  local governance_tip="$1"
  local receipt="$2"
  local compare_dir path index=0
  register_temporary_directory compare_dir cognitura-i08-closure-projection
  for path in "${w1_i08_closure_projection_paths[@]}"; do
    write_expected_w1_i08_closure_file \
      "${governance_tip}" "${path}" "${compare_dir}/expected-${index}"
    git -C "${repo_root}" show "${receipt}:${path}" > \
      "${compare_dir}/actual-${index}" 2>/dev/null || {
        remove_temporary_directory "${compare_dir}"
        fail "I08_CLOSURE_PROJECTION_MISMATCH:head unavailable:${path}"
      }
    cmp -s "${compare_dir}/expected-${index}" \
      "${compare_dir}/actual-${index}" || {
        remove_temporary_directory "${compare_dir}"
        fail "I08_CLOSURE_PROJECTION_MISMATCH:${path}"
      }
    index=$((index + 1))
  done
  remove_temporary_directory "${compare_dir}"
}

validate_w1_i08_closure_receipt() {
  local governance_tip="$1"
  local receipt="$2"
  local actual_paths expected_paths path base_mode head_mode index_content
  [[ "$(single_parent_of "${receipt}" \
    "I08_CLOSURE_RECEIPT_PATHS_INVALID:direct child")" == "${governance_tip}" ]] ||
    fail "I08_CLOSURE_RECEIPT_PATHS_INVALID:direct child"
  validate_w1_i08_closure_correction_chain "${governance_tip}"
  require_no_git_rename_or_copy "${governance_tip}" "${receipt}" \
    "I08_CLOSURE_RECEIPT_PATHS_INVALID:rename or copy"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${governance_tip}..${receipt}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' \
    "${w1_i08_closure_projection_paths[@]}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I08_CLOSURE_RECEIPT_PATHS_INVALID:exact eleven paths"
  for path in "${w1_i08_closure_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${governance_tip}" "${path}")"
    head_mode="$(git_tree_mode "${receipt}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I08_CLOSURE_RECEIPT_PATHS_INVALID:mode:${path}"
    require_git_blob_without_nul "${receipt}" "${path}" \
      "I08_CLOSURE_RECEIPT_PATHS_INVALID:NUL:${path}"
  done
  [[ "$(git_tree_field "${receipt}" "${w1_i07_card_path}" Status)" == DONE &&
     "$(git_tree_field "${receipt}" "${w1_i08_card_path}" Status)" == DONE &&
     "$(git_tree_field "${receipt}" "${w1_i09_card_path}" Status)" == READY &&
     "$(git_tree_field "${receipt}" "${w1_i10_card_path}" Status)" == BLOCKED_BY_DEPENDENCY &&
     "$(git_tree_field "${receipt}" "${w1_i09_card_path}" \
       BusinessImplementationAuthorization)" == USER_AUTHORIZED &&
     "$(git_tree_field "${receipt}" \
       docs/task-cards/wave-1-implementation/README.md ActiveTaskCard)" == W1-I09 &&
     "$(git_tree_field "${receipt}" \
       docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount)" == 1 ]] ||
    fail "I08_CLOSURE_STATE_VECTOR_INVALID:receipt"
  require_w1_i08_closure_review_receipt "${receipt}" "${governance_tip}"
  require_exact_w1_i08_closure_projection "${governance_tip}" "${receipt}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i08_closure_origin_sha}..${receipt}" -- \
    "${w1_i08_product_paths[@]}" ||
    fail "I08_CLOSURE_PRODUCT_DRIFT:receipt"
}

find_unique_w1_i08_closure_receipt() {
  local head="$1"
  local commit parent vector receipt="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i08_closure_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:receipt provenance")"
    vector="$(git_tree_field "${parent}" "${w1_i08_card_path}" Status):$(git_tree_field \
      "${commit}" "${w1_i08_card_path}" Status):$(git_tree_field \
      "${parent}" "${w1_i09_card_path}" Status):$(git_tree_field \
      "${commit}" "${w1_i09_card_path}" Status)"
    if [[ "${vector}" == READY:DONE:QUEUED:READY ]]; then
      receipt_count=$((receipt_count + 1))
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] ||
    fail "I08_CLOSURE_REVIEW_RECEIPT_INVALID:exactly once"
  printf '%s\n' "${receipt}"
}

validate_post_w1_i08_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  [[ "${receipt}" != "${head}" ]] || return 0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I08_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I08_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:empty commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I08_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i09_descendant_path "${path}" ||
        fail "I08_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:${path}"
    done <<< "${changed_paths}"
  done
}

validate_w1_i08_pending_worktree() {
  local governance_tip="$1"
  local path
  for path in "${w1_i08_closure_governance_paths[@]}" \
      "${w1_i08_closure_correction_paths[@]}" \
      "${w1_i08_closure_projection_paths[@]}" \
      "${w1_i08_product_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${governance_tip}" -- "${path}" ||
      fail "I08_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
}

validate_w1_i08_closed_worktree() {
  local governance_tip="$1"
  local receipt="$2"
  local head="$3"
  local path
  for path in "${w1_i08_closure_governance_paths[@]}" \
      "${w1_i08_closure_correction_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${governance_tip}" -- "${path}" ||
      fail "I08_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
  for path in "${w1_i08_closure_projection_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${receipt}" -- "${path}" ||
      fail "I08_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
  for path in "${w1_i08_product_paths[@]}" "${w1_i09_product_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${head}" -- "${path}" ||
      fail "I08_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
}

validate_w1_i09_runtime_rebaseline_chain() {
  local head="$1"
  local validate_worktree="${2:-1}"
  local commits commit parent changed_paths path expected_path
  local expected_mode expected_blob actual_blob evidence_sha
  local index=0
  local verifier_steps=0

  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i09_runtime_rebaseline_origin_sha}" "${head}" ||
    fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:origin"
  commits="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i09_runtime_rebaseline_origin_sha}..${head}")"
  for commit in ${commits}; do
    parent="$(single_parent_of "${commit}" \
      "I09_RUNTIME_REBASELINE_CHAIN_INVALID:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I09_RUNTIME_REBASELINE_CHAIN_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:exact path"
    path="$(printf '%s\n' "${changed_paths}" | awk 'NF { print; exit }')"
    if [[ "${index}" -lt 3 ]]; then
      expected_path="${w1_i09_runtime_rebaseline_paths[${index}]}"
    else
      case "${path}" in
        "${w1_i09_runtime_rebaseline_paths[2]}")
          expected_path="${w1_i09_runtime_rebaseline_paths[2]}"
          ;;
        "${w1_i09_runtime_rebaseline_paths[3]}")
          expected_path="${w1_i09_runtime_rebaseline_paths[3]}"
          verifier_steps=$((verifier_steps + 1))
          ;;
        *) fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:order" ;;
      esac
    fi
    [[ "${path}" == "${expected_path}" ]] ||
      fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:order"
    case "${path}" in
      scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
      *) expected_mode=100644 ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${path}")" == "${expected_mode}" ]] ||
      fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${path}" \
      "I09_RUNTIME_REBASELINE_CHAIN_INVALID:NUL"
    if [[ "${index}" -lt "${#w1_i09_runtime_rebaseline_evidence_shas[@]}" ]]; then
      evidence_sha="${w1_i09_runtime_rebaseline_evidence_shas[${index}]}"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${evidence_sha}:${path}" 2>/dev/null)" ||
        fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:evidence"
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${path}" 2>/dev/null)" ||
        fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:evidence"
    fi
    index=$((index + 1))
  done
  [[ "${index}" -ge "${#w1_i09_runtime_rebaseline_paths[@]}" ]] ||
    fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:order"
  [[ "${verifier_steps}" -ge 1 ]] ||
    fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:order"
  git -C "${repo_root}" diff --quiet \
    "${w1_i09_runtime_rebaseline_origin_sha}..${head}" -- \
    "${w1_i08_product_paths[@]}" "${w1_i08_closure_projection_paths[@]}" ||
    fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:I08 drift"
  if [[ "${validate_worktree}" == 1 ]]; then
    for path in "${w1_i09_runtime_rebaseline_paths[@]}"; do
      git -C "${repo_root}" diff --quiet "${head}" -- "${path}" ||
        fail "I09_RUNTIME_REBASELINE_CHAIN_INVALID:worktree:${path}"
    done
  fi
}

is_w1_i09_runtime_product_path() {
  local requested="$1"
  local allowed
  for allowed in "${w1_i09_runtime_product_paths[@]}"; do
    [[ "${requested}" == "${allowed}" ]] && return 0
  done
  return 1
}

validate_w1_i09_runtime_repair_chain() {
  local head="$1"
  local commits commit parent changed_paths path expected_path
  local expected_mode expected_blob actual_blob evidence_sha repair_tip=""
  local index=0

  [[ "$(git -C "${repo_root}" rev-parse \
      "${w1_i09_runtime_rejected_candidate_sha}^" 2>/dev/null)" == \
      "${w1_i09_runtime_rejected_parent_sha}" ]] ||
    fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:rejected parent"
  [[ "$(git -C "${repo_root}" rev-parse \
      "${w1_i09_runtime_rejected_candidate_sha}^{tree}" 2>/dev/null)" == \
      "${w1_i09_runtime_rejected_tree_sha}" ]] ||
    fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:rejected tree"
  validate_w1_i09_runtime_rebaseline_chain \
    "${w1_i09_runtime_rejected_candidate_sha}" 0
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i09_runtime_rejected_candidate_sha}" "${head}" ||
    fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:origin"
  commits="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i09_runtime_rejected_candidate_sha}..${head}" | head -n 3)"
  for commit in ${commits}; do
    [[ "${index}" -lt "${#w1_i09_runtime_repair_paths[@]}" ]] ||
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:order"
    parent="$(single_parent_of "${commit}" \
      "I09_RUNTIME_REBASELINE_REPAIR_INVALID:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I09_RUNTIME_REBASELINE_REPAIR_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:exact path"
    path="$(printf '%s\n' "${changed_paths}" | awk 'NF { print; exit }')"
    expected_path="${w1_i09_runtime_repair_paths[${index}]}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:order"
    case "${path}" in
      scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
      *) expected_mode=100644 ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${path}")" == "${expected_mode}" ]] ||
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${path}" \
      "I09_RUNTIME_REBASELINE_REPAIR_INVALID:NUL"
    if [[ "${index}" -lt "${#w1_i09_runtime_repair_evidence_shas[@]}" ]]; then
      evidence_sha="${w1_i09_runtime_repair_evidence_shas[${index}]}"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${evidence_sha}:${path}" 2>/dev/null)" ||
        fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:evidence"
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${path}" 2>/dev/null)" ||
        fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:evidence"
    fi
    repair_tip="${commit}"
    index=$((index + 1))
  done
  [[ "${index}" -eq "${#w1_i09_runtime_repair_paths[@]}" ]] ||
    fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:order"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
      "${repair_tip}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I09_RUNTIME_REBASELINE_REPAIR_INVALID:verifier correction parent")"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    if [[ "${changed_paths}" != "${w1_i09_runtime_repair_paths[2]}" ]]; then
      break
    fi
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:empty verifier correction"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I09_RUNTIME_REBASELINE_REPAIR_INVALID:verifier correction rename or copy"
    [[ "$(git_tree_mode "${commit}" "${changed_paths}")" == 100755 ]] ||
      fail "I09_RUNTIME_REBASELINE_REPAIR_INVALID:verifier correction mode"
    require_git_blob_without_nul "${commit}" "${changed_paths}" \
      "I09_RUNTIME_REBASELINE_REPAIR_INVALID:verifier correction NUL"
    repair_tip="${commit}"
  done
  if [[ "${repair_tip}" == \
      "${w1_i09_runtime_boundary_rejected_candidate_sha}" ]] &&
      [[ "${head}" != "${repair_tip}" ]]; then
    [[ "$(git -C "${repo_root}" rev-parse \
        "${w1_i09_runtime_boundary_rejected_candidate_sha}^" 2>/dev/null)" == \
        "${w1_i09_runtime_boundary_rejected_parent_sha}" ]] ||
      fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:rejected parent"
    [[ "$(git -C "${repo_root}" rev-parse \
        "${w1_i09_runtime_boundary_rejected_candidate_sha}^{tree}" 2>/dev/null)" == \
        "${w1_i09_runtime_boundary_rejected_tree_sha}" ]] ||
      fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:rejected tree"
    index=0
    commits="$(git -C "${repo_root}" rev-list --first-parent --reverse \
      "${w1_i09_runtime_boundary_rejected_candidate_sha}..${head}" | head -n 3)"
    for commit in ${commits}; do
      [[ "${index}" -lt "${#w1_i09_runtime_boundary_repair_paths[@]}" ]] ||
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:order"
      parent="$(single_parent_of "${commit}" \
        "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:single parent")"
      git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:empty"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:rename or copy"
      changed_paths="$(git -C "${repo_root}" diff --name-only \
        "${parent}..${commit}")"
      [[ "$(printf '%s\n' "${changed_paths}" | awk \
        'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:exact path"
      path="$(printf '%s\n' "${changed_paths}" | awk 'NF { print; exit }')"
      expected_path="${w1_i09_runtime_boundary_repair_paths[${index}]}"
      [[ "${path}" == "${expected_path}" ]] ||
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:order"
      case "${path}" in
        scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
        *) expected_mode=100644 ;;
      esac
      [[ "$(git_tree_mode "${commit}" "${path}")" == "${expected_mode}" ]] ||
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${path}" \
        "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:NUL"
      if [[ "${index}" -lt \
          "${#w1_i09_runtime_boundary_repair_evidence_shas[@]}" ]]; then
        evidence_sha="${w1_i09_runtime_boundary_repair_evidence_shas[${index}]}"
        expected_blob="$(git -C "${repo_root}" rev-parse \
          "${evidence_sha}:${path}" 2>/dev/null)" ||
          fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:evidence"
        actual_blob="$(git -C "${repo_root}" rev-parse \
          "${commit}:${path}" 2>/dev/null)" ||
          fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:evidence"
        [[ "${actual_blob}" == "${expected_blob}" ]] ||
          fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:evidence"
      fi
      repair_tip="${commit}"
      index=$((index + 1))
    done
    [[ "${index}" -eq "${#w1_i09_runtime_boundary_repair_paths[@]}" ]] ||
      fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:order"
    for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
        "${repair_tip}..${head}"); do
      parent="$(single_parent_of "${commit}" \
        "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:verifier correction parent")"
      changed_paths="$(git -C "${repo_root}" diff --name-only \
        "${parent}..${commit}")"
      if [[ "${changed_paths}" != \
          "${w1_i09_runtime_boundary_repair_paths[2]}" ]]; then
        break
      fi
      git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:empty verifier correction"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:verifier correction rename or copy"
      [[ "$(git_tree_mode "${commit}" "${changed_paths}")" == 100755 ]] ||
        fail "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:verifier correction mode"
      require_git_blob_without_nul "${commit}" "${changed_paths}" \
        "I09_RUNTIME_REBASELINE_BOUNDARY_REPAIR_INVALID:verifier correction NUL"
      repair_tip="${commit}"
    done
  fi
  if [[ "${repair_tip}" == \
      "${w1_i09_runtime_large_blob_rejected_candidate_sha}" ]] &&
      [[ "${head}" != "${repair_tip}" ]]; then
    [[ "$(git -C "${repo_root}" rev-parse \
        "${w1_i09_runtime_large_blob_rejected_candidate_sha}^" 2>/dev/null)" == \
        "${w1_i09_runtime_large_blob_rejected_parent_sha}" ]] ||
      fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:rejected parent"
    [[ "$(git -C "${repo_root}" rev-parse \
        "${w1_i09_runtime_large_blob_rejected_candidate_sha}^{tree}" 2>/dev/null)" == \
        "${w1_i09_runtime_large_blob_rejected_tree_sha}" ]] ||
      fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:rejected tree"
    index=0
    commits="$(git -C "${repo_root}" rev-list --first-parent --reverse \
      "${w1_i09_runtime_large_blob_rejected_candidate_sha}..${head}" | head -n 3)"
    for commit in ${commits}; do
      [[ "${index}" -lt "${#w1_i09_runtime_large_blob_repair_paths[@]}" ]] ||
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:order"
      parent="$(single_parent_of "${commit}" \
        "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:single parent")"
      git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:empty"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:rename or copy"
      changed_paths="$(git -C "${repo_root}" diff --name-only \
        "${parent}..${commit}")"
      [[ "$(printf '%s\n' "${changed_paths}" | awk \
        'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:exact path"
      path="$(printf '%s\n' "${changed_paths}" | awk 'NF { print; exit }')"
      expected_path="${w1_i09_runtime_large_blob_repair_paths[${index}]}"
      [[ "${path}" == "${expected_path}" ]] ||
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:order"
      case "${path}" in
        scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
        *) expected_mode=100644 ;;
      esac
      [[ "$(git_tree_mode "${commit}" "${path}")" == "${expected_mode}" ]] ||
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${path}" \
        "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:NUL"
      if [[ "${index}" -lt \
          "${#w1_i09_runtime_large_blob_repair_evidence_shas[@]}" ]]; then
        evidence_sha="${w1_i09_runtime_large_blob_repair_evidence_shas[${index}]}"
        expected_blob="$(git -C "${repo_root}" rev-parse \
          "${evidence_sha}:${path}" 2>/dev/null)" ||
          fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:evidence"
        actual_blob="$(git -C "${repo_root}" rev-parse \
          "${commit}:${path}" 2>/dev/null)" ||
          fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:evidence"
        [[ "${actual_blob}" == "${expected_blob}" ]] ||
          fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:evidence"
      fi
      repair_tip="${commit}"
      index=$((index + 1))
    done
    [[ "${index}" -eq "${#w1_i09_runtime_large_blob_repair_paths[@]}" ]] ||
      fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:order"
    for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
        "${repair_tip}..${head}"); do
      parent="$(single_parent_of "${commit}" \
        "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:verifier correction parent")"
      changed_paths="$(git -C "${repo_root}" diff --name-only \
        "${parent}..${commit}")"
      if [[ "${changed_paths}" != \
          "${w1_i09_runtime_large_blob_repair_paths[2]}" ]]; then
        break
      fi
      git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:empty verifier correction"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:verifier correction rename or copy"
      [[ "$(git_tree_mode "${commit}" "${changed_paths}")" == 100755 ]] ||
        fail "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:verifier correction mode"
      require_git_blob_without_nul "${commit}" "${changed_paths}" \
        "I09_RUNTIME_REBASELINE_LARGE_BLOB_REPAIR_INVALID:verifier correction NUL"
      repair_tip="${commit}"
    done
  fi
  git -C "${repo_root}" diff --quiet \
    "${w1_i09_runtime_rejected_candidate_sha}..${repair_tip}" -- \
    "${w1_i08_product_paths[@]}" "${w1_i08_closure_projection_paths[@]}" ||
    fail "I09_RUNTIME_REBASELINE_I08_DRIFT"
  printf '%s\n' "${repair_tip}"
}

append_w1_i09_runtime_projection_blocks() {
  local destination_root="$1"
  local correction_tip="$2"
  local correction_parent correction_tree
  correction_parent="$(single_parent_of "${correction_tip}" \
    "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:correction parent")"
  correction_tree="$(git -C "${repo_root}" rev-parse \
    "${correction_tip}^{tree}" 2>/dev/null)" ||
    fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:correction tree"
  printf '%s\n' \
    '' \
    '## 10. Wave 1 source binary provider decision' \
    '' \
    '```text' \
    'W1SourceBinaryStorageProvider = LOCAL_CONTENT_ADDRESSED_FILESYSTEM' \
    'W1SourceBinaryProviderScope = SOURCE_BINARY_ONLY' \
    'W1SourceBinaryProviderAuthority = W1_I09_RUNTIME_REBASELINE' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' >> "${destination_root}/docs/engineering/cognitura-technology-baseline.md"
  printf '%s\n' \
    '' \
    '## 16. W1-I09 runtime rebaseline' \
    '' \
    '```text' \
    'W1I09RuntimeRebaseline = PASS' \
    'W1I09RuntimeBoundary = SOURCE_COMMAND_RUNTIME' \
    'W1I09ProductWriteSetCount = 27' \
    'ActiveTaskCard = W1-I09' \
    '```' >> "${destination_root}/docs/engineering/cognitura-design-index.md"
  printf '%s\n' \
    '' \
    '## 8. W1-I09 runtime rebaseline acceptance' \
    '' \
    '```text' \
    'W1I09RuntimeRebaseline = PASS' \
    'ObjectStorageProvider = LOCAL_CONTENT_ADDRESSED_FILESYSTEM' \
    'I09FormalDatabaseGate = PASS' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' >> "${destination_root}/docs/engineering/cognitura-wave-1-design-acceptance.md"
  printf '%s\n' \
    '' \
    '## 16. W1-I09 runtime rebaseline receipt' \
    '' \
    '```text' \
    'W1I09RuntimeRebaseline = PASS' \
    "ReviewedRejectedCandidate = ${w1_i09_runtime_rejected_candidate_sha}" \
    "ReviewedVerifierCorrectionCandidate = ${correction_tip}" \
    "ReviewedVerifierCorrectionParent = ${correction_parent}" \
    "ReviewedVerifierCorrectionTree = ${correction_tree}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'ActiveTaskCard = W1-I09' \
    'TaskCardCount = 14' \
    'ReadyTaskCardCount = 1' \
    'I09ProductWriteSetCount = 27' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' >> "${destination_root}/docs/engineering/cognitura-wave-1-implementation-plan.md"
  awk '
    /^I09_CANONICAL_CARD_BEGIN$/ { capture=1; next }
    /^I09_CANONICAL_CARD_END$/ { capture=0; exit }
    capture { print }
  ' "${destination_root}/${w1_i09_runtime_repair_paths[0]}" > \
    "${destination_root}/${w1_i09_card_path}"
}

validate_w1_i09_runtime_projection() {
  local correction_tip="$1"
  local projection="$2"
  local parent actual_paths expected_paths path expected_root actual_file index=0
  parent="$(single_parent_of "${projection}" \
    "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:direct child")"
  [[ "${parent}" == "${correction_tip}" ]] ||
    fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:direct child"
  require_no_git_rename_or_copy "${correction_tip}" "${projection}" \
    "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:rename or copy"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${correction_tip}..${projection}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' "${w1_i09_runtime_projection_paths[@]}" |
    LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:exact paths"
  register_temporary_directory expected_root cognitura-i09-runtime-projection
  for path in "${w1_i09_runtime_projection_paths[@]}" \
      "${w1_i09_runtime_repair_paths[0]}"; do
    mkdir -p "${expected_root}/$(dirname "${path}")"
    git -C "${repo_root}" show "${correction_tip}:${path}" > \
      "${expected_root}/${path}" ||
      fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:base:${path}"
  done
  append_w1_i09_runtime_projection_blocks \
    "${expected_root}" "${correction_tip}"
  for path in "${w1_i09_runtime_projection_paths[@]}"; do
    [[ "$(git_tree_mode "${projection}" "${path}")" == 100644 ]] ||
      fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:mode"
    require_git_blob_without_nul "${projection}" "${path}" \
      "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:NUL"
    actual_file="${expected_root}/actual-${index}"
    git -C "${repo_root}" show "${projection}:${path}" > "${actual_file}" ||
      fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:content"
    cmp -s "${expected_root}/${path}" "${actual_file}" ||
      fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:content"
    index=$((index + 1))
  done
  remove_temporary_directory "${expected_root}"
}

materialize_w1_i09_canonical_bridge_projection() {
  local bridge_tip="$1"
  local destination_root="$2"
  local path bridge_parent bridge_tree card_file plan_file index_file temporary
  bridge_parent="$(single_parent_of "${bridge_tip}" \
    "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:bridge parent")"
  bridge_tree="$(git -C "${repo_root}" rev-parse \
    "${bridge_tip}^{tree}" 2>/dev/null)" ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:bridge tree"
  for path in "${w1_i09_canonical_bridge_projection_paths[@]}"; do
    mkdir -p "${destination_root}/${path%/*}"
    git -C "${repo_root}" show "${bridge_tip}:${path}" > \
      "${destination_root}/${path}" ||
      fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:source"
  done
  index_file="${destination_root}/${w1_i09_canonical_bridge_projection_paths[0]}"
  plan_file="${destination_root}/${w1_i09_canonical_bridge_projection_paths[1]}"
  card_file="${destination_root}/${w1_i09_canonical_bridge_projection_paths[2]}"
  [[ "$(grep -Fc 'W1I09ProductWriteSetCount = 27' "${index_file}" || true)" -eq 1 ]] ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:index source"
  sed -i.bak 's/W1I09ProductWriteSetCount = 27/W1I09ProductWriteSetCount = 28/' \
    "${index_file}"
  rm "${index_file}.bak"
  [[ "$(grep -Fc 'I09ProductWriteSetCount = 27' "${plan_file}" || true)" -eq 1 ]] ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:plan source"
  sed -i.bak 's/I09ProductWriteSetCount = 27/I09ProductWriteSetCount = 28/' \
    "${plan_file}"
  rm "${plan_file}.bak"
  printf '%s\n' \
    '' \
    '## 17. W1-I09 canonical bytes bridge receipt' \
    '' \
    '```text' \
    'W1I09CanonicalBytesBridge = PASS' \
    "ReviewedCanonicalBridgeCandidate = ${bridge_tip}" \
    "ReviewedCanonicalBridgeParent = ${bridge_parent}" \
    "ReviewedCanonicalBridgeTree = ${bridge_tree}" \
    'I09ProductWriteSetCount = 28' \
    'ProductionFileLimit = 20' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' >> "${plan_file}"
  [[ "$(grep -Fc 'ProductionFileLimit = 19' "${card_file}" || true)" -eq 1 ]] ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:card limit source"
  [[ "$(grep -Fc '暂存清单必须与 27 路径双向一致' "${card_file}" || true)" -eq 1 ]] ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:card count source"
  [[ "$(grep -Fc \
      'WriteSet = server/src/main/java/io/cognitura/source/application/processing/CandidateBlockSet.java' \
      "${card_file}" || true)" -eq 0 ]] ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:duplicate bridge path"
  sed -i.bak \
    -e 's/ProductionFileLimit = 19/ProductionFileLimit = 20/' \
    -e 's/暂存清单必须与 27 路径双向一致/暂存清单必须与 28 路径双向一致/' \
    "${card_file}"
  rm "${card_file}.bak"
  temporary="${destination_root}/card-with-bridge"
  awk -v bridge='WriteSet = server/src/main/java/io/cognitura/source/application/processing/CandidateBlockSet.java' '
    { print }
    $0 == "WriteSet = server/src/main/java/io/cognitura/source/application/command/SourceCommandException.java" {
      print bridge
      inserted++
    }
    END { if (inserted != 1) exit 1 }
  ' "${card_file}" > "${temporary}" ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:card insertion"
  mv "${temporary}" "${card_file}"
}

validate_w1_i09_canonical_bridge_projection() {
  local bridge_tip="$1"
  local projection="$2"
  local parent expected_root expected_paths actual_paths path index=0 actual_file
  parent="$(single_parent_of "${projection}" \
