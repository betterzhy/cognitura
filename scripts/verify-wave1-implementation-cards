      copy_repair_state="POST_FIXTURE_REJECTED_SPEC"
      continue
    fi
    if [[ "${commit}" == "${w1_i09_post_product_fixture_correction_sha}" ]]; then
      [[ "${copy_repair_state}" == "POST_FIXTURE_REJECTED_SPEC" && \
         "${parent}" == "${w1_i09_post_product_fixture_rejected_spec_sha}" ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:order"
      expected_path="${w1_i09_post_product_fixture_paths[1]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:path"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100644 ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:NUL"
      copy_repair_state="POST_FIXTURE_CORRECTION"
      continue
    fi
    if [[ "${commit}" == "${w1_i09_post_product_fixture_test_sha}" ]]; then
      [[ "${copy_repair_state}" == "POST_FIXTURE_CORRECTION" && \
         "${parent}" == "${w1_i09_post_product_fixture_correction_sha}" ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:order"
      expected_path="${w1_i09_post_product_fixture_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:path"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:NUL"
      copy_repair_state="POST_FIXTURE_TEST"
      continue
    fi
    if [[ "${commit}" == "${w1_i09_fixture_diagnostic_spec_sha}" ]]; then
      [[ "${copy_repair_state}" == "POST_FIXTURE_VERIFIER" && \
         "${parent}" == "${w1_i09_fixture_diagnostic_origin_sha}" ]] ||
        fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:order"
      expected_path="${w1_i09_fixture_diagnostic_paths[0]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:path"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100644 ]] ||
        fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:NUL"
      copy_repair_state="FIXTURE_DIAGNOSTIC_SPEC"
      continue
    fi
    if [[ "${commit}" == "${w1_i09_focused_current_spec_sha}" ]]; then
      [[ "${copy_repair_state}" == "FIXTURE_DIAGNOSTIC_VERIFIER" && \
         "${parent}" == "${w1_i09_focused_current_origin_sha}" ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:order"
      expected_path="${w1_i09_focused_current_paths[0]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:path"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_FOCUSED_CURRENT_FINDING_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100644 ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_FOCUSED_CURRENT_FINDING_INVALID:NUL"
      copy_repair_state="FOCUSED_CURRENT_SPEC"
      continue
    fi
    if [[ "${commit}" == "${w1_i09_focused_current_test_sha}" ]]; then
      [[ "${copy_repair_state}" == "FOCUSED_CURRENT_SPEC" && \
         "${parent}" == "${w1_i09_focused_current_spec_sha}" ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:order"
      expected_path="${w1_i09_focused_current_paths[1]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:path"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_FOCUSED_CURRENT_FINDING_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_FOCUSED_CURRENT_FINDING_INVALID:NUL"
      copy_repair_state="FOCUSED_CURRENT_TEST"
      continue
    fi
    if [[ "${copy_repair_state}" == "BRIDGE_TEST" ]]; then
      expected_path="${w1_i09_canonical_bridge_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_CANONICAL_BRIDGE_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_CANONICAL_BRIDGE_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_CANONICAL_BRIDGE_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_CANONICAL_BRIDGE_INVALID:NUL"
      bridge_verifier_steps=1
      copy_repair_state="BRIDGE_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "BRIDGE_VERIFIER" ]]; then
      validate_w1_i09_canonical_bridge_projection "${parent}" "${commit}"
      [[ "${commit}" == "${w1_i09_canonical_bridge_projection_sha}" ]] ||
        fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:identity"
      bridge_projection="${commit}"
      copy_repair_state="BRIDGE_PROJECTED"
      continue
    elif [[ "${copy_repair_state}" == "BRIDGE_FIX_SPEC" ]]; then
      expected_path="${w1_i09_canonical_bridge_freeze_fix_paths[1]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_CANONICAL_BRIDGE_FREEZE_FIX_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_CANONICAL_BRIDGE_FREEZE_FIX_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_CANONICAL_BRIDGE_FREEZE_FIX_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_CANONICAL_BRIDGE_FREEZE_FIX_INVALID:NUL"
      bridge_freeze_fix_steps=1
      copy_repair_state="BRIDGE_FIXED"
      continue
    elif [[ "${copy_repair_state}" == "BRIDGE_SELECTOR_TEST" ]]; then
      expected_path="${w1_i09_canonical_bridge_selector_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_CANONICAL_BRIDGE_SELECTOR_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_CANONICAL_BRIDGE_SELECTOR_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_CANONICAL_BRIDGE_SELECTOR_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_CANONICAL_BRIDGE_SELECTOR_INVALID:NUL"
      bridge_selector_steps=1
      copy_repair_state="BRIDGE_SELECTOR_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "BRIDGE_REVIEW_TEST" ]]; then
      expected_path="${w1_i09_canonical_bridge_review_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_CANONICAL_BRIDGE_REVIEW_FINDING_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_CANONICAL_BRIDGE_REVIEW_FINDING_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_CANONICAL_BRIDGE_REVIEW_FINDING_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_CANONICAL_BRIDGE_REVIEW_FINDING_INVALID:NUL"
      bridge_review_steps=1
      copy_repair_state="BRIDGE_REVIEW_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "V2_COMPAT_TEST" ]]; then
      expected_path="${w1_i09_v2_compatibility_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_V2_COMPATIBILITY_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_V2_COMPATIBILITY_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_V2_COMPATIBILITY_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_V2_COMPATIBILITY_INVALID:NUL"
      v2_compatibility_steps=1
      copy_repair_state="V2_COMPAT_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "V2_COMPAT_VERIFIER" ]]; then
      validate_w1_i09_v2_compatibility_projection "${parent}" "${commit}"
      bridge_projection="${commit}"
      copy_repair_state="V2_COMPAT_PROJECTED"
      continue
    elif [[ "${copy_repair_state}" == "V2_COMPAT_PROJECTED" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "POST_FIXTURE_TEST" ]]; then
      expected_path="${w1_i09_post_product_fixture_paths[3]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:NUL"
      post_product_fixture_steps=1
      copy_repair_state="POST_FIXTURE_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "FIXTURE_DIAGNOSTIC_SPEC" ]]; then
      expected_path="${w1_i09_fixture_diagnostic_paths[1]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:NUL"
      fixture_diagnostic_steps=1
      copy_repair_state="FIXTURE_DIAGNOSTIC_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "FOCUSED_CURRENT_TEST" ]]; then
      expected_path="${w1_i09_focused_current_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_FOCUSED_CURRENT_FINDING_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_FOCUSED_CURRENT_FINDING_INVALID:NUL"
      focused_current_steps=1
      copy_repair_state="FOCUSED_CURRENT_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "FOCUSED_CURRENT_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "FIXTURE_DIAGNOSTIC_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "POST_FIXTURE_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "BRIDGE_REVIEW_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "BRIDGE_SELECTOR_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "BRIDGE_FIXED" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "BRIDGE_PROJECTED" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "BRIDGE_SPEC" ]]; then
      fail "I09_CANONICAL_BRIDGE_INVALID:order"
    fi
    if [[ "${copy_repair_state}" == "REENTRY_TEST" ]]; then
      expected_path="${w1_i09_product_copy_reentry_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:NUL"
      reentry_verifier_steps=1
      copy_repair_state="REENTRY_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "REENTRY_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "REENTRY_SPEC" ]]; then
      fail "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:order"
    fi
    if [[ "${copy_repair_state}" == "FINDING_TEST" ]]; then
      expected_path="${w1_i09_product_copy_finding_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:NUL"
      finding_verifier_steps=1
      copy_repair_state="FINDING_VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "FINDING_VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "FINDING_SPEC" ]]; then
      fail "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:order"
    fi
    if [[ "${copy_repair_state}" == "TEST" ]]; then
      expected_path="${w1_i09_product_copy_repair_paths[2]}"
      [[ "${changed_paths}" == "${expected_path}" ]] ||
        fail "I09_PRODUCT_COPY_REPAIR_INVALID:missing verifier"
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_PRODUCT_COPY_REPAIR_INVALID:rename or copy"
      [[ "$(git_tree_mode "${commit}" "${expected_path}")" == 100755 ]] ||
        fail "I09_PRODUCT_COPY_REPAIR_INVALID:mode"
      require_git_blob_without_nul "${commit}" "${expected_path}" \
        "I09_PRODUCT_COPY_REPAIR_INVALID:NUL"
      verifier_steps=1
      copy_repair_state="VERIFIER"
      continue
    elif [[ "${copy_repair_state}" == "VERIFIER" ]]; then
      copy_repair_state="COMPLETE"
    elif [[ "${copy_repair_state}" == "ORIGIN" || \
            "${copy_repair_state}" == "SPEC" ]]; then
      fail "I09_PRODUCT_COPY_REPAIR_INVALID:order"
    fi

    if [[ "${commit}" == "${w1_i09_product_copy_candidate_sha}" ]]; then
      require_no_git_rename_or_copy_except_fixed_w1_i09_product_copy \
        "${parent}" "${commit}" \
        "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:rename or copy"
    else
      require_no_git_rename_or_copy "${parent}" "${commit}" \
        "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:rename or copy"
    fi
    if [[ "${changed_paths}" == "${w1_i09_canonical_bridge_product_path}" ]]; then
      [[ "${bridge_product_seen}" -eq 0 ]] ||
        fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:second modification"
      validate_w1_i09_canonical_bridge_product "${parent}" "${commit}"
      bridge_product_seen=1
    fi
    if [[ "${changed_paths}" == "${w1_i09_v2_compatibility_product_path}" ]]; then
      if [[ "${v2_compatibility_product_seen}" -eq 0 ]]; then
        validate_w1_i09_v2_compatibility_product "${parent}" "${commit}"
        v2_compatibility_product_seen=1
      elif [[ "${post_product_fixture_seen}" -eq 0 && \
              "${post_product_fixture_steps}" -eq 1 ]]; then
        validate_w1_i09_post_product_fixture "${parent}" "${commit}"
        post_product_fixture_seen=1
      elif [[ "${post_product_fixture_steps}" -eq 0 ]]; then
        fail "I09_V2_COMPATIBILITY_PRODUCT_INVALID:second modification"
      else
        fail "I09_POST_PRODUCT_FIXTURE_INVALID:second modification"
      fi
    fi
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      if is_w1_i08_descendant_path "${path}"; then
        fail "I09_RUNTIME_REBASELINE_I08_DRIFT"
      fi
      is_w1_i09_runtime_product_path "${path}" ||
        fail "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:path:${path}"
      [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
        fail "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:mode:${path}"
      require_git_blob_without_nul "${commit}" "${path}" \
        "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:NUL:${path}"
      if git -C "${repo_root}" show "${commit}:${path}" |
          grep -F 'jdbc:postgresql://' >/dev/null; then
        fail "I09_RUNTIME_REBASELINE_FORMAL_DATABASE_LOCATION"
      fi
    done <<< "${changed_paths}"
    if [[ "${commit}" == "${w1_i09_product_copy_candidate_sha}" ]]; then
      [[ "${copy_repair_state}" == "BEFORE" ]] ||
        fail "I09_PRODUCT_COPY_REPAIR_INVALID:duplicate origin"
      copy_repair_state="ORIGIN"
    fi
  done
  case "${copy_repair_state}" in
    ORIGIN|SPEC|TEST) fail "I09_PRODUCT_COPY_REPAIR_INVALID:incomplete" ;;
    FINDING_SPEC|FINDING_TEST)
      fail "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:incomplete"
      ;;
    REENTRY_SPEC|REENTRY_TEST)
      fail "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:incomplete"
      ;;
    BRIDGE_SPEC|BRIDGE_TEST)
      fail "I09_CANONICAL_BRIDGE_INVALID:incomplete"
      ;;
    BRIDGE_FIX_SPEC)
      fail "I09_CANONICAL_BRIDGE_FREEZE_FIX_INVALID:incomplete"
      ;;
    BRIDGE_SELECTOR_SPEC|BRIDGE_SELECTOR_TEST)
      fail "I09_CANONICAL_BRIDGE_SELECTOR_INVALID:incomplete"
      ;;
    BRIDGE_REVIEW_SPEC|BRIDGE_REVIEW_TEST)
      fail "I09_CANONICAL_BRIDGE_REVIEW_FINDING_INVALID:incomplete"
      ;;
    V2_COMPAT_SPEC|V2_COMPAT_TEST)
      fail "I09_V2_COMPATIBILITY_INVALID:incomplete"
      ;;
    POST_FIXTURE_REJECTED_SPEC|POST_FIXTURE_CORRECTION|POST_FIXTURE_TEST)
      fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:incomplete"
      ;;
    FIXTURE_DIAGNOSTIC_SPEC)
      fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:incomplete"
      ;;
    FOCUSED_CURRENT_SPEC|FOCUSED_CURRENT_TEST)
      fail "I09_FOCUSED_CURRENT_FINDING_INVALID:incomplete"
      ;;
    VERIFIER)
      [[ "${verifier_steps}" -ge 1 ]] ||
        fail "I09_PRODUCT_COPY_REPAIR_INVALID:missing verifier"
      ;;
    FINDING_VERIFIER)
      [[ "${finding_verifier_steps}" -ge 1 ]] ||
        fail "I09_PRODUCT_COPY_FINDING_REPAIR_INVALID:missing verifier"
      ;;
    REENTRY_VERIFIER)
      [[ "${reentry_verifier_steps}" -eq 1 ]] ||
        fail "I09_PRODUCT_COPY_REENTRY_REPAIR_INVALID:missing verifier"
      ;;
    BRIDGE_VERIFIER)
      fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:missing"
      ;;
    BRIDGE_PROJECTED)
      [[ "${bridge_verifier_steps}" -eq 1 ]] ||
        fail "I09_CANONICAL_BRIDGE_INVALID:missing verifier"
      ;;
    BRIDGE_FIXED)
      [[ "${bridge_freeze_fix_steps}" -eq 1 ]] ||
        fail "I09_CANONICAL_BRIDGE_FREEZE_FIX_INVALID:missing verifier"
      ;;
    BRIDGE_SELECTOR_VERIFIER)
      [[ "${bridge_selector_steps}" -eq 1 ]] ||
        fail "I09_CANONICAL_BRIDGE_SELECTOR_INVALID:missing verifier"
      ;;
    BRIDGE_REVIEW_VERIFIER)
      [[ "${bridge_review_steps}" -eq 1 ]] ||
        fail "I09_CANONICAL_BRIDGE_REVIEW_FINDING_INVALID:missing verifier"
      ;;
    V2_COMPAT_VERIFIER)
      fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:missing"
      ;;
    V2_COMPAT_PROJECTED)
      [[ "${v2_compatibility_steps}" -eq 1 ]] ||
        fail "I09_V2_COMPATIBILITY_INVALID:missing verifier"
      ;;
    POST_FIXTURE_VERIFIER)
      [[ "${post_product_fixture_steps}" -eq 1 ]] ||
        fail "I09_POST_PRODUCT_FIXTURE_GOVERNANCE_INVALID:missing verifier"
      ;;
    FIXTURE_DIAGNOSTIC_VERIFIER)
      [[ "${fixture_diagnostic_steps}" -eq 1 ]] ||
        fail "I09_FIXTURE_DIAGNOSTIC_CORRECTION_INVALID:missing verifier"
      ;;
    FOCUSED_CURRENT_VERIFIER)
      [[ "${focused_current_steps}" -eq 1 ]] ||
        fail "I09_FOCUSED_CURRENT_FINDING_INVALID:missing verifier"
      ;;
  esac
  [[ "${i08_fixture_pin_state}" != "TEST" ]] ||
    fail "I09_I08_FIXTURE_PIN_INVALID:missing verifier"
  [[ "${v2_fixture_pin_state}" != "VERIFIER" ]] ||
    fail "I09_V2_FIXTURE_PIN_INVALID:missing test"
  case "${final_review_state}" in
    SPEC|TEST)
      fail "I09_FINAL_REVIEW_FINDING_INVALID:incomplete"
      ;;
    VERIFIER|COMPLETE)
      [[ "${final_review_verifier_steps}" -eq 1 ]] ||
        fail "I09_FINAL_REVIEW_FINDING_INVALID:missing verifier"
      ;;
  esac
  if [[ -z "${bridge_projection}" ]]; then
    bridge_projection="${projection}"
  fi
  git -C "${repo_root}" diff --quiet "${bridge_projection}..${head}" -- \
    "${w1_i09_runtime_projection_paths[@]}" ||
    fail "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:path:projection"
}

route_w1_i09_runtime_repair() {
  local head="$1"
  local repair_tip projection product_write_set_count=27
  repair_tip="$(validate_w1_i09_runtime_repair_chain "${head}")"
  if [[ "${head}" == "${repair_tip}" ]]; then
    printf '%s\n' \
      "Wave1ImplementationTaskCardValidation = PASS" \
      "TaskCardCount = 14" \
      "TaskCardSetStatus = READY_FOR_EXECUTION" \
      "ActiveTaskCard = W1-I09" \
      "ReadyTaskCardCount = 1" \
      "W1I07ClosureStatus = PASS" \
      "W1I08ClosureStatus = PASS" \
      "W1I09RuntimeRebaselineStatus = PENDING_PROJECTION" \
      "FormalDatabaseWrite = NOT_AUTHORIZED" \
      "RemotePush = NOT_AUTHORIZED"
    return 0
  fi
  projection="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${repair_tip}..${head}" | awk 'NF { print; exit }')"
  [[ -n "${projection}" ]] ||
    fail "I09_RUNTIME_REBASELINE_PROJECTION_INVALID:missing"
  validate_w1_i09_runtime_projection "${repair_tip}" "${projection}"
  validate_post_w1_i09_runtime_projection_descendants \
    "${projection}" "${head}"
  if git -C "${repo_root}" merge-base --is-ancestor \
      "${w1_i09_canonical_bridge_spec_sha}" "${head}"; then
    product_write_set_count=28
  fi
  if git -C "${repo_root}" merge-base --is-ancestor \
      "${w1_i09_v2_compatibility_spec_sha}" "${head}"; then
    product_write_set_count=29
  fi
  printf '%s\n' \
    "Wave1ImplementationTaskCardValidation = PASS" \
    "TaskCardCount = 14" \
    "TaskCardSetStatus = READY_FOR_EXECUTION" \
    "ActiveTaskCard = W1-I09" \
    "ReadyTaskCardCount = 1" \
    "W1I07ClosureStatus = PASS" \
    "W1I08ClosureStatus = PASS" \
    "W1I09RuntimeRebaselineStatus = PASS" \
    "I09ProductWriteSetCount = ${product_write_set_count}" \
    "FormalDatabaseWrite = NOT_AUTHORIZED" \
    "RemotePush = NOT_AUTHORIZED"
}

validate_w1_i09_closure_predecessor() {
  local actual_parent actual_tree repair_tip projection
  actual_parent="$(single_parent_of "${w1_i09_closure_origin_sha}" \
    "I09_CLOSURE_PRODUCT_IDENTITY_INVALID:parent")"
  [[ "${actual_parent}" == "${w1_i09_closure_reviewed_parent_sha}" ]] ||
    fail "I09_CLOSURE_PRODUCT_IDENTITY_INVALID:parent"
  actual_tree="$(git -C "${repo_root}" rev-parse \
    "${w1_i09_closure_origin_sha}^{tree}" 2>/dev/null)" ||
    fail "I09_CLOSURE_PRODUCT_IDENTITY_INVALID:tree unavailable"
  [[ "${actual_tree}" == "${w1_i09_closure_reviewed_tree_sha}" ]] ||
    fail "I09_CLOSURE_PRODUCT_IDENTITY_INVALID:tree"
  repair_tip="$(validate_w1_i09_runtime_repair_chain \
    "${w1_i09_closure_origin_sha}")"
  projection="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${repair_tip}..${w1_i09_closure_origin_sha}" | awk 'NF { print; exit }')"
  [[ -n "${projection}" ]] || fail "I09_CLOSURE_PRODUCT_IDENTITY_INVALID:projection"
  validate_w1_i09_runtime_projection "${repair_tip}" "${projection}"
  validate_post_w1_i09_runtime_projection_descendants \
    "${projection}" "${w1_i09_closure_origin_sha}"
}

validate_w1_i09_closure_governance_chain() {
  local tip="$1"
  local commits=() commit parent previous changed_paths path index expected_path
  local expected_mode actual_blob expected_blob evidence_sha
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i09_closure_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:origin"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i09_closure_origin_sha}..${tip}")
  [[ "${#commits[@]}" -eq "${#w1_i09_closure_governance_paths[@]}" ]] ||
    fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:exact five commits"
  previous="${w1_i09_closure_origin_sha}"
  for index in "${!commits[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i09_closure_governance_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i09_runtime_product_path "${path}" &&
        fail "I09_CLOSURE_PRODUCT_DRIFT:${path}"
    done <<< "${changed_paths}"
    [[ "${changed_paths}" == "${expected_path}" ]] ||
      fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:path"
    case "${expected_path}" in
      scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
      *) expected_mode=100644 ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:NUL"
    if [[ "${index}" -lt "${#w1_i09_closure_governance_evidence_shas[@]}" ]]; then
      evidence_sha="${w1_i09_closure_governance_evidence_shas[${index}]}"
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:evidence"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${evidence_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:evidence"
    fi
    previous="${commit}"
  done
}

require_w1_i09_closure_review_receipt() {
  local receipt="$1"
  local governance_tip="$2"
  local governance_parent governance_tree receipt_dir plan_file
  governance_parent="$(single_parent_of "${governance_tip}" \
    "I09_CLOSURE_REVIEW_RECEIPT_INVALID:governance parent")"
  governance_tree="$(git -C "${repo_root}" rev-parse \
    "${governance_tip}^{tree}" 2>/dev/null)" ||
    fail "I09_CLOSURE_REVIEW_RECEIPT_INVALID:governance tree"
  register_temporary_directory receipt_dir cognitura-i09-closure-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${receipt}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
      remove_temporary_directory "${receipt_dir}"
      fail "I09_CLOSURE_REVIEW_RECEIPT_INVALID:plan"
    }
  [[ "$(grep -c '^## 19\. I09 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I09_CLOSURE_REVIEW_RECEIPT_INVALID:heading"
  }
  sed -n '/^## 19\. I09 关闭收据$/,$p' "${plan_file}" > \
    "${receipt_dir}/actual"
  printf '%s\n' \
    '## 19. I09 关闭收据' \
    '' \
    '```text' \
    'W1-I09 = DONE' \
    "ReviewedCandidate = ${w1_i09_closure_origin_sha}" \
    "ReviewedParent = ${w1_i09_closure_reviewed_parent_sha}" \
    "ReviewedTree = ${w1_i09_closure_reviewed_tree_sha}" \
    "ReviewedGovernanceCandidate = ${governance_tip}" \
    "ReviewedGovernanceParent = ${governance_parent}" \
    "ReviewedGovernanceTree = ${governance_tree}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'I09ClosureReleasedTaskCard = W1-I10' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I09_CLOSURE_REVIEW_RECEIPT_INVALID:content"
  }
  remove_temporary_directory "${receipt_dir}"
}

replace_w1_i09_closure_expected_text() {
  local file="$1"
  local old_text="$2"
  local new_text="$3"
  local path="$4"
  local count
  count="$(I09_CLOSURE_OLD_TEXT="${old_text}" perl -0777 -ne \
    '$count = () = /\Q$ENV{I09_CLOSURE_OLD_TEXT}\E/g; print $count' "${file}")" ||
    fail "I09_CLOSURE_PROJECTION_MISMATCH:count:${path}"
  [[ "${count}" == 1 ]] ||
    fail "I09_CLOSURE_PROJECTION_MISMATCH:source:${path}"
  I09_CLOSURE_OLD_TEXT="${old_text}" I09_CLOSURE_NEW_TEXT="${new_text}" \
    perl -0777 -i.bak -pe \
      's/\Q$ENV{I09_CLOSURE_OLD_TEXT}\E/$ENV{I09_CLOSURE_NEW_TEXT}/g' "${file}" ||
    fail "I09_CLOSURE_PROJECTION_MISMATCH:replace:${path}"
  rm -f "${file}.bak"
}

replace_w1_i09_closure_expected_first_field() {
  local file="$1"
  local field="$2"
  local value="$3"
  local path="$4"
  FIRST_FIELD="${field}" perl -ne '
    if (/^\Q$ENV{FIRST_FIELD}\E = /) { $count++ }
    END { print $count + 0 }
  ' "${file}" | grep -Eq '^[1-9][0-9]*$' ||
    fail "I09_CLOSURE_PROJECTION_MISMATCH:field:${path}:${field}"
  FIRST_FIELD="${field}" FIRST_VALUE="${value}" perl -i.bak -pe '
    if (!$done && /^\Q$ENV{FIRST_FIELD}\E = /) {
      $_ = "$ENV{FIRST_FIELD} = $ENV{FIRST_VALUE}\n";
      $done = 1;
    }
  ' "${file}" || fail "I09_CLOSURE_PROJECTION_MISMATCH:field:${path}:${field}"
  rm -f "${file}.bak"
}

