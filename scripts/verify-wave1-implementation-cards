  execution_steps="$(sed -n '/^## 4\. 执行步骤$/,/^## 5\. 验证命令$/p' "${file}")"
  red_count="$(printf '%s\n' "${execution_steps}" | grep -cE '^[0-9]+\. RED：' || true)"
  green_count="$(printf '%s\n' "${execution_steps}" | grep -cE '^[0-9]+\. GREEN：' || true)"
  [[ "${red_count}" -eq 1 ]] || fail "${task_id}: missing RED-first instruction"
  [[ "${green_count}" -eq 1 ]] || fail "${task_id}: missing GREEN instruction"
  red_line="$(printf '%s\n' "${execution_steps}" | grep -nE '^[0-9]+\. RED：' | cut -d: -f1)"
  green_line="$(printf '%s\n' "${execution_steps}" | grep -nE '^[0-9]+\. GREEN：' | cut -d: -f1)"
  [[ "${red_line}" -lt "${green_line}" ]] || fail "${task_id}: RED must precede GREEN"

  validation_section="$(sed -n '/^## 5\. 验证命令$/,/^## 6\. Gate 与完成定义$/p' "${file}")"
  [[ "$(printf '%s\n' "${validation_section}" | grep -c '^```bash$' || true)" -eq 1 ]] ||
    fail "${task_id}: validation section must contain exactly one Bash block"
  [[ "$(printf '%s\n' "${validation_section}" | grep -c '^```$' || true)" -eq 1 ]] ||
    fail "${task_id}: validation section must contain exactly one Bash block"
  validation_bash_block="$(
    printf '%s\n' "${validation_section}" |
      sed -n '/^```bash$/,/^```$/p' |
      sed '1d;$d'
