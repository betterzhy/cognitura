  actual_write_set="$(sed -n 's/^WriteSet = //p' "${file}")"
  [[ "${actual_write_set}" == "${expected_write_set}" ]] ||
    fail "WriteSet mismatch for ${task_id}"
  actual_forbidden_write_set="$(sed -n 's/^ForbiddenWriteSet = //p' "${file}")"
  [[ "${actual_forbidden_write_set}" == "${expected_forbidden_write_set}" ]] ||
    fail "ForbiddenWriteSet mismatch for ${task_id}"
  [[ "$(field_value "${file}" "PositiveVerification")" == "${expected_positive_verification}" ]] ||
    fail "PositiveVerification mismatch for ${task_id}"
  [[ "$(field_value "${file}" "NegativeVerification")" == "${expected_negative_verification}" ]] ||
    fail "NegativeVerification mismatch for ${task_id}"

  [[ "$(field_value "${file}" "CardKind")" == "${expected_kind}" ]] ||
    fail "CardKind mismatch for ${task_id}"
  [[ "$(field_value "${file}" "Gate")" == "${expected_gate}" ]] ||
    fail "Gate mismatch for ${task_id}"
  [[ "$(field_value "${file}" "Risk")" == "${expected_risk}" ]] ||
    fail "Risk mismatch for ${task_id}"
  actual_dependency="$(field_value "${file}" "DependsOn")"
  if [[ "${task_id}" == "W1-I13" && "${actual_dependency}" != "${expected_dependency}" ]]; then
    fail "W1-I13 must depend on W1-I00 through W1-I12"
  fi
  [[ "${actual_dependency}" == "${expected_dependency}" ]] ||
    fail "dependency mismatch for ${task_id}"
  [[ "$(field_value "${file}" "PrimaryBoundary")" == "${expected_boundary}" ]] ||
    fail "PrimaryBoundary mismatch for ${task_id}"
  if [[ "${task_id}" == "W1-I13" && "$(field_value "${file}" "ReviewRoute")" != "${expected_route}" ]]; then
    fail "W1-I13 must use DEEP_REVIEWER_THEN_ULTRA_GATEKEEPER"
  fi
  [[ "$(field_value "${file}" "ReviewRoute")" == "${expected_route}" ]] ||
    fail "ReviewRoute mismatch for ${task_id}"
  [[ "$(field_value "${file}" "RemotePush")" == "NOT_AUTHORIZED" ]] ||
    fail "RemotePush must remain NOT_AUTHORIZED for ${task_id}"

  business_authorization="$(field_value "${file}" "BusinessImplementationAuthorization")"
  if [[ "${task_id}" == "W1-I00" ]]; then
    [[ "${business_authorization}" == "NOT_REQUIRED_GOVERNANCE_ONLY" ]] ||
      fail "BusinessImplementationAuthorization mismatch for ${task_id}"
  else
    case "${business_authorization}" in
      REQUIRED_BEFORE_READY|USER_AUTHORIZED) ;;
      *) fail "BusinessImplementationAuthorization mismatch for ${task_id}" ;;
    esac
    if [[ "${status}" == "READY" || "${status}" == "DONE" ]]; then
      [[ "${business_authorization}" == "USER_AUTHORIZED" ]] ||
        fail "${task_id} requires explicit business implementation authorization"
    fi
  fi

  formal_database_gate="$(field_value "${file}" "FormalDatabaseGate")"
  case "${task_id}" in
    W1-I02)
      case "${formal_database_gate}" in
        REQUIRED_BEFORE_READY|PASS) ;;
        *) fail "FormalDatabaseGate mismatch for ${task_id}" ;;
      esac
