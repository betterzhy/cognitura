    '| `W1-I03` | [DOCX 安全闸](W1-I03-docx-security-gate.md) | `SUSPENDED_BY_USER` | `W1-I01` | `W1-IG3` | `HIGH` |' \
    "restore transition BASE must preserve exact suspended projection: ${base_index_path}"
  for path in AGENTS.md README.md docs/engineering/cognitura-design-index.md; do
    require_all_suspended_base_fields "${resolved_base}" "${path}" BusinessImplementation USER_AUTHORIZED
    require_all_suspended_base_fields "${resolved_base}" "${path}" FormalDatabaseWrite NOT_AUTHORIZED
    require_all_suspended_base_fields "${resolved_base}" "${path}" RemotePush NOT_AUTHORIZED
  done
  require_all_suspended_base_fields "${resolved_base}" docs/design/wave-1/README.md BusinessImplementation USER_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-design-plan.md BusinessImplementation USER_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-design-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-design-plan.md DeploymentAndRelease NOT_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-design-acceptance.md BusinessImplementation USER_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-design-acceptance.md RemotePush NOT_PERFORMED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-implementation-plan.md BusinessImplementation USER_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-implementation-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-implementation-plan.md DeploymentAndRelease NOT_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/engineering/cognitura-wave-1-implementation-plan.md RemotePush NOT_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" docs/task-cards/wave-1/README.md BusinessImplementation USER_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" "${base_index_path}" BusinessImplementation USER_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" "${base_index_path}" FormalDatabaseWrite NOT_AUTHORIZED
  require_all_suspended_base_fields "${resolved_base}" "${base_index_path}" RemotePush NOT_AUTHORIZED
  require_suspended_base_field "${resolved_base}" "${base_card_path}" BusinessImplementationAuthorization USER_AUTHORIZED
  require_suspended_base_field "${resolved_base}" "${base_card_path}" FormalDatabaseGate NOT_APPLICABLE
  require_suspended_base_field "${resolved_base}" "${base_card_path}" RemotePush NOT_AUTHORIZED

  vsb_path="docs/task-cards/visual-style-baseline/execution-state.md"
  base_vsb_status="$(git_tree_field "${resolved_base}" "${vsb_path}" TaskCardSetStatus)"
  case "${base_vsb_status}" in
    COMPLETE) ;;
    STOPPED_BY_USER)
      [[ "$(git_tree_field "${resolved_base}" "${vsb_path}" UserStopAuthorization)" == EXPLICIT_USER_INSTRUCTION ]] ||
        fail "stopped restore requires explicit user-stop authorization"
      ;;
    *) fail "restore requires COMPLETE or explicitly authorized STOPPED_BY_USER VSB state" ;;
  esac
  terminal_vsb_transition_base="$(git_tree_field "${resolved_base}" "${vsb_path}" TransitionBaseSHA)"
  resolved_terminal_vsb_transition_base="$(
    git -C "${repo_root}" rev-parse --verify \
      "${terminal_vsb_transition_base}^{commit}" 2>/dev/null
  )" || fail "restore VSB terminal receipt has an invalid TransitionBaseSHA"
  [[ "$(git -C "${repo_root}" rev-parse "${resolved_base}^")" == \
     "${resolved_terminal_vsb_transition_base}" ]] ||
    fail "restore base must be the exact VSB terminal receipt commit"
  [[ -x "${vsb_verifier}" ]] || fail "VSB validator is unavailable"
  vsb_checkout="$(mktemp -d "${TMPDIR:-/tmp}/cognitura-vsb-base.XXXXXX")"
  git clone --shared -q "${repo_root}" "${vsb_checkout}" ||
    fail "could not create isolated VSB base-tree checkout"
  git -C "${vsb_checkout}" checkout -q --detach "${resolved_base}" || {
    rm -rf -- "${vsb_checkout}"
    fail "could not check out the VSB transition BASE"
  }
  if ! "${vsb_verifier}" \
    --repo-root "${vsb_checkout}" \
    --cards-dir "${vsb_checkout}/docs/task-cards/visual-style-baseline" >/dev/null 2>&1; then
    rm -rf -- "${vsb_checkout}"
    fail "VSB base tree validation failed"
  fi
  if ! "${vsb_verifier}" \
    --repo-root "${vsb_checkout}" \
    --cards-dir "${vsb_checkout}/docs/task-cards/visual-style-baseline" \
    --transition-base "${resolved_terminal_vsb_transition_base}" \
    --transition-head "${resolved_base}" >/dev/null 2>&1; then
    rm -rf -- "${vsb_checkout}"
    fail "restore VSB terminal receipt transition validation failed"
  fi
  rm -rf -- "${vsb_checkout}"

  [[ "$(git_tree_field "${resolved_head}" "${base_index_path}" TaskCardSetStatus)" == READY_FOR_EXECUTION &&
     "$(git_tree_field "${resolved_head}" "${base_index_path}" ActiveTaskCard)" == W1-I03 &&
     "$(git_tree_field "${resolved_head}" "${base_index_path}" SuspendedTaskCard)" == NONE &&
     "$(git_tree_field "${resolved_head}" "${base_index_path}" SuspendedCandidateSHA)" == NONE &&
     "$(git_tree_field "${resolved_head}" "${base_index_path}" SuspendedCandidateMutation)" == NONE &&
     "$(git_tree_field "${resolved_head}" "${base_card_path}" Status)" == READY ]] ||
    fail "restore transition HEAD must release only W1-I03 and clear suspended fields"

  for path in "${restore_paths[@]}"; do
    [[ "$(<"${repo_root}/${path}")" == "$(git -C "${repo_root}" show "${resolved_head}:${path}")" ]] ||
      fail "working projection must match transition HEAD tree: ${path}"
  done
  [[ "$(git_tree_field "${resolved_head}" AGENTS.md ActiveImplementationTaskCard)" == W1-I03 &&
     "$(git_tree_field "${resolved_head}" README.md ActiveImplementationTaskCard)" == W1-I03 &&
     "$(git_tree_field "${resolved_head}" docs/design/wave-1/README.md ActiveImplementationGovernanceTaskCard)" == W1-I03 &&
     "$(git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-design-plan.md ActiveImplementationGovernanceTaskCard)" == W1-I03 &&
     "$(git_tree_field "${resolved_head}" docs/task-cards/wave-1/README.md ActiveImplementationGovernanceTaskCard)" == W1-I03 ]] ||
    fail "restore transition projections must release only W1-I03"
  require_git_tree_field "${resolved_head}" AGENTS.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" README.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" docs/design/wave-1/README.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-design-index.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-design-index.md ActiveTaskCard W1-I03
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-design-index.md ActiveTaskCardStatus READY
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-design-plan.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-design-acceptance.md ImplementationTaskCardPlanStatus I01_COMPLETE_I03_READY
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-design-acceptance.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md ActiveTaskCard W1-I03
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md SuspendedTaskCard NONE
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md SuspendedCandidateSHA NONE
  require_git_tree_field "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md SuspendedCandidateMutation NONE
  require_git_tree_field "${resolved_head}" docs/task-cards/wave-1/README.md Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" "${base_index_path}" ReadyTaskCardCount 1
  require_git_tree_field "${resolved_head}" "${base_index_path}" SuspendedTaskCardCount 0
  require_exact_git_tree_table_row \
    "${resolved_head}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md \
    W1-I03 \
    '| `W1-I03` | DOCX security | `I01` | `READY` |' \
    'transition docs/engineering/cognitura-wave-1-implementation-plan.md: restored status table mismatch'
  require_exact_git_tree_table_row \
    "${resolved_head}" \
    "${base_index_path}" \
    W1-I03 \
    '| `W1-I03` | [DOCX 安全闸](W1-I03-docx-security-gate.md) | `READY` | `W1-I01` | `W1-IG3` | `HIGH` |' \
    "transition ${base_index_path}: restored status table mismatch"
  for path in AGENTS.md README.md docs/engineering/cognitura-design-index.md; do
    require_all_git_tree_fields "${resolved_head}" "${path}" BusinessImplementation USER_AUTHORIZED
    require_all_git_tree_fields "${resolved_head}" "${path}" FormalDatabaseWrite NOT_AUTHORIZED
    require_all_git_tree_fields "${resolved_head}" "${path}" RemotePush NOT_AUTHORIZED
  done
  require_all_git_tree_fields "${resolved_head}" docs/design/wave-1/README.md BusinessImplementation USER_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-design-plan.md BusinessImplementation USER_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-design-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-design-plan.md DeploymentAndRelease NOT_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-design-acceptance.md BusinessImplementation USER_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-design-acceptance.md RemotePush NOT_PERFORMED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md BusinessImplementation USER_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md DeploymentAndRelease NOT_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md RemotePush NOT_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" docs/task-cards/wave-1/README.md BusinessImplementation USER_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" "${base_index_path}" BusinessImplementation USER_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" "${base_index_path}" FormalDatabaseWrite NOT_AUTHORIZED
  require_all_git_tree_fields "${resolved_head}" "${base_index_path}" RemotePush NOT_AUTHORIZED
  require_git_tree_field "${resolved_head}" "${base_card_path}" BusinessImplementationAuthorization USER_AUTHORIZED
  require_git_tree_field "${resolved_head}" "${base_card_path}" FormalDatabaseGate NOT_APPLICABLE
  require_git_tree_field "${resolved_head}" "${base_card_path}" RemotePush NOT_AUTHORIZED
  git -C "${repo_root}" diff --quiet \
    4e63936c631ab34807e714b90d30415a959bc13d.."${resolved_head}" -- \
    server/src/main/java/io/cognitura/source/docx/security/DocxSecurityGate.java \
    server/src/main/java/io/cognitura/source/docx/security/DocxPackageLimits.java \
    server/src/main/java/io/cognitura/source/docx/security/DocxRelationshipClassifier.java \
    server/src/main/java/io/cognitura/source/docx/security/DocxSecurityViolation.java \
    server/src/main/java/io/cognitura/source/docx/security/SafeDocxPackage.java \
    server/src/test/java/io/cognitura/source/docx/security/DocxSecurityGateTest.java \
    server/src/test/java/io/cognitura/source/docx/security/ExternalRelationshipIsolationTest.java \
    server/src/test/resources/docx/security ||
    fail "restore transition changed a frozen W1-I03 production path"
fi

printf '%s\n' \
  "Wave1ImplementationTaskCardValidation = PASS" \
  "TaskCardCount = 14" \
  "TaskCardSetStatus = ${task_set_status}" \
  "ActiveTaskCard = ${active_task_card}"
