                "${w1_i02_gate_tip}" "${transition_base}")"
              validate_w1_i02_database_gate_release \
                "${w1_i02_gate_tip}" "${w1_i02_release_receipt}"
              validate_post_w1_i02_database_gate_descendants \
                "${w1_i02_release_receipt}" "${transition_base}"
              validate_w1_i02_closure "${transition_base}" "${transition_head}"
