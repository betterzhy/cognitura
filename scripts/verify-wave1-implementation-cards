#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: scripts/verify-wave1-implementation-cards [--repo-root PATH] --cards-dir PATH [--transition-base SHA --transition-head SHA]' >&2
  exit 2
}

fail() {
  printf 'Wave1ImplementationTaskCardValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

field_value() {
  local file="$1"
  local key="$2"
  sed -n "s/^${key} = //p" "${file}"
}

one_field_value() {
  local file="$1"
  local key="$2"
  local label="$3"
  local count
  count="$(grep -c "^${key} = " "${file}" || true)"
  [[ "${count}" -eq 1 ]] || fail "${label}: ${key} must occur exactly once"
  field_value "${file}" "${key}"
}

require_projection() {
  local relative_file="$1"
  local key="$2"
  local expected="$3"
  local file="${repo_root}/${relative_file}"
  [[ -f "${file}" ]] || fail "projection file is missing: ${relative_file}"
  [[ "$(one_field_value "${file}" "${key}" "${relative_file}")" == "${expected}" ]] ||
    fail "${relative_file}: ${key} projection mismatch"
}

require_all_projection_values() {
  local relative_file="$1"
  local key="$2"
  local expected="$3"
  local file="${repo_root}/${relative_file}"
  local count mismatches
  [[ -f "${file}" ]] || fail "projection file is missing: ${relative_file}"
  count="$(grep -c "^${key} = " "${file}" || true)"
  mismatches="$(sed -n "s/^${key} = //p" "${file}" | grep -Fvx "${expected}" || true)"
  [[ "${count}" -gt 0 && -z "${mismatches}" ]] ||
    fail "current suspension projection mismatch: ${relative_file} ${key}"
}

require_exact_task_table_row_text() {
  local content="$1"
  local task_id="$2"
  local expected_line="$3"
  local failure_message="$4"
  local matching_rows matching_count
  matching_rows="$(
    printf '%s\n' "${content}" | awk -v task_id="${task_id}" '
      {
        line = $0
        sub(/^[[:space:]]*/, "", line)
        if (substr(line, 1, 1) != "|") {
          next
        }
        remainder = substr(line, 2)
        separator = index(remainder, "|")
        if (separator == 0) {
          next
        }
        first_column = substr(remainder, 1, separator - 1)
        sub(/^[[:space:]]*/, "", first_column)
        sub(/[[:space:]]*$/, "", first_column)
        if (first_column == task_id || first_column == "`" task_id "`") {
          print $0
        }
      }
    '
  )"
  matching_count="$(printf '%s\n' "${matching_rows}" | awk 'NF { count++ } END { print count + 0 }')"
  [[ "${matching_count}" -eq 1 && "${matching_rows}" == "${expected_line}" ]] ||
    fail "${failure_message}"
}

require_exact_projection_table_row() {
  local relative_file="$1"
  local task_id="$2"
  local expected_line="$3"
  local file="${repo_root}/${relative_file}"
  [[ -f "${file}" ]] || fail "projection file is missing: ${relative_file}"
  require_exact_task_table_row_text \
    "$(<"${file}")" \
    "${task_id}" \
    "${expected_line}" \
    "current suspension projection mismatch: ${relative_file} status table"
}

require_exact_git_tree_table_row() {
  local commit="$1"
  local path="$2"
  local task_id="$3"
  local expected_line="$4"
  local failure_message="$5"
  local content
  content="$(git -C "${repo_root}" show "${commit}:${path}" 2>/dev/null)" ||
    fail "transition tree is missing ${path}"
  require_exact_task_table_row_text \
    "${content}" "${task_id}" "${expected_line}" "${failure_message}"
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    fail "SHA-256 tool is unavailable"
  fi
}

normalized_card_digest() {
  local file="$1"
  sed -E \
    -e 's/^Status = .*/Status = __MUTABLE__/' \
    -e 's/^BusinessImplementationAuthorization = .*/BusinessImplementationAuthorization = __MUTABLE__/' \
    -e 's/^FormalDatabaseGate = .*/FormalDatabaseGate = __MUTABLE__/' \
    "${file}" | sha256_stream
}

normalized_i03_digest() {
  local file="$1"
  sed -E 's/^Status = .*/Status = __MUTABLE__/' "${file}" | sha256_stream
}

default_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
vsb_verifier="${default_repo_root}/scripts/verify-visual-style-baseline-cards"
repo_root="${default_repo_root}"
cards_dir=""
transition_base=""
transition_head=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --repo-root)
      [[ "$#" -ge 2 ]] || usage
      repo_root="$2"
      shift 2
      ;;
    --cards-dir)
      [[ "$#" -ge 2 ]] || usage
      cards_dir="$2"
      shift 2
      ;;
    --transition-base)
      [[ "$#" -ge 2 ]] || usage
      transition_base="$2"
      shift 2
      ;;
    --transition-head)
      [[ "$#" -ge 2 ]] || usage
      transition_head="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

[[ -n "${cards_dir}" ]] || usage
[[ -d "${repo_root}" ]] || fail "repo root does not exist: ${repo_root}"
repo_root="$(cd "${repo_root}" && pwd -P)"
[[ -d "${cards_dir}" ]] || fail "cards directory does not exist: ${cards_dir}"
if [[ -n "${transition_base}" || -n "${transition_head}" ]]; then
  [[ -n "${transition_base}" && -n "${transition_head}" ]] ||
    fail "transition-base and transition-head must be supplied together"
fi
index_file="${cards_dir}/README.md"
[[ -f "${index_file}" ]] || fail "task card index is missing: README.md"

expected_ids="W1-I00,W1-I01,W1-I02,W1-I03,W1-I04,W1-I05,W1-I06,W1-I07,W1-I08,W1-I09,W1-I10,W1-I11,W1-I12,W1-I13"
