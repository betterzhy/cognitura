    READY|DONE|BLOCKED_BY_DEPENDENCY|BLOCKED_BY_USER_AUTHORIZATION|QUEUED|SUSPENDED_BY_USER) ;;
    *) fail "unsupported Status for ${task_id}: ${status}" ;;
  esac
