    "${w1_i11_obsolete_oracle_repair_origin_sha}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i11_obsolete_oracle_repair_origin_sha}..${tip}" -- \
    "${w1_i10_product_paths[@]}" "${w1_i10_closure_projection_paths[@]}" \
    "${w1_i11_persistence_rebaseline_projection_paths[@]}" ||
    fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:frozen bytes"
}

