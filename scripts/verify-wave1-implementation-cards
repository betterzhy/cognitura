#!/usr/bin/env bash

set -euo pipefail

temporary_paths=("")

cleanup_temporary_paths() {
  local temporary_path
  for temporary_path in "${temporary_paths[@]}"; do
    [[ -z "${temporary_path}" ]] || rm -rf -- "${temporary_path}"
  done
}
trap cleanup_temporary_paths EXIT

usage() {
  printf '%s\n' \
    'Usage: scripts/verify-wave1-implementation-cards [--repo-root PATH] --cards-dir PATH [--transition-base SHA --transition-head SHA]' >&2
  exit 2
}

fail() {
  printf 'Wave1ImplementationTaskCardValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

register_temporary_directory() {
  local destination_variable="$1"
  local prefix="$2"
  local temporary_path
  temporary_path="$(mktemp -d "${TMPDIR:-/tmp}/${prefix}.XXXXXX")" ||
    fail "could not create temporary directory: ${prefix}"
  temporary_paths+=("${temporary_path}")
  printf -v "${destination_variable}" '%s' "${temporary_path}"
}

remove_temporary_directory() {
  local target="$1"
  [[ -z "${target}" ]] || rm -rf -- "${target}"
}

single_parent_of() {
  local commit="$1"
  local label="$2"
  local parent_line
  parent_line="$(git -C "${repo_root}" rev-list --parents -n 1 "${commit}" 2>/dev/null)" ||
    fail "${label} must resolve to a commit"
  set -- ${parent_line}
  [[ "$#" -eq 2 ]] || fail "${label} must have exactly one parent"
  printf '%s\n' "$2"
}

field_value() {
  local file="$1"
  local key="$2"
  sed -n "s/^${key} = //p" "${file}"
}

one_field_value() {
  local file="$1"
  local key="$2"
  local label="$3"
  local count
  count="$(grep -c "^${key} = " "${file}" || true)"
  [[ "${count}" -eq 1 ]] || fail "${label}: ${key} must occur exactly once"
  field_value "${file}" "${key}"
}

require_projection() {
  local relative_file="$1"
  local key="$2"
  local expected="$3"
  local file="${repo_root}/${relative_file}"
  [[ -f "${file}" ]] || fail "projection file is missing: ${relative_file}"
  [[ "$(one_field_value "${file}" "${key}" "${relative_file}")" == "${expected}" ]] ||
    fail "${relative_file}: ${key} projection mismatch"
}

require_all_projection_values() {
  local relative_file="$1"
  local key="$2"
  local expected="$3"
  local file="${repo_root}/${relative_file}"
  local count mismatches
  [[ -f "${file}" ]] || fail "projection file is missing: ${relative_file}"
  count="$(grep -c "^${key} = " "${file}" || true)"
  mismatches="$(sed -n "s/^${key} = //p" "${file}" | grep -Fvx "${expected}" || true)"
  [[ "${count}" -gt 0 && -z "${mismatches}" ]] ||
    fail "current suspension projection mismatch: ${relative_file} ${key}"
}

require_exact_task_table_row_text() {
  local content="$1"
  local task_id="$2"
  local expected_line="$3"
  local failure_message="$4"
  local matching_rows matching_count
  matching_rows="$(
    printf '%s\n' "${content}" | awk -v task_id="${task_id}" '
      {
        line = $0
        sub(/^[[:space:]]*/, "", line)
        if (substr(line, 1, 1) != "|") {
          next
        }
        remainder = substr(line, 2)
        separator = index(remainder, "|")
        if (separator == 0) {
          next
        }
        first_column = substr(remainder, 1, separator - 1)
        sub(/^[[:space:]]*/, "", first_column)
        sub(/[[:space:]]*$/, "", first_column)
        if (first_column == task_id || first_column == "`" task_id "`") {
          print $0
        }
      }
    '
  )"
  matching_count="$(printf '%s\n' "${matching_rows}" | awk 'NF { count++ } END { print count + 0 }')"
  [[ "${matching_count}" -eq 1 && "${matching_rows}" == "${expected_line}" ]] ||
    fail "${failure_message}"
}

require_exact_projection_table_row() {
  local relative_file="$1"
  local task_id="$2"
  local expected_line="$3"
  local file="${repo_root}/${relative_file}"
  [[ -f "${file}" ]] || fail "projection file is missing: ${relative_file}"
  require_exact_task_table_row_text \
    "$(<"${file}")" \
    "${task_id}" \
    "${expected_line}" \
    "current suspension projection mismatch: ${relative_file} status table"
}

require_exact_git_tree_table_row() {
  local commit="$1"
  local path="$2"
  local task_id="$3"
  local expected_line="$4"
  local failure_message="$5"
  local content
  content="$(git -C "${repo_root}" show "${commit}:${path}" 2>/dev/null)" ||
    fail "transition tree is missing ${path}"
  require_exact_task_table_row_text \
    "${content}" "${task_id}" "${expected_line}" "${failure_message}"
}

