default_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
vsb_verifier="${default_repo_root}/scripts/verify-visual-style-baseline-cards"
repo_root="${default_repo_root}"
cards_dir=""
transition_base=""
transition_head=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --repo-root)
      [[ "$#" -ge 2 ]] || usage
      repo_root="$2"
      shift 2
      ;;
    --cards-dir)
      [[ "$#" -ge 2 ]] || usage
      cards_dir="$2"
      shift 2
      ;;
    --transition-base)
      [[ "$#" -ge 2 ]] || usage
      transition_base="$2"
      shift 2
      ;;
    --transition-head)
      [[ "$#" -ge 2 ]] || usage
      transition_head="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

[[ -n "${cards_dir}" ]] || usage
[[ -d "${repo_root}" ]] || fail "repo root does not exist: ${repo_root}"
repo_root="$(cd "${repo_root}" && pwd -P)"
[[ -d "${cards_dir}" ]] || fail "cards directory does not exist: ${cards_dir}"
cards_dir="$(cd "${cards_dir}" && pwd -P)"
canonical_w1_cards_dir="${repo_root}/docs/task-cards/wave-1-implementation"
closure_cards_dir_is_canonical=0
[[ "${cards_dir}" == "${canonical_w1_cards_dir}" ]] &&
  closure_cards_dir_is_canonical=1
if [[ -n "${transition_base}" || -n "${transition_head}" ]]; then
  [[ -n "${transition_base}" && -n "${transition_head}" ]] ||
    fail "transition-base and transition-head must be supplied together"
fi
index_file="${cards_dir}/README.md"
[[ -f "${index_file}" ]] || fail "task card index is missing: README.md"

current_repository_head="$(git -C "${repo_root}" rev-parse --verify HEAD^{commit} 2>/dev/null)" ||
  fail "repository HEAD must resolve to a commit"
if [[ "${closure_cards_dir_is_canonical}" == 1 ]]; then
  i11_obsolete_oracle_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i11_obsolete_oracle_route_commit="${transition_base}"
  if [[ "${i11_obsolete_oracle_route_commit}" != "${w1_i11_obsolete_oracle_repair_origin_sha}" ]] &&
      git -C "${repo_root}" merge-base --is-ancestor \
        "${w1_i11_obsolete_oracle_repair_origin_sha}" \
        "${i11_obsolete_oracle_route_commit}" 2>/dev/null &&
      [[ -n "$(git -C "${repo_root}" rev-list -n 1 \
        "${w1_i11_obsolete_oracle_repair_origin_sha}..${i11_obsolete_oracle_route_commit}" -- \
        "${w1_i11_obsolete_oracle_repair_paths[0]}" 2>/dev/null)" ]]; then
    route_w1_i11_obsolete_oracle_repair "${i11_obsolete_oracle_route_commit}"
    exit 0
  fi
  i11_rebaseline_repair_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i11_rebaseline_repair_route_commit="${transition_base}"
  if [[ "${i11_rebaseline_repair_route_commit}" != "${w1_i11_rebaseline_review_repair_origin_sha}" ]] &&
      git -C "${repo_root}" merge-base --is-ancestor \
        "${w1_i11_rebaseline_review_repair_origin_sha}" \
        "${i11_rebaseline_repair_route_commit}" 2>/dev/null &&
      [[ -n "$(git -C "${repo_root}" rev-list -n 1 \
        "${w1_i11_rebaseline_review_repair_origin_sha}..${i11_rebaseline_repair_route_commit}" -- \
        "${w1_i11_rebaseline_review_repair_paths[0]}" 2>/dev/null)" ]]; then
    route_w1_i11_rebaseline_review_repair "${i11_rebaseline_repair_route_commit}"
    exit 0
  fi
  i11_rebaseline_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i11_rebaseline_route_commit="${transition_base}"
  if [[ "${i11_rebaseline_route_commit}" != "${w1_i11_persistence_rebaseline_origin_sha}" ]] &&
      [[ -n "$(git -C "${repo_root}" rev-list -n 1 \
        "${i11_rebaseline_route_commit}" -- \
        "${w1_i11_persistence_rebaseline_governance_paths[0]}" 2>/dev/null)" ]]; then
    route_w1_i11_persistence_rebaseline "${i11_rebaseline_route_commit}"
    exit 0
  fi
  i10_post_fixture_pin_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i10_post_fixture_pin_route_commit="${transition_base}"
  if [[ "${i10_post_fixture_pin_route_commit}" != "${w1_i10_post_fixture_pin_origin_sha}" ]] &&
      git -C "${repo_root}" merge-base --is-ancestor \
        "${w1_i10_post_fixture_pin_origin_sha}" "${i10_post_fixture_pin_route_commit}" 2>/dev/null &&
      [[ -n "$(git -C "${repo_root}" rev-list -n 1 \
        "${w1_i10_post_fixture_pin_origin_sha}..${i10_post_fixture_pin_route_commit}" -- \
        "${w1_i10_post_fixture_pin_paths[0]}" 2>/dev/null)" ]]; then
    [[ -z "${transition_base}" ]] || fail "I10_POST_FIXTURE_PIN_INVALID:explicit transition unsupported"
    route_w1_i10_post_fixture_pin "${i10_post_fixture_pin_route_commit}"
    exit 0
  fi
  i10_closure_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i10_closure_route_commit="${transition_base}"
  if [[ "${i10_closure_route_commit}" != "${w1_i10_closure_origin_sha}" ]] &&
      git -C "${repo_root}" merge-base --is-ancestor \
        "${w1_i10_closure_origin_sha}" "${i10_closure_route_commit}" 2>/dev/null &&
      [[ -n "$(git -C "${repo_root}" rev-list -n 1 \
        "${w1_i10_closure_origin_sha}..${i10_closure_route_commit}" -- \
        "${w1_i10_closure_governance_paths[0]}" 2>/dev/null)" ]]; then
    route_w1_i10_closure "${i10_closure_route_commit}"
    exit 0
  fi
  i09_closure_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i09_closure_route_commit="${transition_base}"
