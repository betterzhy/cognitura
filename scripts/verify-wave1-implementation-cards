      ;;
    *) write_expected_w1_i10_closure_tail "${governance_tip}" "${path}" "${output_file}" ;;
  esac
}

write_expected_w1_i10_closure_tail() {
  local governance_tip="$1" path="$2" output_file="$3"
  case "${path}" in
    docs/task-cards/wave-1/README.md)
      replace_w1_i10_closure_expected_first_field "${output_file}" ActiveImplementationGovernanceTaskCard W1-I11 "${path}"
      replace_w1_i10_closure_expected_text "${output_file}" \
        'I00、I01、I02、I03、I04、I05、I06、I07、I08 和 I09 已关闭；I10 已释放为唯一 `READY` 业务卡。' \
        'I00、I01、I02、I03、I04、I05、I06、I07、I08、I09 和 I10 已关闭；I11 已释放为唯一 `READY` 业务卡。' "${path}"
      ;;
    docs/task-cards/wave-1-implementation/README.md)
      replace_w1_i10_closure_expected_first_field "${output_file}" ActiveTaskCard W1-I11 "${path}"
      replace_w1_i10_closure_expected_text "${output_file}" \
        '| `W1-I10` | [来源预览查询](W1-I10-source-preview-query-api.md) | `READY` | `W1-I08,W1-I09` | `W1-IG10` | `HIGH` |' \
        '| `W1-I10` | [来源预览查询](W1-I10-source-preview-query-api.md) | `DONE` | `W1-I08,W1-I09` | `W1-IG10` | `HIGH` |' "${path}"
      replace_w1_i10_closure_expected_text "${output_file}" \
        '| `W1-I11` | [Partial acceptance](W1-I11-partial-acceptance-command-api.md) | `BLOCKED_BY_DEPENDENCY` | `W1-I10` | `W1-IG11` | `HIGH` |' \
        '| `W1-I11` | [Partial acceptance](W1-I11-partial-acceptance-command-api.md) | `READY` | `W1-I10` | `W1-IG11` | `HIGH` |' "${path}"
      replace_w1_i10_closure_expected_text "${output_file}" \
        '完成零发现深审并关闭；I02、I03、I04、I05、I06、I07、I08 和 I09 已关闭，I10 已释放为唯一 `READY` 卡。' \
        '完成零发现深审并关闭；I02、I03、I04、I05、I06、I07、I08、I09 和 I10 已关闭，I11 已释放为唯一 `READY` 卡。' "${path}"
      ;;
    docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md)
      replace_w1_i10_closure_expected_text "${output_file}" 'Status = READY' 'Status = DONE' "${path}"
      ;;
    docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md)
      replace_w1_i10_closure_expected_text "${output_file}" 'Status = BLOCKED_BY_DEPENDENCY' 'Status = READY' "${path}"
      replace_w1_i10_closure_expected_text "${output_file}" 'BusinessImplementationAuthorization = REQUIRED_BEFORE_READY' 'BusinessImplementationAuthorization = USER_AUTHORIZED' "${path}"
      ;;
    *) fail "I10_CLOSURE_PROJECTION_MISMATCH:unknown:${path}" ;;
  esac
}

validate_w1_i10_closure_receipt() {
  local governance_tip="$1" receipt="$2"
  local parent expected_paths actual_paths path expected_root actual_file index=0
  parent="$(single_parent_of "${receipt}" "I10_CLOSURE_RECEIPT_PATHS_INVALID:single parent")"
  [[ "${parent}" == "${governance_tip}" ]] || fail "I10_CLOSURE_RECEIPT_PATHS_INVALID:direct child"
  validate_w1_i10_closure_governance_chain "${governance_tip}"
  require_no_git_rename_or_copy "${parent}" "${receipt}" "I10_CLOSURE_RECEIPT_PATHS_INVALID:rename or copy"
  expected_paths="$(printf '%s\n' "${w1_i10_closure_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${receipt}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] || fail "I10_CLOSURE_RECEIPT_PATHS_INVALID:exact paths"
  for path in "${w1_i10_closure_projection_paths[@]}"; do
    [[ "$(git_tree_mode "${receipt}" "${path}")" == 100644 ]] || fail "I10_CLOSURE_RECEIPT_PATHS_INVALID:mode:${path}"
    require_git_blob_without_nul "${receipt}" "${path}" "I10_CLOSURE_RECEIPT_PATHS_INVALID:NUL:${path}"
  done
  [[ "$(git_tree_field "${receipt}" docs/task-cards/wave-1-implementation/README.md ActiveTaskCard)" == W1-I11 &&
     "$(git_tree_field "${receipt}" docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount)" == 1 &&
     "$(git_tree_field "${receipt}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status)" == DONE &&
     "$(git_tree_field "${receipt}" docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md Status)" == READY &&
     "$(git_tree_field "${receipt}" docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md BusinessImplementationAuthorization)" == USER_AUTHORIZED &&
     "$(git_tree_field "${receipt}" docs/task-cards/wave-1-implementation/W1-I12-desktop-web-source-preview.md Status)" == BLOCKED_BY_DEPENDENCY ]] ||
    fail "I10_CLOSURE_STATE_VECTOR_INVALID"
  require_w1_i10_closure_review_receipt "${receipt}" "${governance_tip}"
  register_temporary_directory expected_root cognitura-i10-closure-projection
  for path in "${w1_i10_closure_projection_paths[@]}"; do
    mkdir -p "${expected_root}/$(dirname "${path}")"
    write_expected_w1_i10_closure_file "${governance_tip}" "${path}" "${expected_root}/${path}"
    actual_file="${expected_root}/actual-${index}"
    git -C "${repo_root}" show "${receipt}:${path}" > "${actual_file}" || fail "I10_CLOSURE_PROJECTION_MISMATCH:actual:${path}"
    cmp -s "${expected_root}/${path}" "${actual_file}" || fail "I10_CLOSURE_PROJECTION_MISMATCH:content:${path}"
    index=$((index + 1))
  done
  remove_temporary_directory "${expected_root}"
  git -C "${repo_root}" diff --quiet "${w1_i10_closure_origin_sha}..${receipt}" -- "${w1_i10_product_paths[@]}" || fail "I10_CLOSURE_PRODUCT_DRIFT"
}

find_unique_w1_i10_closure_receipt() {
  local head="$1" commit parent pair found=""
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse "${w1_i10_closure_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" "I10_CLOSURE_RECEIPT_PATHS_INVALID:history")"
    pair="$(git_tree_field "${parent}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status):$(git_tree_field "${commit}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status):$(git_tree_field "${parent}" docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md Status):$(git_tree_field "${commit}" docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md Status)"
    if [[ "${pair}" == READY:DONE:BLOCKED_BY_DEPENDENCY:READY ]]; then
      [[ -z "${found}" ]] || fail "I10_CLOSURE_RECEIPT_PATHS_INVALID:duplicate"
      found="${commit}"
    fi
  done
  [[ -n "${found}" ]] || fail "I10_CLOSURE_RECEIPT_PATHS_INVALID:missing"
  printf '%s\n' "${found}"
}

is_w1_i11_product_path() {
  local requested="$1" allowed
  for allowed in "${w1_i11_product_paths[@]}"; do [[ "${requested}" == "${allowed}" ]] && return 0; done
  return 1
}

validate_post_w1_i10_closure_descendants() {
  local receipt="$1" head="$2" commit parent changed_paths path
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" "I10_CLOSURE_DESCENDANT_INVALID:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" && fail "I10_CLOSURE_DESCENDANT_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" "I10_CLOSURE_DESCENDANT_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i11_product_path "${path}" || fail "I10_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:${path}"
      [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] || fail "I10_CLOSURE_DESCENDANT_INVALID:mode:${path}"
      require_git_blob_without_nul "${commit}" "${path}" "I10_CLOSURE_DESCENDANT_INVALID:NUL:${path}"
    done <<< "${changed_paths}"
  done
}

route_w1_i10_closure() {
  local route_commit="$1" resolved_base resolved_head vector receipt governance_tip path
  validate_w1_i10_closure_predecessor
  if [[ -n "${transition_base}" ]]; then
    resolved_base="$(git -C "${repo_root}" rev-parse --verify "${transition_base}^{commit}" 2>/dev/null)" || fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:BASE"
    resolved_head="$(git -C "${repo_root}" rev-parse --verify "${transition_head}^{commit}" 2>/dev/null)" || fail "I10_CLOSURE_RECEIPT_PATHS_INVALID:HEAD"
    validate_w1_i10_closure_receipt "${resolved_base}" "${resolved_head}"
    printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' 'TaskCardCount = 14' \
      'TaskCardSetStatus = READY_FOR_EXECUTION' 'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
      'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' 'W1I10ClosureStatus = PASS' \
      'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
    return 0
  fi
  vector="$(git_tree_field "${route_commit}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status):$(git_tree_field "${route_commit}" docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md Status)"
  case "${vector}" in
    READY:BLOCKED_BY_DEPENDENCY)
      validate_w1_i10_closure_governance_chain "${route_commit}"
      for path in "${w1_i10_closure_governance_paths[@]}" "${w1_i10_closure_projection_paths[@]}" "${w1_i10_product_paths[@]}"; do
        git -C "${repo_root}" diff --quiet "${route_commit}" -- "${path}" || fail "I10_CLOSURE_WORKTREE_MISMATCH:${path}"
      done
      printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' 'TaskCardCount = 14' \
        'TaskCardSetStatus = READY_FOR_EXECUTION' 'ActiveTaskCard = W1-I10' 'ReadyTaskCardCount = 1' \
        'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' 'W1I10ClosureStatus = PENDING' \
        'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
      ;;
    DONE:READY)
      receipt="$(find_unique_w1_i10_closure_receipt "${route_commit}")"
      governance_tip="$(single_parent_of "${receipt}" "I10_CLOSURE_RECEIPT_PATHS_INVALID:governance tip")"
      validate_w1_i10_closure_receipt "${governance_tip}" "${receipt}"
      validate_post_w1_i10_closure_descendants "${receipt}" "${route_commit}"
      printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' 'TaskCardCount = 14' \
        'TaskCardSetStatus = READY_FOR_EXECUTION' 'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
        'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' 'W1I10ClosureStatus = PASS' \
        'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
      ;;
    *) fail "I10_CLOSURE_STATE_VECTOR_INVALID:static" ;;
  esac
}

validate_w1_i10_post_fixture_pin_chain() {
  local tip="$1"
  local commits=() commit parent previous changed_paths index expected_path expected_mode
  local actual_blob expected_blob evidence_sha
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i10_post_fixture_pin_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I10_POST_FIXTURE_PIN_INVALID:origin"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i10_post_fixture_pin_origin_sha}..${tip}")
  [[ "${#commits[@]}" -eq 3 ]] || fail "I10_POST_FIXTURE_PIN_INVALID:exact three commits"
  previous="${w1_i10_post_fixture_pin_origin_sha}"
  for index in "${!commits[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i10_post_fixture_pin_paths[${index}]}"
    parent="$(single_parent_of "${commit}" "I10_POST_FIXTURE_PIN_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] || fail "I10_POST_FIXTURE_PIN_INVALID:order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" && fail "I10_POST_FIXTURE_PIN_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" "I10_POST_FIXTURE_PIN_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    [[ "${changed_paths}" == "${expected_path}" ]] || fail "I10_POST_FIXTURE_PIN_INVALID:path"
    case "${expected_path}" in scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;; *) expected_mode=100644 ;; esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] || fail "I10_POST_FIXTURE_PIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" "I10_POST_FIXTURE_PIN_INVALID:NUL"
    if [[ "${index}" -lt 2 ]]; then
      evidence_sha="${w1_i10_post_fixture_pin_evidence_shas[${index}]}"
      actual_blob="$(git -C "${repo_root}" rev-parse "${commit}:${expected_path}" 2>/dev/null)" || fail "I10_POST_FIXTURE_PIN_INVALID:evidence"
      expected_blob="$(git -C "${repo_root}" rev-parse "${evidence_sha}:${expected_path}" 2>/dev/null)" || fail "I10_POST_FIXTURE_PIN_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] || fail "I10_POST_FIXTURE_PIN_INVALID:evidence"
    fi
    previous="${commit}"
  done
  git -C "${repo_root}" diff --quiet \
    "${w1_i10_post_fixture_pin_origin_sha}..${tip}" -- \
    "${w1_i10_product_paths[@]}" "${w1_i10_closure_projection_paths[@]}" ||
    fail "I10_POST_FIXTURE_PIN_INVALID:frozen bytes"
}

route_w1_i10_post_fixture_pin() {
  local route_commit="$1" receipt governance_tip correction_tip
  correction_tip="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i10_post_fixture_pin_origin_sha}..${route_commit}" | sed -n '3p')"
  [[ -n "${correction_tip}" ]] || fail "I10_POST_FIXTURE_PIN_INVALID:missing tip"
  validate_w1_i10_post_fixture_pin_chain "${correction_tip}"
  receipt="${w1_i10_post_fixture_pin_origin_sha}"
  governance_tip="$(single_parent_of "${receipt}" "I10_POST_FIXTURE_PIN_INVALID:closure parent")"
  [[ "${governance_tip}" == "14428d6ce4a9624d0205f12cf611591bb7092f22" ]] ||
    fail "I10_POST_FIXTURE_PIN_INVALID:closure identity"
  validate_w1_i10_closure_receipt "${governance_tip}" "${receipt}"
  validate_post_w1_i10_closure_descendants "${correction_tip}" "${route_commit}"
  printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' 'TaskCardCount = 14' \
    'TaskCardSetStatus = READY_FOR_EXECUTION' 'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
    'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' 'W1I10ClosureStatus = PASS' \
    'W1I10PostFixturePinStatus = PASS' 'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
}

validate_w1_i11_persistence_rebaseline_governance() {
  local tip="$1" commits=() commit parent previous changed_paths index
  local expected_path expected_mode evidence_sha actual_blob expected_blob
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i11_persistence_rebaseline_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I11_PERSISTENCE_REBASELINE_INVALID:origin"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i11_persistence_rebaseline_origin_sha}..${tip}")
  case "${#commits[@]}" in
    4|8) ;;
    *) fail "I11_PERSISTENCE_REBASELINE_INVALID:exact governance commits" ;;
  esac
  previous="${w1_i11_persistence_rebaseline_origin_sha}"
  for index in "${!commits[@]}"; do
    commit="${commits[${index}]}"
    if [[ "${#commits[@]}" -eq 4 ]]; then
      expected_path="${w1_i11_persistence_rebaseline_governance_paths[${index}]}"
    else
      expected_path="${w1_i11_persistence_rebaseline_actual_paths[${index}]}"
    fi
    parent="$(single_parent_of "${commit}" "I11_PERSISTENCE_REBASELINE_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I11_PERSISTENCE_REBASELINE_INVALID:order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I11_PERSISTENCE_REBASELINE_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I11_PERSISTENCE_REBASELINE_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    [[ "${changed_paths}" == "${expected_path}" ]] ||
      fail "I11_PERSISTENCE_REBASELINE_INVALID:path"
    case "${expected_path}" in
      scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
      *) expected_mode=100644 ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I11_PERSISTENCE_REBASELINE_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I11_PERSISTENCE_REBASELINE_INVALID:NUL"
    if [[ ( "${#commits[@]}" -eq 4 && "${index}" -lt 3 ) ||
          ( "${#commits[@]}" -eq 8 && "${index}" -lt 7 ) ]]; then
      if [[ "${#commits[@]}" -eq 4 ]]; then
        evidence_sha="${w1_i11_persistence_rebaseline_evidence_shas[${index}]}"
      else
        evidence_sha="${w1_i11_persistence_rebaseline_actual_evidence_shas[${index}]}"
      fi
      actual_blob="$(git -C "${repo_root}" rev-parse "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I11_PERSISTENCE_REBASELINE_INVALID:evidence"
      expected_blob="$(git -C "${repo_root}" rev-parse "${evidence_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I11_PERSISTENCE_REBASELINE_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I11_PERSISTENCE_REBASELINE_INVALID:evidence"
    fi
    previous="${commit}"
  done
  git -C "${repo_root}" diff --quiet \
    "${w1_i11_persistence_rebaseline_origin_sha}..${tip}" -- \
    "${w1_i10_product_paths[@]}" "${w1_i10_closure_projection_paths[@]}" ||
    fail "I11_PERSISTENCE_REBASELINE_INVALID:frozen predecessor"
}

is_w1_i11_rebaseline_product_path() {
  local requested="$1" allowed
  for allowed in "${w1_i11_persistence_rebaseline_product_paths[@]}"; do
    [[ "${requested}" == "${allowed}" ]] && return 0
  done
  return 1
}

write_expected_w1_i11_rebaseline_file() {
  local governance_tip="$1" path="$2" output_file="$3"
  local write_set forbidden_set validation_block
  git -C "${repo_root}" show "${governance_tip}:${path}" > "${output_file}" 2>/dev/null ||
    fail "I11_PERSISTENCE_REBASELINE_PROJECTION_MISMATCH:base:${path}"
  case "${path}" in
    docs/task-cards/wave-1-implementation/README.md)
      perl -i.bak -pe \
        'if (/^ImplementationGovernanceReviewVerdict = /) { $_ .= "I11PersistenceRebaseline = PASS\n" }' \
        "${output_file}"
      rm -f "${output_file}.bak"
      replace_w1_i10_closure_expected_text "${output_file}" \
        '完成零发现深审并关闭；I02、I03、I04、I05、I06、I07、I08、I09 和 I10 已关闭，I11 已释放为唯一 `READY` 卡。' \
        '完成零发现深审并关闭；I02、I03、I04、I05、I06、I07、I08、I09 和 I10 已关闭，I11 已完成持久化重基线并保持唯一 `READY` 卡。' "${path}"
      ;;
    docs/task-cards/wave-1-implementation/W1-I11-partial-acceptance-command-api.md)
      replace_w1_i10_closure_expected_first_field "${output_file}" \
        PrimaryBoundary SOURCE_PARTIAL_ACCEPTANCE_COMMAND "${path}"
      replace_w1_i10_closure_expected_first_field "${output_file}" \
        ProductionFileLimit 10 "${path}"
      replace_w1_i10_closure_expected_first_field "${output_file}" \
        ProductionWriteSetException APPROVED_I11_PERSISTENCE_REBASELINE "${path}"
      write_set="$(printf '%s\n' "${w1_i11_persistence_rebaseline_product_paths[@]}" | sed 's/^/WriteSet = /')"
      forbidden_set="$(printf '%s\n' \
        'ForbiddenWriteSet = server/src/main/java/io/cognitura/source/docx/**' \
        'ForbiddenWriteSet = web/**,raw/**,.idea/**' \
        'ForbiddenWriteSet = FORMAL_DATABASE_CONNECTION_OR_WRITE')"
      validation_block="$(printf '%s\n' \
        './mvnw -f server/pom.xml -Dtest='\''io.cognitura.source.api.acceptance.*Test,io.cognitura.source.api.query.SourcePreviewControllerTest'\'' test' \
        'scripts/verify-wave1-implementation' \
        'git diff --check' \
        'git status --short')"
      I11_WRITE_SET="${write_set}" perl -0777 -i.bak -pe \
        's/(?:^WriteSet = .*\n)+/$ENV{I11_WRITE_SET}."\n"/mge' "${output_file}"
      rm -f "${output_file}.bak"
      I11_FORBIDDEN_SET="${forbidden_set}" perl -0777 -i.bak -pe \
        's/(?:^ForbiddenWriteSet = .*\n)+/$ENV{I11_FORBIDDEN_SET}."\n"/mge' "${output_file}"
      rm -f "${output_file}.bak"
      replace_w1_i10_closure_expected_text "${output_file}" \
        '本卡不修改 preview query 或 Web。' \
        '本卡只为 ACCEPTED 兼容修改既有 preview query；不修改 Web。' "${path}"
      I11_VALIDATION_BLOCK="${validation_block}" perl -0777 -i.bak -pe \
        's~(?<=```bash\n).*?(?=```\n\n## 6\.)~$ENV{I11_VALIDATION_BLOCK}."\n"~se' "${output_file}"
      rm -f "${output_file}.bak"
      replace_w1_i10_closure_expected_text "${output_file}" \
        '完整 digest/actor/idempotency tuple、不可逆性、相同重放和冲突拒绝全部通过；无 query、' \
        '完整 digest/actor/idempotency tuple、不可逆性、相同重放、并发 CAS 和冲突拒绝全部通过；' "${path}"
      replace_w1_i10_closure_expected_text "${output_file}" \
        'Parser、migration 或 Web 改动。' \
        '证据来自隔离 PostgreSQL 18.4，且无 Web、Parser 或正式数据库改动。' "${path}"
      ;;
    *) fail "I11_PERSISTENCE_REBASELINE_PROJECTION_MISMATCH:unknown:${path}" ;;
  esac
}

validate_w1_i11_persistence_rebaseline_projection() {
  local governance_tip="$1" projection="$2" parent expected_paths actual_paths
  local path expected_root actual_file index=0
  parent="$(single_parent_of "${projection}" \
    "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:single parent")"
  [[ "${parent}" == "${governance_tip}" ]] ||
    fail "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:direct child"
  require_no_git_rename_or_copy "${parent}" "${projection}" \
    "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:rename or copy"
  expected_paths="$(printf '%s\n' "${w1_i11_persistence_rebaseline_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${projection}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:exact paths"
  for path in "${w1_i11_persistence_rebaseline_projection_paths[@]}"; do
    [[ "$(git_tree_mode "${projection}" "${path}")" == 100644 ]] ||
      fail "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:mode:${path}"
    require_git_blob_without_nul "${projection}" "${path}" \
      "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:NUL:${path}"
  done
  [[ "$(git_tree_field "${projection}" "${w1_i11_card_path}" Status)" == READY &&
     "$(git_tree_field "${projection}" "${w1_i11_card_path}" BusinessImplementationAuthorization)" == USER_AUTHORIZED &&
     "$(git_tree_field "${projection}" "${w1_i11_card_path}" FormalDatabaseGate)" == NOT_APPLICABLE &&
     "$(git_tree_field "${projection}" "${w1_i11_card_path}" RemotePush)" == NOT_AUTHORIZED &&
     "$(git_tree_field "${projection}" "${w1_i11_card_path}" ProductionFileLimit)" == 10 ]] ||
    fail "I11_PERSISTENCE_REBASELINE_PROJECTION_MISMATCH:state"
  register_temporary_directory expected_root cognitura-i11-rebaseline-projection
  for path in "${w1_i11_persistence_rebaseline_projection_paths[@]}"; do
    mkdir -p "${expected_root}/$(dirname "${path}")"
    write_expected_w1_i11_rebaseline_file "${governance_tip}" "${path}" "${expected_root}/${path}"
    actual_file="${expected_root}/actual-${index}"
    git -C "${repo_root}" show "${projection}:${path}" > "${actual_file}" ||
      fail "I11_PERSISTENCE_REBASELINE_PROJECTION_MISMATCH:actual:${path}"
    cmp -s "${expected_root}/${path}" "${actual_file}" ||
      fail "I11_PERSISTENCE_REBASELINE_PROJECTION_MISMATCH:content:${path}"
    index=$((index + 1))
  done
  remove_temporary_directory "${expected_root}"
}

validate_post_w1_i11_persistence_rebaseline_descendants() {
  local projection="$1" head="$2" commit parent changed_paths path
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${projection}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I11_PERSISTENCE_REBASELINE_DESCENDANT_INVALID:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I11_PERSISTENCE_REBASELINE_DESCENDANT_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I11_PERSISTENCE_REBASELINE_DESCENDANT_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i11_rebaseline_product_path "${path}" ||
        fail "I11_PERSISTENCE_REBASELINE_DESCENDANT_OUTSIDE_WRITE_SET:${path}"
      [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
        fail "I11_PERSISTENCE_REBASELINE_DESCENDANT_INVALID:mode:${path}"
      require_git_blob_without_nul "${commit}" "${path}" \
        "I11_PERSISTENCE_REBASELINE_DESCENDANT_INVALID:NUL:${path}"
    done <<< "${changed_paths}"
  done
}

route_w1_i11_persistence_rebaseline() {
  local route_commit="$1" governance_tip projection path
  [[ -z "${transition_base}" ]] ||
    fail "I11_PERSISTENCE_REBASELINE_INVALID:explicit transition unsupported"
  governance_tip="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i11_persistence_rebaseline_origin_sha}..${route_commit}" -- \
    scripts/verify-wave1-implementation-cards | sed -n '1p')"
  [[ -n "${governance_tip}" ]] ||
    fail "I11_PERSISTENCE_REBASELINE_INVALID:missing governance tip"
  validate_w1_i11_persistence_rebaseline_governance "${governance_tip}"
  if [[ "${route_commit}" == "${governance_tip}" ]]; then
    for path in "${w1_i11_persistence_rebaseline_actual_paths[@]}" \
        "${w1_i10_product_paths[@]}" "${w1_i10_closure_projection_paths[@]}"; do
      git -C "${repo_root}" diff --quiet "${route_commit}" -- "${path}" ||
        fail "I11_PERSISTENCE_REBASELINE_WORKTREE_MISMATCH:${path}"
    done
    printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' \
      'TaskCardCount = 14' 'TaskCardSetStatus = READY_FOR_EXECUTION' \
      'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
      'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' \
      'W1I10ClosureStatus = PASS' 'W1I10PostFixturePinStatus = PASS' \
      'W1I11PersistenceRebaselineStatus = PENDING' \
      'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
    return 0
  fi
  projection="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${governance_tip}..${route_commit}" | sed -n '1p')"
  [[ -n "${projection}" ]] ||
    fail "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:missing"
  validate_w1_i11_persistence_rebaseline_projection "${governance_tip}" "${projection}"
  validate_post_w1_i11_persistence_rebaseline_descendants "${projection}" "${route_commit}"
  for path in "${w1_i11_persistence_rebaseline_projection_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${projection}" -- "${path}" ||
      fail "I11_PERSISTENCE_REBASELINE_WORKTREE_MISMATCH:${path}"
  done
  printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' \
    'TaskCardCount = 14' 'TaskCardSetStatus = READY_FOR_EXECUTION' \
    'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
    'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' \
    'W1I10ClosureStatus = PASS' 'W1I10PostFixturePinStatus = PASS' \
    'W1I11PersistenceRebaselineStatus = PASS' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
}

validate_w1_i11_rebaseline_review_repair() {
  local tip="$1" commits=() commit parent previous changed_paths index
  local expected_path expected_mode evidence_sha actual_blob expected_blob
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i11_rebaseline_review_repair_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:origin"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i11_rebaseline_review_repair_origin_sha}..${tip}")
  [[ "${#commits[@]}" -eq 3 ]] ||
    fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:exact three commits"
  previous="${w1_i11_rebaseline_review_repair_origin_sha}"
  for index in "${!commits[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i11_rebaseline_review_repair_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I11_REBASELINE_REVIEW_REPAIR_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I11_REBASELINE_REVIEW_REPAIR_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    [[ "${changed_paths}" == "${expected_path}" ]] ||
      fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:path"
    case "${expected_path}" in
      scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
      *) expected_mode=100644 ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I11_REBASELINE_REVIEW_REPAIR_INVALID:NUL"
    if [[ "${index}" -lt 2 ]]; then
      evidence_sha="${w1_i11_rebaseline_review_repair_evidence_shas[${index}]}"
      actual_blob="$(git -C "${repo_root}" rev-parse "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:evidence"
      expected_blob="$(git -C "${repo_root}" rev-parse "${evidence_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:evidence"
    fi
    previous="${commit}"
  done
  validate_w1_i11_persistence_rebaseline_governance \
    "${w1_i11_rebaseline_review_repair_origin_sha}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i11_rebaseline_review_repair_origin_sha}..${tip}" -- \
    "${w1_i10_product_paths[@]}" "${w1_i10_closure_projection_paths[@]}" \
    "${w1_i11_persistence_rebaseline_projection_paths[@]}" ||
    fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:frozen bytes"
}

route_w1_i11_rebaseline_review_repair() {
  local route_commit="$1" correction_tip projection path
  [[ -z "${transition_base}" ]] ||
    fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:explicit transition unsupported"
  correction_tip="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i11_rebaseline_review_repair_origin_sha}..${route_commit}" -- \
    scripts/verify-wave1-implementation-cards | sed -n '1p')"
  [[ -n "${correction_tip}" ]] ||
    fail "I11_REBASELINE_REVIEW_REPAIR_INVALID:missing correction tip"
  validate_w1_i11_rebaseline_review_repair "${correction_tip}"
  if [[ "${route_commit}" == "${correction_tip}" ]]; then
    for path in "${w1_i11_rebaseline_review_repair_paths[@]}" \
        "${w1_i11_persistence_rebaseline_projection_paths[@]}"; do
      git -C "${repo_root}" diff --quiet "${route_commit}" -- "${path}" ||
        fail "I11_REBASELINE_REVIEW_REPAIR_WORKTREE_MISMATCH:${path}"
    done
    printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' \
      'TaskCardCount = 14' 'TaskCardSetStatus = READY_FOR_EXECUTION' \
      'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
      'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' \
      'W1I10ClosureStatus = PASS' 'W1I10PostFixturePinStatus = PASS' \
      'W1I11PersistenceRebaselineStatus = PENDING' \
      'W1I11PersistenceRebaselineReviewFindingStatus = PASS' \
      'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
    return 0
  fi
  projection="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${correction_tip}..${route_commit}" | sed -n '1p')"
  [[ -n "${projection}" ]] ||
    fail "I11_PERSISTENCE_REBASELINE_PROJECTION_PATHS_INVALID:missing"
  validate_w1_i11_persistence_rebaseline_projection "${correction_tip}" "${projection}"
  validate_post_w1_i11_persistence_rebaseline_descendants "${projection}" "${route_commit}"
  for path in "${w1_i11_persistence_rebaseline_projection_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${projection}" -- "${path}" ||
      fail "I11_PERSISTENCE_REBASELINE_WORKTREE_MISMATCH:${path}"
  done
  printf '%s\n' 'Wave1ImplementationTaskCardValidation = PASS' \
    'TaskCardCount = 14' 'TaskCardSetStatus = READY_FOR_EXECUTION' \
    'ActiveTaskCard = W1-I11' 'ReadyTaskCardCount = 1' \
    'W1I09RuntimeRebaselineStatus = PASS' 'W1I09ClosureStatus = PASS' \
    'W1I10ClosureStatus = PASS' 'W1I10PostFixturePinStatus = PASS' \
    'W1I11PersistenceRebaselineStatus = PASS' \
    'W1I11PersistenceRebaselineReviewFindingStatus = PASS' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' 'RemotePush = NOT_AUTHORIZED'
}

