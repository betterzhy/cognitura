      set -- ${closure_receipt_pair}
      closure_receipt_parent="$1"
      closure_receipt="$2"
      validate_w1_i03_closure_receipt \
        "${closure_receipt_parent}" "${closure_receipt}" 0
      validate_post_w1_i03_closure_descendants \
        "${closure_receipt}" "${current_repository_head}"
      git -C "${repo_root}" diff --quiet \
        "${closure_receipt}..${current_repository_head}" -- \
