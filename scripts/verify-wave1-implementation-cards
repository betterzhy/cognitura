validate_post_w1_i09_runtime_projection_descendants() {
  local projection="$1"
  local head="$2"
  local commit parent changed_paths path expected_path expected_mode
  local copy_repair_state="BEFORE" verifier_steps=0 finding_verifier_steps=0
  local reentry_verifier_steps=0 bridge_verifier_steps=0 bridge_product_seen=0
  local bridge_freeze_fix_steps=0 bridge_selector_steps=0 bridge_review_steps=0
  local v2_compatibility_steps=0 v2_compatibility_product_seen=0
  local post_product_fixture_steps=0 post_product_fixture_seen=0
  local fixture_diagnostic_steps=0 focused_current_steps=0
  local i08_fixture_pin_state="BEFORE"
  local v2_fixture_pin_state="BEFORE" actual_blob
  local final_review_state="BEFORE" final_review_verifier_steps=0
  local bridge_projection=""
  [[ "${projection}" != "${head}" ]] || return 0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
      "${projection}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I09_RUNTIME_REBASELINE_PRODUCT_INVALID:single parent")"
