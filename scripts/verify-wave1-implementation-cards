copy_nul_free_file() {
  local input_file="$1"
  local output_file="$2"
  local failure_context="$3"
  if ! LC_ALL=C tr -d '\000' < "${input_file}" > "${output_file}"; then
    fail "${failure_context}"
  fi
  cmp -s "${input_file}" "${output_file}" || fail "${failure_context}"
}

normalize_narrative_pair_file() {
  local input_file="$1"
  local output_file="$2"
  local suspended_text="$3"
  local ready_text="$4"
  local marker="$5"
  local expected_state="$6"
  local failure_context="$7"
  local expected_text unexpected_text
  case "${expected_state}" in
    SUSPENDED)
      expected_text="${suspended_text}"
      unexpected_text="${ready_text}"
      ;;
    READY)
      expected_text="${ready_text}"
      unexpected_text="${suspended_text}"
      ;;
    *) fail "unsupported narrative projection state: ${expected_state}" ;;
  esac
  if ! perl -0777 -e '
    use strict;
    use warnings;
    use bytes;
    my ($expected, $unexpected, $marker) = @ARGV;
    my $text = <STDIN>;
    $text = q{} unless defined $text;
    my $first = index($text, $expected);
    exit 2 if $first < 0;
    exit 3 if index($text, $expected, $first + length($expected)) >= 0;
    exit 4 if index($text, $unexpected) >= 0;
    substr($text, $first, length($expected), $marker);
    print STDOUT $text or exit 5;
  ' -- "${expected_text}" "${unexpected_text}" "${marker}" \
    < "${input_file}" > "${output_file}"; then
    fail "${failure_context}"
  fi
}

normalize_projection_narratives_file() {
  local input_file="$1"
  local output_file="$2"
  local path="$3"
  local expected_state="$4"
  local failure_context="$5"
  local binary_failure_context="${6:-${failure_context}}"
  local narrative_index matched=0 current_file next_file
  current_file="${output_file}.nul-free"
  copy_nul_free_file \
    "${input_file}" "${current_file}" "${binary_failure_context}: ${path}"
  for narrative_index in "${!suspension_narratives[@]}"; do
    [[ "${suspension_narrative_paths[${narrative_index}]}" == "${path}" ]] || continue
    matched=1
    next_file="${output_file}.narrative-${narrative_index}"
    normalize_narrative_pair_file \
      "${current_file}" \
      "${next_file}" \
      "${suspension_narratives[${narrative_index}]}" \
      "${ready_narratives[${narrative_index}]}" \
      "__W1_RESTORE_NARRATIVE_${narrative_index}__" \
      "${expected_state}" \
      "${failure_context}: ${path}"
    current_file="${next_file}"
  done
  if [[ "${path}" != docs/task-cards/wave-1-implementation/W1-I03-docx-security-gate.md ]]; then
    [[ "${matched}" -eq 1 ]] || fail "missing exact narrative contract for ${path}"
  fi
  cp "${current_file}" "${output_file}" ||
    fail "could not materialize normalized narrative projection: ${path}"
}

require_current_suspension_narratives() {
  local path narrative_validation_dir narrative_validation_index=0
  register_temporary_directory \
    narrative_validation_dir cognitura-current-narratives
  for path in \
    AGENTS.md \
    README.md \
    docs/design/wave-1/README.md \
    docs/engineering/cognitura-design-index.md \
    docs/engineering/cognitura-wave-1-design-plan.md \
    docs/engineering/cognitura-wave-1-design-acceptance.md \
    docs/engineering/cognitura-wave-1-implementation-plan.md \
    docs/task-cards/wave-1/README.md \
    docs/task-cards/wave-1-implementation/README.md; do
    [[ -f "${repo_root}/${path}" ]] || fail "projection file is missing: ${path}"
    normalize_projection_narratives_file \
      "${repo_root}/${path}" \
      "${narrative_validation_dir}/normalized-${narrative_validation_index}" \
      "${path}" SUSPENDED \
      "current suspension narrative projection mismatch"
    narrative_validation_index=$((narrative_validation_index + 1))
  done
  remove_temporary_directory "${narrative_validation_dir}"
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    fail "SHA-256 tool is unavailable"
  fi
}

normalized_card_digest() {
  local file="$1"
  sed -E \
    -e 's/^Status = .*/Status = __MUTABLE__/' \
    -e 's/^BusinessImplementationAuthorization = .*/BusinessImplementationAuthorization = __MUTABLE__/' \
    -e 's/^FormalDatabaseGate = .*/FormalDatabaseGate = __MUTABLE__/' \
    "${file}" | sha256_stream
}

normalized_i03_digest() {
  local file="$1"
  sed -E 's/^Status = .*/Status = __MUTABLE__/' "${file}" | sha256_stream
}

