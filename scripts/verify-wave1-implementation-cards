git_tree_mode() {
  local commit="$1"
  local path="$2"
  git -C "${repo_root}" ls-tree "${commit}" -- "${path}" | awk '{print $1}'
}

git_tree_field() {
  local commit="$1"
  local path="$2"
  local key="$3"
  local content count
  content="$(git -C "${repo_root}" show "${commit}:${path}" 2>/dev/null)" ||
    fail "transition tree is missing ${path}"
  count="$(printf '%s\n' "${content}" | grep -c "^${key} = " || true)"
  [[ "${count}" -eq 1 ]] || fail "transition ${path}: ${key} must occur exactly once"
  printf '%s\n' "${content}" | sed -n "s/^${key} = //p"
}

require_git_tree_field() {
  local commit="$1"
  local path="$2"
  local key="$3"
  local expected="$4"
  [[ "$(git_tree_field "${commit}" "${path}" "${key}")" == "${expected}" ]] ||
    fail "transition ${path}: ${key} must equal ${expected}"
}

require_git_blob_without_nul() {
  local commit="$1"
  local path="$2"
  local failure_message="$3"
  local raw_file clean_file
  register_temporary_directory raw_file cognitura-i03-nul
  clean_file="${raw_file}/clean"
  git -C "${repo_root}" show "${commit}:${path}" > "${raw_file}/raw" 2>/dev/null || {
    remove_temporary_directory "${raw_file}"
    fail "${failure_message}"
  }
  LC_ALL=C tr -d '\000' < "${raw_file}/raw" > "${clean_file}" || {
    remove_temporary_directory "${raw_file}"
    fail "${failure_message}"
  }
  cmp -s "${raw_file}/raw" "${clean_file}" || {
    remove_temporary_directory "${raw_file}"
    fail "${failure_message}"
  }
  remove_temporary_directory "${raw_file}"
}

require_no_git_rename_or_copy() {
  local base="$1"
  local head="$2"
  local failure_message="$3"
  local status_file status
  register_temporary_directory status_file cognitura-i03-name-status
  git -C "${repo_root}" -c diff.renameLimit=0 diff-tree \
    --no-commit-id --name-status -r -M -C --find-copies-harder \
    "${base}" "${head}" > "${status_file}/status" || {
    remove_temporary_directory "${status_file}"
    fail "${failure_message}"
  }
  while IFS=$'\t' read -r status _; do
    case "${status}" in
      R*|C*)
        remove_temporary_directory "${status_file}"
        fail "${failure_message}"
        ;;
    esac
  done < "${status_file}/status"
  remove_temporary_directory "${status_file}"
}

is_w1_i04_inferred_xml_fixture_copy() {
  local base="$1"
  local head="$2"
  local status="$3"
  local source="$4"
  local target="$5"
  local base_source_blob head_source_blob
  [[ "${status}" == C* ]] || return 1
  case "${source}" in
    server/src/test/resources/docx/security/minimal-document.xml|\
    server/src/test/resources/docx/text/*.xml) ;;
    *) return 1 ;;
  esac
  case "${target}" in
    server/src/test/resources/docx/text/*.xml) ;;
    *) return 1 ;;
  esac
  [[ "$(git_tree_mode "${base}" "${source}")" == 100644 ]] || return 1
  [[ "$(git_tree_mode "${head}" "${source}")" == 100644 ]] || return 1
  [[ "$(git_tree_mode "${head}" "${target}")" == 100644 ]] || return 1
  git -C "${repo_root}" cat-file -e "${base}:${target}" 2>/dev/null && return 1
  base_source_blob="$(git -C "${repo_root}" rev-parse "${base}:${source}" 2>/dev/null)" ||
    return 1
  head_source_blob="$(git -C "${repo_root}" rev-parse "${head}:${source}" 2>/dev/null)" ||
    return 1
  [[ "${base_source_blob}" == "${head_source_blob}" ]]
}

require_no_git_rename_or_copy_except_w1_i04_xml_fixture_copy() {
  local base="$1"
  local head="$2"
  local failure_message="$3"
  local status_file status source target
  register_temporary_directory status_file cognitura-i04-name-status
  git -C "${repo_root}" -c diff.renameLimit=0 diff-tree \
    --no-commit-id --name-status -r -M -C --find-copies-harder \
    "${base}" "${head}" > "${status_file}/status" || {
    remove_temporary_directory "${status_file}"
    fail "${failure_message}"
  }
  while IFS=$'\t' read -r status source target; do
    case "${status}" in
      R*)
        remove_temporary_directory "${status_file}"
        fail "${failure_message}"
        ;;
      C*)
        is_w1_i04_inferred_xml_fixture_copy \
          "${base}" "${head}" "${status}" "${source}" "${target}" || {
          remove_temporary_directory "${status_file}"
          fail "${failure_message}"
        }
        ;;
    esac
  done < "${status_file}/status"
  remove_temporary_directory "${status_file}"
}

is_w1_i05_inferred_xml_fixture_copy() {
  local base="$1"
  local head="$2"
  local status="$3"
  local source="$4"
  local target="$5"
  local base_source_blob head_source_blob base_source_mode head_source_mode
  [[ "${status}" == C* ]] || return 1
  case "${target}" in
    server/src/test/resources/docx/table/*.xml) ;;
    *) return 1 ;;
  esac
  git -C "${repo_root}" cat-file -e "${base}:${target}" 2>/dev/null && return 1
  [[ "$(git_tree_mode "${head}" "${target}")" == 100644 ]] || return 1
  base_source_blob="$(git -C "${repo_root}" rev-parse \
    "${base}:${source}" 2>/dev/null)" || return 1
  head_source_blob="$(git -C "${repo_root}" rev-parse \
    "${head}:${source}" 2>/dev/null)" || return 1
  [[ "${base_source_blob}" == "${head_source_blob}" ]] || return 1
  base_source_mode="$(git_tree_mode "${base}" "${source}")"
  head_source_mode="$(git_tree_mode "${head}" "${source}")"
  [[ -n "${base_source_mode}" && \
     "${base_source_mode}" == "${head_source_mode}" ]]
}

require_no_git_rename_or_copy_except_w1_i05_xml_fixture_copy() {
  local base="$1"
  local head="$2"
  local failure_message="$3"
  local status_file status source target
  register_temporary_directory status_file cognitura-i05-name-status
  git -C "${repo_root}" -c diff.renameLimit=0 diff-tree \
    --no-commit-id --name-status -r -M -C --find-copies-harder \
    "${base}" "${head}" > "${status_file}/status" || {
    remove_temporary_directory "${status_file}"
    fail "${failure_message}"
  }
  while IFS=$'\t' read -r status source target; do
    case "${status}" in
      R*)
        remove_temporary_directory "${status_file}"
        fail "${failure_message}"
        ;;
      C*)
        is_w1_i05_inferred_xml_fixture_copy \
          "${base}" "${head}" "${status}" "${source}" "${target}" || {
          remove_temporary_directory "${status_file}"
          fail "${failure_message}"
        }
        ;;
    esac
  done < "${status_file}/status"
  remove_temporary_directory "${status_file}"
}

validate_w1_i03_closure_governance_chain() {
  local tip="$1"
  local resolved_origin resolved_tip merge_commits commit parent changed_paths path
  local commit_count=0 design_count=0 plan_count=0 test_count=0 verifier_count=0
  resolved_origin="$(git -C "${repo_root}" rev-parse --verify \
    "${w1_i03_closure_origin_sha}^{commit}" 2>/dev/null)" ||
    fail "I03 closure origin commit is unavailable"
  [[ "${resolved_origin}" == "${w1_i03_closure_origin_sha}" ]] ||
    fail "I03 closure origin commit mismatch"
  resolved_tip="$(git -C "${repo_root}" rev-parse --verify "${tip}^{commit}" 2>/dev/null)" ||
    fail "I03 closure governance tip must resolve to a commit"
  git -C "${repo_root}" merge-base --is-ancestor "${resolved_origin}" "${resolved_tip}" ||
    fail "I03 closure governance tip must descend from the fixed origin"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i03_reviewed_candidate_sha}" "${resolved_tip}" ||
    fail "reviewed W1-I03 candidate must be an ancestor of the closure governance tip"

  merge_commits="$(git -C "${repo_root}" rev-list --min-parents=2 \
    "${resolved_origin}..${resolved_tip}")"
  [[ -z "${merge_commits}" ]] ||
    fail "I03 closure governance commit must have exactly one parent"
  git -C "${repo_root}" diff --quiet \
    "${w1_i03_reviewed_candidate_sha}..${resolved_tip}" -- \
    "${w1_i03_frozen_production_paths[@]}" ||
    fail "reviewed W1-I03 production must remain byte-identical"

  for commit in $(git -C "${repo_root}" rev-list --reverse \
    "${resolved_origin}..${resolved_tip}"); do
    commit_count=$((commit_count + 1))
    parent="$(single_parent_of "${commit}" "I03 closure governance commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I03 closure governance commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I03 closure governance commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk 'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "I03 closure governance changed a path outside the exact four-path WriteSet"
    path="${changed_paths}"
    case "${path}" in
      "${w1_i03_closure_design_path}")
        design_count=$((design_count + 1))
        ;;
      "${w1_i03_closure_plan_path}")
        plan_count=$((plan_count + 1))
        ;;
      tests/task-cards/verify-wave1-implementation-cards.sh)
        test_count=$((test_count + 1))
        ;;
      scripts/verify-wave1-implementation-cards)
        verifier_count=$((verifier_count + 1))
        ;;
      *) fail "I03 closure governance changed a path outside the exact four-path WriteSet" ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${path}")" == \
       "$(w1_i03_closure_mode_for_path "${path}")" ]] ||
      fail "I03 closure governance path mode mismatch"
    require_git_blob_without_nul "${commit}" "${path}" \
      "I03 closure governance path must not contain NUL"
    case "${path}" in
      "${w1_i03_closure_design_path}")
        [[ "${design_count}" -eq 1 ]] ||
          fail "I03 closure governance path changed more than once"
        ;;
      "${w1_i03_closure_plan_path}")
        [[ "${plan_count}" -eq 1 ]] ||
          fail "I03 closure governance path changed more than once"
        ;;
      tests/task-cards/verify-wave1-implementation-cards.sh)
        [[ "${test_count}" -eq 1 ]] ||
          fail "I03 closure governance path changed more than once"
        ;;
      scripts/verify-wave1-implementation-cards)
        [[ "${verifier_count}" -eq 1 ]] ||
          fail "I03 closure governance path changed more than once"
        ;;
    esac
  done

  [[ "${commit_count}" -eq 4 && "${design_count}" -eq 1 && \
     "${plan_count}" -eq 1 && "${test_count}" -eq 1 && \
     "${verifier_count}" -eq 1 ]] ||
    fail "I03 closure governance chain must have the exact four-path cumulative WriteSet"
  for path in "${!w1_i03_closure_governance_paths[@]}"; do
    commit="$(git -C "${repo_root}" rev-list --reverse \
      "${resolved_origin}..${resolved_tip}" | sed -n "$((path + 1))p")"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "$(single_parent_of "${commit}" "I03 closure governance commit")..${commit}")"
    [[ "${changed_paths}" == "${w1_i03_closure_governance_paths[${path}]}" ]] ||
      fail "I03 closure governance paths must be introduced in canonical order"
  done
  require_git_tree_field "${resolved_tip}" "${w1_i03_closure_design_path}" \
    ClosureOriginSHA "${w1_i03_closure_origin_sha}"
  require_git_tree_field "${resolved_tip}" "${w1_i03_closure_design_path}" \
    ReviewedCandidateSHA "${w1_i03_reviewed_candidate_sha}"
  require_git_tree_field "${resolved_tip}" "${w1_i03_closure_design_path}" \
    TransitionKind I03_CLOSE_ADVANCE
}

w1_i03_closure_schema_current() {
  local commit="$1"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i03_closure_origin_sha}" "${commit}" 2>/dev/null || return 1
  ! git -C "${repo_root}" diff --quiet \
    "${w1_i03_closure_origin_sha}..${commit}" -- \
    "${w1_i03_closure_governance_paths[@]}"
}

require_w1_i03_closure_review_receipt() {
  local commit="$1"
  local receipt_dir plan_file actual_block expected_block
  register_temporary_directory receipt_dir cognitura-i03-review-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${commit}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
    remove_temporary_directory "${receipt_dir}"
    fail "I03 closure review receipt mismatch"
  }
  [[ "$(grep -c '^## 8\. I03 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I03 closure review receipt mismatch"
  }
  sed -n '/^## 8\. I03 关闭收据$/,$p' "${plan_file}" > "${receipt_dir}/actual"
  cat > "${receipt_dir}/expected" <<'EOF'
## 8. I03 关闭收据

```text
W1-I03 = DONE
ReviewedCandidate = 4e63936c631ab34807e714b90d30415a959bc13d
ReviewLevel = L3
ReviewRoute = deep_reviewer
ReviewEffort = xhigh
ReviewMultiplicity = ONE
ReviewVerdict = GO
P0 = 0
P1 = 0
P2 = 0
Ultra = NOT_RUN
I03ClosureReleasedTaskCard = W1-I04
QueuedTaskCard = W1-I02
QueuedReason = INDEPENDENT_DATABASE_GATE_REQUIRED
```
EOF
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I03 closure review receipt mismatch"
  }
  actual_block="$(sed -n '/^## 8\. I03 关闭收据$/,$p' "${plan_file}")"
  expected_block="$(<"${receipt_dir}/expected")"
  [[ "${actual_block}" == "${expected_block}" ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I03 closure review receipt mismatch"
  }
  remove_temporary_directory "${receipt_dir}"
}

require_w1_i03_closure_projection_field() {
  local commit="$1"
  local path="$2"
  local field="$3"
  local expected="$4"
  [[ "$(git_tree_field "${commit}" "${path}" "${field}")" == "${expected}" ]] ||
    fail "I03 closure projection field mismatch"
}

require_w1_i03_closure_projection_targets() {
  local commit="$1"
  require_w1_i03_closure_projection_field "${commit}" AGENTS.md \
    ActiveImplementationTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" README.md \
    ActiveImplementationTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/design/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/engineering/cognitura-design-index.md ActiveTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/engineering/cognitura-design-index.md \
    ActiveImplementationTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/engineering/cognitura-wave-1-design-plan.md \
    ActiveImplementationGovernanceTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md \
    ImplementationTaskCardPlanStatus I03_COMPLETE_I04_READY
  require_w1_i03_closure_projection_field "${commit}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md \
    ActiveImplementationGovernanceTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md \
    ActiveTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/task-cards/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I04
  require_w1_i03_closure_projection_field "${commit}" \
    docs/task-cards/wave-1-implementation/README.md ActiveTaskCard W1-I04

  require_exact_git_tree_table_row \
    "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I03 \
    '| `W1-I03` | DOCX security | `I01` | `DONE` |' \
    'I03 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I04 \
    '| `W1-I04` | Text/list/section parser | `I03` | `READY` |' \
    'I03 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/task-cards/wave-1-implementation/README.md W1-I03 \
    '| `W1-I03` | [DOCX 安全闸](W1-I03-docx-security-gate.md) | `DONE` | `W1-I01` | `W1-IG3` | `HIGH` |' \
    'I03 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/task-cards/wave-1-implementation/README.md W1-I04 \
    '| `W1-I04` | [文本、列表与章节](W1-I04-text-list-section-parser.md) | `READY` | `W1-I03` | `W1-IG4` | `HIGH` |' \
    'I03 closure projection table mismatch'
}

require_working_w1_i03_production_frozen() {
  local untracked ignored_untracked
  git -C "${repo_root}" diff --quiet \
    "${w1_i03_reviewed_candidate_sha}" -- \
    "${w1_i03_frozen_production_paths[@]}" ||
    fail "working W1-I03 production must match the reviewed candidate"
  untracked="$(git -C "${repo_root}" ls-files --others --exclude-standard -- \
    "${w1_i03_frozen_production_paths[@]}")"
  [[ -z "${untracked}" ]] ||
    fail "working W1-I03 production must match the reviewed candidate"
  ignored_untracked="$(git -C "${repo_root}" ls-files --others --ignored \
    --exclude-standard -- "${w1_i03_frozen_production_paths[@]}")"
  [[ -z "${ignored_untracked}" ]] ||
    fail "working W1-I03 production must match the reviewed candidate"
}

is_w1_i03_closure_projection_path() {
  local candidate_path="$1"
  local projection_path
  for projection_path in "${w1_i03_closure_projection_paths[@]}"; do
    [[ "${candidate_path}" == "${projection_path}" ]] && return 0
  done
  return 1
}

is_w1_i04_descendant_path() {
  case "$1" in
    server/src/main/java/io/cognitura/source/docx/text/TextListSectionParser.java|\
    server/src/main/java/io/cognitura/source/docx/text/DocumentBlockCandidate.java|\
    server/src/main/java/io/cognitura/source/docx/text/SectionPathTracker.java|\
    server/src/main/java/io/cognitura/source/docx/text/ListSemantics.java|\
    server/src/main/java/io/cognitura/source/docx/text/SourceOrderCursor.java|\
    server/src/test/java/io/cognitura/source/docx/text/TextListSectionParserTest.java|\
    server/src/test/java/io/cognitura/source/docx/text/SectionPathTrackerTest.java|\
    server/src/test/resources/docx/text/*)
      return 0
      ;;
  esac
  return 1
}

validate_post_w1_i03_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" "post-closure descendant commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "post-closure descendant commit must be nonempty"
    require_no_git_rename_or_copy_except_w1_i04_xml_fixture_copy \
      "${parent}" "${commit}" \
      "post-closure descendant commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i03_closure_projection_path "${path}" &&
        fail "I03 closure is allowed exactly once"
      is_w1_i04_descendant_path "${path}" ||
        fail "post-closure descendant changed a path outside the W1-I04 WriteSet"
    done <<< "${changed_paths}"
  done
}

find_unique_w1_i03_closure_receipt() {
  local head="$1"
  local commit parent current_state parent_state
  local receipt="" receipt_parent="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i03_closure_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" "I03 closure provenance commit")"
    current_state="$(git_tree_field "${commit}" "${w1_i03_card_path}" Status):$(
      git_tree_field "${commit}" "${w1_i04_card_path}" Status)"
    parent_state="$(git_tree_field "${parent}" "${w1_i03_card_path}" Status):$(
      git_tree_field "${parent}" "${w1_i04_card_path}" Status)"
    if [[ "${parent_state}" == READY:BLOCKED_BY_DEPENDENCY && \
          "${current_state}" == DONE:READY ]]; then
      receipt_count=$((receipt_count + 1))
      receipt_parent="${parent}"
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] || fail "I03 closure is allowed exactly once"
  printf '%s %s\n' "${receipt_parent}" "${receipt}"
}

normalize_w1_i03_closure_narratives() {
  local input_file="$1"
  local output_file="$2"
  local path="$3"
  local state="$4"
  local narrative_state narrative_index matched=0 current_file next_file
  case "${state}" in
    BASE) narrative_state=SUSPENDED ;;
    HEAD) narrative_state=READY ;;
    *) fail "unsupported I03 closure narrative state: ${state}" ;;
  esac
  current_file="${output_file}.nul-free"
  copy_nul_free_file "${input_file}" "${current_file}" \
    "I03 closure receipt projection must not contain NUL: ${path}"
  for narrative_index in "${!ready_narratives[@]}"; do
    [[ "${suspension_narrative_paths[${narrative_index}]}" == "${path}" ]] || continue
    matched=1
    next_file="${output_file}.narrative-${narrative_index}"
    normalize_narrative_pair_file \
      "${current_file}" "${next_file}" \
      "${ready_narratives[${narrative_index}]}" \
      "${w1_i04_ready_narratives[${narrative_index}]}" \
      "__W1_I03_CLOSURE_NARRATIVE_${narrative_index}__" \
      "${narrative_state}" \
      "I03 closure narrative projection mismatch: ${path}"
    current_file="${next_file}"
  done
  case "${path}" in
    "${w1_i03_card_path}"|"${w1_i04_card_path}") ;;
    *) [[ "${matched}" -eq 1 ]] || fail "missing I03 closure narrative contract for ${path}" ;;
  esac
  cp "${current_file}" "${output_file}" ||
    fail "could not normalize I03 closure narrative projection: ${path}"
}

write_normalized_w1_i03_closure_file() {
  local commit="$1"
  local path="$2"
  local output_file="$3"
  local state="$4"
  local raw_file narrative_file
  raw_file="${output_file}.raw"
  narrative_file="${output_file}.narratives"
  git -C "${repo_root}" show "${commit}:${path}" > "${raw_file}" 2>/dev/null ||
    fail "transition tree is missing ${path}"
  if [[ "${state}" == HEAD && \
        "${path}" == docs/engineering/cognitura-wave-1-implementation-plan.md ]]; then
    sed -i.bak '/^## 8\. I03 关闭收据$/,$d' "${raw_file}"
    rm "${raw_file}.bak"
    sed -i.bak '${/^$/d;}' "${raw_file}"
    rm "${raw_file}.bak"
  fi
  normalize_w1_i03_closure_narratives \
    "${raw_file}" "${narrative_file}" "${path}" "${state}"
  case "${path}" in
    AGENTS.md|README.md)
      sed -E 's/^ActiveImplementationTaskCard = .*/ActiveImplementationTaskCard = __I03_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/design/wave-1/README.md|docs/engineering/cognitura-wave-1-design-plan.md|docs/task-cards/wave-1/README.md)
      sed -E 's/^ActiveImplementationGovernanceTaskCard = .*/ActiveImplementationGovernanceTaskCard = __I03_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-design-index.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I03_CLOSURE__/' \
        -e 's/^ActiveImplementationTaskCard = .*/ActiveImplementationTaskCard = __I03_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-wave-1-design-acceptance.md)
      sed -E \
        -e 's/^ImplementationTaskCardPlanStatus = .*/ImplementationTaskCardPlanStatus = __I03_CLOSURE__/' \
        -e 's/^ActiveImplementationGovernanceTaskCard = .*/ActiveImplementationGovernanceTaskCard = __I03_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-wave-1-implementation-plan.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I03_CLOSURE__/' \
        -e '/^\| `W1-I03` \|/ s/\| `(READY|DONE)` \|$/| `__I03_CLOSURE__` |/' \
        -e '/^\| `W1-I04` \|/ s/\| `(BLOCKED_BY_DEPENDENCY|READY)` \|$/| `__I03_CLOSURE__` |/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/task-cards/wave-1-implementation/README.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I03_CLOSURE__/' \
        -e '/^\| `W1-I03` \|/ s/\| `(READY|DONE)` \|/| `__I03_CLOSURE__` |/' \
        -e '/^\| `W1-I04` \|/ s/\| `(BLOCKED_BY_DEPENDENCY|READY)` \|/| `__I03_CLOSURE__` |/' \
        "${narrative_file}" > "${output_file}"
      ;;
    "${w1_i03_card_path}")
      sed -E 's/^Status = .*/Status = __I03_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    "${w1_i04_card_path}")
      sed -E \
        -e 's/^Status = .*/Status = __I03_CLOSURE__/' \
        -e 's/^BusinessImplementationAuthorization = .*/BusinessImplementationAuthorization = __I03_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    *) fail "unsupported I03 closure projection path: ${path}" ;;
  esac
}

validate_w1_i03_closure_receipt() {
  local base="$1"
  local head="$2"
  local require_working_tree="${3:-0}"
  local resolved_base resolved_head expected_paths actual_paths path base_mode head_mode
  local compare_dir compare_index=0 index_content ready_rows
  resolved_base="$(git -C "${repo_root}" rev-parse --verify "${base}^{commit}" 2>/dev/null)" ||
    fail "I03 closure receipt BASE must resolve to a commit"
  resolved_head="$(git -C "${repo_root}" rev-parse --verify "${head}^{commit}" 2>/dev/null)" ||
    fail "I03 closure receipt HEAD must resolve to a commit"
  [[ "$(single_parent_of "${resolved_head}" "I03 closure receipt HEAD")" == \
     "${resolved_base}" ]] ||
    fail "I03 closure receipt HEAD must be the direct child of BASE"
  validate_w1_i03_closure_governance_chain "${resolved_base}"
  require_no_git_rename_or_copy "${resolved_base}" "${resolved_head}" \
    "I03 closure receipt must not rename or copy paths"
  expected_paths="$(printf '%s\n' "${w1_i03_closure_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${resolved_base}..${resolved_head}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I03 closure receipt fixed diff must equal the exact eleven projection paths"
  for path in "${w1_i03_closure_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${resolved_base}" "${path}")"
    head_mode="$(git_tree_mode "${resolved_head}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I03 closure receipt must preserve every projection path mode"
    require_git_blob_without_nul "${resolved_head}" "${path}" \
      "I03 closure receipt projection must not contain NUL"
  done

  require_git_tree_field "${resolved_base}" "${w1_i03_card_path}" Status READY
  require_git_tree_field "${resolved_base}" "${w1_i04_card_path}" Status BLOCKED_BY_DEPENDENCY
  [[ "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md ActiveTaskCard)" == W1-I04 ]] ||
    fail "I03 closure receipt may release only W1-I04"
  if [[ "$(git_tree_field "${resolved_head}" "${w1_i03_card_path}" Status)" != DONE ||
        "$(git_tree_field "${resolved_head}" "${w1_i04_card_path}" Status)" != READY ]]; then
    fail "I03 closure receipt must set I03 DONE and I04 READY"
  fi

  index_content="$(git -C "${repo_root}" show \
    "${resolved_head}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "transition tree is missing docs/task-cards/wave-1-implementation/README.md"
  ready_rows="$(printf '%s\n' "${index_content}" | \
    grep -c '| `READY` |' || true)"
  [[ "${ready_rows}" -eq 1 ]] ||
    fail "I03 closure receipt must release exactly one READY card"
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I04 \
    '| `W1-I04` | [文本、列表与章节](W1-I04-text-list-section-parser.md) | `READY` | `W1-I03` | `W1-IG4` | `HIGH` |' \
    'I03 closure receipt must set I03 DONE and I04 READY'
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I05 \
    '| `W1-I05` | [表格保真](W1-I05-table-fidelity.md) | `BLOCKED_BY_DEPENDENCY` | `W1-I04` | `W1-IG5` | `HIGH` |' \
    'I03 closure receipt may release only W1-I04'
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I02 \
    '| `W1-I02` | [来源持久化](W1-I02-source-persistence.md) | `QUEUED` | `W1-I01` | `W1-IG2` | `HIGH` |' \
    'I03 closure must keep W1-I02 queued behind its database gate'
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I02 \
    '| `W1-I02` | Source persistence | `I01` | `QUEUED` |' \
    'I03 closure must keep W1-I02 queued behind its database gate'
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I02-source-persistence.md Status QUEUED
  [[ "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite)" == NOT_AUTHORIZED &&
     "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md RemotePush)" == NOT_AUTHORIZED ]] ||
    fail "I03 closure must preserve database and push authorization boundaries"

  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 1
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md SuspendedTaskCardCount 0
  require_git_tree_field "${resolved_head}" "${w1_i04_card_path}" \
    BusinessImplementationAuthorization USER_AUTHORIZED
  require_w1_i03_closure_projection_targets "${resolved_head}"
  require_w1_i03_closure_review_receipt "${resolved_head}"

  register_temporary_directory compare_dir cognitura-i03-closure-compare
  for path in "${w1_i03_closure_projection_paths[@]}"; do
    write_normalized_w1_i03_closure_file \
      "${resolved_base}" "${path}" "${compare_dir}/base-${compare_index}" BASE
    write_normalized_w1_i03_closure_file \
      "${resolved_head}" "${path}" "${compare_dir}/head-${compare_index}" HEAD
    cmp -s "${compare_dir}/base-${compare_index}" \
      "${compare_dir}/head-${compare_index}" || {
      remove_temporary_directory "${compare_dir}"
      fail "I03 closure receipt must be an exact projection-only transform: ${path}"
    }
    compare_index=$((compare_index + 1))
  done
  remove_temporary_directory "${compare_dir}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i03_reviewed_candidate_sha}..${resolved_head}" -- \
    "${w1_i03_frozen_production_paths[@]}" ||
    fail "reviewed W1-I03 production must remain byte-identical"
  if [[ "${require_working_tree}" == 1 ]]; then
    git -C "${repo_root}" diff --quiet "${resolved_head}" -- \
      "${w1_i03_closure_projection_paths[@]}" ||
      fail "working projection must match I03 closure receipt"
    require_working_w1_i03_production_frozen
  fi
}

validate_w1_i04_closure_governance_chain() {
  local tip="$1"
  local origin resolved_tip commit parent changed_paths path expected_path
  local vsb_ledger_path="docs/task-cards/visual-style-baseline/execution-state.md"
  local commit_index=0
  origin="$(git -C "${repo_root}" rev-parse --verify \
    "${w1_i04_closure_origin_sha}^{commit}" 2>/dev/null)" ||
    fail "I04 closure origin commit is unavailable"
  [[ "${origin}" == "${w1_i04_closure_origin_sha}" ]] ||
    fail "I04 closure origin commit mismatch"
  [[ "$(git -C "${repo_root}" rev-parse --verify \
      "${w1_i04_vsb_terminal_restore_sha}^{commit}" 2>/dev/null)" == \
      "${w1_i04_vsb_terminal_restore_sha}" ]] ||
    fail "fixed VSB terminal restore snapshot identity mismatch"
  [[ "$(git_tree_mode "${w1_i04_vsb_terminal_restore_sha}" "${vsb_ledger_path}")" == 100644 &&
     "$(git -C "${repo_root}" rev-parse \
       "${w1_i04_vsb_terminal_restore_sha}:${vsb_ledger_path}" 2>/dev/null)" == \
       "${w1_i04_vsb_execution_ledger_blob}" ]] ||
    fail "fixed VSB terminal restore ledger identity mismatch"
  resolved_tip="$(git -C "${repo_root}" rev-parse --verify "${tip}^{commit}" 2>/dev/null)" ||
    fail "I04 closure governance tip must resolve to a commit"
  git -C "${repo_root}" merge-base --is-ancestor "${origin}" "${resolved_tip}" ||
    fail "I04 closure governance tip must descend from the fixed origin"
  [[ -z "$(git -C "${repo_root}" rev-list --min-parents=2 \
    "${origin}..${resolved_tip}")" ]] ||
    fail "I04 closure governance commit must have exactly one parent"
  git -C "${repo_root}" diff --quiet \
    "${w1_i04_reviewed_candidate_sha}..${resolved_tip}" -- \
    "${w1_i04_frozen_production_paths[@]}" ||
    fail "reviewed W1-I04 production must remain byte-identical"
  git -C "${repo_root}" diff --quiet "${origin}..${resolved_tip}" -- \
    "${w1_i04_closure_projection_paths[@]}" ||
    fail "I04 closure projection must remain unchanged before receipt"
  git -C "${repo_root}" diff --quiet "${origin}..${resolved_tip}" -- \
    "${vsb_ledger_path}" ||
    fail "I04 closure governance must not change the VSB execution ledger"
  for commit in "${w1_i04_reviewed_candidate_sha}" "${origin}" "${resolved_tip}"; do
    [[ "$(git_tree_mode "${commit}" "${vsb_ledger_path}")" == 100644 &&
       "$(git -C "${repo_root}" rev-parse \
         "${commit}:${vsb_ledger_path}" 2>/dev/null)" == \
         "${w1_i04_vsb_execution_ledger_blob}" ]] ||
      fail "I04 closure VSB execution ledger identity mismatch"
  done
  git -C "${repo_root}" diff --quiet "${resolved_tip}" -- "${vsb_ledger_path}" ||
    fail "working VSB execution ledger must match the fixed closure state"
  [[ "$(git -C "${repo_root}" hash-object \
      "${repo_root}/${vsb_ledger_path}" 2>/dev/null)" == \
      "${w1_i04_vsb_execution_ledger_blob}" ]] ||
    fail "working VSB execution ledger must match the fixed closure state"

  for commit in $(git -C "${repo_root}" rev-list --reverse \
    "${origin}..${resolved_tip}"); do
    parent="$(single_parent_of "${commit}" "I04 closure governance commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I04 closure governance commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I04 closure governance commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk 'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "I04 closure governance changed a path outside the exact four-path WriteSet"
    [[ "${commit_index}" -lt "${#w1_i04_closure_governance_paths[@]}" ]] ||
      fail "I04 closure governance chain must have the exact four-path cumulative WriteSet"
    expected_path="${w1_i04_closure_governance_paths[${commit_index}]}"
    path="${changed_paths}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "I04 closure governance paths must be introduced in canonical order"
    [[ "$(git_tree_mode "${commit}" "${path}")" == \
       "$(w1_i04_closure_mode_for_path "${path}")" ]] ||
      fail "I04 closure governance path mode mismatch"
    require_git_blob_without_nul "${commit}" "${path}" \
      "I04 closure governance path must not contain NUL"
    commit_index=$((commit_index + 1))
  done
  [[ "${commit_index}" -eq 4 ]] ||
    fail "I04 closure governance chain must have the exact four-path cumulative WriteSet"
  require_git_tree_field "${resolved_tip}" "${w1_i04_closure_design_path}" \
    ClosureOriginSHA "${w1_i04_closure_origin_sha}"
  require_git_tree_field "${resolved_tip}" "${w1_i04_closure_design_path}" \
    RejectedClosureCandidateSHA "${w1_i04_rejected_closure_candidate_sha}"
  require_git_tree_field "${resolved_tip}" "${w1_i04_closure_design_path}" \
    ReviewedCandidateSHA "${w1_i04_reviewed_candidate_sha}"
  require_git_tree_field "${resolved_tip}" "${w1_i04_closure_design_path}" \
    VSBTerminalRestoreSHA "${w1_i04_vsb_terminal_restore_sha}"
  require_git_tree_field "${resolved_tip}" "${w1_i04_closure_design_path}" \
    VSBExecutionLedgerBlob "${w1_i04_vsb_execution_ledger_blob}"
  require_git_tree_field "${resolved_tip}" "${w1_i04_closure_design_path}" \
    TransitionKind I04_CLOSE_ADVANCE
}

w1_i04_closure_schema_current() {
  local commit="$1"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i04_closure_origin_sha}" "${commit}" 2>/dev/null || return 1
  ! git -C "${repo_root}" diff --quiet \
    "${w1_i04_closure_origin_sha}..${commit}" -- \
    "${w1_i04_closure_governance_paths[@]}"
}

require_w1_i04_closure_review_receipt() {
  local commit="$1"
  local receipt_dir plan_file
  register_temporary_directory receipt_dir cognitura-i04-review-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${commit}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
    remove_temporary_directory "${receipt_dir}"
    fail "I04 closure review receipt mismatch"
  }
  [[ "$(grep -c '^## 9\. I04 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I04 closure review receipt mismatch"
  }
  sed -n '/^## 9\. I04 关闭收据$/,$p' "${plan_file}" > "${receipt_dir}/actual"
  cat > "${receipt_dir}/expected" <<'EOF'
## 9. I04 关闭收据

```text
W1-I04 = DONE
ReviewedCandidate = 4594406e9fd8a9ac380c3b2b880fda67271790bc
ReviewLevel = L3
ReviewRoute = deep_reviewer
ReviewEffort = xhigh
ReviewMultiplicity = ONE
ReviewVerdict = GO
P0 = 0
P1 = 0
P2 = 0
Ultra = NOT_RUN
I04ClosureReleasedTaskCard = W1-I05
QueuedTaskCard = W1-I02
QueuedReason = INDEPENDENT_DATABASE_GATE_REQUIRED
```
EOF
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I04 closure review receipt mismatch"
  }
  remove_temporary_directory "${receipt_dir}"
}

require_w1_i04_closure_projection_targets() {
  local commit="$1"
  require_git_tree_field "${commit}" AGENTS.md ActiveImplementationTaskCard W1-I05
  require_git_tree_field "${commit}" README.md ActiveImplementationTaskCard W1-I05
  require_git_tree_field "${commit}" docs/design/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I05
  require_git_tree_field "${commit}" docs/engineering/cognitura-design-index.md \
    ActiveTaskCard W1-I05
  require_git_tree_field "${commit}" docs/engineering/cognitura-design-index.md \
    ActiveImplementationTaskCard W1-I05
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-design-plan.md \
    ActiveImplementationGovernanceTaskCard W1-I05
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-design-acceptance.md \
    ImplementationTaskCardPlanStatus I04_COMPLETE_I05_READY
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-design-acceptance.md \
    ActiveImplementationGovernanceTaskCard W1-I05
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md \
    ActiveTaskCard W1-I05
  require_git_tree_field "${commit}" docs/task-cards/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I05
  require_git_tree_field "${commit}" docs/task-cards/wave-1-implementation/README.md \
    ActiveTaskCard W1-I05
  require_exact_git_tree_table_row \
    "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I04 \
    '| `W1-I04` | Text/list/section parser | `I03` | `DONE` |' \
    'I04 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I05 \
    '| `W1-I05` | Table fidelity | `I04` | `READY` |' \
    'I04 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/task-cards/wave-1-implementation/README.md W1-I04 \
    '| `W1-I04` | [文本、列表与章节](W1-I04-text-list-section-parser.md) | `DONE` | `W1-I03` | `W1-IG4` | `HIGH` |' \
    'I04 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/task-cards/wave-1-implementation/README.md W1-I05 \
    '| `W1-I05` | [表格保真](W1-I05-table-fidelity.md) | `READY` | `W1-I04` | `W1-IG5` | `HIGH` |' \
    'I04 closure projection table mismatch'
}

require_working_w1_i04_production_frozen() {
  local untracked ignored_untracked
  git -C "${repo_root}" diff --quiet "${w1_i04_reviewed_candidate_sha}" -- \
    "${w1_i04_frozen_production_paths[@]}" ||
    fail "working W1-I04 production must match the reviewed candidate"
  untracked="$(git -C "${repo_root}" ls-files --others --exclude-standard -- \
    "${w1_i04_frozen_production_paths[@]}")"
  [[ -z "${untracked}" ]] ||
    fail "working W1-I04 production must match the reviewed candidate"
  ignored_untracked="$(git -C "${repo_root}" ls-files --others --ignored \
    --exclude-standard -- "${w1_i04_frozen_production_paths[@]}")"
  [[ -z "${ignored_untracked}" ]] ||
    fail "working W1-I04 production must match the reviewed candidate"
}

is_w1_i04_closure_projection_path() {
  local candidate_path="$1"
  local projection_path
  for projection_path in "${w1_i04_closure_projection_paths[@]}"; do
    [[ "${candidate_path}" == "${projection_path}" ]] && return 0
  done
  return 1
}

is_w1_i05_descendant_path() {
  case "$1" in
    server/src/main/java/io/cognitura/source/docx/table/TableFidelityParser.java|\
    server/src/main/java/io/cognitura/source/docx/table/TableBlockCandidate.java|\
    server/src/main/java/io/cognitura/source/docx/table/TableCellCandidate.java|\
    server/src/main/java/io/cognitura/source/docx/table/TableMergeProjection.java|\
    server/src/main/java/io/cognitura/source/docx/table/TableTextEvidence.java|\
    server/src/test/java/io/cognitura/source/docx/table/TableFidelityParserTest.java|\
    server/src/test/java/io/cognitura/source/docx/table/TableMergeProjectionTest.java|\
    server/src/test/resources/docx/table/*)
      return 0
      ;;
  esac
  return 1
}

validate_post_w1_i04_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" "post-I04-closure descendant commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "post-I04-closure descendant commit must be nonempty"
    require_no_git_rename_or_copy_except_w1_i05_xml_fixture_copy \
      "${parent}" "${commit}" \
      "post-I04-closure descendant commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i04_closure_projection_path "${path}" &&
        fail "I04 closure is allowed exactly once"
      is_w1_i05_descendant_path "${path}" ||
        fail "post-I04-closure descendant changed a path outside the W1-I05 WriteSet"
    done <<< "${changed_paths}"
  done
}

validate_fixed_w1_i05_verifier_recovery() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path expected_path expected_commit expected_parent
  local recovery_index=0
  local actual_commits

  [[ "${receipt}" == "${w1_i05_verifier_recovery_origin_sha}" ]] ||
    fail "W1-I05 verifier recovery must start at the fixed I04 closure receipt"
  git -C "${repo_root}" cat-file -e \
    "${w1_i05_fixed_recovery_tip_sha}^{commit}" 2>/dev/null ||
    fail "fixed W1-I05 verifier recovery candidate is unavailable"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i05_fixed_recovery_tip_sha}" "${head}" ||
    fail "HEAD must descend from the fixed W1-I05 verifier recovery candidate"

  actual_commits="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${w1_i05_fixed_recovery_tip_sha}")"
  [[ "$(printf '%s\n' "${actual_commits}" | awk \
    'NF { count++ } END { print count + 0 }')" -eq \
    "${#w1_i05_fixed_recovery_commits[@]}" ]] ||
    fail "fixed W1-I05 verifier recovery commit count mismatch"

  for commit in ${actual_commits}; do
    expected_commit="${w1_i05_fixed_recovery_commits[${recovery_index}]}"
    [[ "${commit}" == "${expected_commit}" ]] ||
      fail "fixed W1-I05 verifier recovery commit identity mismatch"
    parent="$(single_parent_of "${commit}" "W1-I05 verifier recovery commit")"
    if [[ "${recovery_index}" -eq 0 ]]; then
      expected_parent="${receipt}"
    else
      expected_parent="${w1_i05_fixed_recovery_commits[$((recovery_index - 1))]}"
    fi
    [[ "${parent}" == "${expected_parent}" ]] ||
      fail "fixed W1-I05 verifier recovery parent identity mismatch"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "W1-I05 verifier recovery commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "W1-I05 verifier recovery commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "W1-I05 verifier recovery commit must change exactly one declared path"
    path="${changed_paths}"
    expected_path="${w1_i05_verifier_recovery_paths[${recovery_index}]}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "W1-I05 verifier recovery paths must follow the fixed order"
    [[ "$(git_tree_mode "${commit}" "${path}")" == \
       "$(w1_i05_verifier_recovery_mode_for_path "${path}")" ]] ||
      fail "W1-I05 verifier recovery path mode mismatch: ${path}"
    require_git_blob_without_nul "${commit}" "${path}" \
      "W1-I05 verifier recovery path must not contain NUL"
    recovery_index=$((recovery_index + 1))
  done

  [[ "${recovery_index}" -eq "${#w1_i05_verifier_recovery_paths[@]}" ]] ||
    fail "fixed W1-I05 verifier recovery chain is incomplete"
}

validate_w1_i05_review_repair_and_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path expected_path repair_tip=""
  local expected_blob actual_blob
  local repair_index=0

  validate_fixed_w1_i05_verifier_recovery "${receipt}" "${head}"
  git -C "${repo_root}" cat-file -e \
    "${w1_i05_fixed_review_repair_tip_sha}^{commit}" 2>/dev/null ||
    fail "fixed W1-I05 recovery review repair candidate is unavailable"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i05_fixed_review_repair_tip_sha}" "${head}" ||
    fail "HEAD must descend from the fixed W1-I05 recovery review repair candidate"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i05_fixed_recovery_tip_sha}..${w1_i05_fixed_review_repair_tip_sha}"); do
    parent="$(single_parent_of "${commit}" "W1-I05 review repair commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "W1-I05 review repair commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "W1-I05 review repair commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "W1-I05 review repair commit must change exactly one declared path"
    path="${changed_paths}"
    expected_path="${w1_i05_review_repair_paths[${repair_index}]}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "W1-I05 review repair paths must follow the fixed order"
    [[ "$(git_tree_mode "${commit}" "${path}")" == \
       "$(w1_i05_review_repair_mode_for_path "${path}")" ]] ||
      fail "W1-I05 review repair path mode mismatch"
    require_git_blob_without_nul "${commit}" "${path}" \
      "W1-I05 review repair path must not contain NUL"
    if [[ "${repair_index}" -lt \
          "${#w1_i05_review_repair_evidence_shas[@]}" ]]; then
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i05_review_repair_evidence_shas[${repair_index}]}:${path}" \
        2>/dev/null)" || fail "W1-I05 review repair evidence is unavailable"
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${path}" 2>/dev/null)" ||
        fail "W1-I05 review repair blob is unavailable"
      if [[ "${actual_blob}" != "${expected_blob}" ]]; then
        case "${repair_index}" in
          1) fail "W1-I05 review repair Markdown RED evidence mismatch" ;;
          2) fail "W1-I05 review repair Markdown GREEN evidence mismatch" ;;
          *) fail "W1-I05 review repair evidence mismatch: step ${repair_index} ${path}" ;;
        esac
      fi
    fi
    repair_tip="${commit}"
    repair_index=$((repair_index + 1))
  done

  [[ "${repair_index}" -eq "${#w1_i05_review_repair_paths[@]}" ]] ||
    fail "W1-I05 review repair chain is incomplete"
  [[ "${repair_tip}" == "${w1_i05_fixed_review_repair_tip_sha}" ]] ||
    fail "W1-I05 recovery review repair tip identity mismatch"
}

validate_w1_i05_literal_repair_and_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path expected_path repair_tip=""
  local expected_blob actual_blob
  local repair_index=0

  validate_w1_i05_review_repair_and_descendants "${receipt}" "${head}"
  git -C "${repo_root}" cat-file -e \
    "${w1_i05_fixed_literal_repair_tip_sha}^{commit}" 2>/dev/null ||
    fail "fixed W1-I05 literal pathspec repair candidate is unavailable"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i05_fixed_literal_repair_tip_sha}" "${head}" ||
    fail "HEAD must descend from the fixed W1-I05 literal pathspec repair candidate"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i05_literal_repair_origin_sha}..${w1_i05_fixed_literal_repair_tip_sha}"); do
    parent="$(single_parent_of "${commit}" \
      "W1-I05 literal pathspec repair commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "W1-I05 literal pathspec repair commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "W1-I05 literal pathspec repair commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "W1-I05 literal pathspec repair commit must change exactly one declared path"
    path="${changed_paths}"
    expected_path="${w1_i05_literal_repair_paths[${repair_index}]}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "W1-I05 literal pathspec repair paths must follow the fixed order"
    [[ "$(git_tree_mode "${commit}" "${path}")" == \
       "$(w1_i05_literal_repair_mode_for_path "${path}")" ]] ||
      fail "W1-I05 literal pathspec repair path mode mismatch"
    require_git_blob_without_nul "${commit}" "${path}" \
      "W1-I05 literal pathspec repair path must not contain NUL"
    if [[ "${repair_index}" -lt \
          "${#w1_i05_literal_repair_evidence_shas[@]}" ]]; then
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i05_literal_repair_evidence_shas[${repair_index}]}:${path}" \
        2>/dev/null)" ||
        fail "W1-I05 literal pathspec repair evidence is unavailable"
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${path}" 2>/dev/null)" ||
        fail "W1-I05 literal pathspec repair blob is unavailable"
      if [[ "${actual_blob}" != "${expected_blob}" ]]; then
        case "${repair_index}" in
          1) fail "W1-I05 literal pathspec repair Markdown RED evidence mismatch" ;;
          2) fail "W1-I05 literal pathspec repair Markdown GREEN evidence mismatch" ;;
          *) fail "W1-I05 literal pathspec repair evidence mismatch: step ${repair_index} ${path}" ;;
        esac
      fi
    fi
    repair_tip="${commit}"
    repair_index=$((repair_index + 1))
  done

  [[ "${repair_index}" -eq "${#w1_i05_literal_repair_paths[@]}" ]] ||
    fail "W1-I05 literal pathspec repair chain is incomplete"
  [[ "${repair_tip}" == "${w1_i05_fixed_literal_repair_tip_sha}" ]] ||
    fail "W1-I05 literal pathspec repair tip identity mismatch"
}

validate_fixed_w1_i05_implementation_candidate() {
  local head="$1"
  local actual_commits commit parent expected_commit expected_parent
  local changed_paths path
  local candidate_index=0

  git -C "${repo_root}" cat-file -e \
    "${w1_i05_fixed_fixture_correction_sha}^{commit}" 2>/dev/null ||
    fail "fixed W1-I05 implementation candidate is unavailable"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i05_fixed_fixture_correction_sha}" "${head}" ||
    fail "HEAD must descend from the fixed W1-I05 implementation candidate"
  actual_commits="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i05_fixed_literal_repair_tip_sha}..${w1_i05_fixed_fixture_correction_sha}")"
  [[ "$(printf '%s\n' "${actual_commits}" | awk \
    'NF { count++ } END { print count + 0 }')" -eq \
    "${#w1_i05_fixed_product_commits[@]}" ]] ||
    fail "fixed W1-I05 implementation commit count mismatch"

  for commit in ${actual_commits}; do
    expected_commit="${w1_i05_fixed_product_commits[${candidate_index}]}"
    [[ "${commit}" == "${expected_commit}" ]] ||
      fail "fixed W1-I05 implementation candidate identity mismatch"
    parent="$(single_parent_of "${commit}" "fixed W1-I05 implementation commit")"
    if [[ "${candidate_index}" -eq 0 ]]; then
      expected_parent="${w1_i05_fixed_literal_repair_tip_sha}"
    else
      expected_parent="${w1_i05_fixed_product_commits[$((candidate_index - 1))]}"
    fi
    [[ "${parent}" == "${expected_parent}" ]] ||
      fail "fixed W1-I05 implementation parent identity mismatch"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "fixed W1-I05 implementation commit must be nonempty"
    require_no_git_rename_or_copy_except_w1_i05_xml_fixture_copy \
      "${parent}" "${commit}" \
      "fixed W1-I05 implementation commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i05_descendant_path "${path}" ||
        fail "fixed W1-I05 implementation changed a path outside the WriteSet"
      [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
        fail "fixed W1-I05 implementation path mode mismatch"
      require_git_blob_without_nul "${commit}" "${path}" \
        "fixed W1-I05 implementation path must not contain NUL"
    done <<< "${changed_paths}"
    candidate_index=$((candidate_index + 1))
  done

  [[ "${candidate_index}" -eq "${#w1_i05_fixed_product_commits[@]}" ]] ||
    fail "fixed W1-I05 implementation chain is incomplete"
}

validate_w1_i05_xml_copy_repair_and_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path expected_path repair_tip=""
  local expected_blob actual_blob
  local repair_index=0

  validate_w1_i05_literal_repair_and_descendants "${receipt}" "${head}"
  validate_fixed_w1_i05_implementation_candidate "${head}"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i05_fixed_fixture_correction_sha}..${head}"); do
    if [[ "${repair_index}" -ge "${#w1_i05_xml_copy_repair_paths[@]}" ]]; then
      continue
    fi
    parent="$(single_parent_of "${commit}" "W1-I05 XML copy repair commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "W1-I05 XML copy repair commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "W1-I05 XML copy repair commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "W1-I05 XML copy repair commit must change exactly one declared path"
    path="${changed_paths}"
    expected_path="${w1_i05_xml_copy_repair_paths[${repair_index}]}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "W1-I05 XML copy repair paths must follow the fixed order"
    [[ "$(git_tree_mode "${commit}" "${path}")" == \
       "$(w1_i05_xml_copy_repair_mode_for_path "${path}")" ]] ||
      fail "W1-I05 XML copy repair path mode mismatch"
    require_git_blob_without_nul "${commit}" "${path}" \
      "W1-I05 XML copy repair path must not contain NUL"
    if [[ "${repair_index}" -lt \
          "${#w1_i05_xml_copy_repair_evidence_shas[@]}" ]]; then
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i05_xml_copy_repair_evidence_shas[${repair_index}]}:${path}" \
        2>/dev/null)" ||
        fail "W1-I05 XML copy repair evidence is unavailable"
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${path}" 2>/dev/null)" ||
        fail "W1-I05 XML copy repair blob is unavailable"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "W1-I05 XML copy repair evidence mismatch: step ${repair_index} ${path}"
    fi
    repair_tip="${commit}"
    repair_index=$((repair_index + 1))
  done

  [[ "${repair_index}" -eq "${#w1_i05_xml_copy_repair_paths[@]}" ]] ||
    fail "W1-I05 XML copy repair chain is incomplete"
  validate_post_w1_i04_closure_descendants "${repair_tip}" "${head}"
}

find_unique_w1_i04_closure_receipt() {
  local head="$1"
  local commit parent current_state parent_state
  local receipt="" receipt_parent="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i04_closure_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" "I04 closure provenance commit")"
    current_state="$(git_tree_field "${commit}" "${w1_i04_card_path}" Status):$(
      git_tree_field "${commit}" "${w1_i05_card_path}" Status)"
    parent_state="$(git_tree_field "${parent}" "${w1_i04_card_path}" Status):$(
      git_tree_field "${parent}" "${w1_i05_card_path}" Status)"
    if [[ "${parent_state}" == READY:BLOCKED_BY_DEPENDENCY && \
          "${current_state}" == DONE:READY ]]; then
      receipt_count=$((receipt_count + 1))
      receipt_parent="${parent}"
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] || fail "I04 closure is allowed exactly once"
  printf '%s %s\n' "${receipt_parent}" "${receipt}"
}

normalize_w1_i04_closure_narratives() {
  local input_file="$1"
  local output_file="$2"
  local path="$3"
  local state="$4"
  local expected_state narrative_index matched=0 current_file next_file
  case "${state}" in
    BASE) expected_state=SUSPENDED ;;
    HEAD) expected_state=READY ;;
    *) fail "unsupported I04 closure narrative state: ${state}" ;;
  esac
  current_file="${output_file}.nul-free"
  copy_nul_free_file "${input_file}" "${current_file}" \
    "I04 closure receipt projection must not contain NUL: ${path}"
  for narrative_index in "${!w1_i04_ready_narratives[@]}"; do
    [[ "${suspension_narrative_paths[${narrative_index}]}" == "${path}" ]] || continue
    matched=1
    next_file="${output_file}.narrative-${narrative_index}"
    normalize_narrative_pair_file \
      "${current_file}" "${next_file}" \
      "${w1_i04_ready_narratives[${narrative_index}]}" \
      "${w1_i05_ready_narratives[${narrative_index}]}" \
      "__W1_I04_CLOSURE_NARRATIVE_${narrative_index}__" \
      "${expected_state}" \
      "I04 closure narrative projection mismatch: ${path}"
    current_file="${next_file}"
  done
  case "${path}" in
    "${w1_i04_card_path}"|"${w1_i05_card_path}") ;;
    *) [[ "${matched}" -eq 1 ]] || fail "missing I04 closure narrative contract for ${path}" ;;
  esac
  cp "${current_file}" "${output_file}" ||
    fail "could not normalize I04 closure narrative projection: ${path}"
}

write_normalized_w1_i04_closure_file() {
  local commit="$1"
  local path="$2"
  local output_file="$3"
  local state="$4"
  local raw_file="${output_file}.raw"
  local narrative_file="${output_file}.narratives"
  git -C "${repo_root}" show "${commit}:${path}" > "${raw_file}" 2>/dev/null ||
    fail "transition tree is missing ${path}"
  if [[ "${state}" == HEAD && \
        "${path}" == docs/engineering/cognitura-wave-1-implementation-plan.md ]]; then
    sed -i.bak '/^## 9\. I04 关闭收据$/,$d' "${raw_file}"
    rm "${raw_file}.bak"
    sed -i.bak '${/^$/d;}' "${raw_file}"
    rm "${raw_file}.bak"
  fi
  normalize_w1_i04_closure_narratives \
    "${raw_file}" "${narrative_file}" "${path}" "${state}"
  case "${path}" in
    AGENTS.md|README.md)
      sed -E 's/^ActiveImplementationTaskCard = .*/ActiveImplementationTaskCard = __I04_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/design/wave-1/README.md|docs/engineering/cognitura-wave-1-design-plan.md|docs/task-cards/wave-1/README.md)
      sed -E 's/^ActiveImplementationGovernanceTaskCard = .*/ActiveImplementationGovernanceTaskCard = __I04_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-design-index.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I04_CLOSURE__/' \
        -e 's/^ActiveImplementationTaskCard = .*/ActiveImplementationTaskCard = __I04_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-wave-1-design-acceptance.md)
      sed -E \
        -e 's/^ImplementationTaskCardPlanStatus = .*/ImplementationTaskCardPlanStatus = __I04_CLOSURE__/' \
        -e 's/^ActiveImplementationGovernanceTaskCard = .*/ActiveImplementationGovernanceTaskCard = __I04_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-wave-1-implementation-plan.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I04_CLOSURE__/' \
        -e '/^\| `W1-I04` \|/ s/\| `(READY|DONE)` \|$/| `__I04_CLOSURE__` |/' \
        -e '/^\| `W1-I05` \|/ s/\| `(BLOCKED_BY_DEPENDENCY|READY)` \|$/| `__I04_CLOSURE__` |/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/task-cards/wave-1-implementation/README.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I04_CLOSURE__/' \
        -e '/^\| `W1-I04` \|/ s/\| `(READY|DONE)` \|/| `__I04_CLOSURE__` |/' \
        -e '/^\| `W1-I05` \|/ s/\| `(BLOCKED_BY_DEPENDENCY|READY)` \|/| `__I04_CLOSURE__` |/' \
        "${narrative_file}" > "${output_file}"
      ;;
    "${w1_i04_card_path}")
      sed -E 's/^Status = .*/Status = __I04_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    "${w1_i05_card_path}")
      sed -E \
        -e 's/^Status = .*/Status = __I04_CLOSURE__/' \
        -e 's/^BusinessImplementationAuthorization = .*/BusinessImplementationAuthorization = __I04_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    *) fail "unsupported I04 closure projection path: ${path}" ;;
  esac
}

validate_w1_i04_closure_receipt() {
  local base="$1"
  local head="$2"
  local require_working_tree="${3:-0}"
  local resolved_base resolved_head expected_paths actual_paths path base_mode head_mode
  local index_content ready_rows compare_dir compare_index=0
  resolved_base="$(git -C "${repo_root}" rev-parse --verify "${base}^{commit}" 2>/dev/null)" ||
    fail "I04 closure receipt BASE must resolve to a commit"
  resolved_head="$(git -C "${repo_root}" rev-parse --verify "${head}^{commit}" 2>/dev/null)" ||
    fail "I04 closure receipt HEAD must resolve to a commit"
  [[ "$(single_parent_of "${resolved_head}" "I04 closure receipt HEAD")" == \
     "${resolved_base}" ]] ||
    fail "I04 closure receipt HEAD must be the direct child of BASE"
  validate_w1_i04_closure_governance_chain "${resolved_base}"
  require_no_git_rename_or_copy "${resolved_base}" "${resolved_head}" \
    "I04 closure receipt must not rename or copy paths"
  expected_paths="$(printf '%s\n' "${w1_i04_closure_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${resolved_base}..${resolved_head}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I04 closure receipt fixed diff must equal the exact eleven projection paths"
  for path in "${w1_i04_closure_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${resolved_base}" "${path}")"
    head_mode="$(git_tree_mode "${resolved_head}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I04 closure receipt must preserve every projection path mode"
    require_git_blob_without_nul "${resolved_head}" "${path}" \
      "I04 closure receipt projection must not contain NUL"
  done
  require_git_tree_field "${resolved_base}" "${w1_i04_card_path}" Status READY
  require_git_tree_field "${resolved_base}" "${w1_i05_card_path}" Status BLOCKED_BY_DEPENDENCY
  if [[ "$(git_tree_field "${resolved_head}" "${w1_i04_card_path}" Status)" != DONE ||
        "$(git_tree_field "${resolved_head}" "${w1_i05_card_path}" Status)" != READY ]]; then
    fail "I04 closure receipt must set I04 DONE and I05 READY"
  fi
  require_git_tree_field "${resolved_head}" "${w1_i05_card_path}" \
    BusinessImplementationAuthorization USER_AUTHORIZED
  index_content="$(git -C "${repo_root}" show \
    "${resolved_head}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "transition tree is missing docs/task-cards/wave-1-implementation/README.md"
  ready_rows="$(printf '%s\n' "${index_content}" | grep -c '| `READY` |' || true)"
  [[ "${ready_rows}" -eq 1 ]] ||
    fail "I04 closure receipt must release exactly one READY card"
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I02 \
    '| `W1-I02` | [来源持久化](W1-I02-source-persistence.md) | `QUEUED` | `W1-I01` | `W1-IG2` | `HIGH` |' \
    'I04 closure must keep W1-I02 queued behind its database gate'
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I02-source-persistence.md Status QUEUED
  [[ "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite)" == NOT_AUTHORIZED &&
     "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md RemotePush)" == NOT_AUTHORIZED ]] ||
    fail "I04 closure must preserve database and push authorization boundaries"
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 1
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md SuspendedTaskCardCount 0
  require_w1_i04_closure_projection_targets "${resolved_head}"
  require_w1_i04_closure_review_receipt "${resolved_head}"

  register_temporary_directory compare_dir cognitura-i04-closure-compare
  for path in "${w1_i04_closure_projection_paths[@]}"; do
    write_normalized_w1_i04_closure_file \
      "${resolved_base}" "${path}" "${compare_dir}/base-${compare_index}" BASE
    write_normalized_w1_i04_closure_file \
      "${resolved_head}" "${path}" "${compare_dir}/head-${compare_index}" HEAD
    cmp -s "${compare_dir}/base-${compare_index}" \
      "${compare_dir}/head-${compare_index}" || {
      remove_temporary_directory "${compare_dir}"
      fail "I04 closure receipt must be an exact projection-only transform: ${path}"
    }
    compare_index=$((compare_index + 1))
  done
  remove_temporary_directory "${compare_dir}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i04_reviewed_candidate_sha}..${resolved_head}" -- \
    "${w1_i04_frozen_production_paths[@]}" ||
    fail "reviewed W1-I04 production must remain byte-identical"
  if [[ "${require_working_tree}" == 1 ]]; then
    git -C "${repo_root}" diff --quiet "${resolved_head}" -- \
      "${w1_i04_closure_projection_paths[@]}" ||
      fail "working projection must match I04 closure receipt"
    require_working_w1_i04_production_frozen
  fi
}

