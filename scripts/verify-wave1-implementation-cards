                  "W1I06ClosureStatus = PASS" \
                  "W1I02DatabaseGateStatus = PASS" \
                  "FormalDatabaseWrite = NOT_AUTHORIZED" \
                  "RemotePush = NOT_AUTHORIZED"
                exit 0
                ;;
              DONE)
                git -C "${repo_root}" merge-base --is-ancestor \
                  "${w1_i02_closure_base_sha}" "${current_repository_head}" ||
                  fail "I02 closure HEAD must descend from the fixed base"
                w1_i02_release_receipt="$(find_unique_w1_i02_database_gate_release \
                  "${w1_i02_gate_tip}" "${w1_i02_closure_base_sha}")"
                validate_w1_i02_database_gate_release \
                  "${w1_i02_gate_tip}" "${w1_i02_release_receipt}"
                validate_post_w1_i02_database_gate_descendants \
                  "${w1_i02_release_receipt}" "${w1_i02_closure_base_sha}"
                w1_i02_closure_receipt="$(find_unique_w1_i02_closure \
                  "${current_repository_head}")"
                validate_w1_i02_closure \
                  "${w1_i02_closure_base_sha}" "${w1_i02_closure_receipt}"
                validate_post_w1_i02_closure_descendants \
                  "${w1_i02_closure_receipt}" "${current_repository_head}"
                git -C "${repo_root}" diff --quiet \
                  "${w1_i02_closure_receipt}" -- \
                  "${w1_i02_closure_projection_paths[@]}" ||
                  fail "working projection must match I02 closure receipt"
                printf '%s\n' \
                  "Wave1ImplementationTaskCardValidation = PASS" \
                  "TaskCardCount = 14" \
                  "TaskCardSetStatus = READY_FOR_EXECUTION" \
                  "ActiveTaskCard = W1-I07" \
                  "ReadyTaskCardCount = 1" \
                  "W1I03ClosureStatus = PASS" \
                  "W1I04ClosureStatus = PASS" \
                  "W1I05ClosureStatus = PASS" \
                  "W1I06EntryRepairStatus = ${w1_i06_entry_repair_status}" \
                  "W1I06ClosureStatus = PASS" \
                  "W1I02DatabaseGateStatus = PASS" \
                  "W1I02ClosureStatus = PASS" \
                  "FormalDatabaseWrite = NOT_AUTHORIZED" \
                  "RemotePush = NOT_AUTHORIZED"
                exit 0
                ;;
              *) fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:unsupported I02 state" ;;
            esac
          fi
          validate_post_w1_i06_closure_verifier_correction \
            "${i06_closure_receipt}" "${current_repository_head}"
          git -C "${repo_root}" diff --quiet "${i06_closure_receipt}" -- \
            "${w1_i06_closure_projection_paths[@]}" ||
            fail "working projection must match I06 closure receipt"
          printf '%s\n' \
            "Wave1ImplementationTaskCardValidation = PASS" \
            "TaskCardCount = 14" \
            "TaskCardSetStatus = BLOCKED_BY_DATABASE_GATE" \
            "ActiveTaskCard = NONE" \
            "W1I03ClosureStatus = PASS" \
            "W1I04ClosureStatus = PASS" \
            "W1I05ClosureStatus = PASS" \
            "W1I06EntryRepairStatus = ${w1_i06_entry_repair_status}" \
            "W1I06ClosureStatus = PASS"
          exit 0
          ;;
        *) fail "I05 closure current state has an unsupported I05/I06 status vector" ;;
      esac
    fi
  fi
fi
if [[ -n "${transition_base}" && "${closure_cards_dir_is_canonical}" == 1 ]]; then
  i04_transition_base="$(git -C "${repo_root}" rev-parse --verify \
