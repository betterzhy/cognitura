        "${w1_i09_closure_origin_sha}" "${i09_closure_route_commit}" 2>/dev/null &&
      [[ -n "$(git -C "${repo_root}" rev-list -n 1 \
        "${w1_i09_closure_origin_sha}..${i09_closure_route_commit}" -- \
        "${w1_i09_closure_governance_paths[0]}" 2>/dev/null)" ]]; then
    route_w1_i09_closure "${i09_closure_route_commit}"
    exit 0
  fi
  i08_route_commit="${current_repository_head}"
  [[ -n "${transition_base}" ]] && i08_route_commit="${transition_base}"
  if [[ "${i08_route_commit}" != "${w1_i08_closure_origin_sha}" ]] &&
      git -C "${repo_root}" merge-base --is-ancestor \
        "${w1_i08_closure_origin_sha}" "${i08_route_commit}" 2>/dev/null; then
