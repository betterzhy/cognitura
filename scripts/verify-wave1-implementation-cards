  if w1_i04_closure_schema_current "${i04_transition_base}"; then
    i04_transition_head="$(git -C "${repo_root}" rev-parse --verify \
      "${transition_head}^{commit}" 2>/dev/null)" ||
      fail "transition HEAD must resolve to a commit"
    i04_transition_state="$(git_tree_field "${i04_transition_base}" \
      "${w1_i04_card_path}" Status):$(git_tree_field \
      "${i04_transition_base}" "${w1_i05_card_path}" Status)"
    case "${i04_transition_state}" in
