}

validate_w1_i09_closure_receipt() {
  local governance_tip="$1"
  local receipt="$2"
  local parent expected_paths actual_paths path expected_root actual_file index=0
  parent="$(single_parent_of "${receipt}" \
    "I09_CLOSURE_RECEIPT_PATHS_INVALID:single parent")"
  [[ "${parent}" == "${governance_tip}" ]] ||
    fail "I09_CLOSURE_RECEIPT_PATHS_INVALID:direct child"
  validate_w1_i09_closure_governance_chain "${governance_tip}"
  require_no_git_rename_or_copy "${parent}" "${receipt}" \
    "I09_CLOSURE_RECEIPT_PATHS_INVALID:rename or copy"
  expected_paths="$(printf '%s\n' "${w1_i09_closure_projection_paths[@]}" |
    LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${parent}..${receipt}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I09_CLOSURE_RECEIPT_PATHS_INVALID:exact paths"
  for path in "${w1_i09_closure_projection_paths[@]}"; do
    [[ "$(git_tree_mode "${receipt}" "${path}")" == 100644 ]] ||
      fail "I09_CLOSURE_RECEIPT_PATHS_INVALID:mode:${path}"
    require_git_blob_without_nul "${receipt}" "${path}" \
      "I09_CLOSURE_RECEIPT_PATHS_INVALID:NUL:${path}"
  done
  [[ "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/README.md TaskCardSetStatus)" == \
      READY_FOR_EXECUTION &&
     "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/README.md ActiveTaskCard)" == W1-I10 &&
     "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount)" == 1 &&
     "$(git_tree_field "${receipt}" "${w1_i09_card_path}" Status)" == DONE &&
     "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status)" == READY &&
     "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md \
      BusinessImplementationAuthorization)" == USER_AUTHORIZED ]] ||
    fail "I09_CLOSURE_STATE_VECTOR_INVALID"
  require_w1_i09_closure_review_receipt "${receipt}" "${governance_tip}"
  register_temporary_directory expected_root cognitura-i09-closure-projection
  for path in "${w1_i09_closure_projection_paths[@]}"; do
    mkdir -p "${expected_root}/$(dirname "${path}")"
    write_expected_w1_i09_closure_file \
      "${governance_tip}" "${path}" "${expected_root}/${path}"
    actual_file="${expected_root}/actual-${index}"
    git -C "${repo_root}" show "${receipt}:${path}" > "${actual_file}" ||
      fail "I09_CLOSURE_PROJECTION_MISMATCH:actual:${path}"
    cmp -s "${expected_root}/${path}" "${actual_file}" ||
      fail "I09_CLOSURE_PROJECTION_MISMATCH:content:${path}"
    index=$((index + 1))
  done
  remove_temporary_directory "${expected_root}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i09_closure_origin_sha}..${receipt}" -- \
    "${w1_i09_runtime_product_paths[@]}" || fail "I09_CLOSURE_PRODUCT_DRIFT"
}

find_unique_w1_i09_closure_receipt() {
  local head="$1"
  local commit parent pair found=""
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
      "${w1_i09_closure_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I09_CLOSURE_RECEIPT_PATHS_INVALID:history")"
    pair="$(git_tree_field "${parent}" "${w1_i09_card_path}" Status):$(git_tree_field \
      "${commit}" "${w1_i09_card_path}" Status):$(git_tree_field \
      "${parent}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status):$(git_tree_field \
      "${commit}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status)"
    if [[ "${pair}" == READY:DONE:BLOCKED_BY_DEPENDENCY:READY ]]; then
      [[ -z "${found}" ]] || fail "I09_CLOSURE_RECEIPT_PATHS_INVALID:duplicate"
      found="${commit}"
    fi
  done
  [[ -n "${found}" ]] || fail "I09_CLOSURE_RECEIPT_PATHS_INVALID:missing"
  printf '%s\n' "${found}"
}

is_w1_i10_product_path() {
  local requested="$1"
  local allowed
  for allowed in "${w1_i10_product_paths[@]}"; do
    [[ "${requested}" == "${allowed}" ]] && return 0
  done
  return 1
}

validate_post_w1_i09_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
      "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I09_CLOSURE_DESCENDANT_INVALID:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I09_CLOSURE_DESCENDANT_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I09_CLOSURE_DESCENDANT_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i10_product_path "${path}" ||
        fail "I09_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:${path}"
      [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
        fail "I09_CLOSURE_DESCENDANT_INVALID:mode:${path}"
      require_git_blob_without_nul "${commit}" "${path}" \
        "I09_CLOSURE_DESCENDANT_INVALID:NUL:${path}"
    done <<< "${changed_paths}"
  done
}

route_w1_i09_closure() {
  local route_commit="$1"
  local resolved_base resolved_head vector receipt governance_tip path
  validate_w1_i09_closure_predecessor
  if [[ -n "${transition_base}" ]]; then
    resolved_base="$(git -C "${repo_root}" rev-parse --verify \
      "${transition_base}^{commit}" 2>/dev/null)" ||
      fail "I09_CLOSURE_GOVERNANCE_CHAIN_INVALID:BASE"
    resolved_head="$(git -C "${repo_root}" rev-parse --verify \
      "${transition_head}^{commit}" 2>/dev/null)" ||
      fail "I09_CLOSURE_RECEIPT_PATHS_INVALID:HEAD"
    validate_w1_i09_closure_receipt "${resolved_base}" "${resolved_head}"
    printf '%s\n' \
      'Wave1ImplementationTaskCardValidation = PASS' \
      'TaskCardCount = 14' \
      'TaskCardSetStatus = READY_FOR_EXECUTION' \
      'ActiveTaskCard = W1-I10' \
      'ReadyTaskCardCount = 1' \
      'W1I07ClosureStatus = PASS' \
      'W1I08ClosureStatus = PASS' \
      'W1I09RuntimeRebaselineStatus = PASS' \
      'W1I09ClosureStatus = PASS' \
      'FormalDatabaseWrite = NOT_AUTHORIZED' \
      'RemotePush = NOT_AUTHORIZED'
    return 0
  fi
  vector="$(git_tree_field "${route_commit}" "${w1_i09_card_path}" Status):$(git_tree_field \
    "${route_commit}" docs/task-cards/wave-1-implementation/W1-I10-source-preview-query-api.md Status)"
  case "${vector}" in
    READY:BLOCKED_BY_DEPENDENCY)
      validate_w1_i09_closure_governance_chain "${route_commit}"
      for path in "${w1_i09_closure_governance_paths[@]}" \
          "${w1_i09_closure_projection_paths[@]}" \
          "${w1_i09_runtime_product_paths[@]}"; do
        git -C "${repo_root}" diff --quiet "${route_commit}" -- "${path}" ||
          fail "I09_CLOSURE_WORKTREE_MISMATCH:${path}"
      done
      printf '%s\n' \
        'Wave1ImplementationTaskCardValidation = PASS' \
        'TaskCardCount = 14' \
        'TaskCardSetStatus = READY_FOR_EXECUTION' \
        'ActiveTaskCard = W1-I09' \
        'ReadyTaskCardCount = 1' \
        'W1I09RuntimeRebaselineStatus = PASS' \
        'W1I09ClosureStatus = PENDING' \
        'FormalDatabaseWrite = NOT_AUTHORIZED' \
        'RemotePush = NOT_AUTHORIZED'
      ;;
    DONE:READY)
      receipt="$(find_unique_w1_i09_closure_receipt "${route_commit}")"
      governance_tip="$(single_parent_of "${receipt}" \
        "I09_CLOSURE_RECEIPT_PATHS_INVALID:governance tip")"
      validate_w1_i09_closure_receipt "${governance_tip}" "${receipt}"
      validate_post_w1_i09_closure_descendants "${receipt}" "${route_commit}"
      printf '%s\n' \
        'Wave1ImplementationTaskCardValidation = PASS' \
        'TaskCardCount = 14' \
        'TaskCardSetStatus = READY_FOR_EXECUTION' \
        'ActiveTaskCard = W1-I10' \
        'ReadyTaskCardCount = 1' \
        'W1I09RuntimeRebaselineStatus = PASS' \
        'W1I09ClosureStatus = PASS' \
        'FormalDatabaseWrite = NOT_AUTHORIZED' \
        'RemotePush = NOT_AUTHORIZED'
      ;;
    *) fail "I09_CLOSURE_STATE_VECTOR_INVALID:static" ;;
  esac
}

validate_w1_i10_closure_predecessor() {
  local actual_parent actual_tree
  actual_parent="$(single_parent_of "${w1_i10_closure_origin_sha}" \
    "I10_CLOSURE_PREDECESSOR_INVALID:parent")"
  [[ "${actual_parent}" == "${w1_i10_closure_reviewed_parent_sha}" ]] ||
    fail "I10_CLOSURE_PREDECESSOR_INVALID:parent"
  actual_tree="$(git -C "${repo_root}" rev-parse \
    "${w1_i10_closure_origin_sha}^{tree}" 2>/dev/null)" ||
    fail "I10_CLOSURE_PREDECESSOR_INVALID:tree"
  [[ "${actual_tree}" == "${w1_i10_closure_reviewed_tree_sha}" ]] ||
    fail "I10_CLOSURE_PREDECESSOR_INVALID:tree"
}

validate_w1_i10_closure_governance_chain() {
  local tip="$1"
  local commits=() commit parent previous changed_paths path index expected_path
  local expected_mode actual_blob expected_blob evidence_sha
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i10_closure_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:origin"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i10_closure_origin_sha}..${tip}")
  [[ "${#commits[@]}" -eq 5 ]] ||
    fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:exact five commits"
  previous="${w1_i10_closure_origin_sha}"
  for index in "${!commits[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i10_closure_governance_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i10_product_path "${path}" && fail "I10_CLOSURE_PRODUCT_DRIFT:${path}"
    done <<< "${changed_paths}"
    [[ "${changed_paths}" == "${expected_path}" ]] ||
      fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:path"
    case "${expected_path}" in scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;; *) expected_mode=100644 ;; esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:NUL"
    if [[ "${index}" -lt 4 ]]; then
      evidence_sha="${w1_i10_closure_governance_evidence_shas[${index}]}"
      actual_blob="$(git -C "${repo_root}" rev-parse "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:evidence"
      expected_blob="$(git -C "${repo_root}" rev-parse "${evidence_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I10_CLOSURE_GOVERNANCE_CHAIN_INVALID:evidence"
    fi
    previous="${commit}"
  done
}

require_w1_i10_closure_review_receipt() {
  local receipt="$1" governance_tip="$2"
  local governance_parent governance_tree receipt_dir plan_file
  governance_parent="$(single_parent_of "${governance_tip}" \
    "I10_CLOSURE_REVIEW_RECEIPT_INVALID:governance parent")"
  governance_tree="$(git -C "${repo_root}" rev-parse "${governance_tip}^{tree}" 2>/dev/null)" ||
    fail "I10_CLOSURE_REVIEW_RECEIPT_INVALID:governance tree"
  register_temporary_directory receipt_dir cognitura-i10-closure-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${receipt}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
      remove_temporary_directory "${receipt_dir}"
      fail "I10_CLOSURE_REVIEW_RECEIPT_INVALID:plan"
    }
  [[ "$(grep -c '^## 20\. I10 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I10_CLOSURE_REVIEW_RECEIPT_INVALID:heading"
  }
  sed -n '/^## 20\. I10 关闭收据$/,$p' "${plan_file}" > "${receipt_dir}/actual"
  printf '%s\n' '## 20. I10 关闭收据' '' '```text' \
    'W1-I10 = DONE' \
    "ReviewedCandidate = ${w1_i10_closure_origin_sha}" \
    "ReviewedParent = ${w1_i10_closure_reviewed_parent_sha}" \
    "ReviewedTree = ${w1_i10_closure_reviewed_tree_sha}" \
    "ReviewedGovernanceCandidate = ${governance_tip}" \
    "ReviewedGovernanceParent = ${governance_parent}" \
    "ReviewedGovernanceTree = ${governance_tree}" \
    'ReviewLevel = L3' 'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' 'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' 'P0 = 0' 'P1 = 0' 'P2 = 0' \
    'Ultra = NOT_RUN' 'I10ClosureReleasedTaskCard = W1-I11' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I10_CLOSURE_REVIEW_RECEIPT_INVALID:content"
  }
  remove_temporary_directory "${receipt_dir}"
}

replace_w1_i10_closure_expected_text() {
  local file="$1" old_text="$2" new_text="$3" path="$4" count
  count="$(I10_CLOSURE_OLD_TEXT="${old_text}" perl -0777 -ne \
    '$count = () = /\Q$ENV{I10_CLOSURE_OLD_TEXT}\E/g; print $count' "${file}")" ||
    fail "I10_CLOSURE_PROJECTION_MISMATCH:count:${path}"
  [[ "${count}" == 1 ]] || fail "I10_CLOSURE_PROJECTION_MISMATCH:source:${path}"
  I10_CLOSURE_OLD_TEXT="${old_text}" I10_CLOSURE_NEW_TEXT="${new_text}" \
    perl -0777 -i.bak -pe \
      's/\Q$ENV{I10_CLOSURE_OLD_TEXT}\E/$ENV{I10_CLOSURE_NEW_TEXT}/g' "${file}" ||
    fail "I10_CLOSURE_PROJECTION_MISMATCH:replace:${path}"
  rm -f "${file}.bak"
}

replace_w1_i10_closure_expected_first_field() {
  local file="$1" field="$2" value="$3" path="$4"
  FIRST_FIELD="${field}" perl -ne '
    if (/^\Q$ENV{FIRST_FIELD}\E = /) { $count++ }
    END { print $count + 0 }
  ' "${file}" | grep -Eq '^[1-9][0-9]*$' ||
    fail "I10_CLOSURE_PROJECTION_MISMATCH:field:${path}:${field}"
  FIRST_FIELD="${field}" FIRST_VALUE="${value}" perl -i.bak -pe '
    if (!$done && /^\Q$ENV{FIRST_FIELD}\E = /) {
      $_ = "$ENV{FIRST_FIELD} = $ENV{FIRST_VALUE}\n";
      $done = 1;
    }
  ' "${file}" || fail "I10_CLOSURE_PROJECTION_MISMATCH:field:${path}:${field}"
  rm -f "${file}.bak"
}

