    W1-I03 \
    '| `W1-I03` | DOCX security | `I01` | `SUSPENDED_BY_USER` |' \
    'restore transition BASE must preserve exact suspended projection: docs/engineering/cognitura-wave-1-implementation-plan.md'
  require_exact_git_tree_table_row \
    "${resolved_base}" \
