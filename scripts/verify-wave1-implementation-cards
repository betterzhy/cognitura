require_w1_i05_closure_review_receipt() {
  local commit="$1"
  local governance_base="$2"
  local receipt_dir plan_file governance_parent governance_tree
  governance_parent="$(single_parent_of "${governance_base}" \
    "reviewed I05 closure governance candidate")"
  governance_tree="$(git -C "${repo_root}" rev-parse \
    "${governance_base}^{tree}" 2>/dev/null)" ||
    fail "reviewed I05 closure governance tree is unavailable"
  register_temporary_directory receipt_dir cognitura-i05-review-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${commit}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
    remove_temporary_directory "${receipt_dir}"
    fail "I05 closure review receipt mismatch"
  }
  [[ "$(grep -c '^## 10\. I05 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I05 closure review receipt mismatch"
  }
  sed -n '/^## 10\. I05 关闭收据$/,$p' "${plan_file}" > "${receipt_dir}/actual"
  printf '%s\n' \
    '## 10. I05 关闭收据' \
    '' \
    '```text' \
    'W1-I05 = DONE' \
    "ReviewedCandidate = ${w1_i05_reviewed_candidate_sha}" \
    "ReviewedGovernanceCandidate = ${governance_base}" \
    "ReviewedGovernanceParent = ${governance_parent}" \
    "ReviewedGovernanceTree = ${governance_tree}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'I05ClosureReleasedTaskCard = W1-I06' \
    'QueuedTaskCard = W1-I02' \
    'QueuedReason = INDEPENDENT_DATABASE_GATE_REQUIRED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I05 closure review receipt mismatch"
  }
  remove_temporary_directory "${receipt_dir}"
}

validate_w1_i05_closure_governance_chain() {
  local tip="$1"
  local commit parent changed_paths path expected_path expected_commit
  local commit_index=0
  local fixed_commits=(
    "${w1_i05_closure_plan_sha}"
    "${w1_i05_closure_test_sha}"
  )
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i05_closure_repair_origin_sha}" "${tip}" ||
    fail "I05 closure governance tip must descend from the recovery origin"
  [[ "$(single_parent_of "${w1_i05_closure_repair_origin_sha}" \
    "I05 closure recovery origin")" == \
    "${w1_i05_rejected_closure_candidate_sha}" ]] ||
    fail "I05 closure recovery origin must directly revert the rejected candidate"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i05_closure_repair_origin_sha}..${tip}"); do
    [[ "${commit_index}" -lt "${#w1_i05_closure_governance_paths[@]}" ]] ||
      fail "I05 closure governance chain must have exactly three commits"
    parent="$(single_parent_of "${commit}" "I05 closure governance commit")"
    if [[ "${commit_index}" -eq 0 ]]; then
      [[ "${parent}" == "${w1_i05_closure_repair_origin_sha}" ]] ||
        fail "I05 closure governance origin mismatch"
    fi
    if [[ "${commit_index}" -lt "${#fixed_commits[@]}" ]]; then
      expected_commit="${fixed_commits[${commit_index}]}"
      [[ "${commit}" == "${expected_commit}" ]] ||
        fail "I05 closure governance commit identity mismatch"
    fi
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I05 closure governance commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I05 closure governance commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    [[ "$(printf '%s\n' "${changed_paths}" | awk \
      'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
      fail "I05 closure governance commit must change exactly one path"
    path="${changed_paths}"
    expected_path="${w1_i05_closure_governance_paths[${commit_index}]}"
    [[ "${path}" == "${expected_path}" ]] ||
      fail "I05 closure governance paths must follow the fixed order"
    case "${path}" in
      "${w1_i05_closure_plan_path}")
        [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
          fail "I05 closure governance path mode mismatch"
        ;;
      *)
        [[ "$(git_tree_mode "${commit}" "${path}")" == 100755 ]] ||
          fail "I05 closure governance path mode mismatch"
        ;;
    esac
    require_git_blob_without_nul "${commit}" "${path}" \
      "I05 closure governance path must not contain NUL"
    commit_index=$((commit_index + 1))
  done
  [[ "${commit_index}" -eq 3 ]] ||
    fail "I05 closure governance chain must have exactly three commits"
  require_git_tree_field "${tip}" "${w1_i05_closure_plan_path}" \
    TransitionKind I05_CLOSE_ADVANCE
  require_git_tree_field "${tip}" "${w1_i05_closure_plan_path}" \
    ClosureRepairOriginSHA "${w1_i05_closure_repair_origin_sha}"
  require_git_tree_field "${tip}" "${w1_i05_closure_plan_path}" \
    RejectedClosureCandidateSHA "${w1_i05_rejected_closure_candidate_sha}"
  require_git_tree_field "${tip}" "${w1_i05_closure_plan_path}" \
    ReviewedProductCandidateSHA "${w1_i05_reviewed_candidate_sha}"
  require_git_tree_field "${tip}" "${w1_i05_closure_plan_path}" \
    GovernanceCommitCount 3
}

require_w1_i05_closure_projection_targets() {
  local commit="$1"
  require_git_tree_field "${commit}" AGENTS.md ActiveImplementationTaskCard W1-I06
  require_git_tree_field "${commit}" README.md ActiveImplementationTaskCard W1-I06
  require_git_tree_field "${commit}" docs/design/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I06
  require_git_tree_field "${commit}" docs/engineering/cognitura-design-index.md \
    ActiveTaskCard W1-I06
  require_git_tree_field "${commit}" docs/engineering/cognitura-design-index.md \
    ActiveImplementationTaskCard W1-I06
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-design-plan.md \
    ActiveImplementationGovernanceTaskCard W1-I06
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-design-acceptance.md \
    ImplementationTaskCardPlanStatus I05_COMPLETE_I06_READY
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-design-acceptance.md \
    ActiveImplementationGovernanceTaskCard W1-I06
  require_git_tree_field "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md \
    ActiveTaskCard W1-I06
  require_git_tree_field "${commit}" docs/task-cards/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I06
  require_git_tree_field "${commit}" docs/task-cards/wave-1-implementation/README.md \
    ActiveTaskCard W1-I06
  require_exact_git_tree_table_row \
    "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I05 \
    '| `W1-I05` | Table fidelity | `I04` | `DONE` |' \
    'I05 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I06 \
    '| `W1-I06` | Image/relationship projection | `I04,I05` | `READY` |' \
    'I05 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/task-cards/wave-1-implementation/README.md W1-I05 \
    '| `W1-I05` | [表格保真](W1-I05-table-fidelity.md) | `DONE` | `W1-I04` | `W1-IG5` | `HIGH` |' \
    'I05 closure projection table mismatch'
  require_exact_git_tree_table_row \
    "${commit}" docs/task-cards/wave-1-implementation/README.md W1-I06 \
    '| `W1-I06` | [图片与关系](W1-I06-image-anchor-relationship-projection.md) | `READY` | `W1-I04,W1-I05` | `W1-IG6` | `HIGH` |' \
    'I05 closure projection table mismatch'
}

normalize_w1_i05_closure_narratives() {
  local input_file="$1"
  local output_file="$2"
  local path="$3"
  local state="$4"
  local expected_state narrative_index matched=0 current_file next_file
  case "${state}" in
    BASE) expected_state=SUSPENDED ;;
    HEAD) expected_state=READY ;;
    *) fail "unsupported I05 closure narrative state: ${state}" ;;
  esac
  current_file="${output_file}.nul-free"
  copy_nul_free_file "${input_file}" "${current_file}" \
    "I05 closure receipt projection must not contain NUL: ${path}"
  for narrative_index in "${!w1_i05_ready_narratives[@]}"; do
    [[ "${suspension_narrative_paths[${narrative_index}]}" == "${path}" ]] || continue
    matched=1
    next_file="${output_file}.narrative-${narrative_index}"
    normalize_narrative_pair_file \
      "${current_file}" "${next_file}" \
      "${w1_i05_ready_narratives[${narrative_index}]}" \
      "${w1_i06_ready_narratives[${narrative_index}]}" \
      "__W1_I05_CLOSURE_NARRATIVE_${narrative_index}__" \
      "${expected_state}" \
      "I05 closure narrative projection mismatch: ${path}"
    current_file="${next_file}"
  done
  case "${path}" in
    "${w1_i05_card_path}"|"${w1_i06_card_path}") ;;
    *) [[ "${matched}" -eq 1 ]] || fail "missing I05 closure narrative contract for ${path}" ;;
  esac
  cp "${current_file}" "${output_file}" ||
    fail "could not normalize I05 closure narrative projection: ${path}"
}

write_normalized_w1_i05_closure_file() {
  local commit="$1"
  local path="$2"
  local output_file="$3"
  local state="$4"
  local raw_file="${output_file}.raw"
  local narrative_file="${output_file}.narratives"
  git -C "${repo_root}" show "${commit}:${path}" > "${raw_file}" 2>/dev/null ||
    fail "transition tree is missing ${path}"
  if [[ "${state}" == HEAD && \
        "${path}" == docs/engineering/cognitura-wave-1-implementation-plan.md ]]; then
    sed -i.bak '/^## 10\. I05 关闭收据$/,$d' "${raw_file}"
    rm "${raw_file}.bak"
    sed -i.bak '${/^$/d;}' "${raw_file}"
    rm "${raw_file}.bak"
  fi
  normalize_w1_i05_closure_narratives \
    "${raw_file}" "${narrative_file}" "${path}" "${state}"
  case "${path}" in
    AGENTS.md|README.md)
      sed -E 's/^ActiveImplementationTaskCard = .*/ActiveImplementationTaskCard = __I05_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/design/wave-1/README.md|docs/engineering/cognitura-wave-1-design-plan.md|docs/task-cards/wave-1/README.md)
      sed -E 's/^ActiveImplementationGovernanceTaskCard = .*/ActiveImplementationGovernanceTaskCard = __I05_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-design-index.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I05_CLOSURE__/' \
        -e 's/^ActiveImplementationTaskCard = .*/ActiveImplementationTaskCard = __I05_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-wave-1-design-acceptance.md)
      sed -E \
        -e 's/^ImplementationTaskCardPlanStatus = .*/ImplementationTaskCardPlanStatus = __I05_CLOSURE__/' \
        -e 's/^ActiveImplementationGovernanceTaskCard = .*/ActiveImplementationGovernanceTaskCard = __I05_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/engineering/cognitura-wave-1-implementation-plan.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I05_CLOSURE__/' \
        -e '/^\| `W1-I05` \|/ s/\| `(READY|DONE)` \|$/| `__I05_CLOSURE__` |/' \
        -e '/^\| `W1-I06` \|/ s/\| `(BLOCKED_BY_DEPENDENCY|READY)` \|$/| `__I05_CLOSURE__` |/' \
        "${narrative_file}" > "${output_file}"
      ;;
    docs/task-cards/wave-1-implementation/README.md)
      sed -E \
        -e 's/^ActiveTaskCard = .*/ActiveTaskCard = __I05_CLOSURE__/' \
        -e '/^\| `W1-I05` \|/ s/\| `(READY|DONE)` \|/| `__I05_CLOSURE__` |/' \
        -e '/^\| `W1-I06` \|/ s/\| `(BLOCKED_BY_DEPENDENCY|READY)` \|/| `__I05_CLOSURE__` |/' \
        "${narrative_file}" > "${output_file}"
      ;;
    "${w1_i05_card_path}")
      sed -E 's/^Status = .*/Status = __I05_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    "${w1_i06_card_path}")
      sed -E \
        -e 's/^Status = .*/Status = __I05_CLOSURE__/' \
        -e 's/^BusinessImplementationAuthorization = .*/BusinessImplementationAuthorization = __I05_CLOSURE__/' \
        "${narrative_file}" > "${output_file}"
      ;;
    *) fail "unsupported I05 closure projection path: ${path}" ;;
  esac
}

validate_w1_i05_closure_receipt() {
  local base="$1"
  local head="$2"
  local resolved_base resolved_head expected_paths actual_paths path base_mode head_mode
  local index_content ready_rows compare_dir compare_index=0
  resolved_base="$(git -C "${repo_root}" rev-parse --verify "${base}^{commit}" 2>/dev/null)" ||
    fail "I05 closure receipt BASE must resolve to a commit"
  resolved_head="$(git -C "${repo_root}" rev-parse --verify "${head}^{commit}" 2>/dev/null)" ||
    fail "I05 closure receipt HEAD must resolve to a commit"
  [[ "$(single_parent_of "${resolved_head}" "I05 closure receipt HEAD")" == \
     "${resolved_base}" ]] ||
    fail "I05 closure receipt HEAD must be the direct child of BASE"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i05_reviewed_candidate_sha}" "${resolved_base}" ||
    fail "I05 closure BASE must descend from the reviewed candidate"
  git -C "${repo_root}" diff --quiet \
    "${w1_i05_reviewed_candidate_sha}..${resolved_base}" -- \
    "${w1_i05_frozen_product_paths[@]}" ||
    fail "reviewed W1-I05 production must remain byte-identical"
  git -C "${repo_root}" diff --quiet \
    "${w1_i05_reviewed_candidate_sha}..${resolved_head}" -- \
    "${w1_i05_frozen_product_paths[@]}" ||
    fail "reviewed W1-I05 production must remain byte-identical"
  validate_w1_i05_closure_governance_chain "${resolved_base}"
  require_no_git_rename_or_copy "${resolved_base}" "${resolved_head}" \
    "I05 closure receipt must not rename or copy paths"
  expected_paths="$(printf '%s\n' "${w1_i05_closure_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${resolved_base}..${resolved_head}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I05 closure receipt fixed diff must equal the exact eleven projection paths"
  for path in "${w1_i05_closure_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${resolved_base}" "${path}")"
    head_mode="$(git_tree_mode "${resolved_head}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I05 closure receipt must preserve every projection path mode"
    require_git_blob_without_nul "${resolved_head}" "${path}" \
      "I05 closure receipt projection must not contain NUL"
  done
  require_git_tree_field "${resolved_base}" "${w1_i05_card_path}" Status READY
  require_git_tree_field "${resolved_base}" "${w1_i06_card_path}" Status BLOCKED_BY_DEPENDENCY
  require_git_tree_field "${resolved_head}" "${w1_i05_card_path}" Status DONE
  require_git_tree_field "${resolved_head}" "${w1_i06_card_path}" Status READY
  [[ "$(git_tree_field "${resolved_head}" "${w1_i06_card_path}" \
      BusinessImplementationAuthorization)" == USER_AUTHORIZED ]] ||
    fail "I05 closure must explicitly authorize W1-I06"
  index_content="$(git -C "${repo_root}" show \
    "${resolved_head}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "transition tree is missing docs/task-cards/wave-1-implementation/README.md"
  ready_rows="$(printf '%s\n' "${index_content}" | grep -c '| `READY` |' || true)"
  [[ "${ready_rows}" -eq 1 ]] ||
    fail "I05 closure receipt must release exactly one READY card"
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I02 \
    '| `W1-I02` | [来源持久化](W1-I02-source-persistence.md) | `QUEUED` | `W1-I01` | `W1-IG2` | `HIGH` |' \
    'I05 closure must keep W1-I02 queued behind its database gate'
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I02-source-persistence.md Status QUEUED
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite NOT_AUTHORIZED
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md RemotePush NOT_AUTHORIZED
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 1
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md SuspendedTaskCardCount 0
  require_w1_i05_closure_projection_targets "${resolved_head}"
  require_w1_i05_closure_review_receipt "${resolved_head}" "${resolved_base}"

  register_temporary_directory compare_dir cognitura-i05-closure-compare
  for path in "${w1_i05_closure_projection_paths[@]}"; do
    write_normalized_w1_i05_closure_file \
      "${resolved_base}" "${path}" "${compare_dir}/base-${compare_index}" BASE
    write_normalized_w1_i05_closure_file \
      "${resolved_head}" "${path}" "${compare_dir}/head-${compare_index}" HEAD
    cmp -s "${compare_dir}/base-${compare_index}" \
      "${compare_dir}/head-${compare_index}" || {
      remove_temporary_directory "${compare_dir}"
      fail "I05 closure receipt must be an exact projection-only transform: ${path}"
    }
    compare_index=$((compare_index + 1))
  done
  remove_temporary_directory "${compare_dir}"
}

find_unique_w1_i05_closure_receipt() {
  local head="$1"
  local commit parent current_state parent_state
  local receipt="" receipt_parent="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i05_closure_repair_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" "I05 closure provenance commit")"
    current_state="$(git_tree_field "${commit}" "${w1_i05_card_path}" Status):$(
      git_tree_field "${commit}" "${w1_i06_card_path}" Status)"
    parent_state="$(git_tree_field "${parent}" "${w1_i05_card_path}" Status):$(
      git_tree_field "${parent}" "${w1_i06_card_path}" Status)"
    if [[ "${parent_state}" == READY:BLOCKED_BY_DEPENDENCY && \
          "${current_state}" == DONE:READY ]]; then
      receipt_count=$((receipt_count + 1))
      receipt_parent="${parent}"
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] || fail "I05 closure is allowed exactly once"
  printf '%s %s\n' "${receipt_parent}" "${receipt}"
}

validate_post_w1_i05_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" "post-I05-closure descendant commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "post-I05-closure descendant commit must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "post-I05-closure descendant commit must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i05_closure_projection_path "${path}" &&
        fail "I05 closure is allowed exactly once"
      is_w1_i06_descendant_path "${path}" ||
        fail "post-I05-closure descendant changed a path outside the W1-I06 WriteSet"
    done <<< "${changed_paths}"
  done
}

validate_w1_i06_entry_repair_and_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths expected_paths path expected_path expected_commit
  local commit_index=0
  local fixed_governance_commits=(
    "${w1_i06_entry_repair_design_sha}"
    "${w1_i06_entry_repair_plan_sha}"
    "${w1_i06_entry_repair_test_sha}"
    "${w1_i06_entry_repair_test_correction_sha}"
    "${w1_i06_entry_repair_rejected_verifier_sha}"
    "${w1_i06_entry_repair_review_test_sha}"
    "${w1_i06_entry_repair_review_verifier_sha}"
  )

  if [[ "${receipt}" != "${w1_i06_entry_repair_origin_sha}" ]]; then
    validate_post_w1_i05_closure_descendants "${receipt}" "${head}"
    [[ "${receipt}" == "${head}" ]] ||
      fail "non-fixed I05 closure receipt must not have descendants"
    w1_i06_entry_repair_status=PENDING
    return
  fi
  git -C "${repo_root}" merge-base --is-ancestor "${receipt}" "${head}" ||
    fail "W1-I06 entry-repair HEAD must descend from the fixed I05 closure receipt"

  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    case "${commit_index}" in
      0|1|2|3|4|5|6)
        parent="$(single_parent_of "${commit}" \
          "W1-I06 entry-repair governance commit")"
        if [[ "${commit_index}" -eq 0 ]]; then
          [[ "${parent}" == "${receipt}" ]] ||
            fail "W1-I06 entry-repair governance origin mismatch"
        fi
        if [[ "${commit_index}" -lt "${#fixed_governance_commits[@]}" ]]; then
          expected_commit="${fixed_governance_commits[${commit_index}]}"
          [[ "${commit}" == "${expected_commit}" ]] ||
            fail "W1-I06 entry-repair governance identity mismatch"
        fi
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 entry-repair governance commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 entry-repair governance commit must not rename or copy paths"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}")"
        [[ "$(printf '%s\n' "${changed_paths}" | awk \
          'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
          fail "W1-I06 entry-repair governance commit must change exactly one path"
        path="${changed_paths}"
        expected_path="${w1_i06_entry_repair_governance_paths[${commit_index}]}"
        [[ "${path}" == "${expected_path}" ]] ||
          fail "W1-I06 entry-repair governance paths must follow the fixed order"
        case "${path}" in
          docs/superpowers/*)
            [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
              fail "W1-I06 entry-repair governance path mode mismatch"
            ;;
          *)
            [[ "$(git_tree_mode "${commit}" "${path}")" == 100755 ]] ||
              fail "W1-I06 entry-repair governance path mode mismatch"
            ;;
        esac
        require_git_blob_without_nul "${commit}" "${path}" \
          "W1-I06 entry-repair governance path must not contain NUL"
        ;;
      7)
        parent="$(single_parent_of "${commit}" \
          "W1-I06 entry-repair RED commit")"
        [[ "${commit}" == "${w1_i06_entry_repair_red_sha}" ]] ||
          fail "W1-I06 entry-repair RED commit identity mismatch"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 entry-repair RED commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 entry-repair RED commit must not rename or copy paths"
        expected_paths="$(printf '%s\n' \
          "${w1_i06_entry_repair_red_paths[@]}" | LC_ALL=C sort)"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}" | LC_ALL=C sort)"
        [[ "${changed_paths}" == "${expected_paths}" ]] ||
          fail "W1-I06 entry-repair RED commit must change exactly the declared test paths"
        for path in "${w1_i06_entry_repair_red_paths[@]}"; do
          [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
            fail "W1-I06 entry-repair RED path mode mismatch"
          require_git_blob_without_nul "${commit}" "${path}" \
            "W1-I06 entry-repair RED path must not contain NUL"
        done
        ;;
      8)
        parent="$(single_parent_of "${commit}" \
          "W1-I06 entry-repair GREEN commit")"
        [[ "${commit}" == "${w1_i06_entry_repair_rejected_green_sha}" ]] ||
          fail "W1-I06 entry-repair GREEN commit identity mismatch"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 entry-repair GREEN commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 entry-repair GREEN commit must not rename or copy paths"
        expected_paths="$(printf '%s\n' \
          "${w1_i06_entry_repair_green_paths[@]}" | LC_ALL=C sort)"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}" | LC_ALL=C sort)"
        [[ "${changed_paths}" == "${expected_paths}" ]] ||
          fail "W1-I06 entry-repair GREEN commit must change exactly the declared production paths"
        for path in "${w1_i06_entry_repair_green_paths[@]}"; do
          [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
            fail "W1-I06 entry-repair GREEN path mode mismatch"
          require_git_blob_without_nul "${commit}" "${path}" \
            "W1-I06 entry-repair GREEN path must not contain NUL"
        done
        ;;
      9|10)
        parent="$(single_parent_of "${commit}" \
          "W1-I04 image-payload finding governance commit")"
        if [[ "${commit_index}" -eq 9 && \
              "${commit}" != "${w1_i06_entry_review_contract_test_sha}" ]]; then
          fail "W1-I04 image-payload finding governance identity mismatch"
        fi
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I04 image-payload finding governance commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I04 image-payload finding governance commit must not rename or copy paths"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}")"
        [[ "$(printf '%s\n' "${changed_paths}" | awk \
          'NF { count++ } END { print count + 0 }')" -eq 1 ]] ||
          fail "W1-I04 image-payload finding governance commit must change exactly one path"
        path="${changed_paths}"
        expected_path="${w1_i06_entry_review_governance_paths[$((commit_index - 9))]}"
        [[ "${path}" == "${expected_path}" ]] ||
          fail "W1-I04 image-payload finding governance paths must follow the fixed order"
        [[ "$(git_tree_mode "${commit}" "${path}")" == 100755 ]] ||
          fail "W1-I04 image-payload finding governance path mode mismatch"
        require_git_blob_without_nul "${commit}" "${path}" \
          "W1-I04 image-payload finding governance path must not contain NUL"
        ;;
      11)
        parent="$(single_parent_of "${commit}" \
          "W1-I06 entry-repair RED commit")"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 entry-repair RED commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 entry-repair RED commit must not rename or copy paths"
        expected_paths="$(printf '%s\n' \
          "${w1_i06_entry_review_red_paths[@]}" | LC_ALL=C sort)"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}" | LC_ALL=C sort)"
        [[ "${changed_paths}" == "${expected_paths}" ]] ||
          fail "W1-I06 entry-repair RED commit must change exactly the declared test paths"
        for path in "${w1_i06_entry_review_red_paths[@]}"; do
          [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
            fail "W1-I06 entry-repair RED path mode mismatch"
          require_git_blob_without_nul "${commit}" "${path}" \
            "W1-I06 entry-repair RED path must not contain NUL"
        done
        ;;
      12)
        parent="$(single_parent_of "${commit}" \
          "W1-I06 entry-repair GREEN commit")"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 entry-repair GREEN commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 entry-repair GREEN commit must not rename or copy paths"
        expected_paths="$(printf '%s\n' \
          "${w1_i06_entry_review_green_paths[@]}" | LC_ALL=C sort)"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}" | LC_ALL=C sort)"
        [[ "${changed_paths}" == "${expected_paths}" ]] ||
          fail "W1-I06 entry-repair GREEN commit must change exactly the declared production paths"
        for path in "${w1_i06_entry_review_green_paths[@]}"; do
          [[ "$(git_tree_mode "${commit}" "${path}")" == 100644 ]] ||
            fail "W1-I06 entry-repair GREEN path mode mismatch"
          require_git_blob_without_nul "${commit}" "${path}" \
            "W1-I06 entry-repair GREEN path must not contain NUL"
        done
        ;;
      17|18|19)
        parent="$(single_parent_of "${commit}" \
          "W1-I06 copy-inference repair governance commit")"
        if [[ "${commit_index}" -eq 17 && \
              "${commit}" != "${w1_i06_copy_repair_test_sha}" ]]; then
          fail "W1-I06 copy-inference repair test identity mismatch"
        fi
        if [[ "${commit_index}" -eq 18 && \
              "${commit}" != "${w1_i06_copy_repair_green_sha}" ]]; then
          fail "W1-I06 copy-inference repair GREEN identity mismatch"
        fi
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 copy-inference repair governance commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 copy-inference repair governance commit must not rename or copy paths"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}")"
        if [[ "${commit_index}" -eq 17 ]]; then
          expected_paths="tests/task-cards/verify-wave1-implementation-cards.sh"
        else
          expected_paths="$(printf '%s\n' \
            scripts/verify-wave1-implementation-cards \
            tests/task-cards/verify-wave1-implementation-cards.sh | LC_ALL=C sort)"
        fi
        [[ "$(printf '%s\n' "${changed_paths}" | LC_ALL=C sort)" == "${expected_paths}" ]] ||
          fail "W1-I06 copy-inference repair governance paths must follow the fixed order"
        while IFS= read -r path; do
          [[ -n "${path}" ]] || continue
          [[ "$(git_tree_mode "${commit}" "${path}")" == 100755 ]] ||
            fail "W1-I06 copy-inference repair governance path mode mismatch"
          require_git_blob_without_nul "${commit}" "${path}" \
            "W1-I06 copy-inference repair governance path must not contain NUL"
        done <<< "${changed_paths}"
        ;;
      22)
        parent="$(single_parent_of "${commit}" "W1-I06 closure RED commit")"
        [[ "${commit}" == "${w1_i06_closure_test_sha}" ]] ||
          fail "W1-I06 closure RED commit identity mismatch"
        [[ "${parent}" == "${w1_i06_reviewed_candidate_sha}" ]] ||
          fail "W1-I06 closure RED parent mismatch"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 closure RED commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 closure RED commit must not rename or copy paths"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}")"
        [[ "${changed_paths}" == tests/task-cards/verify-wave1-implementation-cards.sh ]] ||
          fail "W1-I06 closure RED commit must change only its contract test"
        [[ "$(git_tree_mode "${commit}" "${changed_paths}")" == 100755 ]] ||
          fail "W1-I06 closure RED path mode mismatch"
        require_git_blob_without_nul "${commit}" "${changed_paths}" \
          "W1-I06 closure RED path must not contain NUL"
        ;;
      23)
        parent="$(single_parent_of "${commit}" "W1-I06 closure verifier commit")"
        [[ "${parent}" == "${w1_i06_closure_test_sha}" ]] ||
          fail "W1-I06 closure verifier parent mismatch"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "W1-I06 closure verifier commit must be nonempty"
        require_no_git_rename_or_copy "${parent}" "${commit}" \
          "W1-I06 closure verifier commit must not rename or copy paths"
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}")"
        [[ "${changed_paths}" == scripts/verify-wave1-implementation-cards ]] ||
          fail "W1-I06 closure verifier commit must change only the verifier"
        [[ "$(git_tree_mode "${commit}" "${changed_paths}")" == 100755 ]] ||
          fail "W1-I06 closure verifier path mode mismatch"
        require_git_blob_without_nul "${commit}" "${changed_paths}" \
          "W1-I06 closure verifier path must not contain NUL"
        ;;
      *)
        parent="$(single_parent_of "${commit}" \
          "post-W1-I06-entry-repair descendant commit")"
        git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
          fail "post-W1-I06-entry-repair descendant commit must be nonempty"
        case "${commit}" in
          "${w1_i06_internal_projection_red_sha}"|"${w1_i06_external_projection_red_sha}")
            require_no_git_rename_or_copy_except_fixed_w1_i06_test_copy \
              "${parent}" "${commit}" \
              "post-W1-I06-entry-repair descendant commit must not rename or copy paths"
            ;;
          *)
            require_no_git_rename_or_copy "${parent}" "${commit}" \
              "post-W1-I06-entry-repair descendant commit must not rename or copy paths"
            ;;
        esac
        changed_paths="$(git -C "${repo_root}" diff --name-only \
          "${parent}..${commit}")"
        while IFS= read -r path; do
          [[ -n "${path}" ]] || continue
          is_w1_i06_descendant_path "${path}" ||
            fail "post-W1-I06-entry-repair descendant changed a path outside the W1-I06 WriteSet"
        done <<< "${changed_paths}"
        ;;
    esac
    commit_index=$((commit_index + 1))
  done

  [[ "${commit_index}" -ge 11 ]] ||
    fail "W1-I06 entry-repair governance chain must include the finding repair admission"
  if [[ "${commit_index}" -lt 13 ]]; then
    w1_i06_entry_repair_status=PENDING
  else
    w1_i06_entry_repair_status=PASS
  fi
  case "${commit_index}" in
    18|19)
      fail "W1-I06 copy-inference repair chain must include the fixed correction"
      ;;
  esac
}

require_w1_i06_closure_review_receipt() {
  local commit="$1"
  local receipt_dir plan_file
  register_temporary_directory receipt_dir cognitura-i06-review-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${commit}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
    remove_temporary_directory "${receipt_dir}"
    fail "I06 closure review receipt mismatch"
  }
  [[ "$(grep -c '^## 11\. I06 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I06 closure review receipt mismatch"
  }
  sed -n '/^## 11\. I06 关闭收据$/,$p' "${plan_file}" > "${receipt_dir}/actual"
  printf '%s\n' \
    '## 11. I06 关闭收据' \
    '' \
    '```text' \
    'W1-I06 = DONE' \
    "ReviewedCandidate = ${w1_i06_reviewed_candidate_sha}" \
    "ReviewedGovernanceCandidate = ${w1_i06_reviewed_candidate_sha}" \
    "ReviewedGovernanceParent = ${w1_i06_reviewed_parent_sha}" \
    "ReviewedGovernanceTree = ${w1_i06_reviewed_tree_sha}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'I06ClosureTaskCardSetStatus = BLOCKED_BY_DATABASE_GATE' \
    'BlockedTaskCard = W1-I02' \
    'BlockedReason = INDEPENDENT_DATABASE_GATE_REQUIRED' \
    'ReleasedTaskCard = NONE' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I06 closure review receipt mismatch"
  }
  remove_temporary_directory "${receipt_dir}"
}

validate_w1_i06_closure_receipt() {
  local base="$1"
  local head="$2"
  local resolved_base resolved_head expected_paths actual_paths path base_mode head_mode
  local index_content ready_rows
  resolved_base="$(git -C "${repo_root}" rev-parse --verify \
    "${base}^{commit}" 2>/dev/null)" ||
    fail "I06 closure receipt BASE must resolve to a commit"
  resolved_head="$(git -C "${repo_root}" rev-parse --verify \
    "${head}^{commit}" 2>/dev/null)" ||
    fail "I06 closure receipt HEAD must resolve to a commit"
  [[ "$(single_parent_of "${resolved_head}" "I06 closure receipt HEAD")" == \
     "${resolved_base}" ]] ||
    fail "I06 closure receipt HEAD must be the direct child of BASE"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i06_reviewed_candidate_sha}" "${resolved_base}" ||
    fail "I06 closure BASE must descend from the reviewed candidate"
  git -C "${repo_root}" diff --quiet \
    "${w1_i06_reviewed_candidate_sha}..${resolved_base}" -- \
    "${w1_i06_frozen_product_paths[@]}" ||
    fail "reviewed W1-I06 production must remain byte-identical"
  git -C "${repo_root}" diff --quiet \
    "${w1_i06_reviewed_candidate_sha}..${resolved_head}" -- \
    "${w1_i06_frozen_product_paths[@]}" ||
    fail "reviewed W1-I06 production must remain byte-identical"
  require_no_git_rename_or_copy "${resolved_base}" "${resolved_head}" \
    "I06 closure receipt must not rename or copy paths"
  expected_paths="$(printf '%s\n' "${w1_i06_closure_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${resolved_base}..${resolved_head}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I06 closure receipt fixed diff must equal the exact ten projection paths"
  for path in "${w1_i06_closure_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${resolved_base}" "${path}")"
    head_mode="$(git_tree_mode "${resolved_head}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I06 closure receipt must preserve every projection path mode"
    require_git_blob_without_nul "${resolved_head}" "${path}" \
      "I06 closure receipt projection must not contain NUL"
  done

  require_git_tree_field "${resolved_base}" "${w1_i06_card_path}" Status READY
  require_git_tree_field "${resolved_head}" "${w1_i06_card_path}" Status DONE
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md \
    TaskCardSetStatus BLOCKED_BY_DATABASE_GATE
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md ActiveTaskCard NONE
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 0
  [[ "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite)" == NOT_AUTHORIZED &&
     "$(git_tree_field "${resolved_head}" \
      docs/task-cards/wave-1-implementation/README.md RemotePush)" == NOT_AUTHORIZED ]] ||
    fail "I06 closure must preserve database and push authorization boundaries"
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite NOT_AUTHORIZED
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/README.md RemotePush NOT_AUTHORIZED
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I02-source-persistence.md Status QUEUED
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I02-source-persistence.md \
    FormalDatabaseGate REQUIRED_BEFORE_READY
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I07-revision-attempt-fencing-publication.md \
    Status BLOCKED_BY_DEPENDENCY
  require_git_tree_field "${resolved_head}" \
    docs/task-cards/wave-1-implementation/W1-I07-revision-attempt-fencing-publication.md \
    FormalDatabaseGate REQUIRED_DEPENDENCY_I02_ONLY
  index_content="$(git -C "${repo_root}" show \
    "${resolved_head}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "transition tree is missing docs/task-cards/wave-1-implementation/README.md"
  ready_rows="$(printf '%s\n' "${index_content}" | grep -c '| `READY` |' || true)"
  [[ "${ready_rows}" -eq 0 ]] || fail "I06 closure must not release a READY card"
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I02 \
    '| `W1-I02` | [来源持久化](W1-I02-source-persistence.md) | `QUEUED` | `W1-I01` | `W1-IG2` | `HIGH` |' \
    'I06 closure must keep W1-I02 queued behind its database gate'
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I06 \
    '| `W1-I06` | [图片与关系](W1-I06-image-anchor-relationship-projection.md) | `DONE` | `W1-I04,W1-I05` | `W1-IG6` | `HIGH` |' \
    'I06 closure must set I06 DONE'
  require_exact_git_tree_table_row \
    "${resolved_head}" docs/task-cards/wave-1-implementation/README.md W1-I07 \
    '| `W1-I07` | [处理发布](W1-I07-revision-attempt-fencing-publication.md) | `BLOCKED_BY_DEPENDENCY` | `W1-I02,W1-I04,W1-I05,W1-I06` | `W1-IG7` | `HIGH` |' \
    'I06 closure must not release W1-I07'
  require_w1_i06_closure_review_receipt "${resolved_head}"
}

find_unique_w1_i06_closure_receipt() {
  local head="$1"
  local commit parent current_state parent_state
  local receipt="" receipt_parent="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i06_reviewed_candidate_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" "I06 closure provenance commit")"
    current_state="$(git_tree_field "${commit}" "${w1_i06_card_path}" Status)"
    parent_state="$(git_tree_field "${parent}" "${w1_i06_card_path}" Status)"
    if [[ "${parent_state}" == READY && "${current_state}" == DONE ]]; then
      receipt_count=$((receipt_count + 1))
      receipt_parent="${parent}"
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] || fail "I06 closure is allowed exactly once"
  printf '%s %s\n' "${receipt_parent}" "${receipt}"
}

validate_post_w1_i06_closure_verifier_correction() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths commit_count=0
  [[ "${receipt}" != "${head}" ]] || return 0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    commit_count=$((commit_count + 1))
    [[ "${commit_count}" -eq 1 ]] ||
      fail "post-I06-closure verifier correction must be exactly one commit"
    parent="$(single_parent_of "${commit}" \
      "post-I06-closure verifier correction")"
    [[ "${parent}" == "${receipt}" ]] ||
      fail "post-I06-closure verifier correction must directly follow the receipt"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "post-I06-closure verifier correction must be nonempty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "post-I06-closure verifier correction must not rename or copy paths"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    [[ "${changed_paths}" == scripts/verify-wave1-implementation-cards ]] ||
      fail "post-I06-closure verifier correction must change only the verifier"
    [[ "$(git_tree_mode "${commit}" "${changed_paths}")" == 100755 ]] ||
      fail "post-I06-closure verifier correction path mode mismatch"
    require_git_blob_without_nul "${commit}" "${changed_paths}" \
      "post-I06-closure verifier correction path must not contain NUL"
  done
  [[ "${commit_count}" -eq 1 ]] ||
    fail "post-I06-closure verifier correction must be exactly one commit"
}

validate_w1_i02_database_gate_governance() {
  local gate_tip="$1"
  local resolved_tip commit parent changed_paths expected_path expected_mode
  local commit_index=0
  resolved_tip="$(git -C "${repo_root}" rev-parse --verify \
    "${gate_tip}^{commit}" 2>/dev/null)" ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:tip must resolve"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i02_database_gate_test_sha}" "${resolved_tip}" ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:fixed test is not an ancestor"
  git -C "${repo_root}" diff --quiet \
    "${w1_i02_database_gate_origin_sha}..${resolved_tip}" -- \
    "${w1_i06_closure_projection_paths[@]}" ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:I06 closure projection drifted"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i02_database_gate_origin_sha}..${resolved_tip}"); do
    parent="$(single_parent_of "${commit}" "W1-I02 database gate governance commit")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:empty governance commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "W1_I02_DATABASE_GATE_CHANGE_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    case "${commit_index}" in
      0)
        [[ "${commit}" == "${w1_i02_database_gate_design_sha}" &&
           "${parent}" == "${w1_i02_database_gate_origin_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:design identity"
        expected_path="${w1_i02_database_gate_governance_paths[0]}"
        expected_mode=100644
        ;;
      1)
        [[ "${commit}" == "${w1_i02_database_gate_plan_sha}" &&
           "${parent}" == "${w1_i02_database_gate_design_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:plan identity"
        expected_path="${w1_i02_database_gate_governance_paths[1]}"
        expected_mode=100644
        ;;
      2)
        [[ "${commit}" == "${w1_i02_database_gate_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_plan_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:test identity"
        expected_path="${w1_i02_database_gate_governance_paths[2]}"
        expected_mode=100755
        ;;
      3)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_verifier_sha}" &&
           "${parent}" == "${w1_i02_database_gate_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected verifier identity"
        expected_path="${w1_i02_database_gate_governance_paths[3]}"
        expected_mode=100755
        ;;
      4)
        [[ "${commit}" == "${w1_i02_database_gate_repair_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_verifier_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:repair test identity"
        expected_path="${w1_i02_database_gate_governance_paths[4]}"
        expected_mode=100755
        ;;
      5)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_review_candidate_sha}" &&
           "${parent}" == "${w1_i02_database_gate_repair_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected review candidate identity"
        expected_path="${w1_i02_database_gate_governance_paths[5]}"
        expected_mode=100755
        ;;
      6)
        [[ "${commit}" == "${w1_i02_database_gate_review_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_review_candidate_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:review finding test identity"
        expected_path="${w1_i02_database_gate_governance_paths[6]}"
        expected_mode=100755
        ;;
      7)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_header_verifier_sha}" &&
           "${parent}" == "${w1_i02_database_gate_review_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected header verifier identity"
        expected_path="${w1_i02_database_gate_governance_paths[7]}"
        expected_mode=100755
        ;;
      8)
        [[ "${commit}" == "${w1_i02_database_gate_header_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_header_verifier_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:authority header test identity"
        expected_path="${w1_i02_database_gate_governance_paths[8]}"
        expected_mode=100755
        ;;
      9)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_header_reader_sha}" &&
           "${parent}" == "${w1_i02_database_gate_header_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected header reader identity"
        expected_path="${w1_i02_database_gate_governance_paths[9]}"
        expected_mode=100755
        ;;
      10)
        [[ "${commit}" == "${w1_i02_database_gate_historical_receipt_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_header_reader_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:historical receipt test identity"
        expected_path="${w1_i02_database_gate_governance_paths[10]}"
        expected_mode=100755
        ;;
      11)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_first_field_sha}" &&
           "${parent}" == "${w1_i02_database_gate_historical_receipt_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected first-field identity"
        expected_path="${w1_i02_database_gate_governance_paths[11]}"
        expected_mode=100755
        ;;
      12)
        [[ "${commit}" == "${w1_i02_database_gate_header_anchor_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_first_field_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:authority header anchor test identity"
        expected_path="${w1_i02_database_gate_governance_paths[12]}"
        expected_mode=100755
        ;;
      13)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_first_block_sha}" &&
           "${parent}" == "${w1_i02_database_gate_header_anchor_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected first-block identity"
        expected_path="${w1_i02_database_gate_governance_paths[13]}"
        expected_mode=100755
        ;;
      14)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_section_candidate_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_first_block_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected section candidate identity"
        expected_path="${w1_i02_database_gate_governance_paths[14]}"
        expected_mode=100755
        ;;
      15)
        [[ "${commit}" == "${w1_i02_database_gate_section_checkpoint_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_section_candidate_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:authority section checkpoint identity"
        expected_path="${w1_i02_database_gate_governance_paths[15]}"
        expected_mode=100755
        ;;
      16)
        [[ "${commit}" == "${w1_i02_database_gate_rejected_section_gate_sha}" &&
           "${parent}" == "${w1_i02_database_gate_section_checkpoint_test_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:rejected section gate identity"
        expected_path="${w1_i02_database_gate_governance_paths[16]}"
        expected_mode=100755
        ;;
      17)
        [[ "${commit}" == "${w1_i02_database_gate_value_invariant_test_sha}" &&
           "${parent}" == "${w1_i02_database_gate_rejected_section_gate_sha}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:value invariant test identity"
        expected_path="${w1_i02_database_gate_governance_paths[17]}"
        expected_mode=100755
        ;;
      18)
        [[ "${parent}" == "${w1_i02_database_gate_value_invariant_test_sha}" &&
           "${commit}" == "${resolved_tip}" ]] ||
          fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:value invariant verifier identity"
        expected_path="${w1_i02_database_gate_governance_paths[18]}"
        expected_mode=100755
        ;;
      *) fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:extra governance commit" ;;
    esac
    [[ "${changed_paths}" == "${expected_path}" ]] ||
      fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:wrong governance path"
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "W1_I02_DATABASE_GATE_CHANGE_INVALID:path mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "W1_I02_DATABASE_GATE_CHANGE_INVALID:NUL"
    commit_index=$((commit_index + 1))
  done
  [[ "${commit_index}" -eq 19 ]] ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:governance commit count"
}

find_w1_i02_database_gate_tip() {
  local head="$1"
  local commit gate_tip="" commit_count=0
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i02_database_gate_value_invariant_test_sha}" "${head}" ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:value invariant test is not an ancestor"
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i02_database_gate_value_invariant_test_sha}..${head}"); do
    commit_count=$((commit_count + 1))
    if [[ "${commit_count}" -eq 1 ]]; then
      gate_tip="${commit}"
      break
    fi
  done
  [[ -n "${gate_tip}" ]] ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:verifier commit unavailable"
  validate_w1_i02_database_gate_governance "${gate_tip}"
  printf '%s\n' "${gate_tip}"
}

require_w1_i02_database_gate_review_receipt() {
  local receipt="$1"
  local gate_tip="$2"
  local gate_parent gate_tree receipt_dir plan_file actual_candidate
  gate_parent="$(single_parent_of "${gate_tip}" \
    "reviewed W1-I02 database gate candidate")"
  gate_tree="$(git -C "${repo_root}" rev-parse "${gate_tip}^{tree}")" ||
    fail "W1_I02_DATABASE_GATE_REVIEW_IDENTITY_MISMATCH:tree unavailable"
  register_temporary_directory receipt_dir cognitura-i02-database-gate-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${receipt}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
    remove_temporary_directory "${receipt_dir}"
    fail "W1_I02_DATABASE_GATE_REVIEW_RECEIPT_INVALID:plan unavailable"
  }
  [[ "$(grep -c '^## 12\. I02 Database Gate Admission Receipt$' \
      "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "W1_I02_DATABASE_GATE_REVIEW_RECEIPT_INVALID:heading count"
  }
  sed -n '/^## 12\. I02 Database Gate Admission Receipt$/,$p' \
    "${plan_file}" > "${receipt_dir}/actual"
  actual_candidate="$(sed -n 's/^ReviewedGateCandidate = //p' \
    "${receipt_dir}/actual")"
  [[ "${actual_candidate}" == "${gate_tip}" ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "W1_I02_DATABASE_GATE_REVIEW_IDENTITY_MISMATCH:candidate"
  }
  printf '%s\n' \
    '## 12. I02 Database Gate Admission Receipt' \
    '' \
    '```text' \
    'W1-I02DatabaseGate = PASS' \
    "ReviewedGateCandidate = ${gate_tip}" \
    "ReviewedGateParent = ${gate_parent}" \
    "ReviewedGateTree = ${gate_tree}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0Findings = 0' \
    'P1Findings = 0' \
    'P2Findings = 0' \
    'Ultra = NOT_RUN' \
    "PostgreSQLTestImage = ${w1_i02_postgres_image}" \
    'ExpectedPostgreSQLMajor = 18' \
    'IsolatedContainerLifecycle = PASS' \
    'ReleasedTaskCard = W1-I02' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "W1_I02_DATABASE_GATE_REVIEW_RECEIPT_INVALID:receipt mismatch"
  }
  remove_temporary_directory "${receipt_dir}"
}

require_w1_i02_release_field() {
  local receipt="$1"
  local path="$2"
  local field="$3"
  local expected="$4"
  [[ "$(git_tree_field "${receipt}" "${path}" "${field}")" == "${expected}" ]] ||
    fail "W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:${path}:${field}"
}

require_w1_i02_release_boundary() {
  local receipt="$1"
  local path="$2"
  local field="$3"
  local expected="$4"
  local content count mismatches
  content="$(git -C "${repo_root}" show "${receipt}:${path}" 2>/dev/null)" ||
    fail "W1_I02_DATABASE_GATE_AUTHORIZATION_DRIFT:${path}:${field}"
  count="$(printf '%s\n' "${content}" | grep -c "^${field} = " || true)"
  mismatches="$(printf '%s\n' "${content}" | sed -n \
    "s/^${field} = //p" | grep -Fvx "${expected}" || true)"
  [[ "${count}" -gt 0 && -z "${mismatches}" ]] ||
    fail "W1_I02_DATABASE_GATE_AUTHORIZATION_DRIFT:${path}:${field}"
}

validate_w1_i02_database_gate_release() {
  local gate_tip="$1"
  local receipt="$2"
  local actual_paths expected_paths path base_mode head_mode
  [[ "$(single_parent_of "${receipt}" "W1-I02 database gate release")" == \
     "${gate_tip}" ]] ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:release must directly follow gate tip"
  git -C "${repo_root}" diff-tree --quiet "${gate_tip}" "${receipt}" &&
    fail "W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:empty release"
  require_no_git_rename_or_copy "${gate_tip}" "${receipt}" \
    "W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:rename or copy"
  expected_paths="$(printf '%s\n' "${w1_i02_release_projection_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${gate_tip}..${receipt}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:exact ten paths"
  for path in "${w1_i02_release_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${gate_tip}" "${path}")"
    head_mode="$(git_tree_mode "${receipt}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:path mode"
    require_git_blob_without_nul "${receipt}" "${path}" \
      "W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:NUL"
  done
  require_git_tree_field "${gate_tip}" "${w1_i02_card_path}" Status QUEUED
  [[ "$(git_tree_field "${receipt}" "${w1_i02_card_path}" Status)" == READY &&
     "$(git_tree_field "${receipt}" "${w1_i02_card_path}" \
       BusinessImplementationAuthorization)" == USER_AUTHORIZED &&
     "$(git_tree_field "${receipt}" "${w1_i02_card_path}" \
       FormalDatabaseGate)" == PASS ]] ||
    fail "I02_READY_REQUIRES_DATABASE_GATE"
  [[ "$(git_tree_field "${receipt}" \
       docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite)" == NOT_AUTHORIZED &&
     "$(git_tree_field "${receipt}" \
       docs/task-cards/wave-1-implementation/README.md RemotePush)" == NOT_AUTHORIZED ]] ||
    fail "W1_I02_DATABASE_GATE_AUTHORIZATION_DRIFT"
  require_w1_i02_release_field "${receipt}" AGENTS.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" AGENTS.md \
    ActiveImplementationTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" README.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" README.md \
    ActiveImplementationTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" docs/design/wave-1/README.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" docs/design/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-design-index.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-design-index.md ActiveTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-design-index.md ActiveTaskCardStatus READY
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-design-index.md ActiveImplementationTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-design-plan.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-design-plan.md \
    ActiveImplementationGovernanceTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md \
    ImplementationTaskCardPlanStatus I02_DATABASE_GATE_PASS_I02_READY
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md \
    ActiveImplementationGovernanceTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md \
    TaskCardSetStatus READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md ActiveTaskCard W1-I02
  require_w1_i02_release_field "${receipt}" docs/task-cards/wave-1/README.md \
    Wave1ImplementationTaskCardSet READY_FOR_EXECUTION
  require_w1_i02_release_field "${receipt}" docs/task-cards/wave-1/README.md \
    ActiveImplementationGovernanceTaskCard W1-I02
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md \
    TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md ActiveTaskCard W1-I02
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 1
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/W1-I07-revision-attempt-fencing-publication.md \
    Status BLOCKED_BY_DEPENDENCY
  require_w1_i02_release_boundary "${receipt}" AGENTS.md \
    FormalDatabaseWrite NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" AGENTS.md RemotePush NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" README.md \
    FormalDatabaseWrite NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" README.md RemotePush NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-design-index.md FormalDatabaseWrite NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-design-index.md RemotePush NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-wave-1-design-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-wave-1-design-plan.md DeploymentAndRelease NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md RemotePush NOT_PERFORMED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md RemotePush NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md RemotePush NOT_AUTHORIZED
  require_w1_i02_release_boundary "${receipt}" "${w1_i02_card_path}" \
    RemotePush NOT_AUTHORIZED
  index_content="$(git -C "${repo_root}" show \
    "${receipt}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "W1_I02_DATABASE_GATE_RELEASE_SCOPE_INVALID:index unavailable"
  [[ "$(printf '%s\n' "${index_content}" | grep -c '| `READY` |' || true)" -eq 1 ]] ||
    fail "W1_I02_DATABASE_GATE_RELEASE_SCOPE_INVALID:READY count"
  require_exact_git_tree_table_row \
    "${receipt}" docs/task-cards/wave-1-implementation/README.md W1-I02 \
    '| `W1-I02` | [来源持久化](W1-I02-source-persistence.md) | `READY` | `W1-I01` | `W1-IG2` | `HIGH` |' \
    'W1_I02_DATABASE_GATE_RELEASE_SCOPE_INVALID:I02 row'
  require_exact_git_tree_table_row \
    "${receipt}" docs/task-cards/wave-1-implementation/README.md W1-I07 \
    '| `W1-I07` | [处理发布](W1-I07-revision-attempt-fencing-publication.md) | `BLOCKED_BY_DEPENDENCY` | `W1-I02,W1-I04,W1-I05,W1-I06` | `W1-IG7` | `HIGH` |' \
    'W1_I02_DATABASE_GATE_RELEASE_SCOPE_INVALID:I07 row'
  require_exact_git_tree_table_row \
    "${receipt}" docs/engineering/cognitura-wave-1-implementation-plan.md W1-I02 \
    '| `W1-I02` | Source persistence | `I01` | `READY` |' \
    'W1_I02_DATABASE_GATE_RELEASE_PROJECTION_INVALID:implementation plan I02 row'
  require_w1_i02_database_gate_review_receipt "${receipt}" "${gate_tip}"
}

find_unique_w1_i02_database_gate_release() {
  local gate_tip="$1"
  local head="$2"
  local commit parent current_state parent_state receipt="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${gate_tip}..${head}"); do
    parent="$(single_parent_of "${commit}" "W1-I02 database gate release provenance")"
    current_state="$(git_tree_field "${commit}" "${w1_i02_card_path}" Status)"
    parent_state="$(git_tree_field "${parent}" "${w1_i02_card_path}" Status)"
    if [[ "${parent_state}" == QUEUED && "${current_state}" == READY ]]; then
      receipt_count=$((receipt_count + 1))
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] ||
    fail "W1_I02_DATABASE_GATE_CHAIN_INVALID:release must occur exactly once"
  printf '%s\n' "${receipt}"
}

validate_terra_first_routing_successor_commit() {
  local parent="$1"
  local commit="$2"
  local actual_paths expected_paths path expected_mode
  [[ "${parent}" == "${terra_first_routing_predecessor_sha}" ]] ||
    fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:predecessor"
  git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
    fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:empty commit"
  require_no_git_rename_or_copy "${parent}" "${commit}" \
    "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:rename or copy"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${parent}..${commit}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' \
    "${terra_first_routing_successor_paths[@]}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:exact four paths"
  for path in "${terra_first_routing_successor_paths[@]}"; do
    case "${path}" in
      AGENTS.md|docs/superpowers/specs/*) expected_mode=100644 ;;
      scripts/*|tests/*) expected_mode=100755 ;;
      *) fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:unknown path" ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${path}")" == "${expected_mode}" ]] ||
      fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:path mode"
    require_git_blob_without_nul "${commit}" "${path}" \
      "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:NUL"
  done
  [[ "$(git -C "${repo_root}" rev-parse \
      "${commit}:AGENTS.md")" == "${terra_first_routing_agents_blob}" ]] ||
    fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:AGENTS.md blob"
  [[ "$(git -C "${repo_root}" rev-parse \
      "${commit}:${terra_first_routing_authority_path}")" == \
      "${terra_first_routing_authority_blob}" ]] ||
    fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:Authority blob"
}

terra_first_routing_successor_for_head() {
  local head="$1"
  local successor parent
  [[ "${head}" != "${terra_first_routing_predecessor_sha}" ]] || return 1
  git -C "${repo_root}" merge-base --is-ancestor \
    "${terra_first_routing_predecessor_sha}" "${head}" || return 1
  successor="$(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${terra_first_routing_predecessor_sha}..${head}" | sed -n '1p')"
  [[ -n "${successor}" ]] || return 1
  parent="$(single_parent_of "${successor}" \
    "Terra-first routing successor")"
  validate_terra_first_routing_successor_commit "${parent}" "${successor}"
  printf '%s\n' "${successor}"
}

validate_terra_first_routing_worktree() {
  local head="$1"
  local successor path
  successor="$(terra_first_routing_successor_for_head "${head}")" || return 1
  for path in "${terra_first_routing_successor_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${successor}" -- "${path}" ||
      fail "TERRA_FIRST_ROUTING_WORKTREE_DRIFT:${path}"
  done
}

validate_w1_i02_ready_working_projection() {
  local receipt="$1"
  local head="$2"
  local path successor=""
  successor="$(terra_first_routing_successor_for_head "${head}")" || true
  for path in "${w1_i02_release_projection_paths[@]}"; do
    if [[ "${path}" == AGENTS.md && -n "${successor}" ]]; then
      continue
    fi
    git -C "${repo_root}" diff --quiet "${receipt}" -- "${path}" ||
      fail "working projection must match W1-I02 database gate receipt"
  done
  if [[ -n "${successor}" ]]; then
    validate_terra_first_routing_worktree "${head}" ||
      fail "TERRA_FIRST_ROUTING_SUCCESSOR_INVALID:working tree"
  fi
}

validate_post_w1_i02_database_gate_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  [[ "${receipt}" != "${head}" ]] || return 0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" "post-W1-I02 database gate descendant")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "W1_I02_DATABASE_GATE_DESCENDANT_OUTSIDE_WRITE_SET:empty commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "W1_I02_DATABASE_GATE_DESCENDANT_OUTSIDE_WRITE_SET:rename or copy"
    if [[ "${parent}" == "${terra_first_routing_predecessor_sha}" ]]; then
      validate_terra_first_routing_successor_commit "${parent}" "${commit}"
      continue
    fi
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i02_descendant_path "${path}" ||
        fail "W1_I02_DATABASE_GATE_DESCENDANT_OUTSIDE_WRITE_SET:${path}"
    done <<< "${changed_paths}"
  done
}

require_w1_i02_closure_review_receipt() {
  local commit="$1"
  local receipt_dir plan_file
  register_temporary_directory receipt_dir cognitura-i02-closure-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${commit}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
    remove_temporary_directory "${receipt_dir}"
    fail "I02 closure review receipt mismatch"
  }
  [[ "$(grep -c '^## 13\. I02 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I02 closure review receipt mismatch"
  }
  sed -n '/^## 13\. I02 关闭收据$/,$p' "${plan_file}" > \
    "${receipt_dir}/actual"
  printf '%s\n' \
    '## 13. I02 关闭收据' \
    '' \
    '```text' \
    'W1-I02 = DONE' \
    "ReviewedCandidate = ${w1_i02_reviewed_candidate_sha}" \
    "ReviewedParent = ${w1_i02_reviewed_parent_sha}" \
    "ReviewedTree = ${w1_i02_reviewed_tree_sha}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'I02ClosureReleasedTaskCard = W1-I07' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I02 closure review receipt mismatch"
  }
  remove_temporary_directory "${receipt_dir}"
}

write_normalized_w1_i02_closure_file() {
  local commit="$1"
  local path="$2"
  local output_file="$3"
  local state="$4"
  local pair_index current_file next_file expected_state matched=0
  current_file="${output_file}.source"
  git -C "${repo_root}" show "${commit}:${path}" > "${current_file}" 2>/dev/null ||
    fail "I02 closure projection path is unavailable: ${path}"
  copy_nul_free_file "${current_file}" "${output_file}.nul-free" \
    "I02 closure projection contains NUL: ${path}"
  current_file="${output_file}.nul-free"
  if [[ "${state}" == HEAD && \
        "${path}" == docs/engineering/cognitura-wave-1-implementation-plan.md ]]; then
    next_file="${output_file}.without-receipt"
    perl -0777 -pe 's/\n## 13\. I02 关闭收据\n.*\z//s' \
      "${current_file}" > "${next_file}" ||
      fail "I02 closure receipt normalization failed"
    current_file="${next_file}"
  fi
  [[ "${state}" == BASE ]] && expected_state=SUSPENDED || expected_state=READY
  for pair_index in "${!w1_i02_closure_pair_paths[@]}"; do
    [[ "${w1_i02_closure_pair_paths[${pair_index}]}" == "${path}" ]] || continue
    matched=1
    next_file="${output_file}.pair-${pair_index}"
    normalize_narrative_pair_file \
      "${current_file}" "${next_file}" \
      "${w1_i02_closure_pair_base[${pair_index}]}" \
      "${w1_i02_closure_pair_head[${pair_index}]}" \
      "__W1_I02_CLOSURE_PAIR_${pair_index}__" \
      "${expected_state}" \
      "I02 closure projection mismatch: ${path}"
    current_file="${next_file}"
  done
  [[ "${matched}" -eq 1 ]] ||
    fail "missing I02 closure projection contract: ${path}"
  cp "${current_file}" "${output_file}" ||
    fail "could not materialize normalized I02 closure projection: ${path}"
}

validate_w1_i02_closure() {
  local base="$1"
  local head="$2"
  local actual_paths expected_paths path base_mode head_mode compare_dir compare_index=0
  local index_content
  [[ "${base}" == "${w1_i02_closure_base_sha}" ]] ||
    fail "I02 closure must start at the fixed reviewed routing base"
  [[ "$(single_parent_of "${head}" "W1-I02 closure")" == "${base}" ]] ||
    fail "I02 closure must directly follow the fixed base"
  git -C "${repo_root}" diff-tree --quiet "${base}" "${head}" &&
    fail "I02 closure must be non-empty"
  require_no_git_rename_or_copy "${base}" "${head}" \
    "I02 closure must not contain rename or copy changes"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${base}..${head}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' "${w1_i02_closure_commit_paths[@]}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I02 closure fixed diff must equal the exact thirteen paths"
  for path in "${w1_i02_closure_commit_paths[@]}"; do
    base_mode="$(git_tree_mode "${base}" "${path}")"
    head_mode="$(git_tree_mode "${head}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I02 closure must preserve path modes"
    require_git_blob_without_nul "${head}" "${path}" \
      "I02 closure path contains NUL"
  done
  require_git_tree_field "${base}" "${w1_i02_card_path}" Status READY
  require_git_tree_field "${base}" "${w1_i07_card_path}" Status BLOCKED_BY_DEPENDENCY
  require_git_tree_field "${head}" "${w1_i02_card_path}" Status DONE
  require_git_tree_field "${head}" "${w1_i07_card_path}" Status READY
  [[ "$(git_tree_field "${head}" "${w1_i07_card_path}" \
      BusinessImplementationAuthorization)" == USER_AUTHORIZED ]] ||
    fail "W1-I07 requires explicit business implementation authorization"
  [[ "$(git_tree_field "${head}" "${w1_i07_card_path}" FormalDatabaseGate)" == \
      REQUIRED_DEPENDENCY_I02_ONLY ]] ||
    fail "I02 closure must preserve W1-I07 database dependency boundary"
  [[ "$(git_tree_field "${head}" \
       docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite)" == NOT_AUTHORIZED &&
     "$(git_tree_field "${head}" \
       docs/task-cards/wave-1-implementation/README.md RemotePush)" == NOT_AUTHORIZED ]] ||
    fail "I02 closure must preserve database and push authorization boundaries"
  require_git_tree_field "${head}" \
    docs/task-cards/wave-1-implementation/README.md \
    TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${head}" \
    docs/task-cards/wave-1-implementation/README.md ActiveTaskCard W1-I07
  require_git_tree_field "${head}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 1
  index_content="$(git -C "${repo_root}" show \
    "${head}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "I02 closure task index is unavailable"
  [[ "$(printf '%s\n' "${index_content}" | grep -c '| `READY` |' || true)" -eq 1 ]] ||
    fail "I02 closure must release exactly one READY card"
  require_exact_git_tree_table_row \
    "${head}" docs/task-cards/wave-1-implementation/README.md W1-I02 \
    '| `W1-I02` | [来源持久化](W1-I02-source-persistence.md) | `DONE` | `W1-I01` | `W1-IG2` | `HIGH` |' \
    'I02 closure task index I02 row mismatch'
  require_exact_git_tree_table_row \
    "${head}" docs/task-cards/wave-1-implementation/README.md W1-I07 \
    '| `W1-I07` | [处理发布](W1-I07-revision-attempt-fencing-publication.md) | `READY` | `W1-I02,W1-I04,W1-I05,W1-I06` | `W1-IG7` | `HIGH` |' \
    'I02 closure task index I07 row mismatch'
  require_w1_i02_closure_review_receipt "${head}"
  register_temporary_directory compare_dir cognitura-i02-closure-compare
  for path in "${w1_i02_closure_projection_paths[@]}"; do
    write_normalized_w1_i02_closure_file \
      "${base}" "${path}" "${compare_dir}/base-${compare_index}" BASE
    write_normalized_w1_i02_closure_file \
      "${head}" "${path}" "${compare_dir}/head-${compare_index}" HEAD
    cmp -s "${compare_dir}/base-${compare_index}" \
      "${compare_dir}/head-${compare_index}" || {
      remove_temporary_directory "${compare_dir}"
      fail "I02 closure must be an exact projection-only transform: ${path}"
    }
    compare_index=$((compare_index + 1))
  done
  remove_temporary_directory "${compare_dir}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i02_reviewed_candidate_sha}..${head}" -- \
    "${w1_i02_product_paths[@]}" ||
    fail "reviewed W1-I02 product must remain byte-identical"
}

find_unique_w1_i02_closure() {
  local head="$1"
  local commit parent parent_i02 current_i02 parent_i07 current_i07
  local receipt="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i02_closure_base_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" "W1-I02 closure provenance")"
    parent_i02="$(git_tree_field "${parent}" "${w1_i02_card_path}" Status)"
    current_i02="$(git_tree_field "${commit}" "${w1_i02_card_path}" Status)"
    parent_i07="$(git_tree_field "${parent}" "${w1_i07_card_path}" Status)"
    current_i07="$(git_tree_field "${commit}" "${w1_i07_card_path}" Status)"
    if [[ "${parent_i02}:${current_i02}:${parent_i07}:${current_i07}" == \
        READY:DONE:BLOCKED_BY_DEPENDENCY:READY ]]; then
      receipt_count=$((receipt_count + 1))
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] ||
    fail "I02 closure must occur exactly once"
  printf '%s\n' "${receipt}"
}

validate_post_w1_i02_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  [[ "${receipt}" != "${head}" ]] || return 0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" "post-I02-closure descendant")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "post-I02-closure descendant must be non-empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "post-I02-closure descendant must not contain rename or copy changes"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i07_descendant_path "${path}" ||
        fail "post-I02-closure descendant changed a path outside the W1-I07 WriteSet"
    done <<< "${changed_paths}"
  done
}

validate_w1_i07_predecessor() {
  local origin_parent origin_tree i02_receipt actual_paths expected_paths
  origin_parent="$(single_parent_of "${w1_i07_closure_origin_sha}" \
    "W1-I07 reviewed product candidate")"
  [[ "${origin_parent}" == "${w1_i07_reviewed_parent_sha}" ]] ||
    fail "I07_CLOSURE_PRODUCT_IDENTITY_INVALID:parent"
  origin_tree="$(git -C "${repo_root}" rev-parse \
    "${w1_i07_closure_origin_sha}^{tree}" 2>/dev/null)" ||
    fail "I07_CLOSURE_PRODUCT_IDENTITY_INVALID:tree unavailable"
  [[ "${origin_tree}" == "${w1_i07_reviewed_tree_sha}" ]] ||
    fail "I07_CLOSURE_PRODUCT_IDENTITY_INVALID:tree"
  [[ "${w1_i07_closure_origin_sha}" == "${w1_i07_reviewed_candidate_sha}" ]] ||
    fail "I07_CLOSURE_PRODUCT_IDENTITY_INVALID:candidate"
  i02_receipt="$(find_unique_w1_i02_closure "${w1_i07_closure_origin_sha}")"
  validate_w1_i02_closure "${w1_i02_closure_base_sha}" "${i02_receipt}"
  validate_post_w1_i02_closure_descendants \
    "${i02_receipt}" "${w1_i07_closure_origin_sha}"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${i02_receipt}..${w1_i07_closure_origin_sha}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' "${w1_i07_product_paths[@]}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I07_CLOSURE_PRODUCT_IDENTITY_INVALID:exact eight paths"
}

validate_w1_i07_closure_governance_chain() {
  local tip="$1"
  local commits=() commit parent previous changed_paths path index expected_path
  local expected_mode actual_paths expected_paths
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i07_closure_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:origin ancestry"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i07_closure_origin_sha}..${tip}")
  for commit in "${commits[@]}"; do
    parent="$(single_parent_of "${commit}" \
      "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:single parent")"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i07_descendant_path "${path}" &&
        fail "I07_CLOSURE_PRODUCT_DRIFT:${path}"
    done <<< "${changed_paths}"
  done
  [[ "${#commits[@]}" -eq "${#w1_i07_closure_governance_paths[@]}" ]] ||
    fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:exact twenty-one commits"
  previous="${w1_i07_closure_origin_sha}"
  for index in "${!w1_i07_closure_governance_paths[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i07_closure_governance_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:first-parent order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:empty commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:rename or copy"
    actual_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}" | LC_ALL=C sort)"
    [[ "${actual_paths}" == "${expected_path}" ]] ||
      fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:path order"
    case "${expected_path}" in
      docs/superpowers/specs/*|docs/superpowers/plans/*) expected_mode=100644 ;;
      tests/*|scripts/*) expected_mode=100755 ;;
      *) fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:unknown path" ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:NUL"
    previous="${commit}"
  done
  expected_paths="$(printf '%s\n' \
    "${w1_i07_closure_governance_paths[@]}" | LC_ALL=C sort -u)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${w1_i07_closure_origin_sha}..${tip}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:cumulative paths"
  git -C "${repo_root}" diff --quiet \
    "${w1_i07_closure_origin_sha}..${tip}" -- \
    "${w1_i07_closure_projection_paths[@]}" ||
    fail "I07_CLOSURE_PROJECTION_MISMATCH:governance prefix"
  git -C "${repo_root}" diff --quiet \
    "${w1_i07_reviewed_candidate_sha}..${tip}" -- \
    "${w1_i07_product_paths[@]}" ||
    fail "I07_CLOSURE_PRODUCT_DRIFT:governance prefix"
}

require_w1_i07_closure_review_receipt() {
  local receipt="$1"
  local governance_tip="$2"
  local governance_parent governance_tree receipt_dir plan_file
  governance_parent="$(single_parent_of "${governance_tip}" \
    "I07_CLOSURE_REVIEW_RECEIPT_INVALID:governance parent")"
  governance_tree="$(git -C "${repo_root}" rev-parse \
    "${governance_tip}^{tree}" 2>/dev/null)" ||
    fail "I07_CLOSURE_REVIEW_RECEIPT_INVALID:governance tree"
  register_temporary_directory receipt_dir cognitura-i07-closure-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${receipt}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
      remove_temporary_directory "${receipt_dir}"
      fail "I07_CLOSURE_REVIEW_RECEIPT_INVALID:plan unavailable"
    }
  [[ "$(grep -c '^## 14\. I07 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I07_CLOSURE_REVIEW_RECEIPT_INVALID:heading"
  }
  sed -n '/^## 14\. I07 关闭收据$/,$p' "${plan_file}" > \
    "${receipt_dir}/actual"
  printf '%s\n' \
    '## 14. I07 关闭收据' \
    '' \
    '```text' \
    'W1-I07 = DONE' \
    "ReviewedCandidate = ${w1_i07_reviewed_candidate_sha}" \
    "ReviewedParent = ${w1_i07_reviewed_parent_sha}" \
    "ReviewedTree = ${w1_i07_reviewed_tree_sha}" \
    "ReviewedGovernanceCandidate = ${governance_tip}" \
    "ReviewedGovernanceParent = ${governance_parent}" \
    "ReviewedGovernanceTree = ${governance_tree}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'I07ClosureReleasedTaskCard = W1-I08' \
    'QueuedTaskCard = W1-I09' \
    'QueuedReason = SERIAL_EXECUTION_ORDER' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I07_CLOSURE_REVIEW_RECEIPT_INVALID:content"
  }
  remove_temporary_directory "${receipt_dir}"
}

write_normalized_w1_i07_closure_file() {
  local commit="$1"
  local path="$2"
  local output_file="$3"
  local state="$4"
  local current_file next_file pair_index expected_state matched=0
  git -C "${repo_root}" show "${commit}:${path}" > \
    "${output_file}.raw" 2>/dev/null ||
    fail "I07_CLOSURE_PROJECTION_MISMATCH:path unavailable:${path}"
  copy_nul_free_file "${output_file}.raw" "${output_file}.nul-free" \
    "I07_CLOSURE_RECEIPT_PATHS_INVALID:NUL:${path}"
  current_file="${output_file}.nul-free"
  if [[ "${state}" == HEAD && \
        "${path}" == docs/engineering/cognitura-wave-1-implementation-plan.md ]]; then
    next_file="${output_file}.without-receipt"
    perl -0777 -pe 's/\n## 14\. I07 关闭收据\n.*\z//s' \
      "${current_file}" > "${next_file}" ||
      fail "I07_CLOSURE_REVIEW_RECEIPT_INVALID:normalization"
    current_file="${next_file}"
  fi
  [[ "${state}" == BASE ]] && expected_state=SUSPENDED || expected_state=READY
  for pair_index in "${!w1_i07_closure_pair_paths[@]}"; do
    [[ "${w1_i07_closure_pair_paths[${pair_index}]}" == "${path}" ]] || continue
    matched=1
    next_file="${output_file}.pair-${pair_index}"
    normalize_narrative_pair_file \
      "${current_file}" "${next_file}" \
      "${w1_i07_closure_pair_base[${pair_index}]}" \
      "${w1_i07_closure_pair_head[${pair_index}]}" \
      "__W1_I07_CLOSURE_PAIR_${pair_index}__" \
      "${expected_state}" \
      "I07_CLOSURE_PROJECTION_MISMATCH:${path}"
    current_file="${next_file}"
  done
  [[ "${matched}" -eq 1 ]] ||
    fail "I07_CLOSURE_PROJECTION_MISMATCH:missing pair:${path}"
  cp "${current_file}" "${output_file}" ||
    fail "I07_CLOSURE_PROJECTION_MISMATCH:copy:${path}"
}

require_all_w1_i07_git_tree_fields() {
  local commit="$1"
  local path="$2"
  local key="$3"
  local expected="$4"
  local content count mismatches
  content="$(git -C "${repo_root}" show "${commit}:${path}" 2>/dev/null)" ||
    fail "I07_CLOSURE_AUTHORIZATION_DRIFT:${path}:${key}:unavailable"
  count="$(printf '%s\n' "${content}" | grep -c "^${key} = " || true)"
  [[ "${count}" -gt 0 ]] ||
    fail "I07_CLOSURE_AUTHORIZATION_DRIFT:${path}:${key}:missing"
  mismatches="$(printf '%s\n' "${content}" | sed -n "s/^${key} = //p" | \
    grep -Fvx "${expected}" || true)"
  [[ -z "${mismatches}" ]] ||
    fail "I07_CLOSURE_AUTHORIZATION_DRIFT:${path}:${key}"
}

validate_w1_i07_closure_receipt() {
  local governance_tip="$1"
  local receipt="$2"
  local actual_paths expected_paths path base_mode head_mode index_content
  local compare_dir compare_index=0
  [[ "$(single_parent_of "${receipt}" \
    "I07_CLOSURE_RECEIPT_PATHS_INVALID:direct child")" == "${governance_tip}" ]] ||
    fail "I07_CLOSURE_RECEIPT_PATHS_INVALID:direct child"
  validate_w1_i07_closure_governance_chain "${governance_tip}"
  [[ "$(git_tree_field "${receipt}" "${w1_i07_card_path}" Status)" == DONE ]] ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:cards"
  require_no_git_rename_or_copy "${governance_tip}" "${receipt}" \
    "I07_CLOSURE_RECEIPT_PATHS_INVALID:rename or copy"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${governance_tip}..${receipt}" | LC_ALL=C sort)"
  expected_paths="$(printf '%s\n' \
    "${w1_i07_closure_projection_paths[@]}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I07_CLOSURE_RECEIPT_PATHS_INVALID:exact twelve paths"
  for path in "${w1_i07_closure_projection_paths[@]}"; do
    base_mode="$(git_tree_mode "${governance_tip}" "${path}")"
    head_mode="$(git_tree_mode "${receipt}" "${path}")"
    [[ -n "${base_mode}" && "${base_mode}" == "${head_mode}" ]] ||
      fail "I07_CLOSURE_RECEIPT_PATHS_INVALID:mode:${path}"
    require_git_blob_without_nul "${receipt}" "${path}" \
      "I07_CLOSURE_RECEIPT_PATHS_INVALID:NUL:${path}"
  done
  [[ "$(git_tree_field "${governance_tip}" "${w1_i07_card_path}" Status)" == READY &&
     "$(git_tree_field "${governance_tip}" "${w1_i08_card_path}" Status)" == BLOCKED_BY_DEPENDENCY &&
     "$(git_tree_field "${governance_tip}" "${w1_i09_card_path}" Status)" == BLOCKED_BY_DEPENDENCY &&
     "$(git_tree_field "${receipt}" "${w1_i07_card_path}" Status)" == DONE &&
     "$(git_tree_field "${receipt}" "${w1_i08_card_path}" Status)" == READY &&
     "$(git_tree_field "${receipt}" "${w1_i09_card_path}" Status)" == QUEUED &&
     "$(git_tree_field "${receipt}" "${w1_i10_card_path}" Status)" == BLOCKED_BY_DEPENDENCY ]] ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:cards"
  [[ "$(git_tree_field "${receipt}" "${w1_i08_card_path}" \
      BusinessImplementationAuthorization)" == USER_AUTHORIZED &&
     "$(git_tree_field "${receipt}" "${w1_i09_card_path}" \
      BusinessImplementationAuthorization)" == REQUIRED_BEFORE_READY ]] ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:authorization vector"
  [[ "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/README.md ActiveTaskCard)" == W1-I08 ]] ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:ActiveTaskCard = W1-I08"
  [[ "$(git_tree_field "${receipt}" \
      docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount)" == 1 ]] ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:ReadyTaskCardCount = 1"
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md \
    TaskCardSetStatus READY_FOR_EXECUTION
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md ActiveTaskCard W1-I08
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md ReadyTaskCardCount 1
  require_git_tree_field "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md SuspendedTaskCardCount 0
  index_content="$(git -C "${repo_root}" show \
    "${receipt}:docs/task-cards/wave-1-implementation/README.md")" ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:index"
  [[ "$(printf '%s\n' "${index_content}" | grep -c '| `READY` |' || true)" -eq 1 ]] ||
    fail "I07_CLOSURE_STATE_VECTOR_INVALID:READY count"
  require_exact_git_tree_table_row "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md W1-I07 \
    '| `W1-I07` | [处理发布](W1-I07-revision-attempt-fencing-publication.md) | `DONE` | `W1-I02,W1-I04,W1-I05,W1-I06` | `W1-IG7` | `HIGH` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I07 index row'
  require_exact_git_tree_table_row "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md W1-I08 \
    '| `W1-I08` | [稳定引用与 lineage](W1-I08-stable-reference-reparse-lineage.md) | `READY` | `W1-I07` | `W1-IG8` | `HIGH` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I08 index row'
  require_exact_git_tree_table_row "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md W1-I09 \
    '| `W1-I09` | [上传与处理命令](W1-I09-upload-processing-command-api.md) | `QUEUED` | `W1-I07` | `W1-IG9` | `HIGH` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I09 index row'
  require_exact_git_tree_table_row "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md W1-I10 \
    '| `W1-I10` | [来源预览查询](W1-I10-source-preview-query-api.md) | `BLOCKED_BY_DEPENDENCY` | `W1-I08,W1-I09` | `W1-IG10` | `HIGH` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I10 index row'
  require_exact_git_tree_table_row "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md W1-I07 \
    '| `W1-I07` | Attempt fencing/publication | `I02,I04,I05,I06` | `DONE` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I07 plan row'
  require_exact_git_tree_table_row "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md W1-I08 \
    '| `W1-I08` | Stable reference/lineage | `I07` | `READY` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I08 plan row'
  require_exact_git_tree_table_row "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md W1-I09 \
    '| `W1-I09` | Upload/processing command API | `I07` | `QUEUED` |' \
    'I07_CLOSURE_STATE_VECTOR_INVALID:I09 plan row'
  require_all_w1_i07_git_tree_fields "${receipt}" AGENTS.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" AGENTS.md RemotePush NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" README.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" README.md RemotePush NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-design-index.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-design-index.md RemotePush NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-wave-1-design-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-wave-1-design-plan.md DeploymentAndRelease NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-wave-1-design-acceptance.md RemotePush NOT_PERFORMED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/engineering/cognitura-wave-1-implementation-plan.md RemotePush NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md FormalDatabaseWrite NOT_AUTHORIZED
  require_all_w1_i07_git_tree_fields "${receipt}" \
    docs/task-cards/wave-1-implementation/README.md RemotePush NOT_AUTHORIZED
  require_w1_i07_closure_review_receipt "${receipt}" "${governance_tip}"
  register_temporary_directory compare_dir cognitura-i07-closure-compare
  for path in "${w1_i07_closure_projection_paths[@]}"; do
    write_normalized_w1_i07_closure_file \
      "${governance_tip}" "${path}" "${compare_dir}/base-${compare_index}" BASE
    write_normalized_w1_i07_closure_file \
      "${receipt}" "${path}" "${compare_dir}/head-${compare_index}" HEAD
    cmp -s "${compare_dir}/base-${compare_index}" \
      "${compare_dir}/head-${compare_index}" || {
        remove_temporary_directory "${compare_dir}"
        fail "I07_CLOSURE_PROJECTION_MISMATCH:${path}"
      }
    compare_index=$((compare_index + 1))
  done
  remove_temporary_directory "${compare_dir}"
  git -C "${repo_root}" diff --quiet \
    "${w1_i07_reviewed_candidate_sha}..${receipt}" -- \
    "${w1_i07_product_paths[@]}" ||
    fail "I07_CLOSURE_PRODUCT_DRIFT:receipt"
}

find_unique_w1_i07_closure_receipt() {
  local head="$1"
  local commit parent vector receipt="" receipt_count=0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i07_closure_origin_sha}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I07_CLOSURE_GOVERNANCE_CHAIN_INVALID:receipt provenance")"
    vector="$(git_tree_field "${parent}" "${w1_i07_card_path}" Status):$(git_tree_field \
      "${commit}" "${w1_i07_card_path}" Status):$(git_tree_field \
      "${parent}" "${w1_i08_card_path}" Status):$(git_tree_field \
      "${commit}" "${w1_i08_card_path}" Status):$(git_tree_field \
      "${parent}" "${w1_i09_card_path}" Status):$(git_tree_field \
      "${commit}" "${w1_i09_card_path}" Status)"
    if [[ "${vector}" == \
        READY:DONE:BLOCKED_BY_DEPENDENCY:READY:BLOCKED_BY_DEPENDENCY:QUEUED ]]; then
      receipt_count=$((receipt_count + 1))
      receipt="${commit}"
    fi
  done
  [[ "${receipt_count}" -eq 1 ]] ||
    fail "I07_CLOSURE_REVIEW_RECEIPT_INVALID:exactly once"
  printf '%s\n' "${receipt}"
}

validate_post_w1_i07_closure_descendants() {
  local receipt="$1"
  local head="$2"
  local commit parent changed_paths path
  [[ "${receipt}" != "${head}" ]] || return 0
  for commit in $(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${receipt}..${head}"); do
    parent="$(single_parent_of "${commit}" \
      "I07_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:single parent")"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I07_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:empty commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I07_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i08_descendant_path "${path}" ||
        fail "I07_CLOSURE_DESCENDANT_OUTSIDE_WRITE_SET:${path}"
    done <<< "${changed_paths}"
  done
}

validate_w1_i07_pending_worktree() {
  local governance_tip="$1"
  local path
  for path in "${w1_i07_closure_governance_paths[@]}" \
      "${w1_i07_closure_projection_paths[@]}" \
      "${w1_i07_product_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${governance_tip}" -- "${path}" ||
      fail "I07_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
}

validate_w1_i07_closed_worktree() {
  local governance_tip="$1"
  local receipt="$2"
  local head="$3"
  local path
  for path in "${w1_i07_closure_governance_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${governance_tip}" -- "${path}" ||
      fail "I07_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
  for path in "${w1_i07_closure_projection_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${receipt}" -- "${path}" ||
      fail "I07_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
  for path in "${w1_i07_product_paths[@]}"; do
    git -C "${repo_root}" diff --quiet "${head}" -- "${path}" ||
      fail "I07_CLOSURE_WORKTREE_MISMATCH:${path}"
  done
}

validate_w1_i08_predecessor() {
  local origin_parent origin_tree i07_receipt i07_governance_tip
  origin_parent="$(single_parent_of "${w1_i08_closure_origin_sha}" \
    "I08_CLOSURE_PRODUCT_IDENTITY_INVALID:parent")"
  [[ "${origin_parent}" == "${w1_i08_reviewed_parent_sha}" ]] ||
    fail "I08_CLOSURE_PRODUCT_IDENTITY_INVALID:parent"
  origin_tree="$(git -C "${repo_root}" rev-parse \
    "${w1_i08_closure_origin_sha}^{tree}" 2>/dev/null)" ||
    fail "I08_CLOSURE_PRODUCT_IDENTITY_INVALID:tree unavailable"
  [[ "${origin_tree}" == "${w1_i08_reviewed_tree_sha}" ]] ||
    fail "I08_CLOSURE_PRODUCT_IDENTITY_INVALID:tree"
  i07_receipt="$(find_unique_w1_i07_closure_receipt \
    "${w1_i08_closure_origin_sha}")"
  i07_governance_tip="$(single_parent_of "${i07_receipt}" \
    "I08_CLOSURE_PRODUCT_IDENTITY_INVALID:I07 governance tip")"
  validate_w1_i07_predecessor
  validate_w1_i07_closure_receipt \
    "${i07_governance_tip}" "${i07_receipt}"
  validate_post_w1_i07_closure_descendants \
    "${i07_receipt}" "${w1_i08_closure_origin_sha}"
}

validate_w1_i08_closure_governance_chain() {
  local tip="$1"
  local commits=() commit parent previous changed_paths path index expected_path
  local expected_mode actual_paths expected_paths actual_blob expected_blob
  [[ "${tip}" == "${w1_i08_rejected_governance_sha}" ]] ||
    fail "I08_CLOSURE_GOVERNANCE_CANDIDATE_INVALID:fixed candidate"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i08_closure_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:origin ancestry"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i08_closure_origin_sha}..${tip}")
  for commit in "${commits[@]}"; do
    parent="$(single_parent_of "${commit}" \
      "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:single parent")"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i08_descendant_path "${path}" &&
        fail "I08_CLOSURE_PRODUCT_DRIFT:${path}"
    done <<< "${changed_paths}"
  done
  [[ "${#commits[@]}" -eq "${#w1_i08_closure_governance_paths[@]}" ]] ||
    fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:exact three commits"
  previous="${w1_i08_closure_origin_sha}"
  for index in "${!w1_i08_closure_governance_paths[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i08_closure_governance_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:first-parent order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:empty commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:rename or copy"
    actual_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}" | LC_ALL=C sort)"
    [[ "${actual_paths}" == "${expected_path}" ]] ||
      fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:path order"
    [[ "${index}" -eq 0 ]] && expected_mode=100644 || expected_mode=100755
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:NUL"
    if [[ "${index}" -eq 0 ]]; then
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:spec blob"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i08_closure_spec_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:spec evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:spec evidence"
    elif [[ "${index}" -eq 1 ]]; then
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:test blob"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i08_closure_test_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:test evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:test evidence"
    fi
    previous="${commit}"
  done
  expected_paths="$(printf '%s\n' \
    "${w1_i08_closure_governance_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${w1_i08_closure_origin_sha}..${tip}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:cumulative paths"
  git -C "${repo_root}" diff --quiet \
    "${w1_i08_closure_origin_sha}..${tip}" -- \
    "${w1_i08_closure_projection_paths[@]}" ||
    fail "I08_CLOSURE_PROJECTION_MISMATCH:governance prefix"
  git -C "${repo_root}" diff --quiet \
    "${w1_i08_closure_origin_sha}..${tip}" -- \
    "${w1_i08_product_paths[@]}" ||
    fail "I08_CLOSURE_PRODUCT_DRIFT:governance prefix"
}

validate_w1_i08_closure_correction_chain() {
  local tip="$1"
  local commits=() commit parent previous changed_paths path index expected_path
  local expected_mode actual_paths expected_paths actual_blob expected_blob
  validate_w1_i08_closure_governance_chain "${w1_i08_rejected_governance_sha}"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i08_rejected_governance_sha}" "${tip}" 2>/dev/null ||
    fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:origin ancestry"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i08_rejected_governance_sha}..${tip}")
  for commit in "${commits[@]}"; do
    parent="$(single_parent_of "${commit}" \
      "I08_CLOSURE_CORRECTION_CHAIN_INVALID:single parent")"
    changed_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}")"
    while IFS= read -r path; do
      [[ -n "${path}" ]] || continue
      is_w1_i08_descendant_path "${path}" &&
        fail "I08_CLOSURE_PRODUCT_DRIFT:${path}"
    done <<< "${changed_paths}"
  done
  [[ "${#commits[@]}" -eq "${#w1_i08_closure_correction_paths[@]}" ]] ||
    fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:exact three commits"
  previous="${w1_i08_rejected_governance_sha}"
  for index in "${!w1_i08_closure_correction_paths[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i08_closure_correction_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I08_CLOSURE_CORRECTION_CHAIN_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:first-parent order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:empty commit"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I08_CLOSURE_CORRECTION_CHAIN_INVALID:rename or copy"
    actual_paths="$(git -C "${repo_root}" diff --name-only \
      "${parent}..${commit}" | LC_ALL=C sort)"
    [[ "${actual_paths}" == "${expected_path}" ]] ||
      fail "I08_CLOSURE_GOVERNANCE_CHAIN_INVALID:correction path order"
    [[ "${index}" -eq 0 ]] && expected_mode=100644 || expected_mode=100755
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I08_CLOSURE_CORRECTION_CHAIN_INVALID:NUL"
    if [[ "${index}" -eq 0 ]]; then
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:spec blob"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i08_repair_spec_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:spec evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:spec evidence"
    elif [[ "${index}" -eq 1 ]]; then
      actual_blob="$(git -C "${repo_root}" rev-parse \
        "${commit}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:test blob"
      expected_blob="$(git -C "${repo_root}" rev-parse \
        "${w1_i08_repair_test_sha}:${expected_path}" 2>/dev/null)" ||
        fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:test evidence"
      [[ "${actual_blob}" == "${expected_blob}" ]] ||
        fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:test evidence"
    fi
    previous="${commit}"
  done
  expected_paths="$(printf '%s\n' \
    "${w1_i08_closure_correction_paths[@]}" | LC_ALL=C sort)"
  actual_paths="$(git -C "${repo_root}" diff --name-only \
    "${w1_i08_rejected_governance_sha}..${tip}" | LC_ALL=C sort)"
  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I08_CLOSURE_CORRECTION_CHAIN_INVALID:cumulative paths"
  git -C "${repo_root}" diff --quiet \
    "${w1_i08_rejected_governance_sha}..${tip}" -- \
    "${w1_i08_closure_projection_paths[@]}" ||
    fail "I08_CLOSURE_PROJECTION_MISMATCH:correction prefix"
  git -C "${repo_root}" diff --quiet \
    "${w1_i08_closure_origin_sha}..${tip}" -- \
    "${w1_i08_product_paths[@]}" ||
    fail "I08_CLOSURE_PRODUCT_DRIFT:correction prefix"
}

require_w1_i08_closure_review_receipt() {
  local receipt="$1"
  local governance_tip="$2"
  local governance_parent governance_tree receipt_dir plan_file
  governance_parent="$(single_parent_of "${governance_tip}" \
    "I08_CLOSURE_REVIEW_RECEIPT_INVALID:governance parent")"
  governance_tree="$(git -C "${repo_root}" rev-parse \
    "${governance_tip}^{tree}" 2>/dev/null)" ||
    fail "I08_CLOSURE_REVIEW_RECEIPT_INVALID:governance tree"
  register_temporary_directory receipt_dir cognitura-i08-closure-receipt
  plan_file="${receipt_dir}/plan"
  git -C "${repo_root}" show \
    "${receipt}:docs/engineering/cognitura-wave-1-implementation-plan.md" > \
    "${plan_file}" 2>/dev/null || {
      remove_temporary_directory "${receipt_dir}"
      fail "I08_CLOSURE_REVIEW_RECEIPT_INVALID:plan unavailable"
    }
  [[ "$(grep -c '^## 15\. I08 关闭收据$' "${plan_file}" || true)" -eq 1 ]] || {
    remove_temporary_directory "${receipt_dir}"
    fail "I08_CLOSURE_REVIEW_RECEIPT_INVALID:heading"
  }
  sed -n '/^## 15\. I08 关闭收据$/,$p' "${plan_file}" > \
    "${receipt_dir}/actual"
  printf '%s\n' \
    '## 15. I08 关闭收据' \
    '' \
    '```text' \
    'W1-I08 = DONE' \
    "ReviewedCandidate = ${w1_i08_closure_origin_sha}" \
    "ReviewedParent = ${w1_i08_reviewed_parent_sha}" \
    "ReviewedTree = ${w1_i08_reviewed_tree_sha}" \
    "ReviewedGovernanceCandidate = ${w1_i08_rejected_governance_sha}" \
    "ReviewedVerifierCorrectionCandidate = ${governance_tip}" \
    "ReviewedVerifierCorrectionParent = ${governance_parent}" \
    "ReviewedVerifierCorrectionTree = ${governance_tree}" \
    'ReviewLevel = L3' \
    'ReviewRoute = deep_reviewer' \
    'ReviewEffort = xhigh' \
    'ReviewMultiplicity = ONE' \
    'ReviewVerdict = GO' \
    'P0 = 0' \
    'P1 = 0' \
    'P2 = 0' \
    'Ultra = NOT_RUN' \
    'I08ClosureReleasedTaskCard = W1-I09' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' > "${receipt_dir}/expected"
  cmp -s "${receipt_dir}/actual" "${receipt_dir}/expected" || {
    remove_temporary_directory "${receipt_dir}"
    fail "I08_CLOSURE_REVIEW_RECEIPT_INVALID:content"
  }
  remove_temporary_directory "${receipt_dir}"
}

replace_w1_i08_expected_text() {
  local file="$1"
  local old_text="$2"
  local new_text="$3"
  local path="$4"
  local count
  count="$(I08_OLD_TEXT="${old_text}" perl -0777 -ne \
    '$count = () = /\Q$ENV{I08_OLD_TEXT}\E/g; print $count' "${file}")" ||
    fail "I08_CLOSURE_PROJECTION_MISMATCH:count:${path}"
  [[ "${count}" == 1 ]] ||
    fail "I08_CLOSURE_PROJECTION_MISMATCH:source:${path}"
  I08_OLD_TEXT="${old_text}" I08_NEW_TEXT="${new_text}" \
    perl -0777 -i.bak -pe \
      's/\Q$ENV{I08_OLD_TEXT}\E/$ENV{I08_NEW_TEXT}/g' "${file}" ||
    fail "I08_CLOSURE_PROJECTION_MISMATCH:replace:${path}"
  rm -f "${file}.bak"
}

