  [[ "${validation_bash_block}" == "${expected_validation_block}" ]] ||
    fail "${task_id}: validation Bash block mismatch"

  commit_section="$(sed -n '/^## 7\. 提交与审查$/,$p' "${file}")"
  [[ "$(printf '%s\n' "${commit_section}" | grep -c '^```bash$' || true)" -eq 1 ]] ||
    fail "${task_id}: commit section must contain exactly one Bash block"
  [[ "$(printf '%s\n' "${commit_section}" | grep -c '^```$' || true)" -eq 1 ]] ||
    fail "${task_id}: commit section must contain exactly one Bash block"
  commit_bash_block="$(
    printf '%s\n' "${commit_section}" |
      sed -n '/^```bash$/,/^```$/p' |
      sed '1d;$d'
  )"
  canonical_card_path="docs/task-cards/wave-1-implementation/${filename}"
  expected_commit_block="$(printf '%s\n' \
    "sed -n 's/^WriteSet = //p' \\" \
    "  ${canonical_card_path} |" \
    '  git add --pathspec-from-file=-' \
    'git diff --cached --name-only' \
    "git commit -m \"${expected_commit_message}\"")"
  [[ "${commit_bash_block}" == "${expected_commit_block}" ]] ||
    fail "${task_id}: commit Bash block mismatch"
  printf '%s\n' "${commit_section}" |
    grep -Fq '暂存清单必须与本卡 WriteSet 双向精确一致；目录级 `git add` 禁止。' ||
    fail "${task_id}: missing staged WriteSet verification"
  if [[ "${task_id}" == "W1-I13" ]]; then
    expected_fixed_review_gate='FixedCommitReviewGate = NEW_DEEP_REVIEWER_THEN_NEW_ULTRA_GATEKEEPER_ZERO_FINDING_REQUIRED'
  else
    expected_fixed_review_gate='FixedCommitReviewGate = NEW_DEEP_REVIEWER_ZERO_FINDING_BEFORE_SUCCESSOR_RELEASE'
  fi
  [[ "$(printf '%s\n' "${commit_section}" | grep -Fxc "${expected_fixed_review_gate}" || true)" -eq 1 ]] ||
    fail "${task_id}: missing fixed-commit review route"
  [[ "$(grep -c '^FixedCommitReviewGate = ' "${file}" || true)" -eq 1 ]] ||
    fail "${task_id}: FixedCommitReviewGate must occur exactly once"
  [[ "$(grep -Ec '(^|[[:space:]/])git([[:space:]]|$)' "${file}" || true)" -eq 5 ]] ||
    fail "${task_id}: unexpected Git invocation"

  production_limit="$(field_value "${file}" "ProductionFileLimit")"
  production_exception="$(field_value "${file}" "ProductionWriteSetException")"
  [[ "${production_limit}" =~ ^[0-9]+$ ]] || fail "ProductionFileLimit must be numeric for ${task_id}"
  [[ "${production_limit}" -eq 8 ]] || fail "ProductionFileLimit must remain 8 for ${task_id}"
  [[ "${production_exception}" == "NONE" ]] ||
    fail "ProductionWriteSetException must remain NONE for ${task_id}"

  production_count=0
  while IFS= read -r write_path; do
    case "${write_path}" in
      *.test.ts|*.test.tsx|*.test.js|*.test.jsx) ;;
      server/src/main/*|web/src/*)
        production_count=$((production_count + 1))
        case "${task_id}" in
          W1-I00) fail "W1-I00 governance card contains forbidden runtime write" ;;
          W1-I02)
            case "${write_path}" in
              server/src/main/java/io/cognitura/source/persistence/*|server/src/main/resources/db/migration/*) ;;
              *) fail "WriteSet is outside ${task_id} PrimaryBoundary: ${write_path}" ;;
            esac
            ;;
          W1-I13) fail "WriteSet is outside ${task_id} PrimaryBoundary: ${write_path}" ;;
          *)
            case "${write_path}" in
              "${allowed_runtime_root}"*) ;;
              *) fail "WriteSet is outside ${task_id} PrimaryBoundary: ${write_path}" ;;
            esac
            ;;
        esac
        ;;
    esac
  done < <(sed -n 's/^WriteSet = //p' "${file}")
  [[ "${production_count}" -le "${production_limit}" ]] ||
    fail "actual production WriteSet exceeds ProductionFileLimit for ${task_id}"
  [[ "$(normalized_card_digest "${file}")" == "${expected_card_digest}" ]] ||
    fail "${task_id}: card body contract digest mismatch"
  if [[ "${task_id}" == "W1-I03" && "${status}" == "SUSPENDED_BY_USER" ]]; then
    [[ "$(normalized_i03_digest "${file}")" == "902ab45cf2b6eefa92ddef32233ecd0ce953be0b536ebde2956dd286e0ef823b" ]] ||
      fail "W1-I03: only Status may change while suspended"
  fi

  table_row_pattern="^| \`${task_id}\` |"
  table_row="$(grep "${table_row_pattern}" "${index_file}" || true)"
  [[ "$(printf '%s\n' "${table_row}" | grep -c . || true)" -eq 1 ]] ||
    fail "README.md: expected one table row for ${task_id}"
  [[ "${table_row}" == *"| \`${status}\` |"* ]] ||
    fail "README.md: status mismatch for ${task_id}"

  card_index=$((card_index + 1))
done

[[ "${ready_count}" -eq 1 || "${ready_count}" -eq 0 ]] ||
  fail "task card set must have exactly one READY card"

dependencies_are_done() {
  local dependency_list="$1"
  local dependency_id
  local saved_ifs
  [[ "${dependency_list}" != "NONE" ]] || return 0
  saved_ifs="${IFS}"
  IFS=','
  for dependency_id in ${dependency_list}; do
    if [[ "$(status_for_id "${dependency_id}")" != "DONE" ]]; then
      IFS="${saved_ifs}"
      return 1
    fi
  done
  IFS="${saved_ifs}"
  return 0
}

i01_authorization="$(field_value "${cards_dir}/${expected_files[1]}" "BusinessImplementationAuthorization")"
for card_index in "${!expected_files[@]}"; do
  task_id="$(printf 'W1-I%02d' "${card_index}")"
  status="${card_statuses[${card_index}]}"
  if [[ "${task_set_status}" == "SUSPENDED_BY_USER" && "${task_id}" == "W1-I03" ]]; then
    [[ "${status}" == "SUSPENDED_BY_USER" ]] ||
      fail "W1-I03 must be SUSPENDED_BY_USER while the set is suspended"
    continue
  fi
  if [[ "${status}" == "SUSPENDED_BY_USER" ]]; then
    fail "SUSPENDED_BY_USER is allowed only for W1-I03 in the suspended set"
  fi
  if [[ "${task_id}" == "W1-I00" ]]; then
    case "${status}" in
      READY|DONE) ;;
      *) fail "W1-I00 must be READY or DONE" ;;
    esac
    continue
  fi

  if [[ "${task_id}" == "W1-I01" ]]; then
    if [[ "${card_statuses[0]}" != "DONE" ]]; then
      [[ "${i01_authorization}" == "REQUIRED_BEFORE_READY" ]] ||
        fail "W1-I01 cannot be authorized before W1-I00 is DONE"
      [[ "${status}" == "BLOCKED_BY_USER_AUTHORIZATION" ]] ||
        fail "W1-I01 must remain blocked by user authorization"
    elif [[ "${i01_authorization}" == "USER_AUTHORIZED" ]]; then
      case "${status}" in
        READY|DONE) ;;
        *) fail "W1-I01 must be READY or DONE after authorization" ;;
      esac
    else
      [[ "${status}" == "BLOCKED_BY_USER_AUTHORIZATION" ]] ||
        fail "W1-I01 must remain blocked by user authorization"
    fi
    continue
  fi

  card_authorization="$(field_value "${cards_dir}/${expected_files[${card_index}]}" "BusinessImplementationAuthorization")"
  if [[ "${card_authorization}" == "USER_AUTHORIZED" && "${i01_authorization}" != "USER_AUTHORIZED" ]]; then
    fail "${task_id} cannot be authorized before W1-I01 authorization"
  fi
  dependency="$(field_value "${cards_dir}/${expected_files[${card_index}]}" "DependsOn")"
  if dependencies_are_done "${dependency}"; then
    case "${status}" in
      QUEUED|READY|DONE) ;;
      *) fail "${task_id} must be QUEUED, READY, or DONE after dependencies are satisfied" ;;
    esac
  else
    [[ "${status}" == "BLOCKED_BY_DEPENDENCY" ]] ||
      fail "${task_id} must remain BLOCKED_BY_DEPENDENCY until dependencies are DONE"
  fi
done

if [[ "${i01_authorization}" == "USER_AUTHORIZED" ]]; then
  expected_business_implementation="USER_AUTHORIZED"
else
  expected_business_implementation="NOT_AUTHORIZED"
fi
[[ "${business_implementation}" == "${expected_business_implementation}" ]] ||
  fail "README.md: BusinessImplementation projection mismatch"

case "${task_set_status}" in
  READY_FOR_EXECUTION)
    [[ "${ready_count}" -eq 1 ]] || fail "task card set must have exactly one READY card"
    [[ "${active_task_card}" == "${ready_card}" ]] ||
      fail "ActiveTaskCard must match the unique READY card"
    if [[ "${ready_card}" == "W1-I00" && "${card_statuses[1]}" != "BLOCKED_BY_USER_AUTHORIZATION" ]]; then
      fail "W1-I01 must remain blocked by user authorization while I00 is READY"
    fi
    ;;
  BLOCKED_BY_USER_AUTHORIZATION)
    [[ "${ready_count}" -eq 0 ]] || fail "blocked authorization state cannot have a READY card"
    [[ "${active_task_card}" == "NONE" ]] || fail "blocked authorization state must have no active card"
    [[ "${card_statuses[0]}" == "DONE" && "${card_statuses[1]}" == "BLOCKED_BY_USER_AUTHORIZATION" ]] ||
      fail "blocked authorization state requires I00 DONE and I01 blocked"
    ;;
  BLOCKED_BY_DATABASE_GATE)
    [[ "${ready_count}" -eq 0 ]] ||
      fail "database-gate blocked state cannot have a READY card"
    [[ "${active_task_card}" == NONE ]] ||
      fail "database-gate blocked state must have no active card"
    [[ "$(one_field_value "${index_file}" ReadyTaskCardCount README.md)" == 0 ]] ||
      fail "README.md: ReadyTaskCardCount must be 0 behind the database gate"
    [[ "${card_statuses[0]}" == DONE && "${card_statuses[1]}" == DONE &&
       "${card_statuses[2]}" == QUEUED && "${card_statuses[3]}" == DONE &&
       "${card_statuses[4]}" == DONE && "${card_statuses[5]}" == DONE &&
       "${card_statuses[6]}" == DONE ]] ||
      fail "database-gate blocked state has an invalid W1-I00..W1-I06 status vector"
    for blocked_index in 7 8 9 10 11 12 13; do
      [[ "${card_statuses[${blocked_index}]}" == BLOCKED_BY_DEPENDENCY ]] ||
        fail "database-gate blocked state must keep W1-I07..W1-I13 blocked"
    done
    require_projection AGENTS.md Wave1ImplementationTaskCardSet BLOCKED_BY_DATABASE_GATE
