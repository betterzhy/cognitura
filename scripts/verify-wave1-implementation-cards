  [[ "${actual_paths}" == "${expected_paths}" ]] ||
    fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:exact paths"
  register_temporary_directory expected_root cognitura-i09-canonical-bridge-projection
  materialize_w1_i09_canonical_bridge_projection "${bridge_tip}" "${expected_root}"
  for path in "${w1_i09_canonical_bridge_projection_paths[@]}"; do
    [[ "$(git_tree_mode "${projection}" "${path}")" == 100644 ]] ||
      fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:mode"
    require_git_blob_without_nul "${projection}" "${path}" \
      "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:NUL"
    actual_file="${expected_root}/actual-${index}"
    git -C "${repo_root}" show "${projection}:${path}" > "${actual_file}" ||
      fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:content"
    cmp -s "${expected_root}/${path}" "${actual_file}" ||
      fail "I09_CANONICAL_BRIDGE_PROJECTION_INVALID:content"
    index=$((index + 1))
  done
  remove_temporary_directory "${expected_root}"
}

validate_w1_i09_canonical_bridge_product() {
  local parent="$1"
  local commit="$2"
  local expected_root expected_file actual_file
  register_temporary_directory expected_root cognitura-i09-canonical-bridge-product
  expected_file="${expected_root}/expected"
  actual_file="${expected_root}/actual"
  git -C "${repo_root}" show \
    "${parent}:${w1_i09_canonical_bridge_product_path}" > "${expected_file}" ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:source"
  [[ "$(grep -Fc '    byte[] canonicalOmissionsBytes()' "${expected_file}" || true)" -eq 1 ]] ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:source"
  [[ "$(grep -Fc '    byte[] canonicalRevisionDiagnosticsBytes()' "${expected_file}" || true)" -eq 1 ]] ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:source"
  [[ "$(grep -Fc '        byte[] canonicalBytes()' "${expected_file}" || true)" -eq 2 ]] ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:source"
  sed -i.bak \
    -e 's/^    byte\[\] canonicalOmissionsBytes()/    public byte[] canonicalOmissionsBytes()/' \
    -e 's/^    byte\[\] canonicalRevisionDiagnosticsBytes()/    public byte[] canonicalRevisionDiagnosticsBytes()/' \
    "${expected_file}"
  rm "${expected_file}.bak"
  awk '
    $0 == "    public static final class Block {" { in_block = 1 }
    in_block && $0 == "        byte[] canonicalBytes() {" {
      print "        public byte[] canonicalBytes() {"
      replaced++
      next
    }
    { print }
    END { if (replaced != 1) exit 1 }
  ' "${expected_file}" > "${expected_root}/scoped" ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:source"
  mv "${expected_root}/scoped" "${expected_file}"
  git -C "${repo_root}" show \
    "${commit}:${w1_i09_canonical_bridge_product_path}" > "${actual_file}" ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:content"
  cmp -s "${expected_file}" "${actual_file}" ||
    fail "I09_CANONICAL_BRIDGE_PRODUCT_INVALID:content"
  remove_temporary_directory "${expected_root}"
}

materialize_w1_i09_v2_compatibility_projection() {
  local compatibility_tip="$1"
  local destination_root="$2"
  local path parent tree index_file plan_file card_file temporary
  parent="$(single_parent_of "${compatibility_tip}" \
    "I09_V2_COMPATIBILITY_PROJECTION_INVALID:parent")"
  tree="$(git -C "${repo_root}" rev-parse \
    "${compatibility_tip}^{tree}" 2>/dev/null)" ||
    fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:tree"
  for path in "${w1_i09_v2_compatibility_projection_paths[@]}"; do
    mkdir -p "${destination_root}/${path%/*}"
    git -C "${repo_root}" show "${compatibility_tip}:${path}" > \
      "${destination_root}/${path}" ||
      fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:source"
  done
  index_file="${destination_root}/${w1_i09_v2_compatibility_projection_paths[0]}"
  plan_file="${destination_root}/${w1_i09_v2_compatibility_projection_paths[1]}"
  card_file="${destination_root}/${w1_i09_v2_compatibility_projection_paths[2]}"
  [[ "$(grep -Fc 'W1I09ProductWriteSetCount = 28' "${index_file}" || true)" -eq 1 ]] ||
    fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:index source"
  sed -i.bak 's/W1I09ProductWriteSetCount = 28/W1I09ProductWriteSetCount = 29/' \
    "${index_file}"
  rm "${index_file}.bak"
  temporary="${destination_root}/plan-count"
  awk '
    $0 == "I09ProductWriteSetCount = 28" && replaced == 0 {
      print "I09ProductWriteSetCount = 29"
      replaced++
      next
    }
    { print }
    END { if (replaced != 1) exit 1 }
  ' "${plan_file}" > "${temporary}" ||
    fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:plan source"
  mv "${temporary}" "${plan_file}"
  printf '%s\n' \
    '' \
    '## 18. W1-I09 V2 migration compatibility receipt' \
    '' \
    '```text' \
    'W1I09V2MigrationCompatibility = PASS' \
    "ReviewedV2CompatibilityCandidate = ${compatibility_tip}" \
    "ReviewedV2CompatibilityParent = ${parent}" \
    "ReviewedV2CompatibilityTree = ${tree}" \
    'I09ProductWriteSetCount = 29' \
    'ProductionFileLimit = 20' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED' \
    '```' >> "${plan_file}"
  [[ "$(grep -Fc '暂存清单必须与 28 路径双向一致' "${card_file}" || true)" -eq 1 ]] ||
    fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:card count source"
  [[ "$(grep -Fc "WriteSet = ${w1_i09_v2_compatibility_product_path}" \
      "${card_file}" || true)" -eq 0 ]] ||
    fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:duplicate path"
  sed -i.bak \
    's/暂存清单必须与 28 路径双向一致/暂存清单必须与 29 路径双向一致/' \
    "${card_file}"
  rm "${card_file}.bak"
  temporary="${destination_root}/card-v2"
  awk -v added="WriteSet = ${w1_i09_v2_compatibility_product_path}" '
    { print }
    $0 == "WriteSet = server/src/test/java/io/cognitura/source/persistence/JdbcProcessingPublicationPortIntegrationTest.java" {
      print added
      inserted++
    }
    END { if (inserted != 1) exit 1 }
  ' "${card_file}" > "${temporary}" ||
    fail "I09_V2_COMPATIBILITY_PROJECTION_INVALID:card insertion"
  mv "${temporary}" "${card_file}"
}

