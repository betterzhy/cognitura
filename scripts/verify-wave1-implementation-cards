        ;;
    esac
  fi
elif [[ -z "${transition_base}" && "${closure_cards_dir_is_canonical}" == 1 ]] &&
  w1_i03_closure_schema_current "${current_repository_head}"; then
  current_i03_status="$(git_tree_field "${current_repository_head}" \
