          "ActiveTaskCard = W1-I05" \
          "W1I03ClosureStatus = PASS" \
          "W1I04ClosureStatus = PASS"
        exit 0
        ;;
      DONE:READY)
        git -C "${repo_root}" diff --quiet \
          "${i04_transition_base}..${i04_transition_head}" -- \
          "${w1_i04_closure_projection_paths[@]}" ||
          fail "I04 closure is allowed exactly once"
        ;;
    esac
  fi
elif [[ -z "${transition_base}" && "${closure_cards_dir_is_canonical}" == 1 ]] &&
  w1_i04_closure_schema_current "${current_repository_head}"; then
  current_i04_status="$(git_tree_field "${current_repository_head}" \
    "${w1_i04_card_path}" Status)"
  current_i05_status="$(git_tree_field "${current_repository_head}" \
    "${w1_i05_card_path}" Status)"
  case "${current_i04_status}:${current_i05_status}" in
    READY:BLOCKED_BY_DEPENDENCY)
      validate_w1_i04_closure_governance_chain "${current_repository_head}"
      git -C "${repo_root}" diff --quiet "${current_repository_head}" -- \
        "${w1_i04_closure_projection_paths[@]}" ||
        fail "working projection must match I04 closure governance tip"
      require_working_w1_i04_production_frozen
      printf '%s\n' \
        "Wave1ImplementationTaskCardValidation = PASS" \
        "TaskCardCount = 14" \
        "TaskCardSetStatus = READY_FOR_EXECUTION" \
        "ActiveTaskCard = W1-I04" \
        "W1I03ClosureStatus = PASS" \
        "W1I04ClosureStatus = PENDING"
      exit 0
      ;;
    DONE:READY)
      i04_closure_receipt_pair="$(find_unique_w1_i04_closure_receipt \
        "${current_repository_head}")"
      set -- ${i04_closure_receipt_pair}
      i04_closure_receipt_parent="$1"
      i04_closure_receipt="$2"
      validate_w1_i04_closure_receipt \
        "${i04_closure_receipt_parent}" "${i04_closure_receipt}" 0
      validate_w1_i05_xml_copy_repair_and_descendants \
        "${i04_closure_receipt}" "${current_repository_head}"
      git -C "${repo_root}" diff --quiet \
        "${i04_closure_receipt}..${current_repository_head}" -- \
        "${w1_i04_closure_projection_paths[@]}" ||
        fail "I04 closure is allowed exactly once"
      git -C "${repo_root}" diff --quiet \
        "${w1_i04_reviewed_candidate_sha}..${current_repository_head}" -- \
        "${w1_i04_frozen_production_paths[@]}" ||
        fail "reviewed W1-I04 production must remain byte-identical"
      git -C "${repo_root}" diff --quiet "${current_repository_head}" -- \
        "${w1_i04_closure_projection_paths[@]}" ||
        fail "working projection must match I04 closure receipt"
      require_working_w1_i04_production_frozen
      printf '%s\n' \
        "Wave1ImplementationTaskCardValidation = PASS" \
        "TaskCardCount = 14" \
        "TaskCardSetStatus = READY_FOR_EXECUTION" \
        "ActiveTaskCard = W1-I05" \
        "W1I03ClosureStatus = PASS" \
        "W1I04ClosureStatus = PASS" \
        "W1I05VerifierRecoveryStatus = PASS" \
        "W1I05RecoveryReviewRepairStatus = PASS" \
        "W1I05LiteralPathspecRepairStatus = PASS" \
        "W1I05XmlCopyInferenceRepairStatus = PASS"
      exit 0
      ;;
    *) fail "I04 closure current state has an unsupported I04/I05 status vector" ;;
  esac
fi

if [[ -n "${transition_base}" && "${closure_cards_dir_is_canonical}" == 1 ]]; then
