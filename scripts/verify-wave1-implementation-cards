    fail "Risk mismatch for ${task_id}"
  actual_dependency="$(field_value "${file}" "DependsOn")"
  if [[ "${task_id}" == "W1-I13" && "${actual_dependency}" != "${expected_dependency}" ]]; then
    fail "W1-I13 must depend on W1-I00 through W1-I12"
  fi
  [[ "${actual_dependency}" == "${expected_dependency}" ]] ||
    fail "dependency mismatch for ${task_id}"
  [[ "$(field_value "${file}" "PrimaryBoundary")" == "${expected_boundary}" ]] ||
    fail "PrimaryBoundary mismatch for ${task_id}"
  if [[ "${task_id}" == "W1-I13" && "$(field_value "${file}" "ReviewRoute")" != "${expected_route}" ]]; then
    fail "W1-I13 must use DEEP_REVIEWER_THEN_ULTRA_GATEKEEPER"
  fi
  [[ "$(field_value "${file}" "ReviewRoute")" == "${expected_route}" ]] ||
    fail "ReviewRoute mismatch for ${task_id}"
