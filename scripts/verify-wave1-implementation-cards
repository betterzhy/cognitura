  local expected_path expected_mode evidence_sha actual_blob expected_blob
  git -C "${repo_root}" merge-base --is-ancestor \
    "${w1_i11_obsolete_oracle_repair_origin_sha}" "${tip}" 2>/dev/null ||
    fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:origin"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] && commits+=("${commit}")
  done < <(git -C "${repo_root}" rev-list --first-parent --reverse \
    "${w1_i11_obsolete_oracle_repair_origin_sha}..${tip}")
  [[ "${#commits[@]}" -eq 3 ]] ||
    fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:exact three commits"
  previous="${w1_i11_obsolete_oracle_repair_origin_sha}"
  for index in "${!commits[@]}"; do
    commit="${commits[${index}]}"
    expected_path="${w1_i11_obsolete_oracle_repair_paths[${index}]}"
    parent="$(single_parent_of "${commit}" \
      "I11_OBSOLETE_ORACLE_REPAIR_INVALID:single parent")"
    [[ "${parent}" == "${previous}" ]] ||
      fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:order"
    git -C "${repo_root}" diff-tree --quiet "${parent}" "${commit}" &&
      fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:empty"
    require_no_git_rename_or_copy "${parent}" "${commit}" \
      "I11_OBSOLETE_ORACLE_REPAIR_INVALID:rename or copy"
    changed_paths="$(git -C "${repo_root}" diff --name-only "${parent}..${commit}")"
    [[ "${changed_paths}" == "${expected_path}" ]] ||
      fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:path"
    case "${expected_path}" in
      scripts/*|tests/*.sh|tests/*/*.sh) expected_mode=100755 ;;
      *) expected_mode=100644 ;;
    esac
    [[ "$(git_tree_mode "${commit}" "${expected_path}")" == "${expected_mode}" ]] ||
      fail "I11_OBSOLETE_ORACLE_REPAIR_INVALID:mode"
    require_git_blob_without_nul "${commit}" "${expected_path}" \
      "I11_OBSOLETE_ORACLE_REPAIR_INVALID:NUL"
