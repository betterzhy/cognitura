#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s [--document <path>] [--plan <path>] [--acceptance <path>]\n' "$0" >&2
  exit 2
}

fail() {
  printf 'InteractionStateContractValidation = FAIL\n%s\n' "$1" >&2
  exit 1
}

document=""
plan=""
acceptance=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --document)
      [[ "$#" -ge 2 ]] || usage
      document="$2"
      shift 2
      ;;
    --plan)
      [[ "$#" -ge 2 ]] || usage
      plan="$2"
      shift 2
      ;;
    --acceptance)
      [[ "$#" -ge 2 ]] || usage
      acceptance="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done
script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ -z "${document}" ]]; then
  document="${script_root}/Cognitive-Knowledge-Atlas-Interaction-State-Completion-and-High-Fidelity-Input-Design-1.0.md"
fi
[[ -n "${plan}" ]] || plan="${script_root}/docs/engineering/cognitura-high-fidelity-design-plan.md"
[[ -n "${acceptance}" ]] || acceptance="${script_root}/docs/engineering/cognitura-high-fidelity-design-acceptance.md"
[[ -f "${document}" ]] || fail "MISSING_DOCUMENT: ${document}"
[[ -f "${plan}" ]] || fail "MISSING_PLAN: ${plan}"
[[ -f "${acceptance}" ]] || fail "MISSING_ACCEPTANCE: ${acceptance}"

require_exact_line_once() {
  local line="$1"
  local message="$2"
  local count
  count="$(grep -Fxc "${line}" "${document}" || true)"
  [[ "${count}" -eq 1 ]] || fail "${message}"
}

grep -Fqx 'CanonicalProjectName = Cognitura' "${document}" ||
  fail "CanonicalProjectName must be Cognitura"
require_exact_line_once \
  'PrimaryPurpose = PERSONAL_COGNITIVE_STRUCTURE_BUILDING' \
  'PrimaryPurpose must be PERSONAL_COGNITIVE_STRUCTURE_BUILDING'
require_exact_line_once \
  'DesignPurpose =' \
  'DesignPurpose must be declared exactly once'
require_exact_line_once \
  'V1Architecture = MODULAR_MONOLITH' \
  'V1Architecture must be MODULAR_MONOLITH'
require_exact_line_once \
  'HistoricalHierarchyCompositeAlias = DomainPanorama_Theme_Module_Element' \
  'legacy hierarchy composite must only be a historical alias'
[[ "$(grep -Fxc 'DomainPanorama_Theme_Module_Element' "${document}" || true)" -eq 0 ]] ||
  fail "legacy hierarchy composite must only be a historical alias"

contract_p0_values="$(sed -n 's/^ContractP0Remaining = //p' "${document}" | sort -u)"
[[ -n "${contract_p0_values}" && "$(printf '%s\n' "${contract_p0_values}" | wc -l | tr -d ' ')" -eq 1 ]] ||
  fail "ContractP0Remaining projections must use one stage-aware deferred value"
case "${contract_p0_values}" in
  DEFERRED_TO_HF_D01_THROUGH_HF_D04|DEFERRED_TO_HF_D02_THROUGH_HF_D04|DEFERRED_TO_HF_D03_THROUGH_HF_D04|DEFERRED_TO_HF_D04) ;;
  *) fail "ContractP0Remaining must remain deferred to an applicable HF Gate" ;;
esac
input_ready_count="$(grep -c '^HighFidelityInputReady = ' "${document}" || true)"
input_candidate_count="$(grep -Fxc 'HighFidelityInputReady = CANDIDATE_ONLY' "${document}" || true)"
[[ "${input_ready_count}" -ge 1 && "${input_ready_count}" -eq "${input_candidate_count}" ]] ||
  fail "HighFidelityInputReady must remain CANDIDATE_ONLY"
require_exact_line_once \
  'ContractDefined = CANDIDATE_ONLY' \
  'ContractDefined must remain CANDIDATE_ONLY'
contract_completeness="$(sed -n 's/^ContractCompleteness = //p' "${document}")"
case "${contract_completeness}" in
  DEFERRED_TO_HF_D01_THROUGH_HF_D04|DEFERRED_TO_HF_D02_THROUGH_HF_D04|DEFERRED_TO_HF_D03_THROUGH_HF_D04|DEFERRED_TO_HF_D04) ;;
  *) fail "ContractCompleteness must remain stage-aware and deferred" ;;
esac
require_exact_line_once \
  'FormalDesignInputCompletion = DEFERRED_TO_HF_D04' \
  'FormalDesignInputCompletion must remain deferred to HF-D04'

field_values() {
  local key="$1"
  awk -v key="${key}" '
    $0 == key " =" {
      getline
      value=$0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      print value
      next
    }
    index($0, key " = ") == 1 {
      value=substr($0, length(key " = ") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      print value
    }
  ' "${document}"
}

for later_stage_field in \
  HighFidelityVisualDesign \
  HighFidelityVisualValidation \
  HighFidelityUsabilityValidation \
  CrossDomainVisualValidation \
  CrossDomainUsabilityValidation \
  SmallScreenVisualValidation \
  HighFidelityStateAcceptance \
  ImplementationValidation \
  HighFidelityVisualResult \
  HighFidelityUsabilityResult; do
  later_stage_values="$(field_values "${later_stage_field}")"
  [[ -n "${later_stage_values}" ]] || fail "${later_stage_field} status is missing"
  while IFS= read -r later_stage_value; do
    [[ "${later_stage_value}" == "NOT_RUN" ]] ||
      fail "${later_stage_field} must remain NOT_RUN"
  done <<<"${later_stage_values}"
done

for later_stage in HIGH_FIDELITY_VISUAL HIGH_FIDELITY_USABILITY IMPLEMENTATION; do
  later_stage_status="$(awk -F'|' -v target="${later_stage}" '
    /^\|/ {
      stage=$2
      status=$4
      gsub(/^[[:space:]`]+|[[:space:]`]+$/, "", stage)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", status)
      if (stage == target) print status
    }
  ' "${document}")"
  [[ "${later_stage_status}" == "NOT_RUN" ]] ||
    fail "${later_stage} stage must remain NOT_RUN"
done
for forbidden_closure in \
  'CLOSED_BY_THIS_DOCUMENT' \
  'CONTRACT_CLOSED' \
  'CLOSED_AT_CONTRACT_LEVEL' \
  'ReadingFirstRiskClosedAtContractLevel' \
  'StateInputGapsClosed' \
  'COMPLETED_AS_CURRENT_INPUT' \
  'PASS_WITH_READING_FIRST_PRESENTATION_PATCH_REQUIRED' \
  'SecondRoundLowFidelityDirectionAccepted = YES' \
  '| CLOSED |'; do
  if grep -Fq "${forbidden_closure}" "${document}"; then
    fail "candidate must not claim closure before the applicable HF Gate: ${forbidden_closure}"
  fi
done
require_exact_line_once \
  'RemainingInteractionStateP0 = HF_DG2_ORTHOGONAL_STATE_AND_RECOVERY_PASS' \
  'RemainingInteractionStateP0 must record HF-DG2 PASS'
require_exact_line_once \
  'SecondRoundLowFidelityPrototype = HISTORICAL_INPUT_RECORDED' \
  'SecondRoundLowFidelityPrototype must remain a historical record'
require_exact_line_once \
  'SecondRoundLowFidelityAssessment = HISTORICAL_DIRECTION_RECORDED_READING_FIRST_PATCH_REQUIRED' \
  'SecondRoundLowFidelityAssessment must remain a historical record'
require_exact_line_once \
  'SecondRoundLowFidelityDirectionRecord = HISTORICAL_ACCEPTANCE_RECORDED' \
  'SecondRoundLowFidelityDirectionRecord must remain a historical record'
require_exact_line_once \
  'ReadingFirstRiskDisposition = DEFERRED_TO_APPLICABLE_HF_GATE' \
  'ReadingFirstRiskDisposition must remain deferred'
require_exact_line_once \
  'StateInputGapDisposition = HF_DG2_ORTHOGONAL_STATE_AND_RECOVERY_PASS' \
  'StateInputGapDisposition must record HF-DG2 PASS'
require_exact_line_once \
  'OrthogonalStateRecoveryContract = PASS' \
  'OrthogonalStateRecoveryContract must be PASS exactly once'
[[ "$(grep -c '| DEFERRED_TO_APPLICABLE_HF_GATE |$' "${document}" || true)" -eq 12 ]] ||
  fail "second-round trace rows must remain deferred to applicable HF Gates"
canonical_hierarchy="$(awk '
  /^CanonicalHierarchy =$/ {
    getline; one=$0
    getline; two=$0
    getline; three=$0
    getline; four=$0
    print one "|" two "|" three "|" four
    exit
  }
' "${document}")"
[[ "${canonical_hierarchy}" == '  KnowledgeLandscape|  → KnowledgeTheme|  → CognitiveModule|  → KnowledgeElement' ]] ||
  fail "CanonicalHierarchy must use Cognitura four-layer names"

status="$(awk '/^Status =$/ {getline; sub(/^[[:space:]]+/, ""); print; exit}' "${document}")"
[[ "${status}" == "CANDIDATE_AWAITING_REPOSITORY_GATE" ]] ||
  fail "candidate status must remain CANDIDATE_AWAITING_REPOSITORY_GATE"
for boundary in BusinessImplementation FormalDatabaseWrite RemotePush; do
  require_exact_line_once \
    "${boundary} = NOT_AUTHORIZED" \
    "${boundary} must be exactly NOT_AUTHORIZED"
done
grep -Fqx 'RepositoryIntegrationStatus = UNTRACKED_CANDIDATE_REGISTERED_BY_HF_D00' "${document}" ||
  fail "actual repository integration status is missing"
for gap_id in DOC-GAP-HF-001 DOC-GAP-HF-002 DOC-GAP-HF-003; do
  require_exact_line_once \
    "DocumentationGap = ${gap_id}" \
    "${gap_id} must appear exactly once"
done
grep -Fqx 'HistoricalHierarchyAliases =' "${document}" ||
  fail "historical hierarchy aliases are not mapped"

count_unique_rows() {
  local marker="$1"
  awk -F'|' -v marker="${marker}" '
    $2 ~ "`" marker "`" {
      value=$3
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value != "") seen[value]=1
      rows++
    }
    END {
      unique=0
      for (value in seen) unique++
      print rows ":" unique
    }
  ' "${document}"
}

state_counts="$(count_unique_rows StateCode)"
[[ "${state_counts}" == "46:46" ]] ||
  fail "expected 46 unique original StateCode rows, found ${state_counts}"

classification_result="$(awk -F'|' '
  function trim(value) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
    return value
  }
  $2 ~ /`StateCode`/ {
    code=trim($3)
    original[code]=1
    next
  }
  trim($2) == "OriginalStateCode" {
    in_classification_table=1
    next
  }
  in_classification_table && trim($2) == "---" { next }
  in_classification_table && $0 !~ /^\|/ {
    in_classification_table=0
    next
  }
  in_classification_table && /^\|/ {
    code=trim($2)
    classification=trim($3)
    owner=trim($4)
    persistence=trim($5)
    history=trim($6)
    canonical=trim($7)
    rows++
    seen[code]++
    if (classification !~ /^(AXIS_VALUE|TRANSIENT_UI|FLOW_PHASE|EVENT|DERIVED_RESULT)$/) invalid_classification++
    if (owner == "") invalid_owner++
    if (persistence !~ /^(EPHEMERAL_UI|URL|BROWSER_HISTORY|SESSION_DRAFT_STORE|CANONICAL_SERVER_STATE)$/) invalid_persistence++
    if (history !~ /^(NOT_PERSISTED|URL_AND_HISTORY|HISTORY_ONLY|SESSION_RESTORE_ONLY|DERIVED_FROM_CANONICAL_RESULT)$/) invalid_history++
    if (canonical !~ /^(NO_CANONICAL_WRITE|WRITE_REQUIRES_CONFIRMED_CHANGESET|CANONICAL_WRITE_RESULT|DERIVED_AFTER_CANONICAL_WRITE)$/) invalid_canonical++
    if (classification == "EVENT" &&
        (persistence != "EPHEMERAL_UI" || history != "NOT_PERSISTED" || canonical != "NO_CANONICAL_WRITE")) event_persisted++
    if (classification == "TRANSIENT_UI" &&
        (persistence != "EPHEMERAL_UI" || history != "NOT_PERSISTED" || canonical != "NO_CANONICAL_WRITE")) transient_persisted++
    if (code == "PREVIEW" &&
        (persistence != "EPHEMERAL_UI" || history != "NOT_PERSISTED" || canonical != "NO_CANONICAL_WRITE")) preview_persisted++
    if (code == "GENERATING" && owner != "ProjectionGenerationFlow:PROJECTION_GENERATING") generating_owner_invalid++
  }
  END {
    duplicate=0
    unknown=0
    missing=0
    unique=0
    for (code in seen) {
      unique++
      if (seen[code] != 1) duplicate++
      if (!(code in original)) unknown++
    }
    for (code in original) if (!(code in seen)) missing++
    printf "%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d", rows, unique, duplicate, unknown, missing,
      invalid_classification, invalid_owner, invalid_persistence, invalid_history, invalid_canonical,
      event_persisted, transient_persisted, preview_persisted, generating_owner_invalid
  }
' "${document}")"
IFS=: read -r classification_rows classification_unique duplicate_owner_count unknown_classification_count \
  missing_classification_count invalid_classification_count invalid_owner_count invalid_persistence_count \
  invalid_history_count invalid_canonical_count event_persisted_count transient_persisted_count \
  preview_persisted_count generating_owner_invalid_count \
  <<<"${classification_result}"
[[ "${invalid_classification_count}" -eq 0 ]] || fail "invalid Classification"
[[ "${classification_rows}:${classification_unique}" == "46:46" ]] ||
  fail "expected 46 unique classification rows, found ${classification_rows}:${classification_unique}"
[[ "${duplicate_owner_count}" -eq 0 ]] ||
  fail "each OriginalStateCode must have exactly one owner"
[[ "${unknown_classification_count}" -eq 0 ]] ||
  fail "classification contains unknown OriginalStateCode"
[[ "${missing_classification_count}" -eq 0 ]] ||
  fail "classification omits an original StateCode"
[[ "${invalid_owner_count}" -eq 0 ]] || fail "OwningAxisOrFlow must be non-empty"
[[ "${invalid_persistence_count}" -eq 0 ]] || fail "invalid PersistenceBoundary"
[[ "${invalid_history_count}" -eq 0 ]] || fail "invalid URLHistoryDisposition"
[[ "${invalid_canonical_count}" -eq 0 ]] || fail "invalid CanonicalWriteBoundary"
[[ "${event_persisted_count}" -eq 0 ]] || fail "event must not be persisted as state"
[[ "${preview_persisted_count}" -eq 0 ]] || fail "PREVIEW must not enter URL or History"
[[ "${transient_persisted_count}" -eq 0 ]] ||
  fail "TRANSIENT_UI must be EPHEMERAL_UI and not persisted"
[[ "${generating_owner_invalid_count}" -eq 0 ]] ||
  fail "historical GENERATING must map to PROJECTION_GENERATING"
require_exact_line_once \
  'HistoricalStateCode = GENERATING' \
  'historical GENERATING trace marker is required'
require_exact_line_once \
  'LocalProjectionPhase = PROJECTION_GENERATING' \
  'local projection generation must use PROJECTION_GENERATING'
[[ "$(grep -Fxc 'LocalProjectionPhase = GENERATING' "${document}" || true)" -eq 0 ]] ||
  fail "GENERATING namespace collision"

require_exact_line_once \
  '| COGNITIVE_PERSPECTIVE_OVERRIDE | AXIS_VALUE | StableProjectionParameter:CognitivePerspective | URL | URL_AND_HISTORY | NO_CANONICAL_WRITE |' \
  'CognitivePerspective must be a stable Projection parameter AXIS_VALUE'
require_exact_line_once \
  'StableProjectionParameter = CognitivePerspective|URL_AND_HISTORY|NOT_AN_ORTHOGONAL_AXIS' \
  'CognitivePerspective stable Projection parameter boundary is missing'

[[ "$(grep -c '^OrthogonalAxis = ' "${document}" || true)" -eq 6 ]] ||
  fail "expected exactly six orthogonal axes"
for axis_contract in \
  'ModeAxis|READING,VERIFICATION,REVISION' \
  'FocusAxis|IDLE,ELEMENT_PINNED,RELATION_PINNED' \
  'AuxiliarySurfaceAxis|NONE,QUICK_SOURCE,FULL_VERIFICATION,FULL_REVISION' \
  'DraftAxis|NO_DRAFT,CLEAN_DRAFT,DIRTY_DRAFT,SAVED_DRAFT,RECOVERABLE_DRAFT,CONFLICTED_DRAFT' \
  'ProcessingAxis|PROCESSING_IDLE,IMPACT_ANALYZING,COMMIT_ALLOWED,COMMIT_BLOCKED,SUBMITTING,CANONICAL_SAVED,RECOMPUTING,PROJECTION_GENERATING,PENDING_VERIFICATION,PARTIAL_FAILURE,FAILED,COMPLETE' \
  'RecoveryAxis|STABLE,HISTORY_RESTORING,REFRESH_RESTORING,RESTORE_FAILED'; do
  axis_name="${axis_contract%%|*}"
  require_exact_line_once \
    "OrthogonalAxis = ${axis_contract}" \
    "${axis_name} value set mismatch"
done
axis_duplicate_count="$(awk -F'[=|,]' '/^OrthogonalAxis = / {
  for (field_index=3; field_index<=NF; field_index++) {
    value=$field_index
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
    if (value != "") seen[value]++
  }
} END {
  duplicates=0
  for (value in seen) if (seen[value] > 1) duplicates++
  print duplicates
}' "${document}")"
[[ "${axis_duplicate_count}" -eq 0 ]] ||
  fail "orthogonal axis values must be unique across axes or explicitly namespaced"

[[ "$(grep -c '^PersistenceLedger = ' "${document}" || true)" -eq 5 ]] ||
  fail "expected exactly five persistence ledger levels"
for ledger_contract in \
  'EPHEMERAL_UI|Hover,Tooltip,Preview,InputFocus,TemporaryEndpointHighlight|NO_URL_NO_HISTORY_NO_REFRESH_RESTORE_NO_SERVER_WRITE' \
  'URL|Page,StableObject,Mode,StableRelation,ShareablePerspective|NO_DRAFT_ID_NO_TECHNICAL_VERSION_NO_PROCESS_PHASE' \
  'BROWSER_HISTORY|StableFocus,FullWorkspace,Perspective,SemanticAnchor|NO_CANONICAL_FACT_COPY' \
  'SESSION_DRAFT_STORE|Draft,RecoveryGuard,UnconfirmedChangeSetReference,IdempotencyKey|NO_PUBLISHED_COGNITIVE_FACT' \
  'CANONICAL_SERVER_STATE|ConfirmedRevision,Relation,Evidence,ChangeSetResult,ProcessingResult,CurrentVersionPointer|NO_VISUAL_STATE_NO_HOVER_NO_SCROLL_PIXEL'; do
  ledger_name="${ledger_contract%%|*}"
  require_exact_line_once \
    "PersistenceLedger = ${ledger_contract}" \
    "${ledger_name} persistence ledger mismatch"
done

for recovery_contract in \
  'SubmitUnknownDisposition = QUERY_RESULT_WITH_SAME_IDEMPOTENCY_KEY' \
  'IdempotentResultQuery = CHANGESET_ID_OR_IDEMPOTENCY_KEY_REQUIRED' \
  'StaleProjectionDisposition = EXPLICIT_STALE_MARK_AND_CANONICAL_VERSION_REFERENCE' \
  'RevertDisposition = CREATE_NEW_REVERT_CHANGESET' \
  'PhysicalRollbackOfCommittedHistory = FORBIDDEN'; do
  require_exact_line_once "${recovery_contract}" "persistence recovery invariant is missing or duplicated"
done
unknown_save_result_count="$(grep -c '^UnknownSaveResultTreatedAsFailure = ' "${document}" || true)"
unknown_save_forbidden_count="$(grep -Fxc 'UnknownSaveResultTreatedAsFailure = FORBIDDEN' "${document}" || true)"
[[ "${unknown_save_result_count}" -ge 1 && "${unknown_save_result_count}" -eq "${unknown_save_forbidden_count}" ]] ||
  fail "UnknownSaveResultTreatedAsFailure must remain FORBIDDEN"

page_state_mapping="$(awk -F'|' '/^PageStateMapping = / {
  split($1, prefix, " = ")
  state=prefix[2]
  seen[state]++
  rows++
} END {
  unique=0; duplicate=0
  for (state in seen) { unique++; if (seen[state] != 1) duplicate++ }
  print rows ":" unique ":" duplicate
}' "${document}")"
[[ "${page_state_mapping}" == "12:12:0" ]] ||
  fail "expected 12 unique PageState mappings, found ${page_state_mapping}"
for page_state_contract in \
  'EMPTY|ProcessingAxis.PROCESSING_IDLE_WITH_EMPTY_CONTENT' \
  'UPLOADING|SourceIngestionFlow.UPLOADING' \
  'PARSING|SourceIngestionFlow.PARSING' \
  'ANALYZING|ProcessingAxis.IMPACT_ANALYZING_OR_SOURCE_ANALYZING' \
  'GENERATING|ProcessingAxis.PROJECTION_GENERATING' \
  'WAITING_REVIEW|ProcessingAxis.PENDING_VERIFICATION' \
  'PARTIALLY_GENERATED|ProcessingAxis.PARTIAL_FAILURE_WITH_READABLE_RESULT' \
  'FAILED|ProcessingAxis.FAILED' \
  'RETRYING|RecoveryFlow.RETRYING' \
  'CONFIRMED|ProcessingAxis.COMPLETE_WITH_CONFIRMED_REVISION' \
  'PUBLISHED|CanonicalServerState.PUBLISHED_REVISION' \
  'OUTDATED_BY_STRUCTURE_CHANGE|ProjectionFreshnessFlow.STALE_RETAINED'; do
  page_state_name="${page_state_contract%%|*}"
  require_exact_line_once \
    "PageStateMapping = ${page_state_contract}" \
    "${page_state_name} PageState mapping mismatch"
done

for non_change_key in \
  PageStateEnumChange \
  PageStateSchemaChange \
  RendererInputChange \
  SchemaCatalogChange \
  SchemaEvidenceMapChange \
  PhysicalSchemaSpecified; do
  [[ "$(grep -c "^${non_change_key} = " "${document}" || true)" -eq 1 ]] ||
    fail "${non_change_key} must be declared exactly once"
  grep -Fqx "${non_change_key} = NO" "${document}" ||
    fail "${non_change_key} must remain NO"
done

[[ "$(grep -c '^LogicalObjectMapping = ' "${document}" || true)" -eq 5 ]] ||
  fail "expected exactly five logical object mappings"
for logical_mapping in \
  'KnowledgeObjectVersion|EXISTING_COGNITIVE_ARTIFACT_REVISION_IDENTITY' \
  'RelationVersion|EXISTING_RELATION_WITHIN_OWNING_ARTIFACT_REVISION' \
  'ContextBinding|EXISTING_HIERARCHY_PRIMARY_OWNERSHIP_RETURN_TOKEN_AND_SEMANTIC_ANCHOR_PROJECTION' \
  'EvidenceBinding|EXISTING_EVIDENCE_REFERENCE_TO_COGNITIVE_ARTIFACT_OR_RELATION' \
  'ChangeSet|EXISTING_COGNITIVE_STRUCTURE_REVISION_OR_COGNITIVE_MODULE_REVISION_CHANGE_ENVELOPE'; do
  require_exact_line_once \
    "LogicalObjectMapping = ${logical_mapping}" \
    "logical revision Relation Evidence mapping mismatch"
done

exception_counts="$(count_unique_rows ExceptionCode)"
[[ "${exception_counts}" == "20:20" ]] ||
  fail "expected 20 unique ExceptionCode rows, found ${exception_counts}"

rf_counts="$(awk -F'|' '/^\| RF-AC-[0-9][0-9] / {gsub(/ /, "", $2); seen[$2]=1; rows++} END {unique=0; for (v in seen) unique++; print rows ":" unique}' "${document}")"
[[ "${rf_counts}" == "20:20" ]] ||
  fail "expected 20 unique RF-AC rows, found ${rf_counts}"
rf_stage_boundary="$(awk -F'|' '
  /^\| RF-AC-[0-9][0-9] / {
    contract=$6
    high_fidelity=$7
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", contract)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", high_fidelity)
    if (contract != "DEFERRED" && contract != "PASS") contract_invalid++
    if (high_fidelity != "NOT_RUN") high_fidelity_invalid++
  }
  END {print contract_invalid + 0 ":" high_fidelity_invalid + 0}
' "${document}")"
[[ "${rf_stage_boundary}" == "0:0" ]] || {
  [[ "${rf_stage_boundary##*:}" == "0" ]] ||
    fail "high-fidelity RF-AC results must remain NOT_RUN"
  fail "RF-AC contract results must be DEFERRED or PASS"
}
rm_counts="$(awk '/^ISHFI-RM-[0-9][0-9] =$/ {seen[$1]=1; rows++} END {unique=0; for (v in seen) unique++; print rows ":" unique}' "${document}")"
[[ "${rm_counts}" == "30:30" ]] ||
  fail "expected 30 unique reverse-migration items, found ${rm_counts}"

evidence_classes=(
  CognitiveModuleDefaultReading
  RelationFocus
  SourceEvidenceVerification
  RevisionAndImpact
  Recovery
  KnowledgeLandscapeAndKnowledgeTheme
  SmallScreenSafeReadable
  StaticExport
)
[[ "$(grep -c '^HFD03EvidenceClass = ' "${document}" || true)" -eq 8 ]] ||
  fail "expected exact eight canonical evidence classes in candidate"
[[ "$(grep -c '^EvidencePath = ' "${plan}" || true)" -eq 8 ]] ||
  fail "expected exact eight canonical evidence classes in plan"
evidence_sequence=0
for evidence_class in "${evidence_classes[@]}"; do
  evidence_sequence=$((evidence_sequence + 1))
  printf -v evidence_ordinal '%02d' "${evidence_sequence}"
  [[ "$(grep -Fxc "HFD03EvidenceClass = ${evidence_class}" "${document}" || true)" -eq 1 ]] ||
    fail "expected exact eight canonical evidence classes in candidate"
  [[ "$(grep -c "^EvidencePath = ${evidence_ordinal}|${evidence_class}|" "${plan}" || true)" -eq 1 ]] ||
    fail "expected exact eight canonical evidence classes in plan"
done

for contract_link in \
  'HFD03EvidencePlan = docs/engineering/cognitura-high-fidelity-design-plan.md' \
  'HFD03EvidenceAcceptance = docs/engineering/cognitura-high-fidelity-design-acceptance.md' \
  'HFD03EvidenceContract = PASS' \
  'HFD03GateMeaning = EVIDENCE_INPUT_CONTRACT_COMPLETE_ONLY'; do
  require_exact_line_once "${contract_link}" "HF-DG3 candidate evidence link is missing or duplicated"
done

for plan_contract in \
  'CanonicalProjectName = Cognitura' \
  'PlanKind = HIGH_FIDELITY_EVIDENCE_EXECUTION_PLAN' \
  'EvidenceInputContract = PASS' \
  'HighFidelityVisualDesign = NOT_RUN' \
  'HighFidelityUsabilityValidation = NOT_RUN' \
  'ImplementationValidation = NOT_RUN' \
  'VisualTaskCardArtifacts = NOT_CREATED' \
  'HV-D00ReleaseCondition = HF_D04_FIXED_CANDIDATE_DOUBLE_REVIEW_PASS'; do
  [[ "$(grep -Fxc "${plan_contract}" "${plan}" || true)" -eq 1 ]] ||
    fail "high-fidelity evidence plan contract mismatch: ${plan_contract}"
done

for acceptance_contract in \
  'CanonicalProjectName = Cognitura' \
  'AcceptanceKind = HIGH_FIDELITY_EVIDENCE_ACCEPTANCE_LEDGER' \
  'EvidenceArtifactCapture = NOT_RUN' \
  'HighFidelityVisualDesign = NOT_RUN' \
  'HighFidelityUsabilityValidation = NOT_RUN' \
  'ImplementationValidation = NOT_RUN'; do
  [[ "$(grep -Fxc "${acceptance_contract}" "${acceptance}" || true)" -eq 1 ]] ||
    fail "high-fidelity acceptance stage mismatch: ${acceptance_contract}"
done

for coverage_contract in \
  'CoverageRequirement = KnowledgeElementLocationAndExpansion|REQUIRED|Status=NOT_RUN' \
  'CoverageRequirement = PageLifecycle|LOADING,EMPTY,ERROR,PERMISSION_DENIED,UNAVAILABLE|Status=NOT_RUN' \
  'CoverageRequirement = KeyboardFocusAccessibilityFeedback|KEYBOARD_FOCUS,A11Y,FEEDBACK|Status=NOT_RUN' \
  'CoverageRequirement = Viewport|DESKTOP_WEB,SMALL_SCREEN_SAFE_READABLE|Status=NOT_RUN'; do
  [[ "$(grep -Fxc "${coverage_contract}" "${plan}" || true)" -eq 1 ]] ||
    fail "evidence coverage requirement mismatch: ${coverage_contract}"
done

visual_tasks=(
  'HV-D00|VisualFoundation'
  'HV-D01|ModuleDefaultReading'
  'HV-D02|FocusAndSource'
  'HV-D03|RevisionAndRecovery'
  'HV-D04|CrossLayerResponsiveAndExport'
  'HV-D05|FixedVisualUsabilityReview'
)
[[ "$(grep -c '^HVDesignTask = ' "${plan}" || true)" -eq 6 ]] ||
  fail "expected exact HV-D00..HV-D05 task sequence"
for visual_task in "${visual_tasks[@]}"; do
  [[ "$(grep -Fxc "HVDesignTask = ${visual_task}|BLOCKED|NOT_RELEASED" "${plan}" || true)" -eq 1 ]] ||
    fail "visual design tasks must remain BLOCKED and NOT_RELEASED"
done
[[ "$(grep -Ec '^HVDesignTask = .*\|(READY|RELEASED)(\||$)' "${plan}" || true)" -eq 0 ]] ||
  fail "visual design tasks must remain BLOCKED and NOT_RELEASED"

cross_domain_result="$(awk -F'|' '
  /^CrossDomainScenario = / {
    split($1, prefix, " = ")
    type=prefix[2]
    seen[type]++
    if ($2 !~ /^EvidenceClass=[^|]+$/) invalid++
    if ($3 != "CanonicalProjection=KnowledgeLandscape>KnowledgeTheme>CognitiveModule>KnowledgeElement") invalid++
    if ($4 !~ /^Scenario=[^|]+$/) invalid++
    if ($5 != "Status=NOT_RUN") invalid++
    if ($6 != "Gate=HV-D04") invalid++
    rows++
  }
  END {
    print rows ":" seen["MECHANISM_DOMAIN"] ":" seen["RULE_POLICY_DOMAIN"] ":" invalid+0
  }
' "${plan}")"
[[ "${cross_domain_result}" == "2:1:1:0" ]] ||
  fail "mechanism and rule-policy cross-domain scenarios required"
[[ "$(grep -c '^HFD03CrossDomainScenario = ' "${document}" || true)" -eq 2 ]] ||
  fail "candidate must contain exactly two cross-domain scenarios"
for cross_domain_type in MECHANISM_DOMAIN RULE_POLICY_DOMAIN; do
  [[ "$(grep -c "^HFD03CrossDomainScenario = ${cross_domain_type}|CanonicalProjection=KnowledgeLandscape>KnowledgeTheme>CognitiveModule>KnowledgeElement|" "${document}" || true)" -eq 1 ]] ||
    fail "candidate cross-domain canonical projection mismatch"
done

validate_acceptance_rows() {
  local prefix="$1"
  awk -F'|' -v prefix="${prefix}" '
    index($0, prefix " = ") == 1 {
      split($1, head, " = ")
      id=head[2]
      if (id == "") invalid++
      if (NF != 9) field_invalid++
      if ($2 !~ /^EvidenceClass=[^|]+$/ ||
          $3 !~ /^Scenario=[^|]+$/ ||
          $4 !~ /^Viewport=[^|]+$/ ||
          $5 !~ /^InputState=[^|]+$/ ||
          $6 !~ /^Expected=[^|]+$/ ||
          $9 !~ /^Gate=HV-D0[1-5]$/) field_invalid++
      if ($7 !~ /^Artifact=PLANNED:/) artifact_invalid++
      if ($8 != "Status=NOT_RUN") status_invalid++
      evidence=$2
      sub(/^EvidenceClass=/, "", evidence)
      allowed="|CognitiveModuleDefaultReading|RelationFocus|SourceEvidenceVerification|RevisionAndImpact|Recovery|KnowledgeLandscapeAndKnowledgeTheme|SmallScreenSafeReadable|StaticExport|"
      if (index(allowed, "|" evidence "|") == 0) evidence_invalid++
      rows++
    }
    END {print rows ":" invalid+0 ":" field_invalid+0 ":" artifact_invalid+0 ":" status_invalid+0 ":" evidence_invalid+0}
  ' "${acceptance}"
}

rf_acceptance_result="$(validate_acceptance_rows RFAcceptance)"
exception_acceptance_result="$(validate_acceptance_rows ExceptionAcceptance)"
[[ "${rf_acceptance_result}" == "20:0:0:0:0:0" ]] || {
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f1)" -eq 20 ]] ||
    fail "expected exact RF-AC-01..20 acceptance set"
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f3)" -eq 0 ]] ||
    fail "acceptance evidence row field mismatch"
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f4)" -eq 0 ]] ||
    fail "acceptance artifacts must remain PLANNED"
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f5)" -eq 0 ]] ||
    fail "acceptance evidence status must remain NOT_RUN"
  fail "acceptance evidence row field mismatch"
}
[[ "${exception_acceptance_result}" == "20:0:0:0:0:0" ]] || {
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f1)" -eq 20 ]] ||
    fail "expected exact 20 exception acceptance set"
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f3)" -eq 0 ]] ||
    fail "acceptance evidence row field mismatch"
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f4)" -eq 0 ]] ||
    fail "acceptance artifacts must remain PLANNED"
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f5)" -eq 0 ]] ||
    fail "acceptance evidence status must remain NOT_RUN"
  fail "acceptance evidence row field mismatch"
}

rf_index=1
while [[ "${rf_index}" -le 20 ]]; do
  printf -v rf_number '%02d' "${rf_index}"
  rf_id="RF-AC-${rf_number}"
  [[ "$(grep -c "^| ${rf_id} |" "${document}" || true)" -eq 1 ]] ||
    fail "candidate expected exact RF-AC-01..20 set"
  [[ "$(grep -c "^RFAcceptance = ${rf_id}|" "${acceptance}" || true)" -eq 1 ]] ||
    fail "expected exact RF-AC-01..20 acceptance set"
  rf_index=$((rf_index + 1))
done

exception_ids=(
  EX-PREVIEW-TARGET-DELETED
  EX-RELATION-SUPERSEDED
  EX-ELEMENT-PRIMARY-PARENT-CHANGED
  EX-AUTO-UPGRADE-FAILED
  EX-IMPACT-ANALYSIS-FAILED
  EX-CANONICAL-SAVED-RECOMPUTE-FAILED
  EX-CANONICAL-SAVED-GENERATION-FAILED
  EX-GENERATED-CONFLICTS-LOCKED
  EX-DRAFT-CONFLICTS-LATEST
  EX-SOURCE-INVALIDATED
  EX-REFRESH-FOCUS-RESTORE-FAILED
  EX-SEMANTIC-ANCHOR-MOVED
  EX-SMALL-SCREEN-PANEL-OVERFLOW
  EX-TOUCH-NO-HOVER
  EX-KEYBOARD-ENTERS-GRAPH
  EX-DUPLICATE-SUBMIT-CLICK
  EX-NETWORK-TIMEOUT-SAVE-UNKNOWN
  EX-UI-FAILED-CANONICAL-SAVED
  EX-REVERT-AFFECTS-LATER-CHANGES
  EX-WORKSPACE-SWITCH-WITH-DRAFT
)
for exception_id in "${exception_ids[@]}"; do
  [[ "$(grep -Fxc "| \`ExceptionCode\` | ${exception_id} |" "${document}" || true)" -eq 1 ]] ||
    fail "candidate expected exact 20 exception set"
  [[ "$(grep -c "^ExceptionAcceptance = ${exception_id}|" "${acceptance}" || true)" -eq 1 ]] ||
    fail "expected exact 20 exception acceptance set"
done

rm_index=1
while [[ "${rm_index}" -le 30 ]]; do
  printf -v rm_number '%02d' "${rm_index}"
  rm_id="ISHFI-RM-${rm_number}"
  [[ "$(grep -Fxc "${rm_id} =" "${document}" || true)" -eq 1 ]] ||
    fail "candidate expected exact ISHFI-RM-01..30 set"
  [[ "$(grep -c "^ReverseMigrationTrace = ${rm_id}|" "${acceptance}" || true)" -eq 1 ]] ||
    fail "expected exact ISHFI-RM-01..30 trace set"
  rm_index=$((rm_index + 1))
done
rm_trace_result="$(awk -F'|' '
  /^ReverseMigrationTrace = ISHFI-RM-[0-9][0-9]\|/ {
    if (NF != 5 ||
        $2 !~ /^Candidate=ISHFI-RM-[0-9][0-9]$/ ||
        $3 != "Plan=HFD03EvidenceContract" ||
        $4 != "Acceptance=NOT_RUN" ||
        $5 != "Status=TRACED") invalid++
    rows++
  }
  END {print rows ":" invalid+0}
' "${acceptance}")"
[[ "${rm_trace_result}" == "30:0" ]] ||
  fail "reverse-migration trace row field mismatch"

evidence_class_coverage="$(awk -F'|' '
  /^(RFAcceptance|ExceptionAcceptance) = / {
    value=$2
    sub(/^EvidenceClass=/, "", value)
    seen[value]=1
  }
  END {count=0; for (value in seen) count++; print count}
' "${acceptance}")"
[[ "${evidence_class_coverage}" -eq 8 ]] ||
  fail "acceptance must cover every canonical evidence class"

