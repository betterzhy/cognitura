  /^CrossDomainScenario = / {
    split($1, prefix, " = ")
    type=prefix[2]
    seen[type]++
    if ($2 !~ /^EvidenceClass=[^|]+$/) invalid++
    if ($3 != "CanonicalProjection=KnowledgeLandscape>KnowledgeTheme>CognitiveModule>KnowledgeElement") invalid++
    if ($4 !~ /^Scenario=[^|]+$/) invalid++
    if ($5 != "Status=NOT_RUN") invalid++
    if ($6 != "Gate=HV-D04") invalid++
    rows++
  }
