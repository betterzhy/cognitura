validate_acceptance_rows() {
  local prefix="$1"
  awk -F'|' -v prefix="${prefix}" '
    index($0, prefix " = ") == 1 {
      split($1, head, " = ")
      id=head[2]
      if (id == "") invalid++
      if (NF != 9) field_invalid++
      if ($2 !~ /^EvidenceClass=[^|]+$/ ||
          $3 !~ /^Scenario=[^|]+$/ ||
          $4 !~ /^Viewport=[^|]+$/ ||
          $5 !~ /^InputState=[^|]+$/ ||
          $6 !~ /^Expected=[^|]+$/ ||
          $9 !~ /^Gate=HV-D0[1-5]$/) field_invalid++
      if ($7 !~ /^Artifact=PLANNED:/) artifact_invalid++
      if ($8 != "Status=NOT_RUN") status_invalid++
      evidence=$2
      sub(/^EvidenceClass=/, "", evidence)
      allowed="|CognitiveModuleDefaultReading|RelationFocus|SourceEvidenceVerification|RevisionAndImpact|Recovery|KnowledgeLandscapeAndKnowledgeTheme|SmallScreenSafeReadable|StaticExport|"
      if (index(allowed, "|" evidence "|") == 0) evidence_invalid++
      rows++
    }
    END {print rows ":" invalid+0 ":" field_invalid+0 ":" artifact_invalid+0 ":" status_invalid+0 ":" evidence_invalid+0}
  ' "${acceptance}"
}

rf_acceptance_result="$(validate_acceptance_rows RFAcceptance)"
exception_acceptance_result="$(validate_acceptance_rows ExceptionAcceptance)"
[[ "${rf_acceptance_result}" == "20:0:0:0:0:0" ]] || {
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f1)" -eq 20 ]] ||
    fail "expected exact RF-AC-01..20 acceptance set"
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f3)" -eq 0 ]] ||
    fail "acceptance evidence row field mismatch"
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f4)" -eq 0 ]] ||
    fail "acceptance artifacts must remain PLANNED"
  [[ "$(printf '%s' "${rf_acceptance_result}" | cut -d: -f5)" -eq 0 ]] ||
    fail "acceptance evidence status must remain NOT_RUN"
  fail "acceptance evidence row field mismatch"
}
[[ "${exception_acceptance_result}" == "20:0:0:0:0:0" ]] || {
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f1)" -eq 20 ]] ||
    fail "expected exact 20 exception acceptance set"
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f3)" -eq 0 ]] ||
    fail "acceptance evidence row field mismatch"
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f4)" -eq 0 ]] ||
    fail "acceptance artifacts must remain PLANNED"
  [[ "$(printf '%s' "${exception_acceptance_result}" | cut -d: -f5)" -eq 0 ]] ||
    fail "acceptance evidence status must remain NOT_RUN"
  fail "acceptance evidence row field mismatch"
}

