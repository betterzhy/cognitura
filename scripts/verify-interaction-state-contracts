  'ISHFI-RM-26|RelationFocus|02|RF-AC-16,EX-KEYBOARD-ENTERS-GRAPH'
  'ISHFI-RM-27|Recovery|05|RF-AC-18,EX-NETWORK-TIMEOUT-SAVE-UNKNOWN,EX-UI-FAILED-CANONICAL-SAVED'
  'ISHFI-RM-28|CognitiveModuleDefaultReading|01|RF-AC-08'
  'ISHFI-RM-29|StaticExport|08|RF-AC-19'
  'ISHFI-RM-30|KnowledgeLandscapeAndKnowledgeTheme|06|RF-AC-20'
)
for rm_binding in "${rm_bindings[@]}"; do
  IFS='|' read -r rm_id rm_class rm_path rm_acceptance_ids <<<"${rm_binding}"
  expected_rm_trace="ReverseMigrationTrace = ${rm_id}|Candidate=${rm_id}|EvidenceClass=${rm_class}|EvidencePath=${rm_path}|AcceptanceIds=${rm_acceptance_ids}|Status=TRACED"
  [[ "$(grep -Fxc "${expected_rm_trace}" "${acceptance}" || true)" -eq 1 ]] ||
    fail "reverse-migration trace binding mismatch"
  [[ "$(grep -c "^EvidencePath = ${rm_path}|${rm_class}|" "${plan}" || true)" -eq 1 ]] ||
    fail "reverse-migration trace binding mismatch"
  IFS=',' read -r -a rm_references <<<"${rm_acceptance_ids}"
  [[ "${#rm_references[@]}" -ge 1 ]] || fail "reverse-migration trace binding mismatch"
  for rm_reference in "${rm_references[@]}"; do
    rm_reference_count="$(awk -F'|' -v id="${rm_reference}" -v evidence_class="${rm_class}" '
      index($0, "RFAcceptance = " id "|") == 1 || index($0, "ExceptionAcceptance = " id "|") == 1 {
        rows++
        if ($2 != "EvidenceClass=" evidence_class) invalid++
      }
      END {print rows ":" invalid+0}
    ' "${acceptance}")"
    [[ "${rm_reference_count}" == "1:0" ]] || fail "reverse-migration trace binding mismatch"
  done
done

evidence_class_coverage="$(awk -F'|' '
  /^(RFAcceptance|ExceptionAcceptance) = / {
    value=$2
    sub(/^EvidenceClass=/, "", value)
    seen[value]=1
  }
  END {count=0; for (value in seen) count++; print count}
' "${acceptance}")"
[[ "${evidence_class_coverage}" -eq 8 ]] ||
  fail "acceptance must cover every canonical evidence class"

printf '%s\n' \
  "InteractionStateContractValidation = PASS" \
  "OriginalStateCodeCount = 46" \
  "ClassifiedOriginalStateCodeCount = 46" \
  "OrthogonalAxisCount = 6" \
  "PersistenceLedgerLevelCount = 5" \
  "PageStateMappingCount = 12" \
  "ExceptionCodeCount = 20" \
  "RFAcceptanceCount = 20" \
  "ReverseMigrationCount = 30" \
  "EvidenceClassCount = 8" \
  "RFAcceptanceEvidenceCount = 20" \
  "ExceptionAcceptanceEvidenceCount = 20" \
  "ReverseMigrationTraceCount = 30" \
  "CrossDomainScenarioCount = 2" \
  "VisualDesignTaskCount = 6" \
  "HighFidelityVisualDesign = NOT_RUN" \
  "HighFidelityUsabilityValidation = NOT_RUN"
