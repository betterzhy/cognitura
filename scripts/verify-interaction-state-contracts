validate_acceptance_binding() {
  local prefix="$1"
  local id="$2"
  local evidence_class="$3"
  local scenario="$4"
  local expected="$5"
  local gate="$6"
  local result
  result="$(awk -F'|' -v prefix="${prefix}" -v id="${id}" \
    -v evidence_class="${evidence_class}" -v scenario="${scenario}" \
    -v expected="${expected}" -v gate="${gate}" '
    index($0, prefix " = " id "|") == 1 {
      rows++
      if ($2 != "EvidenceClass=" evidence_class ||
          $3 != "Scenario=" scenario ||
          $6 != "Expected=" expected ||
          $9 != "Gate=" gate) invalid++
    }
    END {print rows ":" invalid+0}
  ' "${acceptance}")"
  [[ "${result}" == "1:0" ]]
}

