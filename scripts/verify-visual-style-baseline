#!/bin/sh
/usr/bin/env -i \
  HOME="${HOME:-/tmp}" \
  TMPDIR="${TMPDIR:-/tmp}" \
  PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" \
  LANG="${LANG:-C}" \
  /bin/bash -s -- "$@" <<'VSB_SANITIZED_PAYLOAD'
set -euo pipefail

repo_root=""
candidate_sha=""
runtime_root=""

cleanup() {
  if [[ -n "${runtime_root}" && -d "${runtime_root}" ]]; then
    rm -rf -- "${runtime_root}"
  fi
}
trap cleanup EXIT

fail() {
  printf 'VisualStyleBaselineVerification = FAIL\n%s\n' "$1" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'Usage: scripts/verify-visual-style-baseline --repo-root PATH [--candidate-sha SHA]' >&2
  exit 2
}

sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

require_exact_text_block() {
  local source_file="$1"
  local expected_block="$2"
  local label="$3"
  local expected_file actual_file
  expected_file="${runtime_root}/${label}.expected"
  actual_file="${runtime_root}/${label}.actual"
  [[ "$(grep -Fxc -- '```text' "${source_file}" || true)" -eq 1 ]] ||
    fail "${label} must contain exactly one text block"
  awk '
    $0 == "```text" { capture = 1; next }
    capture && $0 == "```" { closed = 1; exit }
    capture { print }
    END { if (!capture || !closed) exit 1 }
  ' "${source_file}" > "${actual_file}" || fail "${label} text block is not closed"
  printf '%s\n' "${expected_block}" > "${expected_file}"
  cmp -s "${expected_file}" "${actual_file}" || fail "${label} text block mismatch"
}

require_exact_evidence_table() {
  local source_file="$1"
  local expected_table="$2"
  local expected_file actual_file
  expected_file="${runtime_root}/evidence-table.expected"
  actual_file="${runtime_root}/evidence-table.actual"
  [[ "$(grep -Fxc -- '| File | Viewport | Bytes | SHA-256 | Capture command | Real DOM probe | Computed style | Runtime guard | Comparison ready | Allowed requests | Freshness |' "${source_file}" || true)" -eq 1 ]] ||
    fail "evidence manifest table header mismatch"
  [[ "$(grep -c '^|' "${source_file}" || true)" -eq 6 ]] ||
    fail "evidence manifest table must be a four-row closed set"
  awk '
    $0 == "| File | Viewport | Bytes | SHA-256 | Capture command | Real DOM probe | Computed style | Runtime guard | Comparison ready | Allowed requests | Freshness |" { capture = 1 }
    capture && $0 == "" { exit }
    capture { print }
  ' "${source_file}" > "${actual_file}"
  printf '%s\n' "${expected_table}" > "${expected_file}"
  cmp -s "${expected_file}" "${actual_file}" || fail "evidence manifest table mismatch"
}

require_png_dimensions() {
  python3 - "$1" "$2" "$3" <<'PY'
import pathlib
import struct
import sys

data = pathlib.Path(sys.argv[1]).read_bytes()
if len(data) < 24 or data[:8] != b"\x89PNG\r\n\x1a\n":
    raise SystemExit(1)
if struct.unpack(">II", data[16:24]) != (int(sys.argv[2]), int(sys.argv[3])):
    raise SystemExit(1)
PY
}

