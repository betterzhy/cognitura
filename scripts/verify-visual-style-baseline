governed_expected_mode() {
  case "$1" in
    scripts/import-visual-style-reference|\
    scripts/verify-visual-style-baseline-reference|\
    scripts/verify-module-default-reading|\
    scripts/capture-visual-style-baseline|\
    scripts/verify-visual-style-baseline|\
    tests/visual-style-baseline/verify-visual-style-baseline.sh)
      printf '%s\n' 100755
      ;;
    *)
      printf '%s\n' 100644
      ;;
  esac
}

validate_ordinary_candidate_history() {
  local inspected_candidate="$1"
  local release_receipt candidate_file actual_files expected_files raw_status
  local candidate_mode expected_mode
  local chain_commit commit_parent commit_file
  git -C "${repo_root}" rev-parse --verify "${inspected_candidate}^{commit}" >/dev/null 2>&1 ||
    fail "candidate SHA must resolve to a commit"
  git -C "${repo_root}" merge-base --is-ancestor "${inspected_candidate}" HEAD ||
    fail "candidate SHA must be an ancestor of HEAD"
  release_receipt="$(git -C "${repo_root}" rev-list --first-parent -n 1 \
    "${inspected_candidate}" -- \
    docs/task-cards/visual-style-baseline/execution-state.md)"
  [[ -n "${release_receipt}" ]] || fail "candidate release receipt is missing"
  [[ "$(git -C "${repo_root}" show "${release_receipt}:docs/task-cards/visual-style-baseline/execution-state.md" | sed -n 's/^ChromeAuthorityMigrationStatus = //p')" == PASS ]] ||
    fail "candidate parent must be the validated R4 release anchor"
  [[ "$(git -C "${repo_root}" show "${release_receipt}:docs/task-cards/visual-style-baseline/execution-state.md" | sed -n 's/^ExecutionStateVersion = //p')" == 5 ]] ||
    fail "candidate parent must use execution-state version 5"

  expected_files="$(owner_files)"
  actual_files="$(git -C "${repo_root}" diff --name-only "${release_receipt}..${inspected_candidate}" | LC_ALL=C sort)"
  [[ "${actual_files}" == "$(printf '%s\n' "${expected_files}" | LC_ALL=C sort)" ]] ||
    fail "candidate must have the exact twelve-path VSB-03 WriteSet"
  while IFS= read -r chain_commit; do
    [[ -n "${chain_commit}" ]] || continue
    [[ "$(git -C "${repo_root}" show -s --format='%P' "${chain_commit}" | wc -w | tr -d ' ')" -eq 1 ]] ||
      fail "candidate chain commits must have exactly one parent"
    commit_parent="$(git -C "${repo_root}" rev-parse "${chain_commit}^")"
    raw_status="$(git -C "${repo_root}" diff-tree --no-commit-id --name-status -r \
      -M -C --find-copies-harder "${commit_parent}" "${chain_commit}")"
    [[ -n "${raw_status}" ]] || fail "candidate chain commits must be non-empty"
    [[ -z "$(printf '%s\n' "${raw_status}" | awk '$1 ~ /^[RC]/{print}')" ]] ||
      fail "candidate chain must not rename or copy paths"
    while IFS= read -r commit_file; do
      [[ -n "${commit_file}" ]] || continue
      printf '%s\n' "${expected_files}" | grep -Fqx -- "${commit_file}" ||
        fail "candidate chain changed a path outside the exact VSB-03 WriteSet"
    done < <(git -C "${repo_root}" diff --name-only "${commit_parent}..${chain_commit}")
  done < <(git -C "${repo_root}" rev-list --reverse \
    "${release_receipt}..${inspected_candidate}")

  while IFS= read -r candidate_file; do
    [[ -n "${candidate_file}" ]] || continue
    git -C "${repo_root}" cat-file -e "${inspected_candidate}:${candidate_file}" 2>/dev/null ||
      fail "candidate is missing ${candidate_file}"
  done <<< "${expected_files}"

}

historical_hv_repair_write_set() {
  printf '%s\n' \
    docs/superpowers/specs/2026-08-15-cognitura-vsb-historical-hv-replay-repair-design.md \
    docs/superpowers/plans/2026-08-15-cognitura-vsb-historical-hv-replay-repair.md \
    docs/superpowers/plans/2026-08-12-cognitura-visual-style-baseline.md \
    docs/task-cards/visual-style-baseline/README.md \
    scripts/verify-visual-style-baseline-cards \
    tests/task-cards/verify-visual-style-baseline-cards.sh \
    scripts/verify-visual-style-baseline \
    tests/visual-style-baseline/verify-visual-style-baseline.sh
}

historical_hv_repair_expected_mode() {
  case "$1" in
    scripts/verify-visual-style-baseline-cards|\
    tests/task-cards/verify-visual-style-baseline-cards.sh|\
    scripts/verify-visual-style-baseline|\
    tests/visual-style-baseline/verify-visual-style-baseline.sh)
      printf '100755\n'
      ;;
    *) printf '100644\n' ;;
  esac
}

validate_historical_hv_repair_history() {
  local inspected_candidate="$1"
  local repair_origin=2690ab9e6d0318c63deb56f86bc0b923ae845c04
  local repair_authority=244b89d68ae29f08fd9c019ed530db87098e763b
  local previous_commit chain_commit parent_commit raw_status changed_file
  local actual_files expected_files candidate_mode expected_mode content_file
  local authority_path authority_blob candidate_blob
  git -C "${repo_root}" merge-base --is-ancestor \
    "${repair_origin}" "${inspected_candidate}" ||
    fail "historical HV repair candidate must descend the failed candidate"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${repair_authority}" "${inspected_candidate}" ||
    fail "historical HV repair candidate must descend the fixed Authority"
  previous_commit="${repair_origin}"
  while IFS= read -r chain_commit; do
    [[ -n "${chain_commit}" ]] || continue
    [[ "$(git -C "${repo_root}" show -s --format='%P' \
         "${chain_commit}" | wc -w | tr -d ' ')" -eq 1 ]] ||
      fail "historical HV repair chain must be linear"
    parent_commit="$(git -C "${repo_root}" rev-parse "${chain_commit}^")"
    [[ "${parent_commit}" == "${previous_commit}" ]] ||
      fail "historical HV repair chain must be linear"
    raw_status="$(git -C "${repo_root}" -c diff.renameLimit=0 diff-tree \
      --no-commit-id --name-status -r -M -C --find-copies-harder \
      "${parent_commit}" "${chain_commit}")"
    [[ -n "${raw_status}" ]] ||
      fail "historical HV repair chain commits must be non-empty"
    [[ -z "$(printf '%s\n' "${raw_status}" | awk '$1 ~ /^[RC]/{print}')" ]] ||
      fail "historical HV repair chain must not rename or copy paths"
    while IFS= read -r changed_file; do
      [[ -n "${changed_file}" ]] || continue
      historical_hv_repair_write_set | grep -Fqx -- "${changed_file}" ||
        fail "historical HV repair changed a path outside the exact eight-path WriteSet"
      candidate_mode="$(git -C "${repo_root}" ls-tree \
        "${chain_commit}" -- "${changed_file}" | awk '{print $1}')"
      expected_mode="$(historical_hv_repair_expected_mode "${changed_file}")"
      [[ "${candidate_mode}" == "${expected_mode}" ]] ||
        fail "historical HV repair path mode mismatch: ${changed_file}"
      content_file="${runtime_root}/repair-content-$(printf '%s' "${chain_commit}${changed_file}" | shasum | awk '{print $1}')"
      git -C "${repo_root}" show "${chain_commit}:${changed_file}" > \
        "${content_file}" 2>/dev/null ||
        fail "historical HV repair path is missing: ${changed_file}"
      [[ "$(LC_ALL=C tr -cd '\000' < "${content_file}" | wc -c | tr -d ' ')" -eq 0 ]] ||
        fail "historical HV repair path contains NUL: ${changed_file}"
    done < <(git -C "${repo_root}" diff --name-only \
      "${parent_commit}..${chain_commit}")
    [[ "$(git -C "${repo_root}" rev-parse \
         "${chain_commit}:docs/task-cards/visual-style-baseline/execution-state.md")" == \
       "$(git -C "${repo_root}" rev-parse \
         "${repair_origin}:docs/task-cards/visual-style-baseline/execution-state.md")" ]] ||
      fail "historical HV repair must preserve the execution ledger"
    previous_commit="${chain_commit}"
  done < <(git -C "${repo_root}" rev-list --reverse --first-parent \
    "${repair_origin}..${inspected_candidate}")
  [[ "${previous_commit}" == "${inspected_candidate}" ]] ||
    fail "historical HV repair chain must be linear"
  actual_files="$(git -C "${repo_root}" diff --name-only \
    "${repair_origin}..${inspected_candidate}" | LC_ALL=C sort)"
  expected_files="$(historical_hv_repair_write_set | LC_ALL=C sort)"
  [[ "${actual_files}" == "${expected_files}" ]] ||
    fail "historical HV repair candidate must have the exact eight-path WriteSet"
  for authority_path in \
      docs/superpowers/specs/2026-08-15-cognitura-vsb-historical-hv-replay-repair-design.md \
      docs/superpowers/plans/2026-08-15-cognitura-vsb-historical-hv-replay-repair.md \
      docs/superpowers/plans/2026-08-12-cognitura-visual-style-baseline.md; do
    authority_blob="$(git -C "${repo_root}" rev-parse \
      "${repair_authority}:${authority_path}")"
    candidate_blob="$(git -C "${repo_root}" rev-parse \
      "${inspected_candidate}:${authority_path}")"
    [[ "${authority_blob}" == "${candidate_blob}" &&
       "$(git -C "${repo_root}" ls-tree "${inspected_candidate}" -- \
         "${authority_path}" | awk '{print $1}')" == 100644 ]] ||
      fail "historical HV repair Authority blob or mode drifted"
  done
}

validate_candidate_tree() {
  local inspected_candidate="$1"
  local candidate_file candidate_mode expected_mode
  git -C "${repo_root}" rev-parse --verify \
    "${inspected_candidate}^{commit}" >/dev/null 2>&1 ||
    fail "candidate SHA must resolve to a commit"
  git -C "${repo_root}" merge-base --is-ancestor \
    "${inspected_candidate}" HEAD ||
    fail "candidate SHA must be an ancestor of HEAD"
  if git -C "${repo_root}" merge-base --is-ancestor \
      244b89d68ae29f08fd9c019ed530db87098e763b \
      "${inspected_candidate}" 2>/dev/null; then
    validate_ordinary_candidate_history \
      2690ab9e6d0318c63deb56f86bc0b923ae845c04
    validate_historical_hv_repair_history "${inspected_candidate}"
  else
    validate_ordinary_candidate_history "${inspected_candidate}"
  fi
  while IFS= read -r candidate_file; do
    [[ -n "${candidate_file}" ]] || continue
    git -C "${repo_root}" cat-file -e \
      "${inspected_candidate}:${candidate_file}" 2>/dev/null ||
      fail "candidate is missing governed path: ${candidate_file}"
    candidate_mode="$(git -C "${repo_root}" ls-tree \
      "${inspected_candidate}" -- "${candidate_file}" | awk '{print $1}')"
    expected_mode="$(governed_expected_mode "${candidate_file}")"
    [[ "${candidate_mode}" == "${expected_mode}" ]] ||
      fail "candidate governed mode mismatch: ${candidate_file}"
    git -C "${repo_root}" diff --quiet \
      "${inspected_candidate}" -- "${candidate_file}" ||
      fail "working tree differs from candidate: ${candidate_file}"
  done < <(governed_exclusive_files)
  [[ -z "$(git -C "${repo_root}" diff --cached --name-only)" ]] ||
    fail "candidate verification forbids staged changes"
}

materialize_capture_pair() {
  local inspected_candidate="$1"
  local pair_root="$2"
  local release_receipt g4_sha capture_mode verifier_mode
  local expected_task_card_blob expected_wave1_blob
  release_receipt="$(git -C "${repo_root}" rev-list --first-parent -n 1 \
    "${inspected_candidate}" -- \
    docs/task-cards/visual-style-baseline/execution-state.md)"
  g4_sha="$(git -C "${repo_root}" show \
    "${release_receipt}:docs/task-cards/visual-style-baseline/execution-state.md" |
    sed -n 's/^ChromeAuthorityMigrationReviewedCandidateSHA = //p')"
  [[ "${g4_sha}" =~ ^[0-9a-f]{40}$ ]] || fail "R4 reviewed G4 SHA mismatch"
  git -C "${repo_root}" merge-base --is-ancestor "${g4_sha}" "${release_receipt}" ||
    fail "R4 reviewed G4 must be an ancestor of the candidate"
  capture_mode="$(git -C "${repo_root}" ls-tree "${inspected_candidate}" -- \
    scripts/capture-visual-style-baseline | awk '{print $1}')"
  verifier_mode="$(git -C "${repo_root}" ls-tree "${g4_sha}" -- \
    scripts/verify-visual-style-baseline-cards | awk '{print $1}')"
  [[ "${capture_mode}" == 100755 && "${verifier_mode}" == 100755 ]] ||
    fail "candidate capture pair must use mode 100755"
  mkdir -p "${pair_root}"
  git -C "${repo_root}" show \
    "${inspected_candidate}:scripts/capture-visual-style-baseline" > \
    "${pair_root}/capture-visual-style-baseline"
  git -C "${repo_root}" show \
    "${g4_sha}:scripts/verify-visual-style-baseline-cards" > \
    "${pair_root}/verify-visual-style-baseline-cards"
  chmod 755 "${pair_root}/capture-visual-style-baseline" \
    "${pair_root}/verify-visual-style-baseline-cards"
  [[ "$(git hash-object "${pair_root}/capture-visual-style-baseline")" == \
     "$(git -C "${repo_root}" rev-parse \
       "${inspected_candidate}:scripts/capture-visual-style-baseline")" ]] ||
    fail "materialized capture wrapper blob mismatch"
  [[ "$(git hash-object "${pair_root}/verify-visual-style-baseline-cards")" == \
     "$(git -C "${repo_root}" rev-parse \
       "${g4_sha}:scripts/verify-visual-style-baseline-cards")" ]] ||
    fail "materialized G4 verifier blob mismatch"
  expected_task_card_blob="$(git -C "${repo_root}" rev-parse \
    "${inspected_candidate}:scripts/verify-visual-style-baseline-cards")"
  expected_wave1_blob="$(git -C "${repo_root}" rev-parse \
    "${inspected_candidate}:scripts/verify-wave1-implementation-cards")"
  [[ -x "${repo_root}/scripts/verify-visual-style-baseline-cards" &&
     "$(git hash-object "${repo_root}/scripts/verify-visual-style-baseline-cards")" == \
       "${expected_task_card_blob}" ]] ||
    fail "working task-card verifier must equal the fixed candidate blob and mode"
  [[ -x "${repo_root}/scripts/verify-wave1-implementation-cards" &&
     "$(git hash-object "${repo_root}/scripts/verify-wave1-implementation-cards")" == \
       "${expected_wave1_blob}" ]] ||
    fail "working Wave 1 verifier must equal the candidate blob and mode"
  "${pair_root}/verify-visual-style-baseline-cards" \
    --chrome-capture-source-contract \
    "${pair_root}/capture-visual-style-baseline" >/dev/null
}

validate_evidence_contract() {
  local evidence_dir="$1"
  local manifest_file="$2"
  local capture_file capture_name width height capture_sha capture_bytes
  local expected_fields expected_table
  expected_fields='CanonicalProjectName = Cognitura
EvidenceSet = VISUAL_STYLE_BASELINE_VSB_03
EvidenceStatus = FIXED_CANDIDATE
CandidateSHA = SEE_VISUAL_STYLE_BASELINE_EXECUTION_STATE_AFTER_FIXED_REVIEW
CaptureInputSHA = efc763966d64fc808e9098bec52566edb7d15dc3
ReferenceSHA256 = a8446ea987f6a1710c3845f837e2776190997b77f81584cf7b667cbfebe2f95f
Node = 24.18.0
pnpm = 11.17.0
Chrome = Google Chrome 151.0.7922.138
CaptureToolBinding = FIXED_CANDIDATE_TREE
ProbeInput = tests/visual-style-baseline/browser-probe.html
RuntimeGuardInput = tests/visual-style-baseline/browser-runtime-guard.js
ComparisonInput = tests/visual-style-baseline/reference-comparison.html
HistoricalEvidenceOverwrite = FORBIDDEN'
  expected_table='| File | Viewport | Bytes | SHA-256 | Capture command | Real DOM probe | Computed style | Runtime guard | Comparison ready | Allowed requests | Freshness |
|---|---:|---:|---|---|---|---|---|---|---:|---|
| module-default-reading-1440x1100.png | 1440x1100 | 113892 | bf753320352d7c9aab7bc7c40d9f8b40e1f649c174684695e77d1f3223e65ab0 | fixed `.138` capture | PASS | PASS | PASS | PASS | 62 | PASS |
| module-default-reading-1280x960.png | 1280x960 | 88891 | a2fd1fbf5623fe8e2e28dc23317d3d6064102873bc2a050251657ca9d8b992fb | fixed `.138` capture | PASS | PASS | PASS | PASS | 62 | PASS |
| module-default-reading-1024x900.png | 1024x900 | 86766 | bc7ddbb666f6475ee1e114f76a79bd0920bd4ca94744aa559f9c5edb115c01ef | fixed `.138` capture | PASS | PASS | PASS | PASS | 62 | PASS |
| reference-comparison.png | 2560x1100 | 943719 | 46db84298c34a072ac6c48e079d4a48961b875a0ec8810b25075e1b3abe20b53 | fixed `.138` comparison | PASS | PASS | PASS | PASS | 62 | PASS |'
  [[ "$(grep -Ec '^[A-Za-z][A-Za-z0-9]* = ' "${manifest_file}" || true)" -eq 14 ]] ||
    fail "evidence manifest field set mismatch"
  require_exact_text_block "${manifest_file}" "${expected_fields}" "evidence-manifest"
  require_exact_evidence_table "${manifest_file}" "${expected_table}"

  for capture_name in \
      module-default-reading-1440x1100.png:1440:1100 \
      module-default-reading-1280x960.png:1280:960 \
      module-default-reading-1024x900.png:1024:900 \
      reference-comparison.png:2560:1100; do
    width="${capture_name#*:}"
    width="${width%%:*}"
    height="${capture_name##*:}"
    capture_name="${capture_name%%:*}"
    capture_file="${evidence_dir}/${capture_name}"
    [[ -f "${capture_file}" ]] || fail "missing evidence PNG: ${capture_name}"
    require_png_dimensions "${capture_file}" "${width}" "${height}" ||
      fail "evidence PNG dimensions mismatch: ${capture_name}"
    capture_sha="$(sha256_file "${capture_file}")"
    capture_bytes="$(wc -c < "${capture_file}" | tr -d ' ')"
    grep -Fq "| ${capture_name} | ${width}x${height} | ${capture_bytes} | ${capture_sha} |" \
      "${manifest_file}" || fail "evidence manifest row mismatch: ${capture_name}"
  done
}

validate_acceptance_contract() {
  local acceptance_file="$1"
  local expected_fields
  expected_fields='CanonicalProjectName = Cognitura
AcceptanceKind = VISUAL_STYLE_BASELINE
Authority = docs/design/Cognitive-Knowledge-Atlas-Visual-Style-Reference-1.0.md
Evidence = docs/design/visual-style-baseline/evidence/README.md
FixedCandidateSHA = SEE_VISUAL_STYLE_BASELINE_EXECUTION_STATE_AFTER_FIXED_REVIEW
SameProductFamily = PASS
SameVisualCalmness = PASS
SameSurfaceCharacter = PASS
SameBorderCharacter = PASS
SameBluePurpleFamily = PASS
SameTypographyDensity = PASS
SameIconCharacter = PASS
SameRefinementLevel = PASS
SameSemanticColorRestraint = PASS
NewPageIsSubstantiallyMoreReadingFirst = PASS
SameProductVisualFamilyWithReference = PASS
ReadingFirst = PASS
InteractiveCognitiveDocument = PASS
ContinuousDocumentFlow = PASS
ZeroInteractionReading = PASS
CardAndContainerRestraint = PASS
VisualPrimitiveDensity = PASS
InteractionExposureRestraint = PASS
TypographyHierarchy = PASS
ColorSemanticConsistency = PASS
RelationSemanticExpression = PASS
NoDashboardRegression = PASS
NoCardWallRegression = PASS
NoAISaaSTemplateDrift = PASS
NoFormalDesignAuthorityViolation = PASS
VisualStyleBaseline = PASS
ModuleDefaultReadingVisualImplementation = PASS_WITHIN_EXISTING_CANONICAL_PROJECTION
FullModuleDefaultReadingBusinessAcceptance = BLOCKED_BY_DOC_GAP_MDR_001
ImplementationValidation = NOT_CLAIMED_FOR_FULL_PRODUCT_PAGE
FormalDatabaseWrite = NOT_AUTHORIZED
RemotePush = NOT_AUTHORIZED'
  [[ "$(grep -Ec '^[A-Za-z][A-Za-z0-9]* = ' "${acceptance_file}" || true)" -eq 36 ]] ||
    fail "visual acceptance field set mismatch"
  require_exact_text_block "${acceptance_file}" "${expected_fields}" "visual-acceptance"
}

require_historical_hv_output() {
  local output_file="$1"
  local line field
  for line in \
    'HighFidelityVisualTaskCardValidation = PASS' \
    'TaskCardSetStatus = COMPLETE' \
    'HighFidelityVisualDesign = PASS' \
    'HighFidelityDesignStatus = COMPLETE' \
    'HighFidelityVisualValidation = PASS' \
    'HighFidelityUsabilityValidation = PASS' \
    'HighFidelityStateAcceptance = PASS' \
    'ImplementationValidation = NOT_RUN' \
    'BusinessImplementation = NOT_AUTHORIZED' \
    'FormalDatabaseWrite = NOT_AUTHORIZED' \
    'RemotePush = NOT_AUTHORIZED'; do
    field="${line%% = *}"
    [[ "$(grep -c "^${field} = " "${output_file}" || true)" -eq 1 &&
       "$(grep -Fxc -- "${line}" "${output_file}" || true)" -eq 1 ]] ||
      fail "historical HV replay output mismatch: ${line}"
  done
  [[ -z "$(grep -E ' = (FAIL|AUTHORIZED|USER_AUTHORIZED)$' \
      "${output_file}" || true)" ]] ||
    fail "historical HV replay output contains a contradiction"
}

run_historical_hv_replay() {
  local snapshot_sha=77d8c1e780f5cc4d209a56baff349135a3c04ee8
  local snapshot_parent=98d5f89731626c0ead69de46255ba4d433d03c86
  local snapshot_tree=476bc02272b2e0c4f8f6eb4565e9dcf08369f762
  local replay_root="${runtime_root}/historical-hv-replay"
  local replay_tmp="${runtime_root}/historical-hv-tmp"
  local replay_output="${runtime_root}/historical-hv-output"
  local locked_path='/Users/yuzhuangzhuang/.npm/_npx/4aa47c519def57bc/node_modules/.bin:/Users/yuzhuangzhuang/.npm/_npx/acaf29b40d536b0e/node_modules/.bin:/opt/homebrew/opt/python@3.11/libexec/bin:/usr/bin:/bin:/usr/sbin:/sbin'
  local chrome_binary='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
  local chrome_version
  [[ "$(git -C "${repo_root}" rev-parse "${snapshot_sha}^{tree}")" == \
       "${snapshot_tree}" &&
     "$(git -C "${repo_root}" rev-parse "${snapshot_sha}^")" == \
       "${snapshot_parent}" ]] ||
    fail "fixed historical HV replay snapshot identity mismatch"
  [[ "$(git -C "${repo_root}" ls-tree "${snapshot_sha}" -- \
       scripts/verify-high-fidelity-visual)" == \
       $'100755 blob 73c1b62e643d3808c16ccab89aefb13e3646502b\tscripts/verify-high-fidelity-visual' &&
     "$(git -C "${repo_root}" ls-tree "${snapshot_sha}" -- AGENTS.md)" == \
       $'100644 blob 3b9dbe8c3241671ed2070446d3781b1453239f07\tAGENTS.md' &&
     "$(git -C "${repo_root}" ls-tree "${snapshot_sha}" -- \
       docs/engineering/cognitura-design-index.md)" == \
       $'100644 blob d0b85366e8eaee7771afdb95436e1a7e28aa75ae\tdocs/engineering/cognitura-design-index.md' ]] ||
    fail "fixed historical HV replay key blob or mode mismatch"
  [[ "$(git -C "${repo_root}" cat-file blob \
       73c1b62e643d3808c16ccab89aefb13e3646502b | git hash-object --stdin)" == \
       73c1b62e643d3808c16ccab89aefb13e3646502b ]] ||
    fail "fixed historical HV replay key blob or mode mismatch"
  [[ -x "${chrome_binary}" ]] ||
    fail "fixed Google Chrome .138 executable is unavailable"
  chrome_version="$("${chrome_binary}" --version)"
  while [[ "${chrome_version}" == *[[:space:]] ]]; do
    chrome_version="${chrome_version%?}"
  done
  [[ "${chrome_version}" == 'Google Chrome 151.0.7922.138' ]] ||
    fail "fixed historical HV replay requires Google Chrome 151.0.7922.138"
  mkdir -p "${replay_root}" "${replay_tmp}"
  /usr/bin/git -C "${repo_root}" archive --format=tar "${snapshot_sha}" |
    /usr/bin/tar -xf - -C "${replay_root}"
  [[ "$(git hash-object \
       "${replay_root}/scripts/verify-high-fidelity-visual")" == \
       73c1b62e643d3808c16ccab89aefb13e3646502b ]] ||
    fail "archived historical HV verifier blob mismatch"
  if ! /usr/bin/env -i \
      HOME="${HOME:-/tmp}" \
      TMPDIR="${replay_tmp}" \
      PATH="${locked_path}" \
      LANG=C \
      /bin/bash "${replay_root}/scripts/verify-high-fidelity-visual" \
      > "${replay_output}" 2>&1; then
    fail "fixed historical HV replay failed: $(tail -n 2 "${replay_output}" | tr '\n' ' ')"
  fi
  require_historical_hv_output "${replay_output}"
  printf '%s\n' \
    "HistoricalHVReplaySHA = ${snapshot_sha}" \
    'HistoricalHVReplay = PASS' \
    'HistoricalHVCurrentTreeVerifier = NOT_RUN'
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --repo-root)
      [[ "$#" -ge 2 ]] || usage
      repo_root="$2"
      shift 2
      ;;
    --candidate-sha)
      [[ "$#" -ge 2 ]] || usage
      candidate_sha="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done
[[ -n "${repo_root}" ]] || usage
repo_root="$(cd "${repo_root}" && pwd -P)"
runtime_root="$(mktemp -d "${TMPDIR:-/tmp}/cognitura-vsb-fixed.XXXXXX")"

capture_runner="${repo_root}/scripts/capture-visual-style-baseline"
task_card_verifier="${repo_root}/scripts/verify-visual-style-baseline-cards"
if [[ -n "${candidate_sha}" ]]; then
