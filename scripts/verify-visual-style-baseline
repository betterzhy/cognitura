  materialize_capture_pair "${candidate_sha}" "${runtime_root}/scripts"
  capture_runner="${runtime_root}/scripts/capture-visual-style-baseline"
else
  "${task_card_verifier}" \
    --chrome-capture-source-contract "${capture_runner}" >/dev/null
fi
run_historical_hv_replay

evidence_dir="${repo_root}/docs/design/visual-style-baseline/evidence"
manifest_file="${evidence_dir}/README.md"
acceptance_file="${repo_root}/docs/engineering/cognitura-visual-style-baseline-acceptance.md"
